Read("programs/ambient_marking.g");;
product:=Set(Concatenation(List(Elements(H0),a->List(Elements(H3),b->a*b))));;
WitnessValid:=function(h,x,q,b) return q in W and x in h and x^q=b and b in product and not b in [One(W),om];end;;
Read("witness_13.g");; CheckL084(WitnessValid(Group(rejectedGenerators),violatingElement,conjugator,endProductElement),"literal witness 13");; CheckL084(not WitnessValid(Group(rejectedGenerators),One(W),conjugator,endProductElement),"reject zeroed witness 13");; CheckL084(not WitnessValid(Group(rejectedGenerators),violatingElement,conjugator,One(W)),"reject permitted target 13");;
