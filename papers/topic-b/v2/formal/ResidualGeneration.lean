import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Data.Finset.Card
import Mathlib.Tactic

/-!
The actual residual-maximality induction. `fixed P S` is the intersection
of the type stabilizers with labels outside S. The conclusion identifies
it with the subgroup generated by the common stabilizer and the chosen
panel elements; it is not an assumed generation or intersection property.
No incidence geometry, symmetric-group classification or Frattini input
is formalized by this module.
-/

namespace HumanCompression.ResidualGeneration

variable {G I : Type*} [Group G]

def fixed (P : I → Subgroup G) (S : Finset I) : Subgroup G :=
  ⨅ i, ⨅ (_ : i ∉ S), P i

@[simp] theorem mem_fixed (P : I → Subgroup G) (S : Finset I) (x : G) :
    x ∈ fixed P S ↔ ∀ i, i ∉ S → x ∈ P i := by
  simp [fixed]

def generated (P : I → Subgroup G) (s : I → G) (S : Finset I) : Subgroup G :=
  fixed P ∅ ⊔ Subgroup.closure (s '' (S : Set I))

def MaximalIn (A B : Subgroup G) : Prop :=
  A < B ∧ ∀ K : Subgroup G, A ≤ K → K ≤ B → K = A ∨ K = B

theorem generated_mono (P : I → Subgroup G) (s : I → G)
    {S T : Finset I} (h : S ⊆ T) : generated P s S ≤ generated P s T := by
  apply sup_le_sup_left
  apply Subgroup.closure_mono
  exact Set.image_mono h

theorem chosen_mem (P : I → Subgroup G) (s : I → G)
    {S : Finset I} {i : I} (hi : i ∈ S) : s i ∈ generated P s S := by
  exact (le_sup_right : Subgroup.closure (s '' (S : Set I)) ≤
    fixed P ∅ ⊔ Subgroup.closure (s '' (S : Set I)))
      (Subgroup.subset_closure ⟨i, hi, rfl⟩)

theorem generated_le_fixed (P : I → Subgroup G) (s : I → G)
    (hmem : ∀ i j, i ≠ j → s i ∈ P j) (S : Finset I) :
    generated P s S ≤ fixed P S := by
  apply sup_le
  · intro x hx
    exact (mem_fixed P S x).2 fun i _ => (mem_fixed P ∅ x).1 hx i (by simp)
  · apply (Subgroup.closure_le _).2
    rintro x ⟨i, hi, rfl⟩
    apply (mem_fixed P S (s i)).2
    intro j hj
    apply hmem i j
    intro heq
    exact hj (heq ▸ hi)

variable [DecidableEq I]

theorem generated_eq_fixed (P : I → Subgroup G) (s : I → G)
    (hmem : ∀ i j, i ≠ j → s i ∈ P j)
    (hout : ∀ i, s i ∉ P i)
    (hmax : ∀ S : Finset I, S.Nonempty →
      ∃ i ∈ S, MaximalIn (fixed P (S.erase i)) (fixed P S))
    (S : Finset I) : generated P s S = fixed P S := by
  refine S.strongInductionOn ?_
  intro T ih
  by_cases hT : T.Nonempty
  · obtain ⟨i, hi, _, hm⟩ := hmax T hT
    have hsmall : fixed P (T.erase i) ≤ generated P s T := by
      rw [← ih (T.erase i) (Finset.erase_ssubset hi)]
      exact generated_mono P s (Finset.erase_subset i T)
    rcases hm (generated P s T) hsmall (generated_le_fixed P s hmem T) with h | h
    · have hx : s i ∈ fixed P (T.erase i) := h ▸ chosen_mem P s hi
      exact False.elim (hout i ((mem_fixed P (T.erase i) (s i)).1 hx i (by simp)))
    · exact h
  · have he : T = ∅ := Finset.not_nonempty_iff_eq_empty.mp hT
    subst T
    simp [generated]

theorem fixed_inter (P : I → Subgroup G) (S T : Finset I) :
    fixed P S ⊓ fixed P T = fixed P (S ∩ T) := by
  ext x
  simp only [Subgroup.mem_inf, mem_fixed]
  constructor
  · rintro ⟨hS, hT⟩ i hi
    by_cases his : i ∈ S
    · exact hT i (fun hit => hi (Finset.mem_inter.mpr ⟨his, hit⟩))
    · exact hS i his
  · intro h
    constructor
    · intro i hi
      exact h i (fun hit => hi (Finset.mem_inter.mp hit).1)
    · intro i hi
      exact h i (fun hit => hi (Finset.mem_inter.mp hit).2)

theorem generated_inter (P : I → Subgroup G) (s : I → G)
    (hmem : ∀ i j, i ≠ j → s i ∈ P j)
    (hout : ∀ i, s i ∉ P i)
    (hmax : ∀ S : Finset I, S.Nonempty →
      ∃ i ∈ S, MaximalIn (fixed P (S.erase i)) (fixed P S))
    (S T : Finset I) :
    generated P s S ⊓ generated P s T = generated P s (S ∩ T) := by
  rw [generated_eq_fixed P s hmem hout hmax S,
      generated_eq_fixed P s hmem hout hmax T,
      generated_eq_fixed P s hmem hout hmax (S ∩ T)]
  exact fixed_inter P S T

theorem chosen_not_in_others (P : I → Subgroup G) (s : I → G)
    (hmem : ∀ i j, i ≠ j → s i ∈ P j)
    (hout : ∀ i, s i ∉ P i) (S : Finset I) (i : I) :
    s i ∉ generated P s (S.erase i) := by
  intro h
  have hf := generated_le_fixed P s hmem (S.erase i) h
  exact hout i ((mem_fixed P (S.erase i) (s i)).1 hf i (by simp))

theorem generates_top [Fintype I] (P : I → Subgroup G) (s : I → G)
    (hmem : ∀ i j, i ≠ j → s i ∈ P j)
    (hout : ∀ i, s i ∉ P i)
    (hmax : ∀ S : Finset I, S.Nonempty →
      ∃ i ∈ S, MaximalIn (fixed P (S.erase i)) (fixed P S)) :
    generated P s Finset.univ = ⊤ := by
  rw [generated_eq_fixed P s hmem hout hmax]
  simp [fixed]

end HumanCompression.ResidualGeneration

#print axioms HumanCompression.ResidualGeneration.generated_le_fixed
#print axioms HumanCompression.ResidualGeneration.generated_eq_fixed
#print axioms HumanCompression.ResidualGeneration.fixed_inter
#print axioms HumanCompression.ResidualGeneration.generated_inter
#print axioms HumanCompression.ResidualGeneration.chosen_not_in_others
#print axioms HumanCompression.ResidualGeneration.generates_top
