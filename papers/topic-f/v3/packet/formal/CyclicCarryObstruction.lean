import Mathlib.Algebra.Group.Subgroup.Basic

/-! Generic group-theoretic obstruction used by the cyclic-carry proof.
The ring, group construction, and geometric correspondence remain written.
No assumption here asserts the absence of a reversing automorphism.
-/
namespace HumanCompression.CyclicCarry
variable {G : Type*} [Group G]

/-- Inversion on commuting generators extends to their generated subgroup. -/
theorem inversion_on_abelian_closure (f : G →* G) (S : Set G)
    (hcomm : ∀ x ∈ Subgroup.closure S, ∀ y ∈ Subgroup.closure S, Commute x y)
    (hgen : ∀ x ∈ S, f x = x⁻¹) {x : G} (hx : x ∈ Subgroup.closure S) :
    f x = x⁻¹ := by
  induction hx using Subgroup.closure_induction with
  | mem x hx => exact hgen x hx
  | one => simp
  | mul x y hx hy ihx ihy =>
      rw [map_mul, ihx, ihy, mul_inv_rev]
      simpa only [mul_inv_rev] using
        congrArg (fun z : G => z⁻¹) (hcomm x hx y hy).symm
  | inv x hx ih => simp only [map_inv, ih, inv_inv]

/-- Fixing a cyclic extension generator fixes its carry; inverting a carry
whose square is nonidentity therefore gives a contradiction. -/
theorem carry_obstruction (f : G →* G) (beta z : G) (n : ℕ)
    (hcarry : beta ^ n = z) (hbeta : f beta = beta)
    (hinverse : f z = z⁻¹) (hnontrivial : z ^ 2 ≠ 1) : False := by
  have hfix : f z = z := by rw [← hcarry, map_pow, hbeta]
  have hz : z = z⁻¹ := hfix.symm.trans hinverse
  apply hnontrivial
  calc
    z ^ 2 = z * z := pow_two z
    _ = z * z⁻¹ := congrArg (fun w => z * w) hz
    _ = 1 := mul_inv_cancel z

/-- The actual generated-subgroup interface: a carry in an abelian
subgroup generated by inverted elements cannot belong to a fixed power. -/
theorem generated_carry_obstruction (f : G →* G) (S : Set G)
    (hcomm : ∀ x ∈ Subgroup.closure S, ∀ y ∈ Subgroup.closure S, Commute x y)
    (hgen : ∀ x ∈ S, f x = x⁻¹) (beta z : G) (n : ℕ)
    (hz : z ∈ Subgroup.closure S) (hcarry : beta ^ n = z)
    (hbeta : f beta = beta) (hnontrivial : z ^ 2 ≠ 1) : False := by
  exact carry_obstruction f beta z n hcarry hbeta
    (inversion_on_abelian_closure f S hcomm hgen hz) hnontrivial

#print axioms inversion_on_abelian_closure
#print axioms carry_obstruction
#print axioms generated_carry_obstruction
end HumanCompression.CyclicCarry
