# One exact warning against replacing normal closure by ordinary generation.
# GAP plus NQ; no group catalogue. All relations are given below.
if LoadPackage("nq")=fail then Error("NQ required");fi;
SizeScreen([100000,24]);;
F:=FreeGroup(4);;f:=GeneratorsOfGroup(F);;
rel:=List(f,x->x^2);;
for i in [1..4] do for j in [i+1..4] do
 if j-i>1 then Add(rel,Comm(f[i],f[j]));fi;
od;od;
for i in [1..3] do Add(rel,(f[i]*f[i+1])^4);od;
for i in [1..2] do
 t:=Comm(Comm(f[i],f[i+1]),f[i+2]);
 for j in [i..i+2] do Add(rel,Comm(t,f[j]));od;
od;
G:=NilpotentQuotient(F/rel,5);;r:=GeneratorsOfGroup(G){[1..4]};;
iso:=IsomorphismPcGroup(G);;r:=List(r,x->Image(iso,x));;G:=Image(iso);;
K:=CommutatorSubgroup(DerivedSubgroup(G),G);;
locals:=List([1..2],i->CommutatorSubgroup(DerivedSubgroup(Subgroup(G,r{[i..i+2]})),Subgroup(G,r{[i..i+2]})));;
U:=ClosureGroup(locals[1],locals[2]);;
if Size(G)<>1024 or NilpotencyClassOfGroup(G)<>4 or Size(K)<>8
 or List(locals,Size)<>[2,2] or Size(U)<>4 then Error("Invariants");fi;
if NormalClosure(G,U)<>K or IsNormal(G,U) then Error("Normal closure");fi;
outside:=Comm(Comm(Comm(r[1],r[2]),r[3]),r[4]);;
if outside in U or not outside in K or Order(outside)<>2 then Error("Missing weight-four element");fi;
sets:=Combinations([1..4]);;groups:=List(sets,A->Subgroup(G,r{A}));;
for i in [1..16] do for j in [1..16] do
 if Intersection(groups[i],groups[j])<>groups[Position(sets,Intersection(sets[i],sets[j]))] then Error("IP");fi;
od;od;
Print("GAP=",GAPInfo.Version," NQ=",PackageInfo("nq")[1].Version,"\n");
Print("PASS order=1024 rank=4 class=4 excess=3 kernel_order=8 local_kernel_orders=[2,2] local_generated_order=4 normal_closure_order=8 full_subset_meets=256\n");
Print("PASS [[r1,r2],r3,r4] has order2 and belongs to the canonical kernel but not to the subgroup generated by the two local kernels.\n");
QUIT;
