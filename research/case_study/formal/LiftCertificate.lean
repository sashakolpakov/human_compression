import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
Kernel-checked algebraic lemmas used by the central cyclic lift.

Scope: this file formalizes the intersection and chirality-transfer arguments.
It does not assert a formal construction of all the source groups or the
group-to-polyhedron correspondence. Its hypotheses are explicit below.
-/

namespace LeemansLift

variable {H G : Type*} [Group H] [Group G]

def NoReverser (a b : G) : Prop :=
  ¬ ∃ e : G ≃* G, e a = a⁻¹ ∧ e b = b⁻¹

/-- A reversing automorphism preserves the subgroup generated by a power of b. -/
theorem reversing_preserves_power_subgroup (e : H ≃* H) (b : H) (k : ℕ)
    (hb : e b = b⁻¹) :
    (Subgroup.zpowers (b ^ k)).map e.toMonoidHom = Subgroup.zpowers (b ^ k) := by
  rw [MonoidHom.map_zpowers]
  change Subgroup.zpowers (e (b ^ k)) = Subgroup.zpowers (b ^ k)
  rw [map_pow, hb, inv_pow, Subgroup.zpowers_inv]

/-- A surjection with kernel generated by a power of b transfers absence of
simultaneous reversing automorphisms from its image to its domain. -/
theorem noReverser_of_cyclic_kernel (π : H →* G) (hπ : Function.Surjective π)
    (a b : H) (k : ℕ) (hker : π.ker = Subgroup.zpowers (b ^ k))
    (hbase : NoReverser (π a) (π b)) : NoReverser a b := by
  rintro ⟨e, ha, hb⟩
  have hinvariant : π.ker.map e.toMonoidHom = π.ker := by
    rw [hker]
    exact reversing_preserves_power_subgroup e b k hb
  let q := QuotientGroup.quotientKerEquivOfSurjective π hπ
  let ebar := QuotientGroup.congr π.ker π.ker e hinvariant
  let descended : G ≃* G := q.symm.trans (ebar.trans q)
  have hq (x : H) : q (QuotientGroup.mk x) = π x := rfl
  have hdescended (x : H) : descended (π x) = π (e x) := by
    change q (ebar (q.symm (π x))) = π (e x)
    rw [← hq x, q.symm_apply_apply]
    change q (QuotientGroup.mk (e x)) = π (e x)
    exact hq (e x)
  apply hbase
  refine ⟨descended, ?_, ?_⟩
  · rw [hdescended, ha, map_inv]
  · rw [hdescended, hb, map_inv]

/-- If the first cyclic subgroup projects injectively, a trivial intersection
downstairs implies a trivial intersection upstairs. -/
theorem cyclic_intersection_transfer (π : H →* G) (a b : H)
    (hinj : Set.InjOn π (Subgroup.zpowers a))
    (hbase : Disjoint (Subgroup.zpowers (π a)) (Subgroup.zpowers (π b))) :
    Disjoint (Subgroup.zpowers a) (Subgroup.zpowers b) := by
  rw [Subgroup.disjoint_def] at hbase ⊢
  intro z hza hzb
  have hmapa : π z ∈ Subgroup.zpowers (π a) := by
    rw [← MonoidHom.map_zpowers]
    exact ⟨z, hza, rfl⟩
  have hmapb : π z ∈ Subgroup.zpowers (π b) := by
    rw [← MonoidHom.map_zpowers]
    exact ⟨z, hzb, rfl⟩
  apply hinj hza (Subgroup.one_mem _)
  simpa using hbase hmapa hmapb

#print axioms reversing_preserves_power_subgroup
#print axioms noReverser_of_cyclic_kernel
#print axioms cyclic_intersection_transfer

/-- General intersection transport: once the images have the right
intersection, every remaining defect is in the kernel. No centrality,
finiteness, or surjectivity assumption is required. -/
theorem intersection_of_image_and_kernel (π : H →* G) (A B C : Subgroup H)
    (hCA : C ≤ A) (hCB : C ≤ B)
    (himage : A.map π ⊓ B.map π = C.map π)
    (hkernel : (A ⊓ B) ⊓ π.ker ≤ C) : A ⊓ B = C := by
  apply le_antisymm
  · intro x hx
    have hximage : π x ∈ C.map π := by
      rw [← himage]
      exact ⟨⟨x, hx.1, rfl⟩, ⟨x, hx.2, rfl⟩⟩
    rcases hximage with ⟨c, hc, hcx⟩
    have hxc : x * c⁻¹ ∈ C := by
      apply hkernel
      refine ⟨⟨A.mul_mem hx.1 (A.inv_mem (hCA hc)),
        B.mul_mem hx.2 (B.inv_mem (hCB hc))⟩, ?_⟩
      change π (x * c⁻¹) = 1
      rw [map_mul, map_inv, hcx, mul_inv_cancel]
    have := C.mul_mem hxc hc
    simpa using this
  · exact le_inf hCA hCB

#print axioms intersection_of_image_and_kernel

end LeemansLift
