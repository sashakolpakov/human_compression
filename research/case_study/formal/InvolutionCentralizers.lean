import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.GroupTheory.Subgroup.Center
import Mathlib.Tactic

/-!
Abstract centralizer obstruction to long strings of involutions.
No group finiteness, distinctness of generators, or intersection property
is assumed. The actual centralizer theorem for Suzuki groups remains an
external written input.
-/

namespace MathCompression

variable {G : Type*} [Group G]

/-- If involutions in each involution centralizer commute, a centre-free
group generated by nonidentity string involutions has string length <=3. -/
theorem string_rank_le_three_of_involution_centralizers
    (centralizer_condition : ∀ a b c : G,
      a ≠ 1 → b ≠ 1 → c ≠ 1 →
      a * a = 1 → b * b = 1 → c * c = 1 →
      Commute a b → Commute a c → Commute b c)
    (center_free : ∀ z : G, (∀ g : G, Commute z g) → z = 1)
    {n : ℕ} (rho : Fin n → G)
    (nonidentity : ∀ i, rho i ≠ 1)
    (involutions : ∀ i, rho i * rho i = 1)
    (string_commutations : ∀ i j : Fin n,
      i.val + 1 < j.val → Commute (rho i) (rho j))
    (generates : Subgroup.closure (Set.range rho) = ⊤) :
    n ≤ 3 := by
  by_contra h
  have hn : 4 ≤ n := by omega
  let i0 : Fin n := ⟨0, by omega⟩
  let i3 : Fin n := ⟨3, by omega⟩
  have h03 : Commute (rho i0) (rho i3) :=
    string_commutations i0 i3 (by dsimp [i0, i3]; omega)
  have on_generators : ∀ j : Fin n, Commute (rho i3) (rho j) := by
    intro j
    by_cases hj : j.val < 2
    · exact (string_commutations j i3 (by dsimp [i3]; omega)).symm
    · have h0j : Commute (rho i0) (rho j) :=
        string_commutations i0 j (by dsimp [i0]; omega)
      exact centralizer_condition (rho i0) (rho i3) (rho j)
        (nonidentity i0) (nonidentity i3) (nonidentity j)
        (involutions i0) (involutions i3) (involutions j) h03 h0j
  have on_group : ∀ g : G, Commute (rho i3) g := by
    intro g
    have hg : g ∈ Subgroup.closure (Set.range rho) := by
      rw [generates]
      trivial
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      exact on_generators j
    | one => exact Commute.one_right _
    | mul x y hx hy hcx hcy => exact hcx.mul_right hcy
    | inv x hx hcx => exact hcx.inv_right
  exact nonidentity i3 (center_free (rho i3) on_group)

/-- The same conclusion with the conventional trivial-centre hypothesis. -/
theorem string_rank_le_three_of_involution_centralizers_center_bot
    (centralizer_condition : ∀ a b c : G,
      a ≠ 1 → b ≠ 1 → c ≠ 1 →
      a * a = 1 → b * b = 1 → c * c = 1 →
      Commute a b → Commute a c → Commute b c)
    (center_bot : Subgroup.center G = ⊥)
    {n : ℕ} (rho : Fin n → G)
    (nonidentity : ∀ i, rho i ≠ 1)
    (involutions : ∀ i, rho i * rho i = 1)
    (string_commutations : ∀ i j : Fin n,
      i.val + 1 < j.val → Commute (rho i) (rho j))
    (generates : Subgroup.closure (Set.range rho) = ⊤) :
    n ≤ 3 := by
  apply string_rank_le_three_of_involution_centralizers
    centralizer_condition ?_ rho nonidentity involutions
    string_commutations generates
  intro z hz
  have hmem : z ∈ Subgroup.center G := by
    rw [Subgroup.mem_center_iff]
    intro g
    exact (hz g).symm.eq
  rw [center_bot] at hmem
  exact hmem

#print axioms string_rank_le_three_of_involution_centralizers
#print axioms string_rank_le_three_of_involution_centralizers_center_bot

end MathCompression
