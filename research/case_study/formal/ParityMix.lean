import Mathlib.GroupTheory.PGroup
import Mathlib.Tactic
import CoprimePullback

/-!
Actual paired-generator parity fibers. This formalizes the
connected-support argument in phase124_even_label_mix.md. The target
fiber and the mixed intersection property are not supplied as premises.
-/

namespace MathCompression.ParityMix

open MathCompression.CoprimePullback

variable {E G D I : Type*} [Group E] [Group G] [Group D]

def mix (e : I → E) (g : I → G) : Subgroup (E × G) :=
  Subgroup.closure (Set.range fun i => (e i, g i))

theorem pair_mem_mix (e : I → E) (g : I → G) (i : I) : (e i, g i) ∈ mix e g :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- A two-primary first coordinate and odd-order second coordinate let a
power and a coprime root isolate the second coordinate inside the actual
subgroup. No common quotient or kernel equality is assumed. -/
theorem isolate_odd_second (H : Subgroup (E × G)) (hE : IsPGroup 2 E)
    (x : E) (y : G) (hxy : (x, y) ∈ H) (hy : Odd (orderOf y)) : (1, y) ∈ H := by
  obtain ⟨n, hn⟩ := hE x
  have hc : (2 ^ n).Coprime (orderOf y) := hy.coprime_two_left.pow_left n
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hc
  have hp := H.pow_mem (H.pow_mem hxy (2 ^ n)) m
  have he : ((x, y) ^ (2 ^ n)) ^ m = (1, y) := by
    apply Prod.ext
    · simpa using congrArg (fun z : E => z ^ m) hn
    · simpa using hm
  rwa [he] at hp

/-- Odd-order adjacent products in the second factor are pure elements
of the subgroup generated by the paired markers. -/
theorem pure_adjacent (e : I → E) (g : I → G) (hE : IsPGroup 2 E)
    (i j : I) (hodd : Odd (orderOf (g i * g j))) :
    (1, g i * g j) ∈ mix e g := by
  exact isolate_odd_second (mix e g) hE (e i * e j) (g i * g j)
    ((mix e g).mul_mem (pair_mem_mix e g i) (pair_mem_mix e g j)) hodd

/-- Along an actual path, pure adjacent products telescope. -/
theorem pure_path (e : I → E) (g : I → G) (hE : IsPGroup 2 E)
    (hg : ∀ i, g i * g i = 1) (R : I → I → Prop)
    (hodd : ∀ i j, R i j → Odd (orderOf (g i * g j)))
    {i j : I} (hpath : Relation.ReflTransGen R i j) :
    (1, g i * g j) ∈ mix e g := by
  induction hpath with
  | refl => simpa only [hg, Prod.mk_one_one] using (mix e g).one_mem
  | @tail j k hpath hjk ih =>
    have hm := (mix e g).mul_mem ih (pure_adjacent e g hE j k (hodd j k hjk))
    have he : ((1 : E), g i * g j) * (1, g j * g k) = (1, g i * g k) := by
      apply Prod.ext
      · simp
      · change (g i * g j) * (g j * g k) = g i * g k
        calc
          (g i * g j) * (g j * g k) = g i * (g j * g j) * g k := by group
          _ = _ := by rw [hg]; simp
    rwa [he] at hm

/-- Genuine compatible parity characters constrain every generated pair. -/
theorem mix_le_fiber (e : I → E) (g : I → G) (ε : E →* D) (δ : G →* D)
    (hcompat : ∀ i, ε (e i) = δ (g i)) : mix e g ≤ fiberProduct ε δ := by
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨i, rfl⟩
  exact hcompat i

/-- Once every marker in the second factor has a companion equal to the
same involution in the first, every second-factor element has companion
one or that involution. This is proved by group-generation induction. -/
theorem binary_companion (H : Subgroup (E × G)) (g : I → G)
    (hgen : Subgroup.closure (Set.range g) = ⊤) (a : E) (ha : a * a = 1)
    (hcomp : ∀ i, (a, g i) ∈ H) (y : G) :
    ∃ x : E, (x, y) ∈ H ∧ (x = 1 ∨ x = a) := by
  have hy : y ∈ Subgroup.closure (Set.range g) := by rw [hgen]; trivial
  induction hy using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    exact ⟨a, hcomp i, Or.inr rfl⟩
  | one => exact ⟨1, H.one_mem, Or.inl rfl⟩
  | mul y z hy hz ihy ihz =>
    obtain ⟨x, hx, hxa⟩ := ihy
    obtain ⟨w, hw, hwa⟩ := ihz
    refine ⟨x * w, H.mul_mem hx hw, ?_⟩
    rcases hxa with rfl | rfl <;> rcases hwa with rfl | rfl <;> simp [ha]
  | inv y hy ih =>
    obtain ⟨x, hx, hxa⟩ := ih
    refine ⟨x⁻¹, H.inv_mem hx, ?_⟩
    rcases hxa with rfl | rfl
    · exact Or.inl inv_one
    · exact Or.inr (inv_eq_of_mul_eq_one_right ha)

/-- The entire connected parity fiber is generated by the actual paired
markers. The conclusion is derived from the original two-primary,
odd-adjacency, involution and genuine-character hypotheses. The parity
codomain may be any group: its common marker value must be nonidentity. -/
theorem connected_parity_fiber (e : I → E) (g : I → G)
    (hE : IsPGroup 2 E) (he : ∀ i, e i * e i = 1) (hg : ∀ i, g i * g i = 1)
    (hgenE : Subgroup.closure (Set.range e) = ⊤)
    (hgenG : Subgroup.closure (Set.range g) = ⊤)
    (ε : E →* D) (δ : G →* D) (t : D) (ht : t ≠ 1)
    (hε : ∀ i, ε (e i) = t) (hδ : ∀ i, δ (g i) = t)
    (R : I → I → Prop) (hodd : ∀ i j, R i j → Odd (orderOf (g i * g j)))
    (i₀ : I) (hconn : ∀ i, Relation.ReflTransGen R i₀ i) :
    mix e g = fiberProduct ε δ := by
  have hcompat : ∀ i, ε (e i) = δ (g i) := fun i => (hε i).trans (hδ i).symm
  have hle := mix_le_fiber e g ε δ hcompat
  have hcomp : ∀ i, (e i₀, g i) ∈ mix e g := by
    intro i
    have hm := (mix e g).mul_mem (pair_mem_mix e g i₀)
      (pure_path e g hE hg R hodd (hconn i))
    have heq : (e i₀, g i₀) * (1, g i₀ * g i) = (e i₀, g i) := by
      apply Prod.ext
      · simp
      · change g i₀ * (g i₀ * g i) = g i
        rw [← mul_assoc, hg, one_mul]
    rwa [heq] at hm
  have hpure : ∀ y : G, δ y = 1 → (1, y) ∈ mix e g := by
    intro y hy
    obtain ⟨x, hx, hxa⟩ := binary_companion (mix e g) g hgenG (e i₀) (he i₀) hcomp y
    rcases hxa with rfl | rfl
    · exact hx
    · have hval := hle hx
      change ε (e i₀) = δ y at hval
      rw [hε, hy] at hval
      exact False.elim (ht hval)
  have hmap : (mix e g).map (MonoidHom.fst E G) = ⊤ := by
    unfold mix
    rw [MonoidHom.map_closure, ← Set.range_comp]
    exact hgenE
  apply le_antisymm hle
  rintro ⟨x, y⟩ hxy
  have hx : x ∈ (mix e g).map (MonoidHom.fst E G) := by rw [hmap]; trivial
  obtain ⟨⟨u, v⟩, huv, hu⟩ := hx
  change u = x at hu
  subst u
  have hval := hle huv
  change ε x = δ v at hval
  have hrel : δ (v⁻¹ * y) = 1 := by
    change ε x = δ y at hxy
    rw [map_mul, map_inv, ← hval, ← hxy, inv_mul_cancel]
  have hm := (mix e g).mul_mem huv (hpure (v⁻¹ * y) hrel)
  simpa using hm

#print axioms isolate_odd_second
#print axioms pure_adjacent
#print axioms pure_path
#print axioms mix_le_fiber
#print axioms binary_companion
#print axioms connected_parity_fiber

end MathCompression.ParityMix
