# One exact boundary witness for the odd-order nilpotent theorem.
LoadPackage("smallgrp");;
G := SmallGroup(21,1);;
pc := GeneratorsOfGroup(G);;
A := Subgroup(G,[pc[1]]);;
B := Subgroup(G,[pc[1]*pc[2]]);;
C := Subgroup(G,[pc[1]*pc[2]^2]);;
ab := Set(Concatenation(List(Elements(A),x->List(Elements(B),y->x*y))));;
Assert(0,IdGroup(G)=[21,1]);
Assert(0,List([A,B,C],Size)=[3,3,3]);
Assert(0,Size(Intersection(A,B))=1);
Assert(0,Length(Intersection(ab,Elements(C)))=1);
Assert(0,Product(List([A,B,C],Size))=27);
Assert(0,not IsNilpotentGroup(G));
Print("PASS\n");
Print("GAP ",GAPInfo.Version," SmallGrp ",PackageInfo("smallgrp")[1].Version,"\n");
Print("SmallGroup(21,1), structure ",StructureDescription(G),"\n");
Print("Standard pc generators f1,f2; factors generated by f1, f1*f2, f1*f2^2\n");
Print("All cyclic orders3; |A intersect B|=1; |AB intersect C|=1\n");
Print("TPP factor product27>21; odd-order group is not nilpotent\n");
QUIT;
