\usepackage[margin=24mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,array}
\setlength{\emergencystretch}{2em}
\newtheorem{lemma}{Lemma}\newtheorem{theorem}[lemma]{Theorem}
\title{Twenty-two hexagons through every edge}
\author{Human Compression project}\date{}
\begin{document}\maketitle
\begin{theorem}
No finite simple quartic graph of girth six has exactly twenty-two
hexagons through each edge. Thus $n(4,6,22)=\infty$.
\end{theorem}
Two successive boundaries around an edge force an incorrect cycle
count, protected by saturation. The finite inventories have literal
certificates checked using only the Python standard library.

\begin{lemma}\label{saturation}
Let $B$ be a subgraph of a quartic graph $G$. If every vertex at
distance at most two from $u$ in $B$ already has degree four in $B$,
every hexagon of $G$ through $u$ is contained in $B$.
\end{lemma}
\begin{proof}
No vertex outside $B$ can be reached from $u$ in at most three steps:
the first edge leaving $B$ would start at a saturated vertex at distance
at most two. Every vertex of a hexagon through $u$ is reached from
$u$ along that hexagon in at most three steps. Every edge of that
hexagon has an endpoint reached in at most two steps, whose entire
neighbourhood is already in $B$. Thus both its vertices and edges
belong to $B$.
\end{proof}

Fix an edge $uv$ of a hypothetical graph in the theorem. Girth six
gives disjoint trees of depth two rooted at $u,v$, excluding $uv$
in their first steps. Each has thirteen vertices. Every additional
edge among these twenty-six vertices joins opposite leaves; any other
edge or identification creates a cycle of length at most five.
Each cross edge gives precisely one hexagon through $uv$, so there
are twenty-two cross edges.

Partition the nine leaves on either side into three branches of size
three. The cross edges between a pair of branches are a matching,
since two neighbours in one opposite branch create a quadrangle.
If its size is $m_{ij}$, its deficit $d_{ij}=3-m_{ij}$ satisfies
\[
              0\le d_{ij}\le3,\qquad \sum d_{ij}=5.       \tag{1}
\]
There are five unfinished leaf incidences on each side. Their other
endpoints lie outside the twenty-six vertices.

\begin{lemma}\label{capacity}
For the positive unfinished-degree profiles $P_L,P_R$, put
\[
 f(P)=\frac{15-\sum_{r\in P}r^2}{2}.
\]
The necessary inequalities are $f(P_L)\le b(P_R)$ and
$f(P_R)\le b(P_L)$, where
\[
\begin{array}{c|rrrrr}
P&(1,1,1,1,1)&(2,1,1,1)&(2,2,1)&(3,1,1)&(3,2)\\\hline
f(P)&5&4&3&2&1\\
b(P)&4&4&3&3&1.
\end{array}                                               \tag{2}
\]
\end{lemma}
\begin{proof}
There are forty-four hexagons through $u$, of which twenty-two
contain $uv$. If the right leaf deficits are $r_i$, the right leaves
supply $\sum_i\binom{3-r_i}{2}$ of the remaining twenty-two.
Their cross neighbours are in distinct left branches. The missing
number, supplied by common outside neighbours of left leaves, is
\[
 22-\sum_i\binom{3-r_i}{2}
       =\frac{15-\sum_i r_i^2}{2}=f(P_R).                 \tag{3}
\]
The analogous count at $v$ gives $f(P_L)$.

On a fixed side an outside vertex meets at most one leaf per branch,
hence at most three leaves. Five incidences can therefore supply at
most four pairs, from a triple and a pair. Moreover two leaves share
at most one outside neighbour, since two common neighbours give a
quadrangle. For $(2,2,1)$, a triple already uses every pair of the
three deficient leaves, so the two remaining incidences cannot supply
another pair. Without a triple there are at most two pairs. For
$(3,1,1)$ the same argument applies: after a triple the two remaining
incidences are at the same leaf. These profiles have capacity at most
three. For $(3,2)$ only two leaves are deficient, giving capacity at
most one. These are the entries $b(P)$ in (2). Combining them with
the opposite-side count (3) proves the inequalities. The verifier also
checks the five bounds by enumerating partitions of five incidences
into sets of at most three leaves with no repeated leaf pair.
\end{proof}

\begin{lemma}\label{rootpairs}
Let $L_0,L_1,L_2$ be the three left leaf sets, and let $a_i$ count
cross edges incident with $L_i$. Once all left leaves are saturated,
for distinct $i,j,k$ one must have
\[
        \sum_w |N(w)\cap L_i|\,|N(w)\cap L_j|=a_k.       \tag{4}
\]
This expression is unchanged by any farther extension. There is an
identical assertion on the right.
\end{lemma}
\begin{proof}
Write $b_{ij}$ for the hexagons using the two root edges of branches
$i,j$. The equations $a_i+b_{ij}+b_{ik}=22$ and
$a_0+a_1+a_2=22$ give $b_{ij}=a_k$. The middle vertex of such a
hexagon is a common neighbour of one leaf in each of the two branches.
Girth six makes these choices distinct simple hexagons, giving (4).
All leaf neighbour sets are already complete, so no additional edge
can change the sum.
\end{proof}

\paragraph{First finite inventory.}
There are $1206$ matrices in (1). Direct enumeration under row and
column permutations and transpose gives twenty-nine representatives.
For each matrix, take the graph on its six branches whose edges are
the full matchings. Choose a spanning forest. Independent permutations
of the leaves in each branch make every forest matching the identity:
propagate labels from a root in each component, with no consistency
cycle. All remaining matchings are enumerated as partial injective
maps. Their respective numbers for sizes $3,2,1,0$ are $6,18,9,1$.
Thus every possible local graph occurs among $20\,588\,580$ normalized
choices. These normalizations are automorphisms of the two rooted trees.

A prefix certificate covers this full product. A prefix is discarded
only with an explicit quadrangle. Every undiscarded prefix has all
children visited. A complete choice is either excluded by the coupled
inequalities in Lemma~\ref{capacity} or carried to one of $268$
literal representatives. Every map is a permutation of all twenty-six
vertices, preserves the unordered root edge and is checked against every
adjacency entry. The representative lists retain the actual labelled
trees and exactly twenty-two cross edges; this is separately checked.
The prefix inventory has $885165$ records, reaches $149724$ complete
choices, rejects $102360$ by their profiles and checks $47364$ maps.
These numbers describe the certificate, not a graph count up to isomorphism.

\paragraph{The first outside neighbours.}
For each representative partition its five left incidences by their
outside neighbour. A part contains at most four incidences and no leaf
twice. Adjoin the corresponding vertices, leaving the right incidences
unfinished. Discard the partition only with a short cycle or an unequal
count in (4) on the left. Perform the same independent step on the
right. These tests remain necessary for every full graph, since each
side's leaf neighbours are now fixed; adding neighbours to right leaves
does not add neighbours to left leaves.

The insertion recursion for these partitions places the next incidence
in each eligible existing part or in one new part. Ordering new parts
by their first appearance covers every partition; repeated incidences
are treated as distinguished positions and harmless duplicates are
retained. Across the $268$ representatives the two sides have $19672$
partitions. Of these, $13523$ have a short cycle, $6019$ fail (4),
and $130$ survive. Only six representatives have survivors on both sides.

Now combine a surviving left partition and a surviving right partition.
An outside vertex may contain one left part and one right part, or just
one part. Thus choose a partial one-to-one matching between their parts,
retaining total size at most four. No two left parts can be merged,
because they were different outside vertices in that partition; the
same holds on the right. Conversely every full partition restricts to
exactly such a pair of side partitions and such a matching. Hence this
step is complete. It has $128$ choices: $64$ give a short cycle and
$64$ have literal isomorphisms to twelve thirty-vertex graphs. Every
ordered adjacency entry is checked. The maps here need not preserve a
root: subsequent tests apply to the whole partial graph. Every original
tree vertex is saturated, and the four remaining vertices have degrees
$3,2,3,2$ in some order.

\paragraph{The second outside neighbours.}
Five of the twelve graphs already contain an edge on at least
twenty-three hexagons. Their certificate gives twenty-three distinct
alternate length-five paths for that edge. Adding edges cannot remove
them, so those five graphs are impossible.

In each of the other seven graphs, call its deficient vertices the
boundary. Any new edge among old vertices joins two boundary vertices.
Their old distance must be at least five, or that edge creates a short
cycle. Enumerate every subset of these eligible pairs and reject degree
overflow or a short cycle. Next partition all remaining incidences by
their new endpoint, with parts of size at most four and no repeated
old vertex. This includes the empty partition when there is no incidence.
It is the same complete insertion recursion as before.

These choices cover every extension: first take its actual edges
between old boundary vertices, then its actual common new neighbours.
Every previously present vertex now has degree four. Edges between the
new vertices, or beyond them, are deliberately left undecided. There
are $28$ old-edge subsets and $956$ resulting incidence partitions.
For $850$ partitions the certificate gives a short cycle. For each of
the remaining $106$, it gives a vertex $x$ and incident edge $xy$.
The verifier checks that every vertex at distance at most two from
$x$ is saturated. It enumerates every simple length-five path from
$x$ to $y$ avoiding the edge $xy$ and finds a count different from
twenty-two. Each such path is one hexagon through $xy$. By
Lemma~\ref{saturation}, no further completion can change the count.
This rejects all remaining partitions.

\begin{proof}[Conclusion of the theorem]
The two rooted trees occur in every hypothetical graph. The first
inventory accounts for all their cross matchings under actual tree
automorphisms. The two side partitions and their partial matching
account for every possible set of first outside neighbours. Literal
maps place all survivors among twelve explicitly supplied graphs.
The second boundary inventory accounts for every possible next
neighbourhood. Its terminal obstructions persist under arbitrary
completion, by the saturation lemma or the existence of a short cycle.
Thus every hypothetical graph gives a case rejected by a necessary
condition, proving the theorem at every order.
\end{proof}

\paragraph{Verification and attribution.}
The verifier checks all four certificates: ordered indices, complete
product coverage and file consumption, cycle witnesses, permutations
and fixed path counts. Pynauty only discovered literal permutations;
its canonical labelling is not a verification premise.

The classical Moore trees and incidence counting are reused from the
preceding local exclusion with twenty-three hexagons, together with
explicitly recorded program adaptations. The present proof adds the
five-incidence capacity table, the factorization into two side
partitions and the second boundary extension with a saturated
neighbourhood. The preceding nonexistence theorem itself is not a premise.
Goedgebeur and Jooken, \emph{Exhaustive generation of edge-girth-regular
graphs}, arXiv:2401.08271v2, Table 2 on physical page 18, give
$n(4,6,22)\ge39$ without a finite upper example. This theorem strengthens
that bound. Historical priority and current literature have not been
assessed. No whole-source, Lean or compression measurement is claimed.
\end{document}
