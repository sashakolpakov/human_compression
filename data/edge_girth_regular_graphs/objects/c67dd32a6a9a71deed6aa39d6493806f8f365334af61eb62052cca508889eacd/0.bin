import argparse,json,hashlib,subprocess,shutil,os,sys
from pathlib import Path
from local_model import *
W=Path(__file__).resolve().parent
def main():
    ap=argparse.ArgumentParser();ap.add_argument('--out',type=Path,required=True);ap.add_argument('--render',action='store_true');a=ap.parse_args();O=a.out.resolve();O.mkdir(parents=True,exist_ok=False)
    bindings=json.loads((W/'bindings.json').read_text())
    for r in bindings:
        b=Path(r['path']).read_bytes();need(len(b)==r['bytes']and hashlib.sha256(b).hexdigest()==r['sha256'],'source binding')
    if(W/'manifest.json').exists():
        for r in json.loads((W/'manifest.json').read_text())['exports']:
            b=(W/r['path']).read_bytes();need(len(b)==r['bytes']and hashlib.sha256(b).hexdigest()==r['sha256'],'frozen export')
    profiles=[(1,1,1,1),(1,1,2),(2,2),(1,3)];bounds=[3,3,1,1];needs=[6-sum(x*x for x in p)//2 for p in profiles]
    possible=[(profiles[i],profiles[j])for i in range(4)for j in range(4)if needs[i]<=bounds[j]and needs[j]<=bounds[i]]
    need(possible==[((1,1,2),(1,1,2)),((1,3),(1,3))],'coupled degree-profile table')
    reps=[[set(s)for s in G]for G in json.loads((W/'representatives.json').read_text())];need(len(reps)==20,'twenty representatives')
    for G in reps:
        need(len(G)==26 and all(u not in G[u]and all(0<=v<26 and u in G[v]for v in G[u])for u in range(26)),'simple representative')
        need(not short_cycle(G)and all(len(s)<=4 for s in G),'representative girth and degree')
        T=tree();need(all(T[u]<=G[u]for u in range(26)),'literal labelled tree union')
        extra=[(u,v)for u in range(26)for v in G[u]-T[u]if u<v]
        need(len(extra)==23 and all(4<=u<13 and 17<=v<26 for u,v in extra),'literal representative cross edges')
    stats=collections.Counter();covered=0;allpatterns=patterns();need(len(allpatterns)==15,'fifteen deficit orbits')
    with(W/'local_certificate.jsonl').open()as f:
        for pi,(matrix,blocks)in enumerate(allpatterns):
            def visit(G,prefix):
                nonlocal covered
                level=len(prefix)
                for index in range(len(blocks[level][2])):
                    key=prefix+[index];line=f.readline();need(bool(line),'missing local prefix');r=json.loads(line);need(r['matrix']==pi and r['key']==key,'exact local prefix order');H=extend(G,blocks[level],index);stats['prefixes']+=1
                    if 'cycle'in r:
                        need(valid_cycle(H,r['cycle']),'literal local short cycle');stats['short_prefixes']+=1;covered+=math.prod(len(b[2])for b in blocks[level+1:])
                    elif level<8:
                        need(r.get('branch')is True and set(r)=={'matrix','key','branch'},'complete local branch');visit(H,key)
                    else:
                        stats['girth_balls']+=1;covered+=1
                        if 'bad_profile_side'in r:
                            b=r['bad_profile_side'];need(b in [4,17]and profile(H,b)in [[1,1,1,1],[2,2]],'impossible coupled profile');stats['profile_exclusions']+=1
                        else:
                            ci=r['class'];q=r['map'];need(type(ci)is int and 0<=ci<20 and len(q)==26 and all(type(x)is int for x in q)and set(q)==set(range(26))and{q[0],q[13]}=={0,13},'literal rooted bijection');R=reps[ci]
                            need(all((v in H[u])==(q[v]in R[q[u]])for u in range(26)for v in range(26)),'all literal adjacency entries');stats['literal_maps']+=1
            visit(tree(),[])
        need(not f.read().strip(),'extra local prefix')
    need(covered==sum(math.prod(len(b[2])for b in blocks)for _,blocks in allpatterns)==1774224,'complete normalized product')
    with(W/'outside_certificate.jsonl').open()as f:
        for ci,G in enumerate(reps):
            items=[u for u in range(26)for _ in range(4-len(G[u]))];need(len(items)==8,'eight unfinished incidences')
            for index,groups in enumerate(partitions(items)):
                line=f.readline();need(bool(line),'missing outside partition');r=json.loads(line);need(r['class']==ci and r['partition']==index,'exact outside partition order');H=attach(G,groups);stats['outside_partitions']+=1
                need(all(len(H[u])==4 for u in range(26)),'saturated tree union')
                if 'cycle'in r:need(valid_cycle(H,r['cycle']),'literal outside short cycle');stats['outside_short']+=1
                else:
                    side,i,j,actual,required=r['pair_mismatch'];need(side in [0,1]and 0<=i<j<3,'literal root pair');need(pair_counts(H,side,i,j)==(actual,required)and actual!=required,'unequal fixed root pair counts');stats['pair_mismatches']+=1
        need(not f.read().strip(),'extra outside partition')
    expected={'prefixes':52424,'short_prefixes':43005,'girth_balls':6420,'profile_exclusions':5670,'literal_maps':750,'outside_partitions':48816,'outside_short':44371,'pair_mismatches':4445};need(dict(stats)==expected,'literal complete inventory')
    for mode in ['argument','environment']:
        env=os.environ.copy();cmd=[sys.executable]
        if mode=='argument':cmd.append('-O')
        else:env['PYTHONOPTIMIZE']='1'
        r=subprocess.run(cmd+[str(W/'check.py')],env=env,capture_output=True,text=True,timeout=5);need(r.returncode!=0 and 'Optimized Python is not accepted'in r.stderr,'optimization guard');(O/('guard_'+mode+'.stderr')).write_text(r.stderr)
    if a.render:
        shutil.copy2(W/'twenty_three.tex',O/'twenty_three.tex')
        for i in [1,2]:
            r=subprocess.run(['/opt/homebrew/bin/pdflatex','-interaction=nonstopmode','-halt-on-error','twenty_three.tex'],cwd=O,capture_output=True,text=True,timeout=30);(O/f'native{i}.stdout').write_text(r.stdout);(O/f'native{i}.stderr').write_text(r.stderr);need(r.returncode==0 and not r.stderr,'native build')
        log=(O/'twenty_three.log').read_text();need('Overfull'not in log and 'LaTeX Warning:'not in log,'native content')
    report={'status':'PASS_QUARTIC_TWENTY_THREE_LOCAL_EXCLUSION','deficit_matrices':486,'matrix_orbits':15,'covered_normalized_patterns':covered,'certificate_counts':dict(stats),'literal_adjacency_checks':750*26*26,'all_order_exclusion':True,'whole_original_credit':0,'new_question_credit':0,'new_Lean':0,'measurement':None};(O/'report.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report))
if __name__=='__main__':main()
