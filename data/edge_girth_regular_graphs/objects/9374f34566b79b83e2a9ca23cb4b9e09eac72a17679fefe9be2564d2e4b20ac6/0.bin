#include "forest_completion.h"
int main(int argc,char**argv){try{
 require(argc==5,"usage check_completions ROOTS REPORT POSITIVES SECONDS");ifstream in(argv[1]);int count;require(bool(in>>count)&&count>=0,"root count");Budget budget(stod(argv[4]));
 U nodes=0,assignments=0,rightnodes=0,complete=0,mismatch=0,positive=0;vector<Graph>positives;
 for(int id=0;id<count;id++){
  int n;require(bool(in>>n)&&n==26,"root order");Graph g(n);for(U&row:g)require(bool(in>>row),"root row");validate_root(g,10);
  for(int shape=0;shape<4;shape++){
   budget.check();ForestCover search(g,10,shape,10,budget);search.run();nodes+=search.nodes;assignments+=search.assignments;rightnodes+=search.right.nodes;complete+=search.right.complete;mismatch+=search.right.mismatch;positive+=search.right.positive;
   positives.insert(positives.end(),search.right.positives.begin(),search.right.positives.end());
   cout<<"ROOT "<<id<<" SHAPE "<<shape<<" LEFT "<<search.nodes<<" ASSIGNMENTS "<<search.assignments<<" RIGHT "<<search.right.nodes<<" COMPLETE "<<search.right.complete<<" POSITIVE "<<search.right.positive<<'\n'<<flush;
  }
 }
 string extra;require(!(in>>extra),"no extra root input");require(positive==positives.size(),"all positive outputs retained");
 ofstream outgraphs(argv[3]);require(bool(outgraphs),"positive output");outgraphs<<positives.size()<<'\n';for(auto&g:positives){outgraphs<<g.size();for(U row:g)outgraphs<<' '<<row;outgraphs<<'\n';}require(bool(outgraphs),"complete positive write");
 ofstream out(argv[2]);out<<"{\"status\":\"PASS_COMPLETE_FOREST_COMPLETIONS\",\"lambda\":10,\"order\":36,\"root_targets\":"<<count<<",\"forest_calls\":"<<4*count<<",\"left_nodes\":"<<nodes<<",\"left_assignments\":"<<assignments<<",\"right_nodes\":"<<rightnodes<<",\"complete_graphs\":"<<complete<<",\"wrong_hexagons\":"<<mismatch<<",\"positive\":"<<positive<<",\"seconds\":"<<chrono::duration<double>(chrono::steady_clock::now()-budget.started).count()<<"}\n";require(bool(out),"complete report");return 0;
}catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
