struct Probe {std::vector<int>blocks,items;std::vector<std::array<int,3>>final_sizes;U nodes=0;bool accepted=false;
 void check(size_t position){
#include "size_guard.inc"
 accepted=true;
 }
};
int main(){try{
 std::cout<<"{\"rows\":[";bool comma=false;int cases=0;
 for(int f=0;f<=27;f++)for(int n1=0;n1<=8;n1++)for(int n2=0;n2<=8-n1;n2++)for(int n3=0;n3<=8-n1-n2;n3++){
  int used=n1+2*n2+3*n3;if(used>13)continue;
  Probe p;p.items.resize(13);p.final_sizes=possible_final_sizes(f,f);
  p.blocks.insert(p.blocks.end(),n1,1);p.blocks.insert(p.blocks.end(),n2,3);p.blocks.insert(p.blocks.end(),n3,7);p.check(used);
  if(comma)std::cout<<',';comma=true;std::cout<<'['<<f<<','<<n1<<','<<n2<<','<<n3<<','<<p.accepted<<']';cases++;
 }
 std::cout<<"],\"cases\":"<<cases<<"}\n";return 0;
 }catch(const std::exception&e){std::cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
