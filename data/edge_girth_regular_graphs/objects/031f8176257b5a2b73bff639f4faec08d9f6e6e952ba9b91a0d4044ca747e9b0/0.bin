\usepackage[a4paper,margin=27mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}[theorem]{Lemma}
\title{A graph at the girth-six Moore bound}
\author{Human Compression project}
\date{13 October 2026}
\begin{document}\maketitle
\begin{abstract}
A graph of degree four and girth six has at least twenty-six vertices.
We prove that there is exactly one graph at that order, by recovering
its projective plane and classifying the two Latin squares of order
three that describe the corresponding affine plane. Its edges each
belong to twenty-seven six-cycles. This supplies a complete elementary
proof of one numerical uniqueness entry in the tables of Goedgebeur
and Jooken.
\end{abstract}

\section{Scope and attribution}
Graphs in this note are finite, simple and undirected. As in the source,
$\operatorname{egr}(n,k,g,\lambda)$ denotes a connected graph on $n$
vertices of degree $k$, girth $g$, and exactly $\lambda$ cycles of
length $g$ through each edge. Isomorphisms need not preserve a
distinguished vertex or a bipartition.

Table~2 of the fixed manuscript edition
\nolinkurl{arXiv:2401.08271v2} of Goedgebeur and Jooken~\cite{GJ}
states that the least order for $(k,g,\lambda)=(4,6,27)$ is twenty-six
and that exactly one graph attains it. The table attributes its
previous lower and upper bounds to its reference~[10]. Those
attributions are retained. Our earlier reviewed components already
supply the lower bound and the stored example
\nolinkurl{UntilOrder250_143}; only the uniqueness entry remains to
be recovered here.

The Moore bound, projective planes over finite fields, and the
uniqueness of the plane of order three are classical. We claim no new
classification or historical priority for the elementary arguments
below. We include their details so that this recovery does not depend
on an unexplained uniqueness assertion or a census of regular graphs.
Our contribution is the explicit derivation of the source entry and
its checked identification with the stored example.

\section{Equality in the Moore bound}
\begin{lemma}\label{plane}
A graph of degree four and girth at least six has at least twenty-six
vertices. If it has exactly twenty-six, it is the incidence graph of
a projective plane of order three.
\end{lemma}
\begin{proof}
Choose an edge $uv$. Starting at $u$, take its three neighbours other
than $v$, and the three further neighbours of each of those vertices.
Do the same starting at $v$, avoiding $u$. Together with $u,v$, these
are two trees of depth two joined by their root edge. No vertex can
occur twice in this construction: two distinct paths to a repeated
vertex, or a path crossing from one tree to the other, would give a
cycle of length at most five. Thus there are at least
\[
                     2(1+3+9)=26
\]
vertices.

At equality these vertices exhaust the graph. Denote the levels of
the first tree by $\{u\},A_1,A_2$, and those of the second by
$\{v\},B_1,B_2$. Every edge not already in the two joined trees
must go from $A_2$ to $B_2$. Indeed, the endpoints of any other
possible extra edge are joined in the tree by a path of length at
most four, so that edge would create a cycle of length at most five.
The graph is consequently bipartite, with parts
\[
 P=\{u\}\cup B_1\cup A_2,\qquad
 \mathcal L=\{v\}\cup A_1\cup B_2,
 \qquad |P|=|\mathcal L|=13.
\]

For any vertex $x$, its four neighbours each lead to three other
vertices of the same part as $x$. These twelve vertices are distinct,
because a repetition would create a four-cycle. They exhaust the
other vertices in that part. Thus every two vertices in $P$ have
exactly one common neighbour in $\mathcal L$, and every two in
$\mathcal L$ have exactly one common neighbour in $P$. Interpreting
$P$ as points and $\mathcal L$ as lines gives the two unique-join
and unique-meet axioms, with four points on every line and four lines
through every point.

There is a quadrangle, so the incidence structure is nondegenerate.
Choose two points $a,b$ on a line and a point $c$ off that line.
The three lines $ab,ac,bc$ cover only $3\cdot4-3=9$ points. Any
point outside them completes a quadrangle with $a,b,c$. We therefore
have a projective plane of order three.
\end{proof}

\section{Uniqueness of the plane}
\begin{lemma}\label{unique}
Up to incidence isomorphism, there is exactly one projective plane
of order three.
\end{lemma}
\begin{proof}
First we show that there is at most one. Choose a line $\ell_\infty$
and remove it and its four points. The remaining nine points form
an affine plane. More explicitly, each point $p$ of $\ell_\infty$
gives three other lines through $p$, whose remaining sets of three
points partition the nine affine points. These are four parallel
classes. Lines from different classes meet in exactly one affine
point, since their unique projective intersection cannot lie on
$\ell_\infty$.

Choose two classes as rows and columns, and label the three lines
of each by $0,1,2$. Their intersections identify the affine points
with a $3\times3$ array. Label the lines in each remaining class
by $0,1,2$. The labels at the nine array positions give two Latin
squares: each line meets every row and every column exactly once.
The squares are orthogonal, since a line from either of the two
classes meets a line from the other class exactly once.

By permuting rows, columns and symbols, normalize the first square
to have both first row and first column $0,1,2$. The Latin condition
then forces the whole square to be
\[
 L=\begin{pmatrix}0&1&2\\1&2&0\\2&0&1\end{pmatrix}.
\]
For example, the second row starts with $1$. If its middle entry
were $0$, its final entry would be $2$, repeating the top entry in
that column. Its middle entry is therefore $2$, and all the other
entries follow.

Independently permute the symbols of the second square to make its
first row $0,1,2$. Its second row must be a derangement of that row,
so it is either $(1,2,0)$ or $(2,0,1)$. The first choice would
repeat the ordered pairs $(0,0),(1,1),(2,2)$ already appearing in
the first row of the superimposed squares, contrary to orthogonality.
The second row is therefore $(2,0,1)$, and its third row is forced:
\[
 M=\begin{pmatrix}0&1&2\\2&0&1\\1&2&0\end{pmatrix}.
\]
These squares are orthogonal: their nine ordered pairs are distinct.
They determine all four parallel classes, hence the affine plane.
Restoring one point for each class and the line on those four points
recovers the projective plane uniquely.

For existence, take the one-dimensional subspaces of $\mathbb F_3^3$
as points, and the kernels of nonzero linear functionals, up to
nonzero scalar multiples, as lines. There are $(3^3-1)/2=13$ of each.
Each line contains $(3^2-1)/2=4$ points. Two distinct points span a
unique two-dimensional subspace; two distinct two-dimensional
subspaces intersect in a unique one-dimensional subspace. This
gives the required plane and proves existence.
\end{proof}

\section{The numerical entry}
\begin{theorem}
The minimum order of an $\operatorname{egr}(n,4,6,27)$ is twenty-six,
and exactly one isomorphism class occurs at that order.
\end{theorem}
\begin{proof}
Lemmas~\ref{plane} and~\ref{unique} give the lower bound and at most
one graph at equality. The incidence graph of the plane constructed
above is connected and of degree four. It is bipartite and has no
four-cycle, by uniqueness of the line through two points.

Fix an incident point-line pair $p,\ell$. Choose a point
$q\in\ell\setminus\{p\}$, a line $m\ne\ell$ through $p$, and
a point $r\in m\setminus\{p\}$. There are three choices at each
step. The line $h$ through $q,r$ is distinct from both $\ell$ and
$m$, since $q\notin m$ and $r\notin\ell$. These objects form the
six-cycle
\[
                         p,\ell,q,h,r,m,p.
\]
Conversely, every six-cycle containing the edge $p\ell$ determines
exactly these choices when traversed from $p$ to $\ell$. Thus each
edge is on exactly $3^3=27$ six-cycles. In particular the girth is
six, which proves the assertion.
\end{proof}

\paragraph{Certificates.}
The finite verifier builds the plane directly over $\mathbb F_3$,
checks all incidences and cycle counts, and verifies a literal
bijection to the stored source graph. It also enumerates the twelve
Latin squares of order three and checks the normalization used in
Lemma~\ref{unique}. These calculations supplement the written
completeness proof; no external plane census is assumed. The note
recovers one uniqueness entry only and supplies no whole-original,
open-question, additional Lean or compression-measurement credit.

