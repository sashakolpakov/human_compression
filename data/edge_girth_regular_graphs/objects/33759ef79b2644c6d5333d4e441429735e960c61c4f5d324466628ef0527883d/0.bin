#define main target_program_main
#include "complete_lambda.cpp"
#undef main
int main(int argc,char**argv){try{
 need(argc==4,"SOURCE ROOTS EXTERIORS");ifstream in(argv[1]);int k,n;need(bool(in>>k>>n)&&k==1&&n==24,"source24");Graph source(n);for(U&x:source)need(bool(in>>x),"source row");validate(source);vector<Graph>roots,exts;ifstream ir(argv[2]);int nr;ir>>nr;need(nr==348,"348 roots");for(int i=0;i<nr;i++){ir>>n;need(n==17,"root17");Graph g(n);for(U&x:g)ir>>x;roots.push_back(g);}ifstream ie(argv[3]);int orders;ie>>orders;need(orders==4,"four exteriors");for(int z=0;z<orders;z++){ie>>n>>k;for(int i=0;i<k;i++){Graph g(n);for(U&x:g)ie>>x;if(n==7)exts.push_back(g);}}
 map<Graph,int>rootkeys,extkeys;vector<Canonical>rc,ec;for(int i=0;i<nr;i++){rc.push_back(proposal(roots[i],true));rootkeys[rc.back().key]=i;}for(int i=0;i<(int)exts.size();i++){ec.push_back(proposal(exts[i],false));extkeys[ec.back().key]=i;}int insertions=0;Deadline deadline(30);
 for(int v=0;v<24;v++){
  vector<int>lab{v};for(int u=0;u<24;u++)if(source[v]>>u&1)lab.push_back(u);need(lab.size()==5,"four source neighbours");for(int i=1;i<=4;i++)for(int u=0;u<24;u++)if(u!=v&&(source[lab[i]]>>u&1))lab.push_back(u);need(lab.size()==17,"source ball17");auto sorted=lab;sort(sorted.begin(),sorted.end());need(unique(sorted.begin(),sorted.end())==sorted.end(),"distinct ball");for(int u=0;u<24;u++)if(find(lab.begin(),lab.end(),u)==lab.end())lab.push_back(u);
  Graph r(17),h(7);for(int i=0;i<17;i++)for(int j=0;j<17;j++)if(source[lab[i]]>>lab[j]&1)r[i]|=U(1)<<j;for(int i=0;i<7;i++)for(int j=0;j<7;j++)if(source[lab[17+i]]>>lab[17+j]&1)h[i]|=U(1)<<j;validate_root(r);auto a=proposal(r,true),b=proposal(h,false);need(rootkeys.count(a.key)&&extkeys.count(b.key),"source in inventories");int ri=rootkeys.at(a.key),ei=extkeys.at(b.key);literal(r,roots[ri],a.lab,rc[ri].lab,true);literal(h,exts[ei],b.lab,ec[ei].lab,false);
  vector<int>p(24);for(int i=0;i<17;i++)p[a.lab[i]]=rc[ri].lab[i];for(int i=0;i<7;i++)p[17+b.lab[i]]=17+ec[ei].lab[i];Graph target(24);for(int i=0;i<24;i++)for(int j=0;j<24;j++)if(source[lab[i]]>>lab[j]&1)target[p[i]]|=U(1)<<p[j];Exterior e(exts[ei]);vector<int>masks(7);for(int i=0;i<7;i++)masks[i]=(target[17+i]>>5)&4095;auto best=masks;for(auto q:e.automorphisms){vector<int>x(7);for(int i=0;i<7;i++)x[i]=masks[q[i]];if(x<best)best=x;}Cover cover(false);Boundary state(roots[ri],e,deadline,cover);need(state.state.valid,"source initial budgets");vector<Change>changes;
  for(int at=0;at<7;at++){int y=e.order[at];state.masks[y]=best[y];state.done[y]=true;need(state.canonical(),"source orbit minimum prefix retained");need(wt(best[y])==4-wt(e.g[y]),"source exterior degree");for(int x=0;x<12;x++)if(best[y]>>x&1){need(state.missing[x]>0,"source leaf capacity");Change c;need(state.state.push(5+x,17+y,c),"source edge retained");state.missing[x]--;changes.push_back(c);insertions++;}for(int x:state.missing)need(x<=6-at,"source suffix capacity");}
  need(state.state.complete(),"source exact full target");auto c=proposal(state.state.g,false),d=proposal(source,false);need(c.key==d.key,"source final class");literal(state.state.g,source,c.lab,d.lab,false);for(auto it=changes.rbegin();it!=changes.rend();it++)state.state.pop(*it);need(state.state.g==Boundary::initial(roots[ri],e.g),"source rollback");
 }
 cout<<"{\"status\":\"PASS_ALL_SOURCE_ROOT_COMPLETIONS\",\"roots\":24,\"insertions\":"<<insertions<<"}\n";return 0;
 }catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
