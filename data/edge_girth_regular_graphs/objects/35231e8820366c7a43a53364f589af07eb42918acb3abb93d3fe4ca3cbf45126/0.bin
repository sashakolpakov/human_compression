\documentclass[11pt,a4paper]{article}
\usepackage[margin=25mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\setlength{\emergencystretch}{2em}
\newtheorem{lemma}{Lemma}
\newtheorem{theorem}[lemma]{Theorem}
\newtheorem{corollary}[lemma]{Corollary}
\title{Squares near a shortest odd cycle}
\author{Human Compression project}
\date{}
\begin{document}\maketitle
We write $n(k,4,\lambda)$ for the least order of a simple $k$-regular
graph of girth four in which every edge belongs to exactly $\lambda$
squares, with value infinity if none exists. We give a common proof of
three lower bounds in Tables~3 and~4 of the fixed manuscript~\cite{GJ}:
\[
 n(5,4,10)\ge20,\qquad n(6,4,18)\ge22,\qquad n(6,4,19)\ge24.
\]
The argument does not require the previously acquired lower bounds or
any graph census.

\begin{lemma}\label{integers}
Let $t_0,\ldots,t_4$ be nonnegative integers, with indices modulo five,
and put $F_i=t_i+t_{i+1}-t_{i-1}t_{i+2}$.
If $F_i\ge1$ for every $i$, then every $t_i=1$.
\end{lemma}
\begin{proof}
First suppose some $t_i$ vanishes, and rotate so that $t_0=0$.
The inequalities at indices zero and four give
\[
 t_1\ge1+t_4t_2,\qquad t_4\ge1+t_1t_3.
\]
Thus $t_1,t_4\ge1$. If $t_2,t_3$ were both positive, substitution
would yield $t_1\ge1+t_2+t_1t_2t_3>t_1$. Hence at least one
vanishes. If $t_2=0$, the inequality at index two gives
$t_3\ge1+t_1t_4$. Substitution gives
$(1-t_1^2)t_4\ge1+t_1$, impossible. If $t_3=0$, the same index
gives $t_2\ge1+t_1t_4$, and substitution gives the symmetric
contradiction $(1-t_4^2)t_1\ge1+t_4$.

All $t_i$ are therefore positive. Set $s_i=t_i-1\ge0$. Summation gives
\[
 \sum_i F_i=5-\sum_i s_i s_{i+2}\le5.
\]
Consequently every $F_i=1$ and every product $s_i s_{i+2}=0$.
The individual equations reduce to
$s_i+s_{i+1}=s_{i-1}+s_{i+2}$. Writing $d_i=s_i-s_{i-1}$,
we get $d_i=d_{i+2}$. Since addition of two traverses all five
indices, all differences are equal; their sum is zero, so every
$s_i$ is equal. The vanishing products force all of them to be zero.
\end{proof}

\begin{theorem}\label{pentagon}
Let $G$ be triangle-free and $k$-regular, where $k\ge5$. Suppose
every edge belongs to exactly $\lambda$ squares. If $G$ contains
a pentagon, then $\lambda\le(k-2)^2$.
\end{theorem}
\begin{proof}
Write a pentagon as $v_0\ldots v_4v_0$. Triangle-freeness implies
that it is induced and that every vertex has at most two neighbours
on it. Those two neighbours, if present, are nonconsecutive. Put
\[
 A_i=\{x:N(x)\cap V(C)=\{v_{i-1},v_{i+1}\}\},\quad
 B_i=\{x:N(x)\cap V(C)=\{v_i\}\},
\]
and let $Z$ contain the vertices with no cycle neighbours. Write
$a_i=|A_i|\ge1$, $b_i=|B_i|$, and note that $v_i\in A_i$ and
$a_{i-1}+a_{i+1}+b_i=k$.

Squares through $v_iv_{i+1}$ correspond to edges between
\[
 A_{i-1}\cup(A_{i+1}\setminus\{v_{i+1}\})\cup B_i
 \quad\hbox{and}\quad
 (A_i\setminus\{v_i\})\cup A_{i+2}\cup B_{i+1}.
\]
An edge cannot join vertices sharing a cycle neighbour. In particular,
edges between $A$ classes occur only between consecutive classes.
There are therefore at most
\begin{align*}
 U_i={}&(a_i-1)(a_{i-1}+a_{i+1}-1)+(a_{i+1}-1)a_{i+2}\\
 &+b_i(a_i+a_{i+2}-2)+b_{i+1}(a_{i-1}+a_{i+1}-2)+b_i b_{i+1}
\end{align*}
such edges. The first line counts the three possible pairs of $A$
classes. A vertex in $B_i$ can meet the displayed $A_i$ class and
the noncycle vertices of $A_{i+2}$, giving the next term; the next
term is its counterpart for $B_{i+1}$. The final term counts edges
between the two $B$ classes. Vertices of $Z$ do not occur here.
Every pair counted in this upper bound is distinct. We do not assume
that all these possible edges are present.

Substituting $b_i=k-a_{i-1}-a_{i+1}$ and setting $t_i=a_i-1$ gives
\[
                  U_i=(k-2)^2+F_i.
\]
If $\lambda>(k-2)^2$, integrality and $\lambda\le U_i$ imply
$F_i\ge1$ for every $i$. Lemma~\ref{integers} gives all $a_i=2$,
all $b_i=k-4$, and all $U_i=(k-2)^2+1$. Hence $\lambda=U_i$:
every permitted pair counted for every cycle edge must be an edge.

Choose $x\in B_i$, which exists since $k\ge5$.
It is adjacent to $v_i$ by definition. Equality for $v_iv_{i+1}$
forces it to meet the sole noncycle vertex in $A_i$, the sole
noncycle vertex in $A_{i+2}$, and every vertex in $B_{i+1}$.
Equality for $v_{i-1}v_i$ also forces the sole noncycle vertex in
$A_{i-2}$ and every vertex in $B_{i-1}$. All listed vertices are
distinct. Thus $x$ has at least $4+2(k-4)=2k-4>k$ neighbours,
a contradiction.
\end{proof}

\begin{lemma}\label{odd}
If a triangle-free $k$-regular graph on $n$ vertices is not bipartite,
its shortest odd cycle has length $\ell$ with $k\ell\le2n$.
\end{lemma}
\begin{proof}
A shortest odd cycle is induced. An outside vertex has at most two
neighbours on it: otherwise the cyclic gaps between consecutive
neighbours are all at least two and one is odd. The other gaps have
total at least four, so this odd gap and the outside vertex give a
shorter odd cycle. Every vertex thus has at most two neighbours on
the cycle. Counting incidences gives $k\ell\le2n$.
\end{proof}

\begin{lemma}\label{complement}
Let $G$ be $k$-regular and bipartite with $m$ vertices in each part,
and put $d=m-k$. Let $H$ be its complement inside $K_{m,m}$.
For an edge $xy$ of $G$, let $p_H(x,y)$ be the number of paths of
length three from $x$ to $y$ in $H$. The number of squares of $G$
through $xy$ is
\[
         (k-1)(2k-m-1)+d(d-1)-p_H(x,y).
\]
If $p_H(x,y)=0$ for every edge $xy$ of $G$, every component of $H$
is complete bipartite. If also $d>0$, each such component is $K_{d,d}$,
so $d$ divides $m$.
\end{lemma}
\begin{proof}
For distinct vertices $x,t$ in the same part put
$\mu(x,t)=|N_H(x)\cap N_H(t)|$. Their common neighbourhood in $G$
has size $m-2d+\mu(x,t)=2k-m+\mu(x,t)$. Also
$\sum_{t\ne x}\mu(x,t)=d(d-1)$, by counting two-step paths in $H$.
Squares on $xy$ correspond to a vertex $t\in N_G(y)\setminus\{x\}$
and a common neighbour other than $y$. Thus their number is
\[
 (k-1)(2k-m-1)+\sum_{t\in N_G(y)\setminus\{x\}}\mu(x,t).
\]
The missing terms are $\sum_{t\in N_H(y)}\mu(x,t)=p_H(x,y)$.
Because $xy$ is absent from $H$, these length-three walks have four
distinct vertices and are paths.

If a component of $H$ is not complete bipartite, choose two
nonadjacent vertices in its opposite parts and a shortest path
between them. Its first three edges give a path whose endpoints
are not adjacent, or the chosen path would not be shortest.
They therefore form an edge of $G$ with positive $p_H$, a contradiction.
The last assertion follows from $d$-regularity of $H$.
\end{proof}

\begin{corollary}\label{bounds}
The three lower bounds stated at the start hold.
\end{corollary}
\begin{proof}
For any edge of a triangle-free $k$-regular graph its two
neighbourhoods are disjoint, so $n\ge2k$. Counting square-edge
incidences also gives $8\mid nk\lambda$.

For $(k,\lambda)=(5,10)$, this divisibility requires $4\mid n$.
Below order twenty, the only possible orders are twelve and sixteen.
Lemma~\ref{odd} either excludes an odd cycle altogether or forces a
pentagon; Theorem~\ref{pentagon} excludes the latter since $10>9$.
The graph is therefore bipartite, with equal parts of size $m=n/2$.
For $m=6$, the complement has degree one and the square count in
Lemma~\ref{complement} is twelve, not ten. For $m=8$, the complement
has degree three and the same formula is $10-p_H(x,y)$. The required
count forces every $p_H$ to vanish, so three divides eight, a
contradiction.

For $(k,\lambda)=(6,18)$ the possible orders below twenty-two are
$12,14,16,18,20$; for $(6,19)$ those below twenty-four are
$12,16,20$. In both cases Lemma~\ref{odd} shows that a shortest odd
cycle would be a pentagon, and Theorem~\ref{pentagon} excludes it
because $\lambda>16$. Thus the graph is bipartite. The possible
part sizes and the complement formula give
\[
\begin{array}{c|ccccc}
m&6&7&8&9&10\\\hline
d&0&1&2&3&4\\
\hbox{square count}&25&20&\le17&\le16&\le17
\end{array}
\]
The first two values are exact since $H$ has degree zero or one.
No listed value is eighteen or nineteen. This proves both bounds.
\end{proof}

\paragraph{Attribution and scope.}
The three numerical lower bounds are results of Goedgebeur and Jooken
\cite{GJ}, Tables~3 and~4, physical pages~19 and~20. The local class
count extends our preceding proof for parameters $(16,6,4,17)$;
Lemma~\ref{integers} supplies a uniform inequality in place of its
four-case table, and Lemma~\ref{complement} states the general
complement identity. All arguments needed here are included above.
No historical priority is claimed for these elementary ideas.
This proves three lower-bound entries, with no new classification,
open-problem, Lean or compression-measurement claim. The accompanying
finite examples and arithmetic checks are supplementary certificates,
not premises of the proof.
