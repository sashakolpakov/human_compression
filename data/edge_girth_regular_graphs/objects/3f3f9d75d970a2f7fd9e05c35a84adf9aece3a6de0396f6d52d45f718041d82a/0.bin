"""Literal two-colour square edge domain; no SAT or graph completion search."""
import sys
if sys.flags.optimize:
    raise RuntimeError('ordinary Python required')
sys.dont_write_bytecode = True
from pathlib import Path
from itertools import combinations
from collections import Counter
import argparse
import hashlib
import json

HERE = Path(__file__).resolve().parent
ACCEPTANCE = HERE / 'hexagon_ball_square_completion_root_acceptance.json'
ACCEPTANCE_SHA = 'dc5ea43424e9e3d724b41c172824f4a0c04b2fbe4db9d1e1739a5eaa5b8bf7b5'


def need(ok, why):
    if not ok:
        raise ValueError(why)


def pin(path):
    raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def skeleton():
    names = [f'c_{i}' for i in range(6)]
    names += [f'x_{i}_{e}' for i in range(6) for e in range(2)]
    names += [f't_{i}' for i in range(4)] + [f'z_{i}' for i in range(4)]
    single = [(i, e, j) for i in range(6) for e in range(2)
              for j in range(3 if i in (2, 5) else 2)]
    names += [f's_{i}_{e}_{j}' for i, e, j in single]
    need(len(names) == len(set(names)) == 54, '54 distinct named vertices')
    index = {name: i for i, name in enumerate(names)}
    base = set()

    def edge(a, b):
        u, v = index[a], index[b]
        need(u != v, 'no loop in fixed graph')
        key = tuple(sorted((u, v)))
        need(key not in base, 'no repeated fixed edge')
        base.add(key)

    for i in range(6):
        edge(f'c_{i}', f'c_{(i+1)%6}')
        for e in range(2):
            edge(f'c_{i}', f'x_{i}_{e}')
    for t, anchor, child in [(0, 0, 0), (0, 3, 0), (2, 0, 1), (2, 3, 1),
                              (1, 1, 0), (1, 4, 0), (3, 1, 1), (3, 4, 1)]:
        edge(f't_{t}', f'x_{anchor}_{child}')
    for i in range(4):
        edge(f't_{i}', f'z_{i}')
        edge(f't_{i}', f'z_{(i+1)%4}')
    for i, e, j in single:
        edge(f'x_{i}_{e}', f's_{i}_{e}_{j}')
    for i in (2, 5):
        for e in range(2):
            edge(f's_{i}_{e}_0', f'z_{e}')
            edge(f's_{i}_{e}_1', f'z_{e+2}')

    anchors = {index[f's_{i}_{e}_{j}']: i for i, e, j in single}
    allowed = set()
    for u, v in combinations(sorted(anchors), 2):
        d = abs(anchors[u]-anchors[v])
        if min(d, 6-d) >= 2:
            allowed.add((u, v))
    degree = Counter(v for e in base for v in e)
    need(len(base) == 70 and len(allowed) == 196 and not base & allowed,
         'fixed70 and all196 permitted residual S--S pairs')
    need(all(degree[v] == 4 for v in range(54) if v not in anchors),
         'every non-S vertex is saturated')
    need(Counter(degree[v] for v in anchors) == {1: 20, 2: 8},
         'twenty degree-one and eight degree-two S vertices')
    need(sum(4-degree[v] for v in anchors) == 76, '38 residual edges')
    return names, base, allowed, anchors


def fixed_cycles(n, base):
    """Enumerate only length3..6 cycles in the fixed degree<=4 graph K."""
    adj = [set() for _ in range(n)]
    for u, v in base:
        adj[u].add(v)
        adj[v].add(u)
    found = []

    def walk(path):
        if len(path) >= 3 and path[0] in adj[path[-1]] and path[1] < path[-1]:
            found.append(path)
        if len(path) == 6:
            return
        for v in sorted(adj[path[-1]]):
            if v > path[0] and v not in path:
                walk(path + [v])

    for v in range(n):
        walk([v])
    return sorted(found, key=lambda p: (len(p), p))


def encode():
    need(pin(ACCEPTANCE)['sha256'] == ACCEPTANCE_SHA, 'accepted exact conditional cover')
    names, base, allowed, anchors = skeleton()
    cycles = fixed_cycles(len(names), base)
    hexagons = [p for p in cycles if len(p) == 6]
    ownership = Counter(tuple(sorted((a, b))) for p in hexagons
                        for a, b in zip(p, p[1:]+p[:1]))
    obstruction = any(len(p) < 6 for p in cycles) or any(c > 1 for c in ownership.values())
    text = f'{len(names)} {len(base)} {len(allowed)}\n'
    text += ''.join(f'{u} {v}\n' for u, v in sorted(base))
    text += ''.join(f'{u} {v}\n' for u, v in sorted(allowed))
    metadata = dict(status='LITERAL_FIXED_TWO_COLOUR_SQUARE_DOMAIN',
                    encoder=pin(Path(__file__).resolve()), conditional_cover=pin(ACCEPTANCE),
                    vertices=names, fixed_edges=[list(e) for e in sorted(base)],
                    allowed_edges=[list(e) for e in sorted(allowed)],
                    single_parent_anchors={str(v): anchors[v] for v in sorted(anchors)},
                    forced_edges=70, optional_edges=196, required_selected_edges=38,
                    fixed_cycles=cycles,
                    fixed_cycle_counts={str(k): sum(len(p) == k for p in cycles) for k in range(3, 7)},
                    fixed_obstruction_found=obstruction,
                    model_sha256=hashlib.sha256(text.encode('ascii')).hexdigest(),
                    solver_calls=0, graph_completion_calls=0, exclusions=0,
                    scope='One exact edge domain for the acquired two-colour t4 subcase. '
                          'Permitted edges retain only the proved anchor restriction; '
                          'they are not certified mutually compatible or extendible.')
    return text, metadata


if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('--model', type=Path, required=True)
    ap.add_argument('--metadata', type=Path, required=True)
    a = ap.parse_args()
    need(a.model == HERE/'hexagon_ball_square_model.txt' and
         a.metadata == HERE/'hexagon_ball_square_model.json', 'fixed preparation paths')
    need(not a.model.exists() and not a.metadata.exists(), 'preserve existing preparation')
    raw, record = encode()
    need(len(raw.encode()) < 4096 and len(json.dumps(record).encode()) < 65536,
         'small literal graph domain')
    a.model.write_text(raw, encoding='ascii')
    a.metadata.write_text(json.dumps(record, indent=2)+'\n')
    print(json.dumps(dict(model=pin(a.model), metadata=pin(a.metadata),
                         fixed_cycle_counts=record['fixed_cycle_counts'],
                         fixed_obstruction_found=record['fixed_obstruction_found'],
                         solver_calls=0, graph_completion_calls=0)))
