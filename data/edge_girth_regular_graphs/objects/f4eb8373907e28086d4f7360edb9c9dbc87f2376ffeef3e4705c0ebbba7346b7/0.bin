import itertools,collections
FULL=tuple(itertools.permutations(range(4)))
PARTIAL=tuple(sorted({tuple(-1 if i==j else p[i] for i in range(4))for p in FULL for j in range(4)}))
FIRST=((0,1,2,3),(0,2,1,3));OPTIONS=(FIRST,PARTIAL,PARTIAL,FULL)
LEFT=(7,7,11,11);RIGHT=(22,26,22,26)
def need(x,m):
 if not x:raise RuntimeError(m)
def tree():
 G=[set()for _ in range(32)]
 for b in (0,15):
  for i in range(1,15):edge(G,b+i,b+(i-1)//2)
 edge(G,0,15);return G
def edge(G,u,v):G[u].add(v);G[v].add(u)
def quadrant(G,level,index):
 H=[s.copy()for s in G]
 for i,j in enumerate(OPTIONS[level][index]):
  if j>=0:edge(H,LEFT[level]+i,RIGHT[level]+j)
 return H
def short_cycle(G):
 for u in range(len(G)):
  for v in sorted(G[u]):
   if u>=v:continue
   paths={u:[u]};Q=collections.deque([u])
   while Q:
    x=Q.popleft();p=paths[x]
    if len(p)>=7:continue
    for y in sorted(G[x]):
     if (x,y)==(u,v)or(x,y)==(v,u):continue
     if y==v:return p+[v]
     if y not in paths:paths[y]=p+[y];Q.append(y)
 return None
def valid_cycle(G,p):
 return 3<=len(p)<=7 and len(p)==len(set(p))and all(type(x)is int and 0<=x<len(G)for x in p)and all(p[(i+1)%len(p)]in G[p[i]]for i in range(len(p)))
def attach(G):
 H=[s.copy()for s in G]
 for half,z in [((7,11),30),((11,15),30),((22,26),31),((26,30),31)]:
  candidates=[u for u in range(*half)if len(H[u])==2];need(len(candidates)==1,'one unfinished leaf per quarter');edge(H,candidates[0],z)
 return H
def paths(G,u,v,length):
 out=[]
 def visit(p):
  if len(p)==length:
   if v in G[p[-1]]:out.append(p+[v])
   return
  for x in sorted(G[p[-1]]):
   if x!=v and x not in p:visit(p+[x])
 visit([u]);return out
