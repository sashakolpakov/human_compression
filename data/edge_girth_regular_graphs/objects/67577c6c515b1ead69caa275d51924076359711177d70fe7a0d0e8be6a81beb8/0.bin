\newtheorem{theorem}{Theorem}\newtheorem{lemma}[theorem]{Lemma}
\title{A lower bound for pentavalent graphs with fourteen pentagons on each edge}
\author{A component of the fixed F012 recovery}\date{}
\begin{document}\maketitle
\begin{abstract}
A $5$-regular graph of girth $5$ in which every edge belongs to fourteen
pentagons has at least $48$ vertices. This recovers, and strengthens, the
lower bound $42$ in Table~3 of the fixed source. The proof combines a
count outside a Moore ball with a spectral obstruction on $28$ vertices.
The latter uses only twenty-six explicitly printed integer nonsquares;
there is no graph enumeration or finite classification premise.
\end{abstract}

\begin{lemma}\label{twenty-eight}
There is no simple $5$-regular graph of girth at least $5$ on $28$ vertices.
\end{lemma}
\begin{proof}
Suppose such a graph exists, and let $A$ be its adjacency matrix. The
radius-two ball about each vertex has $1+5+20=26$ vertices: triangles and
quadrilaterals would be the only possible identifications. Thus
\[
 D=J+4I-A-A^2
\]
is the adjacency matrix of the relation ``distinct and at distance at
least three'', where vertices in different components also satisfy this
relation. Indeed $A^2$ has diagonal $5$; on adjacent vertices it is zero,
and on distinct nonadjacent vertices it is $1$ precisely at distance two.
Every row of $D$ therefore has sum $2$. Consequently $D$ is a disjoint
union of simple cycles, of lengths between $3$ and $28$. Since $A$ is
regular, $AJ=JA$, and hence $A$ and $D$ commute.

We use the classical irreducibility of cyclotomic polynomials. If
$\delta=\zeta+\zeta^{-1}$ for a primitive $m$th root of unity with
$3\le m\le28$, the real field $K=\mathbb Q(\delta)$ has degree
$\varphi(m)/2$. Its element
\[
 17-4\delta=(4-\zeta)(4-\zeta^{-1})
\]
has norm $\Phi_m(4)$: pair the primitive roots under inversion in the
product defining the cyclotomic polynomial. Table~\ref{norms} gives an
integer $s_m$ with
\begin{equation}\label{nonsquare}
 s_m^2<\Phi_m(4)<(s_m+1)^2
 \qquad(3\le m\le28).
\end{equation}
A square in $K$ has square rational norm. These positive integer norms
are not rational squares, so $17-4\delta$ is not a square in $K$.

Simultaneously diagonalize the real symmetric matrices $A,D$. Off the
principal all-one vector, an eigenpair $(\theta,\delta)$ satisfies
\begin{equation}\label{quadratic}
 \theta^2+\theta=4-\delta.
\end{equation}
For $\delta\ne\pm2$ the quadratic in \eqref{quadratic} is irreducible
 over $K$, by \eqref{nonsquare}. Moreover
$\delta=4-\theta-\theta^2$ puts $K$ inside $\mathbb Q(\theta)$, so the
relative degree is exactly two. Each rational irreducible factor of the
characteristic polynomial of $A$ consequently contains both roots above
every conjugate $\delta$, with equal multiplicities. In each such
$D$-eigenspace the mean of the $A$-eigenvalues is therefore $-1/2$.

Let $c$ be the number of cycles of $D$, and $e$ the number of even cycles.
The eigenvalues $2$ and $-2$ of $D$ have multiplicities $c$ and $e$,
respectively. Let $b$ of the latter $e$ dimensions have $A$-eigenvalue $2$;
the remaining eigenvalue there is $-3$, by \eqref{quadratic}.
The $\delta=2$ space contributes zero to $\operatorname{tr} A(D-2I)$,
including its principal vector. The $\delta=-2$ space contributes
$-4(2b-3(e-b))=12e-20b$.

The other $D$-eigenvalues number $28-c-e$ and sum $-2c+2e$, since
$\operatorname{tr}D=0$. Their contribution, by the mean just proved, is
\[
 -\tfrac12\bigl((-2c+2e)-2(28-c-e)\bigr)=28-2e.
\]
But $A,D$ have disjoint edge sets, so $\operatorname{tr}(AD)=0$, and
$\operatorname{tr}A=0$ as well. We obtain
$0=28+10e-20b$, which is impossible modulo $10$.
\end{proof}

