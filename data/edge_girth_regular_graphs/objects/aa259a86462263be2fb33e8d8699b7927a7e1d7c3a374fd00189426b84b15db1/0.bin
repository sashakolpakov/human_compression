#include "cycle_budget.h"
using Counts=array<array<int,64>,64>;
Counts independent(const Graph&g){Counts result{};int n=g.size();for(int a=0;a<n;a++)for(int b=a+1;b<n;b++)for(int c=b+1;c<n;c++)for(int d=c+1;d<n;d++)for(int e=d+1;e<n;e++){
 array<int,4>p{b,c,d,e};do{if(p[0]>p[3])continue;array<int,5>v{a,p[0],p[1],p[2],p[3]};bool good=true;for(int i=0;i<5;i++)if(!(g[v[i]]>>v[(i+1)%5]&1))good=false;if(good)for(int i=0;i<5;i++){result[v[i]][v[(i+1)%5]]++;result[v[(i+1)%5]][v[i]]++;}}while(next_permutation(p.begin(),p.end()));
 }return result;}
U decisions=0;
void control(const Graph&g,int limit){CycleBudget s(Graph(g.size()),limit);vector<Change>history;need(s.counts==independent(s.g),"empty counts");
 for(int u=0;u<(int)g.size();u++)for(int v=u+1;v<(int)g.size();v++)if(g[u]>>v&1){Graph before=s.g;auto old=s.counts;Change c;bool actual=s.push(u,v,c);Graph candidate=before;add(candidate,u,v);Counts expected=independent(candidate);bool permitted=girth5(candidate);for(int a=0;a<(int)g.size();a++)for(int b=a+1;b<(int)g.size();b++)if(expected[a][b]>limit)permitted=false;need(actual==permitted,"independent insertion decision");decisions++;
  if(actual){need(s.g==candidate&&s.counts==expected,"exact incremented counts");history.push_back(c);}else need(s.g==before&&s.counts==old,"rejection immutable");
 }
 while(!history.empty()){s.pop(history.back());history.pop_back();need(s.counts==independent(s.g),"independent rollback counts");}need(s.g==Graph(g.size()),"empty restored graph");
}
int main(int argc,char**argv){try{need(argc==2,"usage SOURCE");U graphs=0;for(int code=0;code<1024;code++){Graph g(5);int at=0;for(int u=0;u<5;u++)for(int v=u+1;v<5;v++,at++)if(code>>at&1)add(g,u,v);for(int limit=0;limit<=2;limit++){control(g,limit);graphs++;}}
 ifstream in(argv[1]);int count,n;need(bool(in>>count>>n)&&count==1&&n==24,"source format");Graph g(n);for(U&row:g)need(bool(in>>row),"source row");validate(g);need(girth5(g),"source girth");auto expected=independent(g);for(int u=0;u<n;u++){need(wt(g[u])==4,"source degree");for(int v=u+1;v<n;v++)if(g[u]>>v&1)need(expected[u][v]==5,"source pentagons");}for(int limit=2;limit<=5;limit++){control(g,limit);graphs++;}
 cout<<"{\"status\":\"PASS_INDEPENDENT_CYCLE_INSERTION_ROLLBACK\",\"graph_limit_cases\":"<<graphs<<",\"insertion_decisions\":"<<decisions<<",\"source_order\":24,\"source_edges\":48}\n";return 0;
 }catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
