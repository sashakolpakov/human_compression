\documentclass[11pt,a4paper]{article}
\usepackage[margin=25mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,array}
\setlength{\emergencystretch}{2em}
\newtheorem{lemma}{Lemma}\newtheorem{theorem}[lemma]{Theorem}
\title{Fourteen octagons through every edge}
\author{Human Compression project}\date{}
\begin{document}\maketitle
We give a local exclusion whose conclusion is independent of the order
of the graph. The finite part of the proof uses explicit short cycles
and literal vertex permutations; the certificate verifier requires only
the Python standard library.

\begin{theorem}
There is no finite simple cubic graph of girth eight with exactly
fourteen octagons through each edge. Thus $n(3,8,14)=\infty$.
\end{theorem}

At a vertex of a cubic graph, let $c_{ij}$ count octagons using the
$i$th and $j$th incident edges. If each edge belongs to fourteen
such cycles, then
\[
 c_{12}+c_{13}=c_{12}+c_{23}=c_{13}+c_{23}=14,
 \qquad c_{12}=c_{13}=c_{23}=7.                         \tag{1}
\]
Fix an edge $uv$. The two binary trees of depth three rooted at $u$
and $v$, excluding $uv$ in their first steps, are disjoint and have
fifteen vertices each. An identification or an additional edge involving
an internal vertex would create a cycle of length at most seven.
An additional edge between two leaves of the same tree would do so
as well. Thus the only additional edges in this thirty-vertex induced
subgraph join a left leaf to a right leaf. They correspond bijectively
to the octagons through $uv$, so there are fourteen.

Partition the eight leaves on each side into two sets of four,
according to their first step from their root; denote these sets by
$L_0,L_1$ and $R_0,R_1$. Within each set of four there is also a
partition into two sibling pairs. A leaf cannot have two neighbours
in the same opposite set of four: their tree distance is at most four,
so the two added edges would create a cycle of length at most six.
Consequently the edges between each $L_i,R_j$ form a matching,
of size $m_{ij}\le4$.

\begin{lemma}\label{forced}
After interchanging the two halves on one side if necessary,
\[
                         (m_{ij})=\begin{pmatrix}4&3\\3&4\end{pmatrix}.
                                                               \tag{2}
\]
There is one unfilled leaf incidence in each of the four sets.
The two on the left meet one common outside vertex $z$; the two
on the right meet another outside vertex $z'$, distinct from $z$.
\end{lemma}
\begin{proof}
Octagons using $uv$ and the root edge leading to $L_i$ correspond
to the matching edges incident with $L_i$. By (1) there are seven.
The analogous assertion holds on the right. Therefore the rows
and columns of $(4-m_{ij})$ all sum to one, proving (2). The full
matching in each row or column supplies one cross neighbour to
every leaf; precisely one leaf misses the second neighbour.

Now count octagons through the two left root edges, omitting $uv$.
Their vertex opposite $u$ is a common neighbour of two left leaves,
one in each half. Six right leaves have two cross neighbours and
supply six such cycles. The other two right leaves have only one
cross neighbour. The only remaining possible opposite vertex is
outside the thirty-vertex subgraph. Since exactly two unfinished
left incidences remain, equation (1) forces them to meet one vertex
$z$, supplying the seventh cycle. The same argument gives $z'$ on
the right. If $z=z'$, that vertex would have four neighbours,
contradicting cubic degree.
\end{proof}

Let $B$ include the thirty tree vertices and these two forced outside
vertices. All its vertices have degree three except $z,z'$, which
have degree two. The finite classification of this partial graph is
particularly small after normalizing one complete matching.

\begin{lemma}\label{local}
Every possible $B$ is isomorphic to the graph $B_*$ specified below.
Number the left tree by $0,\ldots,14$, with root $0$ and parent
$\lfloor(i-1)/2\rfloor$ for $i>0$. Number the right tree in the
same way, adding fifteen to every label, and join roots $0,15$.
Add the following fourteen cross edges:
\[
\begin{array}{rrrrrrr}
(7,22)&(8,24)&(8,28)&(9,23)&(9,27)&(10,25)&(10,29)\\
(11,29)&(12,24)&(12,27)&(13,23)&(13,28)&(14,25)&(14,26).
\end{array}
\]
Finally join $z=30$ to $7,11$ and $z'=31$ to $22,26$.
\end{lemma}
\begin{proof}
A complete matching between two sets of four is a bijection.
Up to independent permutations preserving their sibling partitions,
it has precisely two forms:
\[
                       (0,1,2,3),\qquad(0,2,1,3).       \tag{3}
\]
Indeed, the inverse image of the right sibling partition is one
of the three partitions of four points into pairs. It either equals
the left partition, or is one of the other two; the stabilizer of
the left partition interchanges those other two. Once the partitions
agree, their stabilizers identify the individual points. Each such
permutation extends to an automorphism of its binary subtree.
The verifier also checks this normalization literally for every
one of the twenty-four bijections.

Normalize the $L_0,R_0$ matching using (3). The other complete
matching has $24$ choices. A matching of size three has
$4\cdot4\cdot3!=96$ choices. Thus the normalized inventory has
\[
                         2\cdot96^2\cdot24=442368       \tag{4}
\]
cases, before girth is imposed. The supplied certificate traverses
this exact product by prefixes. A prefix is discarded only with
an explicit cycle of length three through seven; every completion
would retain that cycle. For each undiscarded prefix all choices
of the next matching are visited. At the fourth matching, the
forced vertices of Lemma~\ref{forced} are added, and any further
short cycle is again supplied explicitly.

There are $1024$ thirty-vertex cases surviving the first girth test,
and $512$ surviving the forced attachments. For every one of the
latter the certificate gives a permutation of all thirty-two vertices
to $B_*$. The verifier compares every ordered adjacency entry and
checks that the two degree-two vertices map to $30,31$. It also
checks every prefix key in order and the total coverage in (4).
Thus there is no assumption that a graph-isomorphism or canonical
labelling program found all cases. The generator used such software
only to discover the literal permutations checked here.
\end{proof}

\begin{lemma}\label{protected}
Suppose a partial cubic graph $B$ has just two deficient vertices
$z,z'$, each of degree two, and all other vertices have degree three.
Suppose $B$ contains a path of length three from $z$ to $z'$.
If an edge $e$ of $B$ lies on no simple $z,z'$ path of length at
most three, then every octagon through $e$ in any cubic completion
of girth at least eight is already contained in $B$.
\end{lemma}
\begin{proof}
An extra edge $zz'$ would close a quadrangle, so both missing
incidences lead outside $B$. These are the only edges by which a
cycle can leave and re-enter $B$. A simple cycle which uses them
is the union of an internal $z,z'$ path and a path whose internal
vertices are outside $B$. The latter has length at least five:
together with the given length-three path it would otherwise
form a cycle of length at most seven. In an octagon, the internal
path therefore has length at most three. It cannot contain $e$
by hypothesis. This proves the assertion. No assumption about the
number or structure of the farther vertices is used.
\end{proof}

\begin{proof}[Proof of the theorem]
For $B_*$, the only simple $30,31$ path of length at most three is
\[
                              30,7,22,31.               \tag{5}
\]
The edge $e=\{1,3\}$ lies on precisely twelve octagons in $B_*$.
For complete inspectability, their alternate length-seven paths
from $1$ to $3$ are listed here:
\[
\begin{array}{rrrrrrrr}
1&0&2&5&11&30&7&3\\
1&0&2&5&12&24&8&3\\
1&0&2&6&13&28&8&3\\
1&0&15&16&18&22&7&3\\
1&0&15&16&19&24&8&3\\
1&0&15&17&21&28&8&3\\
1&4&9&23&13&28&8&3\\
1&4&9&23&18&22&7&3\\
1&4&9&27&12&24&8&3\\
1&4&10&25&19&24&8&3\\
1&4&10&29&11&30&7&3\\
1&4&10&29&21&28&8&3.
\end{array}
\]
The verifier enumerates all simple paths of the stated lengths,
so the displayed lists assert exact counts, not only lower bounds.
Alternatively they can be checked by branching through the explicit
adjacency list in Lemma~\ref{local}. Lemma~\ref{protected} shows
that no octagon through $e$ can be added by completing the graph.
Its final count is therefore twelve, contradicting the required
fourteen. Lemmas~\ref{forced} and \ref{local} supplied $B_*$ in
every hypothetical graph, proving the theorem.
\end{proof}

\paragraph{Attribution and scope.}
Goedgebeur and Jooken, \emph{Exhaustive generation of edge-girth-regular
graphs}, arXiv:2401.08271v2, Table 1 on physical page 17, record
$n(3,8,14)\ge64$ and no finite upper example. The present all-order
exclusion implies and strengthens that bound. The tree about an
edge is the classical Moore-bound construction. The two forced
outside vertices, the complete matching inventory and the protected
edge argument supply the present proof. Its explicit finite
verification is a proof dependency. No priority, named-conjecture,
whole-original, Lean or numerical-compression claim is made here.
\end{document}
