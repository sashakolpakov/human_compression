#include "vertex_ball.h"
inline void validate_root_lambda(const Graph&g,int lambda){validate(g);need(g.size()==17&&girth5(g),"valid root");auto t=ball();for(int u=0;u<5;u++)need(g[u]==t[u],"literal fixed Moore tree");array<int,4>cross{};for(int u=5;u<17;u++){need(wt(g[u])<=4&&(g[u]&31)==t[u],"leaf capacity and parent");for(int v=u+1;v<17;v++)if(g[u]>>v&1){need((u-5)/3!=(v-5)/3,"different leaf branches");cross[(u-5)/3]++;cross[(v-5)/3]++;}}for(int d:cross)need(d==lambda,"specified root-edge pentagons");}
