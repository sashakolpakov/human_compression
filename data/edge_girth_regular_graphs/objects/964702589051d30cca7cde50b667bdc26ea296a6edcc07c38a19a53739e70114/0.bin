\documentclass[11pt,a4paper]{article}
\usepackage[margin=25mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\setlength{\emergencystretch}{2em}
\newtheorem{lemma}{Lemma}
\newtheorem{theorem}[lemma]{Theorem}
\title{A dense graph determined by its squares}
\author{Human Compression project}
\date{}
\begin{document}\maketitle
An edge-girth-regular graph of parameters $(n,k,4,\lambda)$ is a
simple graph with $n$ vertices, degree $k$ at every vertex, no triangles,
and exactly $\lambda>0$ squares through every edge. We prove the
following entry of Table~4 in Goedgebeur and Jooken's fixed manuscript
\cite{GJ}. The lower bound sixteen and the positive example have already
been checked separately. The present claim concerns uniqueness at that
order; it uses no graph census.

\begin{theorem}\label{main}
There is exactly one graph of parameters $(16,6,4,17)$, up to
isomorphism. It is obtained from $K_{8,8}$ by removing four disjoint
copies of $K_{2,2}$, which together contain all sixteen vertices.
\end{theorem}

\begin{lemma}\label{odd}
If a triangle-free graph with $n$ vertices is $k$-regular and contains
an odd cycle, the length $\ell$ of its shortest odd cycle satisfies
$k\ell\le 2n$.
\end{lemma}
\begin{proof}
A shortest odd cycle $C$ is induced: a chord would give a shorter odd
cycle. A vertex outside $C$ has at most two neighbours on $C$. Indeed,
if it had at least three, the cyclic gaps between consecutive neighbours
would all be at least two, by triangle-freeness. Their odd total implies
an odd gap $d$, and the other gaps sum to at least four. The path along
this gap, together with the outside vertex, would give an odd cycle of
length $d+2\le\ell-2$. This is impossible. Vertices on $C$ have exactly
two neighbours on $C$. Counting all incidences with $C$ now gives
$k\ell\le2n$.
\end{proof}

\begin{lemma}\label{bipartite}
Every graph of parameters $(16,6,4,17)$ is bipartite.
\end{lemma}
\begin{proof}
Suppose otherwise. Lemma~\ref{odd} gives a shortest odd cycle of length
five, since $6\ell\le32$. Write its vertices as
$v_0,v_1,\ldots,v_4$, with indices read modulo five. Every vertex has
at most two neighbours on this cycle, and a pair of such neighbours
is nonconsecutive. Partition the whole vertex set into the sets
\[
 A_i=\{x:N(x)\cap V(C)=\{v_{i-1},v_{i+1}\}\},\qquad
 B_i=\{x:N(x)\cap V(C)=\{v_i\}\},
\]
and $Z$, the set of vertices having no cycle neighbour. Put
$a_i=|A_i|$, $b_i=|B_i|$, and $z=|Z|$. Notice that $v_i\in A_i$.
The degrees of the five cycle vertices and the total order give
\begin{equation}\label{sizes}
 a_{i-1}+a_{i+1}+b_i=6,\qquad
 \sum_i(a_i+b_i)+z=16,\qquad \sum_i b_i+2z=2.
\end{equation}
Up to a rotation and reversal of the cycle, the solutions are the four
rows in the table below. To obtain them, either $z=1$ and all $b_i=0$,
or $z=0$ and the two units in $b$ occupy one position, consecutive
positions, or nonconsecutive positions. Substitution in the five linear
equations determines $a$ uniquely.

For completeness we bound the number of squares on $v_i v_{i+1}$
using just these classes. Its two opposite neighbourhoods are
\[
 A_{i-1}\cup(A_{i+1}\setminus\{v_{i+1}\})\cup B_i,
 \quad
 (A_i\setminus\{v_i\})\cup A_{i+2}\cup B_{i+1}.
\]
Each square corresponds to one edge between these disjoint sets.
Two vertices sharing a cycle neighbour cannot be adjacent. Thus edges
between $A$ classes can occur only between consecutive classes; these
give at most
$(a_i-1)(a_{i-1}+a_{i+1}-1)+(a_{i+1}-1)a_{i+2}$ edges.
A vertex in $B_i$ may meet the displayed $A_i$ class and the noncycle
vertices in $A_{i+2}$, giving at most $a_i+a_{i+2}-2$ edges.
Likewise $B_{i+1}$ contributes at most $a_{i-1}+a_{i+1}-2$ per vertex.
Finally there are at most $b_i b_{i+1}$ edges between the two $B$
classes. Consequently an upper bound is
\begin{align*}
 U_i={}&(a_i-1)(a_{i-1}+a_{i+1}-1)+(a_{i+1}-1)a_{i+2}\\
 &+b_i(a_i+a_{i+2}-2)+b_{i+1}(a_{i-1}+a_{i+1}-2)+b_i b_{i+1}.
\end{align*}
No vertex of $Z$ belongs to these neighbourhoods. The bound permits
extra edges that other conditions might forbid, so it is an upper bound
without any assumption that the classes are completely joined.
\[
\begin{array}{c|c|c|c}
z&(b_0,b_1,b_2,b_3,b_4)&(a_0,a_1,a_2,a_3,a_4)&U_0\\\hline
1&(0,0,0,0,0)&(3,3,3,3,3)&16\\
0&(2,0,0,0,0)&(2,2,4,4,2)&15\\
0&(1,1,0,0,0)&(2,2,3,4,3)&14\\
0&(1,0,1,0,0)&(3,2,3,3,3)&15
\end{array}
\]
In every case the edge $v_0v_1$ is in fewer than seventeen squares,
a contradiction.
\end{proof}

\begin{proof}[Proof of Theorem~\ref{main}]
Take a bipartition $P,Q$ of the graph $G$. Regularity gives
$6|P|=6|Q|$, hence $|P|=|Q|=8$. Let $H$ be the complement of $G$
inside $K_{P,Q}$. It is a simple bipartite graph of degree two, so its
components are even cycles of length at least four.

Fix an edge $xy$ of $G$, with $x\in P$. For distinct $x,t\in P$, write
$\mu(x,t)=|N_H(x)\cap N_H(t)|$. The common neighbourhood in $G$ has
size $4+\mu(x,t)$, and
\[
             \sum_{t\in P\setminus\{x\}}\mu(x,t)=2.
\]
The latter identity counts the two paths in $H$ which start at $x$,
have length two and do not immediately return. Counting squares on
$xy$ by their other vertex in $P$ gives
\begin{align*}
 \lambda
 &=\sum_{t\in N_G(y)\setminus\{x\}}(3+\mu(x,t))\\
 &=17-\sum_{t\in N_H(y)}\mu(x,t).
\end{align*}
The value seventeen therefore forces the last sum to vanish whenever
$xy$ is absent from $H$. If a component of $H$ were a cycle of length
at least six, take three consecutive edges $x b t y$ in that cycle.
Their endpoints are not adjacent in $H$, but $t\in N_H(y)$ and
$\mu(x,t)\ge1$. This is a contradiction. Thus every component of $H$
is a four-cycle, proving uniqueness.

Conversely, remove four disjoint copies of $K_{2,2}$ from $K_{8,8}$.
The resulting graph is bipartite and has degree six. Any two vertices
in the same part have at least four common neighbours, so it is
connected. For an edge $xy$ of this graph, the vertices $x,y$ belong
to different removed components. Every $t\in N_H(y)$ then satisfies
$\mu(x,t)=0$, so the displayed formula gives seventeen squares on
every edge. This proves existence and girth four.
\end{proof}

\paragraph{Certificates and attribution.}
The accompanying program checks the explicit graph, counts its squares
in two ways, and verifies a literal isomorphism to line 52 of the
acquired source data. It also enumerates the elementary integer
solutions in~\eqref{sizes} and checks the square upper bound directly
on the allowed class pairs. These checks supplement the written proof;
they do not replace a missing classification search.

The numerical result is attributed to \cite{GJ}, Table~4, physical
page~20. Its lower bound is there attributed to reference~[8,
Theorem~2.3]. The present derivation combines the shortest-odd-cycle
incidence count, the explicit class calculation, and the degree-two
bipartite complement. We make no claim of historical priority for
these elementary arguments or the graph. No new open problem,
formalization or compression measurement is claimed.
