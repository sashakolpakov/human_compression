#include "vertex_ball.h"
int main(int argc,char**argv){try{
 need(argc==5,"usage EXTERIORS REPORT SECONDS LAMBDA");int lambda=stoi(argv[4]);need(lambda>=2&&lambda<=4,"lambda two to four");Deadline d(stod(argv[3]));ofstream output(argv[1]);need(bool(output),"exterior output");output<<1<<'\n';ofstream report(argv[2]);report<<"{\"status\":\"PASS_COMPLETE_PARAMETERIZED_PENTAGON_EXTERIORS\",\"orders\":[";
 for(int t=8;t<=8;t++){
  int required=2*lambda-2;vector<pair<int,int>>es;for(int i=0;i<t;i++)for(int j=i+1;j<t;j++)es.emplace_back(i,j);Graph g(t);Cover cover(false);U combinations=0,eligible=0,nodes=0;
  function<void(int,int)>visit=[&](int start,int left){if((++nodes&4095)==0)d.check();if(!left){combinations++;if(!girth5(g))return;for(U row:g)if(wt(row)>4)return;eligible++;cover.take(g);return;}for(int i=start;i+left<=(int)es.size();i++){auto[u,v]=es[i];add(g,u,v);visit(i+1,left-1);remove_edge(g,u,v);}};visit(0,required);need(g==Graph(t),"exterior restoration");
  output<<t<<' '<<cover.graphs.size()<<'\n';for(auto&h:cover.graphs){for(U row:h)output<<row<<' ';output<<'\n';}
  if(t>8)report<<',';report<<"{\"t\":"<<t<<",\"edges\":"<<required<<",\"literal_subsets\":"<<combinations<<",\"eligible\":"<<eligible<<",\"literal_maps\":"<<cover.verified<<",\"classes\":"<<cover.graphs.size()<<'}';cout<<"EXTERIOR "<<t<<" CLASSES "<<cover.graphs.size()<<'\n';
 }
 report<<"]}\n";need(bool(output)&&bool(report),"complete outputs");return 0;
 }catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
