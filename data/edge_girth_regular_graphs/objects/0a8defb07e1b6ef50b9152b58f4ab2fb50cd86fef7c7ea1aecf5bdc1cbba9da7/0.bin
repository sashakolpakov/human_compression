\documentclass[11pt]{article}
\usepackage[margin=25mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\newtheorem{theorem}{Theorem}\newtheorem{lemma}[theorem]{Lemma}
\title{Two pentagons through every edge of a pentavalent graph}
\author{A component of the fixed F012 recovery}\date{}
\begin{document}\maketitle
\begin{abstract}
We prove that a simple $5$-regular graph of girth $5$ with exactly two
pentagons through every edge has at least $44$ vertices. This recovers
the lower bound in the fixed source's Table~3. The argument uses saturation
of the pentagon count at a branch of a Moore ball and one elementary
inequality at a cross edge. No graph enumeration is a premise.
\end{abstract}

Fix a vertex $v$. Its radius-two ball consists of $v$, its five neighbours
$p_1,\ldots,p_5$, and disjoint sets $L_1,\ldots,L_5$ of four leaves each,
where $L_i=N(p_i)\setminus\{v\}$. Girth $5$ ensures that these $26$
vertices are distinct. The only additional edges inside the ball join
leaves in different sets $L_i$. Let $C$ be the graph of these cross edges,
on the twenty leaves, and let $Y$ be the complement of the ball.

Cross edges incident with $L_i$ correspond bijectively to pentagons
through $vp_i$. Hence there are exactly two such incidences for each
$i$, and $C$ has five edges and maximum degree two. A leaf $x$ of
$C$-degree $a$ has exactly $4-a$ neighbours in $Y$. In particular,
the four leaves in any fixed $L_i$ have altogether $16-2=14$ incidences
with $Y$. No vertex of $Y$ can meet two leaves of $L_i$, since that would
give a quadrilateral through $p_i$. Thus precisely fourteen vertices of
$Y$ meet $L_i$.

\begin{lemma}\label{saturation}
If $x\in L_i$ has degree two in $C$ and $w$ is a neighbour of $x$ in
$C$, then no neighbour of $w$ in $Y$ meets $L_i$.
\end{lemma}
\begin{proof}
The edge $p_ix$ already lies in two pentagons, one obtained from each
cross edge at $x$ by returning through $v$. Let $y\in Y$ be adjacent to
$w$. If $y$ also meets $x$, there is a triangle. If it meets another leaf
$z\in L_i$, then
\[
 p_i,x,w,y,z,p_i
\]
is a third pentagon through $p_ix$, distinct from the first two because
it contains $y$. Both alternatives are impossible.
\end{proof}

\begin{theorem}
A simple $5$-regular graph of girth $5$ in which every edge belongs to
exactly two pentagons has at least $44$ vertices.
\end{theorem}
\begin{proof}
Write $t=|Y|$. We prove $t\ge17$, separating the possible components of
the graph $C$, whose maximum degree is two.

Suppose first that $C$ has a path component with at least two edges.
Its endpoint $w$ has degree one and is adjacent to a vertex $x$ of
degree two. If $x\in L_i$, the three neighbours of $w$ in $Y$ are
disjoint from the fourteen vertices meeting $L_i$, by
Lemma~\ref{saturation}. Consequently $t\ge17$.

If $C$ has a cycle component, choose a vertex $x\in L_i$ on it and let
$w,z$ be its two neighbours. Each of $w,z$ has two neighbours in $Y$.
These four vertices are distinct: a common neighbour would give the
quadrilateral $x,w,y,z,x$. None meets $L_i$, again by
Lemma~\ref{saturation}, so $t\ge14+4=18$.

It remains that every nontrivial component of $C$ is a single edge.
Choose such an edge $ab$, with $a\in L_i$ and $b\in L_j$. Each of
$a,b$ has three neighbours in $Y$. For $y\in Y$, let $m_i(y),m_j(y)$
indicate whether it meets $L_i,L_j$, and let $e_a(y),e_b(y)$ indicate
adjacency to $a,b$. These are all zero or one. Adjacency to both $a,b$
would give a triangle, so
\[
 m_i(y)+m_j(y)+e_a(y)+e_b(y)\le3.
\]
If the sum is three, then $y$ is adjacent to one endpoint of $ab$ and
to a different leaf in the other endpoint's branch. It therefore gives
a pentagon through $ab$; for example, if $y$ meets $a$ and
$d\in L_j\setminus\{b\}$, this pentagon is
$a,b,p_j,d,y,a$. Different vertices $y$ give different pentagons.
The edge $ab$ already belongs to $a,b,p_j,v,p_i,a$, so at most one
vertex $y$ can have the indicated sum equal to three. Summing over $Y$
now gives
\[
 14+14+3+3\le2t+1.
\]
Thus $t\ge17$ in the remaining case as well. The whole graph has at
least $26+17=43$ vertices. Its order is even, because its degree is odd,
and the claimed lower bound follows.
\end{proof}

\paragraph{Attribution and verification.}
Goedgebeur--Jooken, \emph{Exhaustive generation of edge-girth-regular
graphs}, arXiv:2401.08271v2, 25 June 2024, Table~3 on physical page~19,
states the lower bound $44$ for $(5,5,2)$. We recover that bound; the
source's separate upper bound is not a premise. The Moore ball and
cycle-incidence counts are classical. The branch-saturation proof and
the displayed summation are the author's derivation here, without a
priority claim. A small linear-programming diagnostic suggested the
last inequality; neither its solver nor its output is used in the proof.

The supplementary checker constructs all thirty-nine labelled root
models obtained from a five-cycle, or a triangle and a doubled edge,
on the five branch labels. It checks the saturation and summation
statements on every possible attachment of one exterior vertex to
those models, and compares selected cases with direct cycle counting.
These are finite controls for the written argument, not a complete
graph census. Only one prior lower-bound clause is recovered; no exact
count, whole-original, open-question, Lean or complexity credit is claimed.
\end{document}
