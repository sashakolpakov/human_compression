\documentclass[11pt,a4paper]{article}
\usepackage[margin=25mm]{geometry}\usepackage{amsmath,amssymb,amsthm}
\newtheorem{lemma}{Lemma}
\title{Integer third-layer counts}\author{Human Compression project}\date{}
\begin{document}\maketitle
We use the complete moment proof in \emph{Equality in the count of third
neighbours}. For a graph with parameters $(n,k,6,\lambda)$, a root has
$1+k^2$ vertices in its ball of radius two. Write $t=n-1-k^2$ and
$S=k(k-1)^2$. If $c_x$ counts the neighbours of an outside vertex in
the second layer, the acquired identities are
\[
                  \sum_x c_x=S,\qquad \sum_x c_x^2=S+k\lambda.
\]
The integers $c_x$ may be zero; no diameter assumption is made.

\begin{lemma}
For every positive integer $j$,
\[
 n\ge 1+k^2+
 \left\lceil\frac{2jS-k\lambda}{j(j+1)}\right\rceil.
\]
In particular, for a quartic graph of girth six,
$n\ge53-2\lambda$ and $3\mid n\lambda$.
\end{lemma}
\begin{proof}
For any integer $c$, the consecutive integers $c-j,c-j-1$ have
nonnegative product. Summing this inequality over the $t$ outside
vertices gives
\[
 0\le \sum_x(c_x-j)(c_x-j-1)
   = k\lambda-2jS+j(j+1)t.
\]
The stated bound follows because $t$ is an integer. Taking $k=4$,
$S=36$ and $j=1$ gives $n\ge17+36-2\lambda$.
Finally, the $2n$ edges each belong to $\lambda$ six-cycles,
while every such cycle uses six edges. Their number is $n\lambda/3$,
which is an integer.
\end{proof}

The seven entries below follow immediately. In the last row, increase
$53-2\lambda$ to the least integer satisfying $3\mid n\lambda$.
\[
\begin{array}{c|rrrrrrr}
 \lambda&2&3&4&5&6&7&8\\\hline
 \text{lower bound recorded in Table 2}&51&45&45&42&40&39&39\\
 53-2\lambda&49&47&45&43&41&39&37\\
 \text{bound proved here}&51&47&45&45&41&39&39
\end{array}
\]
Thus one acquired moment identity and one integer inequality recover
all seven recorded lower bounds. Three are strengthened relative to
the cited table. These are lower bounds only; no existence at the
displayed orders is asserted.

\paragraph{Attribution and scope.}
The comparison is with Goedgebeur and Jooken, \emph{Exhaustive generation
of edge-girth-regular graphs}, arXiv:2401.08271v2, Table 2, physical
page 18. Their earlier literature column cites Drglin, Filipovski,
Jajcay and Raiman, Theorem 2.3. The present component retains the
complete acquired moment proof and applies the elementary nonnegativity
of a product of consecutive integers. It makes no priority claim for
the inequality or the strengthened values; a later literature audit
would be needed for that. Source examples check the moment identities
and arithmetic, and are not premises for the universal bounds.
There is no new catalogue title, whole-original, conjecture, Lean or
measured compression credit.
\end{document}
