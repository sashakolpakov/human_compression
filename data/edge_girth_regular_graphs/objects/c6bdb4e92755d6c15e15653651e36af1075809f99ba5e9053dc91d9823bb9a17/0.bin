\setlength{\emergencystretch}{2em}
\newtheorem{theorem}{Theorem}\newtheorem{lemma}[theorem]{Lemma}
\title{Square counts in graphs of degree five}
\author{Human Compression project}\date{}
\begin{document}\maketitle
We recover the two lower bounds $n(5,4,6)\ge20$ and
$n(5,4,8)\ge20$ in Table~3 of Goedgebeur and Jooken~\cite{GJ}.
Here $n(k,4,\lambda)$ denotes the least order of a simple graph of
degree $k$, girth four, with exactly $\lambda$ squares through every
edge. The proof reuses the prescribed-cycle completion theorem and
common-neighbour moment bound from~\cite{moments}. Two elementary
reductions isolate its remaining alternatives. A separate finite
argument handles the bipartite incidence matrices.

\begin{lemma}\label{seven}
A nonbipartite triangle-free graph of degree five on at most eighteen
vertices contains a five-cycle.
\end{lemma}
\begin{proof}
Let $C$ be a shortest odd cycle, of length $\ell$. The acquired
shortest-cycle argument~\cite{cycles} gives $5\ell\le2n$:
every vertex has at most two neighbours on $C$. If there is no
five-cycle, then $\ell=7$ and $n\ge18$, since $n$ is even.
Thus $n=18$, and the total number of incidences with $C$ is $35$.
Exactly one vertex, say $w$, has one neighbour on $C$; every other
vertex has two. Two cycle neighbours must be at distance two on
$C$, since distance one gives a triangle and distance three gives
a five-cycle along the three-edge arc. Number the cycle modulo seven
so that the sole cycle neighbour of $w$ is $v_0$, and put
\[
 A_i=\{x:N(x)\cap V(C)=\{v_{i-1},v_{i+1}\}\},\qquad a_i=|A_i|.
\]
The cycle vertex $v_i$ belongs to $A_i$. Its degree gives
$a_{i-1}+a_{i+1}+\mathbf1_{i=0}=5$. Solving these seven linear
equations yields
\[
             (a_0,\ldots,a_6)=(3,2,2,3,3,2,2).
\]

Each $A_i$ is independent, and there is no edge between $A_i$ and
$A_{i+2}$, since its endpoints have a common cycle neighbour.
An edge between $A_i$ and $A_{i+3}$ would give the five-cycle
\[
 x,v_{i-1},v_{i-2},v_{i-3},y,x,
 \qquad x\in A_i,\ y\in A_{i+3}.
\]
Here $v_{i-3}$ is a cycle neighbour of $y$, with indices modulo seven,
and all five vertices are distinct. Reversing indices covers distance
four. Consequently edges between these classes join consecutive classes
only.

The vertex $w$ cannot meet $A_1$ or $A_6$, because of its neighbour
$v_0$. It cannot meet $A_3$ or $A_4$: such an edge, together with
$wv_0$ and the two-edge cycle path from $v_0$ to $v_2$ or $v_5$,
would give a five-cycle. Thus its possible neighbours lie in
$A_0\cup A_2\cup A_5$.

Every vertex of $A_1$ must meet all five vertices of $A_0\cup A_2$,
and every vertex of $A_3$ must meet all five of $A_2\cup A_4$.
Hence the vertices of $A_2$ already have their five neighbours in
$A_1\cup A_3$ and cannot meet $w$. The identical argument using
$A_4,A_6$ excludes neighbours of $w$ in $A_5$.
Only $A_0$ remains, but $|A_0|=3<5$, a contradiction.
\end{proof}

\begin{lemma}\label{bipmoment}
A bipartite graph of degree five on at most eighteen vertices cannot
have six squares through every edge. If it has eight squares through
every edge, its order is at least sixteen.
\end{lemma}
\begin{proof}
Regularity gives two parts of equal size $m$. Fix a vertex $x$, and
for every other vertex $y$ in its part put $c_y=|N(x)\cap N(y)|$.
Counting two-step walks and squares gives
\[
                \sum c_y=20,\qquad \sum c_y(c_y-1)=5\lambda.
\]
For a prescribed sum, the factorial moment of nonnegative integers
is smallest when they differ by at most one: replacing $a,b$ with
$a-1,b+1$ when $a\ge b+2$ strictly decreases it.
If $m\le9$, pad the list to eight entries with zeros. Its minimum
moment is $4(2\cdot1)+4(3\cdot2)=32>30$, excluding $\lambda=6$.
If $m\le7$, use six entries; their minimum is
$4(3\cdot2)+2(4\cdot3)=48>40$, excluding $\lambda=8$.
\end{proof}

\begin{lemma}\label{finite}
There is no graph of degree five with square count six or eight,
containing a five-cycle, on fourteen, sixteen or eighteen vertices.
There is no bipartite graph of degree five with square count eight
on sixteen or eighteen vertices.
\end{lemma}
\begin{proof}
We describe both complete finite reductions and their certificates.
For the first, acquire the prescribed-five-cycle partition and
completion theorem~\cite{cycles,moments}. Relative to the cycle,
$a_i,b_i,z$ count vertices with cycle neighbours $v_{i-1},v_{i+1}$,
with sole cycle neighbour $v_i$, or with none; $v_i$ itself belongs
to the first class. At degree five the size equations are
\[
 a_{i-1}+a_{i+1}+b_i=5,\quad \sum_i b_i+2z=2n-25,
 \quad a_i\ge1,\ b_i,z\ge0.
\]
Every solution is enumerated by the nonnegative $z$ and weak
compositions of $2n-25-2z$. Writing $c_i=5-b_i$, its unique possible
$a$ is given by the acquired linear formula
\[
 2a_0=c_0+c_1-c_2-c_3+c_4,\quad
 a_2=c_1-a_0,\ a_3=c_4-a_0,\ a_1=c_2-a_3,\ a_4=c_0-a_1.
\]
Nonpositive entries are discarded. A separate enumeration of
$a\in\{1,\ldots,5\}^5$ checks the entire labelled inventory.
Rotations and reflections reduce the size patterns, with no assumed
automorphism of a completed graph.

The acquired completion recursion is unchanged except for its degree
constant and the corresponding moment identities. At a closed vertex,
the possible common-neighbour counts have sum $5\cdot4=20$ and
factorial moment $5\lambda$. The same interval proof and convex
minimization apply, now with increment levels zero through four.
The degree deficits, exact leaf tests and target moment use degree five.
The active-cell symmetry, prescribed edges, closed-edge square intervals
and completeness induction are acquired without alteration. Both builds
complete the following inventories with zero outputs for targets six
and eight:
\begin{center}
\begin{tabular}{r|r|r|r}
Order&Labelled patterns&Dihedral representatives&Search nodes\\\hline
14&40&6&72\\
16&141&20&11\,078\\
18&191&28&314\,525
\end{tabular}
\end{center}
The attached records give every case, its input and its complete output.

For the bipartite alternative write the incidence matrix as $m$ rows
of length $m$, each of weight five. After selecting $r$ complete rows,
let $d_j$ be the present sum in column $j$. The next row is any
five-element set of columns with $d_j<5$. Columns with identical
selected entries form cells. Their permutations fix every selected
row, so it suffices to choose the first $t$ columns of each cell for
every possible collection of occupancies with total five. Any
completion can be transported by such a permutation to one of these
choices, including all of its later rows. Induction on $r$ proves
that every incidence matrix is represented. This symmetry does not
assert that the outputs count labelled matrices or isomorphism classes.

Reject a state if $d_j>5$ or $d_j+m-r<5$. For an already selected
edge $(i,j)$, its squares whose other row has been selected number
\[
 L_{ij}=\sum_{\substack{h<r,\ h\ne i\\j\in R_h}}
                   (|R_i\cap R_h|-1),
\]
where $R_i$ is row $i$'s support. Squares using a future row can
contribute at most
\[
 U_{ij}=\sum_{t\in R_i\setminus\{j\}}\min(5-d_j,5-d_t).
\]
Indeed each such row must use both columns $j,t$, and each use consumes
one of their respective remaining incidences. Thus
$L_{ij}\le\lambda\le L_{ij}+U_{ij}$ is necessary. Overcounting
incompatible future rows only weakens this rejection.
When all rows have been selected, column degrees are five and $U_{ij}=0$;
the test then checks the exact square count on every edge.
The complete results, identical in ordinary and sanitized builds, are
\begin{center}
\begin{tabular}{r|r|r|r}
Part size&Square count&Search nodes&Outputs\\\hline
8&8&304\,337&0\\
9&8&9\,970\,414&0
\end{tabular}
\end{center}
These exhaustive recursions and their completed records establish both
finite exclusions. A timeout is reported separately and cannot be used
as a zero output.
\end{proof}

\begin{theorem}
\[n(5,4,6)\ge20,\qquad n(5,4,8)\ge20.\]
\end{theorem}
\begin{proof}
The acquired edge-neighbourhood bound gives
$n\ge10+\lceil2(16-\lambda)/5\rceil$, hence $n\ge14$ for both
values. Degree five requires even order. Below twenty, therefore,
only fourteen, sixteen and eighteen remain. If a candidate is
nonbipartite, Lemma~\ref{seven} forces a five-cycle and
Lemma~\ref{finite} excludes it. The bipartite possibilities are
excluded by Lemmas~\ref{bipmoment} and~\ref{finite}.
\end{proof}

\paragraph{Verification and attribution.}
The two numerical bounds are prior results in Table~3 of~\cite{GJ},
physical page~19. The shortest-cycle incidence bound, cycle partition,
completion recursion and convex moment argument are acquired from
reviewed components. The seven-cycle contradiction and bipartite
incidence recursion supply the additional reductions here; no general
historical priority claim is made. The checker compares the two complete
cycle inventories, checks the exact implementation changes, replays all
finite exclusions in ordinary and sanitized builds, and includes positive
controls. Those controls test implementations; the written induction and
necessary bounds establish mathematical completeness. This component
claims two lower-bound rows only, with no exact-count, whole-original,
open-conjecture, Lean or compression-measurement credit.
