#define main target_program_main
#include "complete.cpp"
#undef main
int main(int argc,char**argv){try{need(argc==2,"EXTERIORS");ifstream in(argv[1]);int orders;need(bool(in>>orders)&&orders==4,"four orders");Graph r=ball();Deadline d(30);Cover c(false);cout<<"[";bool comma=false;for(int z=0;z<orders;z++){int t,k;need(bool(in>>t>>k),"header");for(int j=0;j<k;j++){Graph h(t);for(U&x:h)need(bool(in>>x),"row");Exterior e(h);Boundary b(r,e,d,c);if(comma)cout<<',';comma=true;cout<<"{\"t\":"<<t<<",\"model\":"<<j<<",\"states\":[";int n=1;for(int i=0;i<t;i++)n*=3;for(int code=0;code<n;code++){int x=code;for(int i=0;i<t;i++){b.masks[i]=x%3;x/=3;b.done[i]=false;}U flags=b.canonical()?1:0;for(int at=0;at<t;at++){b.done[e.order[at]]=true;if(b.canonical())flags|=U(1)<<(at+1);}if(code)cout<<',';cout<<flags;}cout<<"]}";}}cout<<"]\n";return 0;}catch(const exception&e){cerr<<e.what()<<'\n';return 1;}}
