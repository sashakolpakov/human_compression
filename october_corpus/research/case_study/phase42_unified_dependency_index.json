  "retained_inventory": [
    {
      "id": "B97",
      "statement": "Inductively minimal rank-r pairs are thin and residually connected, with group S_(r+1); their connected diagrams have no induced cycles longer than three, every edge in exactly one maximal clique, and every vertex in one or two maximal cliques; conversely each permitted connected diagram determines one pair up to isomorphism.",
      "reference": "Buekenhout-Cara-Dehon 1997, Mostly Finite Geometries, pp185-190, as restated in N001 Lemma1 and following paragraph",
      "direct_original_read": false,
      "restatement_binding": {
        "start_codepoint": 15818,
        "end_codepoint_exclusive": 16573,
        "sha256_utf8": "97b2ef364b8b30d5108920abec0e6da3475454c796a09b8907281556d2e3b535",
        "displayed_lines": [
          193,
          194
        ],
        "role": "retained_1997_classification_restatement"
      },
      "used_only_for": [
        "A1",
        "A2",
        "A3",
        "A4"
      ],
      "not_targeted": "The 1997 classification itself is outside this intake."
    },
    {
      "id": "W1",
      "statement": "Every independent family in S_m has size <=m-1; every independent family of size m-1 generates S_m.",
      "reference": "Whiston 2000, Journal of Algebra232,255-268; source recital N003 p3",
      "direct_original_read": false,
      "read_limit": "N003 recital read; original Whiston proof not independently read in this assembly.",
      "normalization": "N003 recital says equality iff generation; only the required extremal-size => generation direction is retained, not a false assertion that all minimal generating sets have maximal size."
    },
    {
      "id": "W2",
      "statement": "For n>=7 an omission subgroup of an independent (n-1)-element generating family in S_n is intransitive, transitive imprimitive with two-point blocks, or A_n.",
      "reference": "N003 p4 consequence explicitly attributed to Whiston [8]",
      "direct_original_read": false,
      "cfsg_dependency_retained": true,
      "not_inferred_from": "W1"
    },
    {
      "id": "Cayley",
      "statement": "The number of trees on a specified labelled m-point set is m^(m-2).",
      "reference": "Classical formula, also invoked in N003 Corollary2.2",
      "unexpanded": true
    },
    {
      "id": "Coset",
      "statement": "The source (G1)-(G3) criterion and residue/coset correspondence; RWPRI equivalence to (G4). All conditions are restated in manuscript section1.",
      "reference": "N003 author manuscript pp7-8; Buekenhout1995, Buekenhout-Hermand1991, Tits1974 as cited there.",
      "direct_original_read": false,
      "read_limit": "The exact criterion in N003 has been read; the earlier reference books/articles were not independently acquired for this assembly."
    },
    {
      "id": "AutSn",
      "statement": "Every automorphism of S_n is inner for n>=7.",
      "reference": "Classical symmetric-group automorphism fact, used only if group-geometry isomorphisms allow automorphisms of the specified action.",
      "unexpanded": true,
      "alternative": "The source conjugate-coset-data convention avoids this additional isomorphism convention."
    },
    {
      "id": "Elementary",
      "statement": "Elementary finite group and permutation theory, vector spaces over F2, sign, finite maxima, primitive action iff maximal point stabilizer; all nontrivial forest, parity, module and overgroup arguments are expanded in manuscript.",
      "unexpanded": true
    },
    {
      "id": "PΦ",
      "statement": "For finite p-groups P, P/Phi(P) is an elementary abelian p-group.",
      "reference": "N008 p174 recalled finite-p-group fact",
      "role": "retained_unexpanded_input_for_C8_C9",
      "direct_original_read": false
    },
    {
      "id": "Zorn",
      "statement": "Every nonempty partially ordered set whose chains have upper bounds has a maximal element.",
      "role": "retained_set_theoretic_input_for_explicitly_infinite_maximal_overgroup_arguments",
      "finite_branch": "For finite groups the proof explicitly selects a proper overgroup of largest order and does not need Zorn."
    },
    {
      "id": "Gaschütz1953",
      "statement": "A finite Frattini-free F with socle S=A times D (abelian and nonabelian simple factors respectively) has F=A semidirect K, K<=Aut(S)=Aut(A) times Aut(D), D=Inn(S)<=K, and K acts semisimply on A; the intersection of maximal K-invariant subgroups of A is trivial.",
      "reference": "N008 Theorem 4.1 p175, quoting Gaschütz, Math.Z.58(1953),160-170",
      "role": "explicit_source_quoted_background_not_rederived_not_used_by_C1_C11",
