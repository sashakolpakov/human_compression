# Exact finite diagnostic for the all-parameter written proof.
# Stock GAP algorithms are retained; these samples do not prove the theorem.
SetInfoLevel(InfoWarning,0);;
Ffree:=FreeGroup("a","b","c");;a:=Ffree.1;;b:=Ffree.2;;c:=Ffree.3;;
mix:=function(A,B)
 local d,e1,e2,s;
 d:=DirectProduct(A.g,B.g);e1:=Embedding(d,1);e2:=Embedding(d,2);
 s:=List([1..3],i->Image(e1,A.s[i])*Image(e2,B.s[i]));
 return rec(g:=Group(s),s:=s);
end;;
extension:=function(f,s)
 local mu,ag,t,e0,e1,ts,iso;
 mu:=GroupHomomorphismByImages(f,f,s,[s[1]^-1,s[1]^2*s[2]]);
 if mu=fail or not IsBijective(mu) then Error("mirror failed");fi;
 ag:=Group([mu]);if not IsGroupOfAutomorphisms(ag) then Error("not autos");fi;
 t:=SemidirectProduct(ag,f);e0:=Embedding(t,1);e1:=Embedding(t,2);
 ts:=[Image(e1,s[1]),Image(e1,s[2])];
 Add(ts,Image(e0,mu)*ts[1]*ts[2]);
 iso:=IsomorphismPermGroup(t);
 return rec(g:=Image(iso),s:=List(ts,x->Image(iso,x)));
end;;
check:=function(ok,label) if not ok then Print("FAIL ",label,"\n");QUIT_GAP(1);fi;end;;
run:=function(pn,alpha,k)
 local q,hh,d,rels,fp,iso,p,pm,r,f,v,t,td,qq,qqd,h,x,y,z,Y,W,mu,P0,pi0,g0,s0,mu0,kr,df,dp,rf,rv,ri,et,J,rt,tt,ert,eft,l,e1,e2,k1,k2,um,vv,act,asig,msig,A,B,C,zf,pf,qf,QF,QV,lv,allrels;
 q:=pn^alpha;hh:=pn^(alpha-1);d:=k*hh;
 rels:=Concatenation([a^(2*pn),b^q,c^(2*pn)],[(a*b)^2,(b*c)^2,(a*b*c)^2],[b*a^2*(a^2*b^(1+d))^-1,c^2*b*(b^(1+d)*c^2)^-1]);
 fp:=Ffree/rels;iso:=IsomorphismPermGroup(fp);
 check(IsBijective(iso),"bare presentation isomorphism");
 p:=rec(g:=Image(iso),s:=List(GeneratorsOfGroup(fp),x->Image(iso,x)));
 check(Size(p.g)=4*pn^2*q and List(p.s,Order)=[2*pn,q,2*pn],"source exact order and type");
 check(ForAll(rels,w->MappedWord(w,GeneratorsOfGroup(Ffree),p.s)=One(p.g)),"literal source relators");
 check(Intersection(Group(p.s{[1,2]}),Group(p.s{[2,3]}))=Group([p.s[2]]),"source end IP");
 check(Size(Intersection(Group([p.s[1]]),Group([p.s[2]])))=1 and Size(Intersection(Group([p.s[2]]),Group([p.s[3]])))=1,"source cyclic IP");
 dp:=GroupHomomorphismByImages(p.g,p.g,p.s,List(Reversed(p.s),x->x^-1));
 check(dp<>fail and IsBijective(dp),"source marked self-duality");
 x:=p.s[2]^hh;y:=p.s[3]^2;
 check(Order(x)=pn and x^p.s[1]=x^-1 and x^p.s[3]=x^-1,"normal chirality coordinate");
 check(y^p.s[2]=y*x^k and y^p.s[1]=y^-1*x^k and y^(p.s[1]^-1)=y^-1*x^-k,"source coordinate identities");
 pi0:=NaturalHomomorphismByNormalSubgroup(p.g,Group([x]));g0:=Image(pi0);s0:=List(p.s,g->Image(pi0,g));
 mu0:=GroupHomomorphismByImages(g0,g0,s0,[s0[1]^-1,s0[1]^2*s0[2],s0[3]]);
 check(mu0<>fail and IsBijective(mu0),"quotient mirror");
 pm:=rec(g:=p.g,s:=[p.s[1]^-1,p.s[1]^2*p.s[2],p.s[3]]);r:=mix(p,pm);
 A:=r.s[1];B:=r.s[2];C:=r.s[3];f:=Group([A,B]);v:=Group([B,C]);
 mu:=GroupHomomorphismByImages(r.g,r.g,r.s,[A^-1,A^2*B,C]);
 check(mu<>fail and IsBijective(mu),"R mirror");
 df:=GroupHomomorphismByImages(r.g,r.g,r.s,List(Reversed(r.s),x->x^-1));
 check(df<>fail and IsBijective(df),"R marked duality");
 check(Size(r.g)=4*pn^3*q and Size(f)=2*pn^2*q and Size(v)=Size(f),"R and ends orders");
 Y:=C^2;z:=Comm(Y,B);W:=Group([Y,z]);
 check(z=Comm(A^2,B)^-1 and Order(z)=pn,"literal Z word identity");
 check(IsAbelian(W) and Size(W)=pn^2 and Exponent(W)=pn,"W rank and exponent");
 check(Y^A=Y^-1*z and Y^B=Y*z and Y^C=Y,"Y action table");
 check(z^A=z^-1 and z^B=z and z^C=z^-1,"Z action table");
 check(Image(mu,Y)=Y and Image(mu,z)=z^-1,"W mirror");
 check(NormalClosure(r.g,Group([Y]))=W,"exact normal closure");
 check(Intersection(W,f)=Group([z]) and IsSubgroup(v,W),"W parabolics");
 check(Intersection(f,v)=Group([B,z]) and Size(Intersection(f,v))=pn*q,"R exact bad intersection");
 check(Size(Intersection(Group([B]),Group([z])))=1,"medial and Z independent");
 t:=extension(f,[A,B]);td:=rec(g:=t.g,s:=List(Reversed(t.s),x->x^-1));
 check(Size(t.g)=4*pn^2*q,"trivial extension order");
 et:=GroupHomomorphismByImages(f,t.g,[A,B],t.s{[1,2]});
 check(et<>fail and IsInjective(et),"facet embedding in extension");
 zf:=Image(et,z);J:=Group([zf]);
 check(IsNormal(t.g,J) and Size(J)=pn,"T normal J");
 check(zf^t.s[1]=zf^-1 and zf^t.s[2]=zf and zf^t.s[3]=zf,"J character");
 rt:=NaturalHomomorphismByNormalSubgroup(r.g,W);tt:=NaturalHomomorphismByNormalSubgroup(t.g,J);
 ert:=GroupHomomorphismByImages(Image(rt),Image(tt),List(r.s,g->Image(rt,g)),List(t.s,g->Image(tt,g)));
 check(ert<>fail and IsBijective(ert),"exact common quotient marked isomorphism");
 qq:=mix(r,t);qqd:=mix(r,td);h:=mix(qq,qqd);
 check(Size(qq.g)=4*pn^4*q and Size(qqd.g)=Size(qq.g) and Size(h.g)=4*pn^5*q,"cover and shared orders");
 dp:=GroupHomomorphismByImages(qq.g,qqd.g,qq.s,List(Reversed(qqd.s),x->x^-1));
 check(dp<>fail and IsBijective(dp),"covers literal duality");
 for qf in [qq,qqd,h] do
  pf:=GroupHomomorphismByImages(qf.g,r.g,qf.s,r.s);
  check(pf<>fail and IsSurjective(pf),"marked covering map");
  QF:=Group(qf.s{[1,2]});QV:=Group(qf.s{[2,3]});
  check(Intersection(QF,QV)=Group([qf.s[2]]),"cover end IP");
  check(Size(Intersection(Kernel(pf),QF))=1 and Size(Intersection(Kernel(pf),QV))=1,"cover end injectivity");
  um:=GroupHomomorphismByImages(qf.g,qf.g,qf.s,[qf.s[1]^-1,qf.s[1]^2*qf.s[2],qf.s[3]]);
  check(um<>fail and IsBijective(um),"cover mirror");
 od;
 pf:=GroupHomomorphismByImages(h.g,r.g,h.s,r.s);l:=Kernel(pf);
 e1:=GroupHomomorphismByImages(h.g,qq.g,h.s,qq.s);e2:=GroupHomomorphismByImages(h.g,qqd.g,h.s,qqd.s);
 k1:=Kernel(e1);k2:=Kernel(e2);
 check(IsAbelian(l) and Size(l)=pn^2 and Exponent(l)=pn,"L elementary abelian");
 check(Size(k1)=pn and Size(k2)=pn and Size(Intersection(k1,k2))=1,"distinct covering axes");
 um:=GroupHomomorphismByImages(h.g,h.g,h.s,[h.s[1]^-1,h.s[1]^2*h.s[2],h.s[3]]);
 act:=List([k1,k2],n->List(h.s,g->First([0..pn-1],j->GeneratorsOfGroup(n)[1]^g=GeneratorsOfGroup(n)[1]^j)));
 msig:=List([k1,k2],n->First([0..pn-1],j->Image(um,GeneratorsOfGroup(n)[1])=GeneratorsOfGroup(n)[1]^j));
 check(act=[[1,1,pn-1],[pn-1,1,1]] and msig=[1,pn-1],"complete axis action signs");
 Print("PARAM_PASS ",[pn,alpha,k]," orders ",List([p,r,t,qq,qqd,h],z->Size(z.g))," W=C",pn,"xC",pn," kernel=C",pn,"xC",pn,"\n");
end;;
for par in [[3,2,1],[3,2,2],[3,3,1],[3,3,2],[5,2,1],[5,2,2],[5,2,3],[5,2,4]] do
 run(par[1],par[2],par[3]);
od;
Print("PASS GAP ",GAPInfo.Version," eight exact finite diagnostics; all-parameter theorem is written\n");
QUIT_GAP(0);
