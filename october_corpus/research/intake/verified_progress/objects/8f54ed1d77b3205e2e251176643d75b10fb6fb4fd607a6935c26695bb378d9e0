def check():
    assert time.monotonic() - START < 120
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == 'darwin' else 1024)
    assert rss <= 256 * 2**20 and READ <= 16 * 2**20 and len(SEEN) <= 128

def desc(path, body):
    return dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())

def signature(st):
    return st.st_dev, st.st_ino, st.st_mode, st.st_size, st.st_mtime_ns, st.st_ctime_ns

def whole(path, expected=None):
    global READ
    check()
    path = Path(path)
    if str(path) in SEEN:
        body, ref, _ = SEEN[str(path)]
        assert expected is None or ref == expected
        return body, ref
    a = path.lstat()
    assert path.is_absolute() and path.resolve(strict=True) == path and path.is_file()
    assert a.st_size <= 4 * 2**20 and READ + a.st_size <= 16 * 2**20
    body = path.read_bytes()
    assert len(body) == a.st_size and signature(a) == signature(path.lstat())
    ref = desc(path, body)
    assert expected is None or ref == expected
    SEEN[str(path)] = body, ref, signature(a)
    READ += len(body)
    check()
    return body, ref

def document(path, expected=None):
    body, ref = whole(path, expected)
    return json.loads(body), ref

def write(name, value):
    body = (json.dumps(value, indent=2, sort_keys=True) + '\n').encode()
    assert len(body) <= 64 * 2**10
    path = HERE / name
    with path.open('xb') as f:
        assert f.write(body) == len(body)
        f.flush()
        os.fsync(f.fileno())
    assert path.read_bytes() == body
    return desc(path, body)

