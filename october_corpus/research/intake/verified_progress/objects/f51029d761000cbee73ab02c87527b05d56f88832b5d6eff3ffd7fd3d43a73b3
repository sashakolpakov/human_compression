def write(name, value):
    b = (json.dumps(value, indent=2, sort_keys=True) + '\n').encode()
    path = HERE / name
    with path.open('xb') as f:
        f.write(b)
    return dict(path=str(path), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

