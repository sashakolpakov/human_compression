pins = {}

def pin(path):
    p = Path(path)
    n = p.stat().st_size
    assert n <= 4 * 1024**2
    with p.open('rb') as f:
        b = f.read(n + 1)
    assert len(b) == n
    ref = dict(path=str(p), bytes=n, sha256=hashlib.sha256(b).hexdigest())
    pins[str(p)] = ref
    return b, ref

def get(ref):
    b, actual = pin(ref['path'])
    assert actual == ref
    return b

def doc(path):
    b, ref = pin(path)
    return json.loads(b), ref

def same(a, b):
    assert json.dumps(a, sort_keys=True) == json.dumps(b, sort_keys=True)

