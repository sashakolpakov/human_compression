"""UNRUN supplied words only; imported K properness is a separate Root premise.

No orbit, stabilizer, membership lookup, group order or search is performed.
The future operational entry must authenticate model/frame/unpaid/Root inputs.
Matrix primitives are the exact retained PS edition, loaded by that entry.
"""
import retained_math as M

class Work:
    def __init__(self,tick):self.tick,self.used,self.cases=tick,0,0
    def charge(self,n):
        M.need(type(n)is int and 0<=n and self.used+n<=200000,'bounded new word/scalar bank')
        self.tick();self.used+=n
    def begin_case(self):
        M.need(self.cases<8 and self.used+20000<=200000,'eight cases with20000 prospective reserve')
        self.tick();self.cases+=1

def word(labels,generators,budget,work,maximum=4096):
    M.need(type(labels)is list and len(labels)<=maximum
      and all(type(j)is int and 0<=j<len(generators)for j in labels),'bounded typed positive word')
    work.charge(len(labels));value=M.I7
    for label in labels:value=budget.multiply(value,generators[label])
    return value

def consume(marks,K_generators,ambient,fact,budget,work):
    """Verify C*g_i*C^-1=w_i(K), with C a supplied known-G positive word.

    marks and K_generators are already parsed actual 7x7 tuple matrices.
    Root separately owns K=<K_generators> as the same certified proper group.
    All four equalities are required; a failed check gives no disposition.
    """
    work.begin_case()
    M.need(type(marks)is tuple and len(marks)==4 and type(K_generators)is tuple and len(K_generators)==3
      and type(ambient)is tuple and len(ambient)==2,'four actual marks, three known-K generators, two known-G members')
    work.charge(49*(4+3+2+1))
    for matrix in marks+K_generators+ambient:
        M.need(type(matrix)is tuple and len(matrix)==7
          and all(type(row)is tuple and len(row)==7 for row in matrix)
          and all(type(x)is int and 0<=x<11 for row in matrix for x in row),'whole canonical actual matrices')
    M.need(type(fact)is dict and set(fact)=={'K_words','conjugator_word','conjugator_inverse'},'exact supplied word grammar')
    values=fact['K_words'];M.need(type(values)is list and len(values)==4,'one complete word per original mark')
    C=word(fact['conjugator_word'],ambient,budget,work,maximum=128)
    inverse=M.matrix(fact['conjugator_inverse'],7)
    M.need(budget.multiply(C,inverse)==budget.multiply(inverse,C)==M.I7,'whole supplied conjugator inverse')
    for mark,letters in zip(marks,values):
        value=word(letters,K_generators,budget,work)
        M.need(budget.multiply(budget.multiply(inverse,value),C)==mark,'full matrix equality for every actual mark')
    return dict(status='VERIFIED_FOUR_SUPPLIED_WORD_CONTAINMENTS',all_four_marks_in_conjugate_K=True,
      K_order_or_stabilizer_or_orbit_recomputed=False,membership_lookup_or_discovery_calls=0,
      properness_uses_separate_accepted_K_and_original_frame_premises=True,GEN_claim=False,IP_claim=False,paid_credit=0)
