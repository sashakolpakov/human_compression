def need(v,why):
    if not v: raise ValueError(why)

def dec(b):
    def pairs(rows):
        d={}
        for k,v in rows: need(k not in d,'duplicate key'); d[k]=v
        return d
    return json.loads(b,object_pairs_hook=pairs,parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))

def ws(b,i):
    while i<len(b) and b[i]in b' \n\r\t': i+=1
    return i

def string_end(b,i):
    need(b[i]==34,'JSON string'); i+=1
    while i<len(b):
        if b[i]==92: i+=2
        elif b[i]==34: return i+1
        else: i+=1
    raise ValueError('unterminated string')

def value_end(b,i):
    if b[i]==34: return string_end(b,i)
    if b[i]in b'[{':
        stack=[b[i]]; i+=1
        while stack:
            need(i<len(b) and len(stack)<4096,'bounded JSON nesting')
            if b[i]==34: i=string_end(b,i); continue
            if b[i]in b'[{': stack.append(b[i])
            elif b[i]in b']}': need((stack.pop(),b[i])in((91,93),(123,125)),'matched JSON')
            i+=1
        return i
    j=i
    while i<len(b) and b[i]not in b',]} \n\r\t': i+=1
    need(i>j,'primitive token'); return i

def obj(b):
    i=ws(b,0); need(b[i]==123,'object'); i=ws(b,i+1); d={}
    while b[i]!=125:
        j=string_end(b,i); k=dec(b[i:j]); need(type(k)is str and k not in d,'unique string key')
        i=ws(b,j); need(b[i]==58,'colon'); i=ws(b,i+1); j=value_end(b,i); d[k]=b[i:j]; i=ws(b,j)
        if b[i]==44: i=ws(b,i+1)
        else: need(b[i]==125,'object delimiter')
    need(ws(b,i+1)==len(b),'whole object'); return d

def arr(b):
    i=ws(b,0); need(b[i]==91,'array'); i=ws(b,i+1); a=[]
    while b[i]!=93:
        j=value_end(b,i); a.append(b[i:j]); i=ws(b,j)
        if b[i]==44: i=ws(b,i+1)
        else: need(b[i]==93,'array delimiter')
    need(ws(b,i+1)==len(b),'whole array'); return a

def at(b,path):
    for k in path: b=obj(b)[k]
    return b

