def string_end(b,i):
    assert b[i]==34;i+=1
    while i<len(b):
        if b[i]==92:i+=2
        elif b[i]==34:return i+1
        else:i+=1
    raise ValueError('unterminated string')
def end(b,i):
    if b[i]==34:return string_end(b,i)
    if b[i]in b'[{':
        stack=[b[i]];i+=1
        while stack:
            assert i<len(b)
            if b[i]==34:i=string_end(b,i);continue
            if b[i]in b'[{':stack.append(b[i])
            elif b[i]in b']}':assert(stack.pop(),b[i])in((91,93),(123,125))
            i+=1
        return i
    while i<len(b)and b[i]not in b',]} \r\n\t':i+=1
    return i
def fields(b):
    i=white(b,0);assert b[i]==123;i=white(b,i+1);out={}
    while b[i]!=125:
