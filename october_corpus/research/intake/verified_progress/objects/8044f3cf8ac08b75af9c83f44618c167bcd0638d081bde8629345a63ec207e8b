"""Bounded fresh cyclic rows from frozen design6e3576; all data untrusted.
The numerical direct verifier uses supplied equations and never calls acquire.
"""
from retained_math import need

class ScalarWork:
    """One shared scalar meter, at most eight cases; exact charges in PROTOCOL.rst."""

    def __init__(self, tick, limit=200000):
        need(type(limit) is int and 12000 <= limit <= 200000,
             'explicit bounded new linear scalar bank')
        self.tick = tick
        self.limit = limit
        self.used = 0
        self.cases = 0

    def charge(self, units):
        need(type(units) is int and units >= 0 and self.used + units <= self.limit,
             'new linear scalar bank exhausted before operation')
        self.tick()
        self.used += units

    def begin_case(self):
        need(self.cases < 8 and self.used + 12000 <= self.limit,
             'at most eight fresh cases with prospective linear reserve')
        self.tick()
        self.cases += 1
        return self.used

    def subtract_product(self, a, b, c):
        self.charge(2)
        return (a - b*c) % 11

    def multiply(self, a, b):
        self.charge(1)
        return (a*b) % 11

    def inverse(self, a):
        need(type(a) is int and 1 <= a < 11, 'nonzero F11 pivot')
        self.charge(32)
        return pow(a, -1, 11)

def canonical_row(row):
    return (type(row) is tuple and len(row) == 7
            and all(type(x) is int and 0 <= x < 11 for x in row))

def inverse_of_actual_rows(rows, work):
    """Gauss-Jordan workspace; never replace the stored genuine orbit rows."""
    need(type(rows) is list and len(rows) == 7 and all(canonical_row(x) for x in rows),
         'seven original rows, not normalized elimination rows')
    augmented = [list(row) + [int(i == j) for j in range(7)]
                 for i, row in enumerate(rows)]
    for column in range(7):
        pivot = next((i for i in range(column, 7) if augmented[i][column]), None)
        need(pivot is not None, 'a full cyclic carrier must have rank seven')
        augmented[column], augmented[pivot] = augmented[pivot], augmented[column]
        inv = work.inverse(augmented[column][column])
        augmented[column] = [work.multiply(x, inv) for x in augmented[column]]
        for i in range(7):
            if i != column and augmented[i][column]:
                coefficient = augmented[i][column]
                augmented[i] = [work.subtract_product(x, coefficient, y)
                                for x, y in zip(augmented[i], augmented[column])]
    need(all(row[:7] == [int(i == j) for j in range(7)]
             for i, row in enumerate(augmented)), 'complete left block is identity')
    return tuple(tuple(row[7:]) for row in augmented)

def acquire(seed, marks, budget, work):
    """Acquire genuine orbit rows and an untrusted full carrier; never write or infer GEN."""
    start = work.begin_case()
    need(canonical_row(seed) and any(seed), 'actual acquired nonzero seed')
    need(type(marks) is tuple and len(marks) == 4
         and all(type(g) is tuple and len(g) == 7
                 and all(canonical_row(row) for row in g) for g in marks),
         'four already reconstructed actual seven-dimensional marks')
    actual_rows, edges, echelon = [], [], []

    def append_if_independent(original, edge):
        reduced = list(original)
        for pivot, normalized in echelon:
            coefficient = reduced[pivot]
            if coefficient:
                reduced = [work.subtract_product(x, coefficient, y)
                           for x, y in zip(reduced, normalized)]
        pivot = next((i for i, x in enumerate(reduced) if x), None)
        if pivot is None:
            return False
        inv = work.inverse(reduced[pivot])
        normalized = tuple(work.multiply(x, inv) for x in reduced)
        echelon.append((pivot, normalized))
        echelon.sort(key=lambda item: item[0])
        actual_rows.append(original)
        if edge is not None:
            edges.append(edge)
        return True

    need(append_if_independent(seed, None), 'the seed starts the actual orbit basis')
    parent = 0
    images = 0
    while parent < len(actual_rows) and len(actual_rows) < 7:
        for label, mark in enumerate(marks):
            work.charge(98)
            image = budget.image(actual_rows[parent], mark)
            images += 1
            need(canonical_row(image), 'literal retained image returns a canonical row')
            append_if_independent(image, [parent, label])
            if len(actual_rows) == 7:
                break
        parent += 1
    need(images <= 28 and len(actual_rows) <= 7 and len(edges) == len(actual_rows)-1,
         'finite breadth-first basis and exact earlier-parent provenance')
    fact = None
    if len(actual_rows) == 7:
        right_inverse = inverse_of_actual_rows(actual_rows, work)
        work.charge(686)
        identity = tuple(tuple(int(i == j) for j in range(7)) for i in range(7))
        need(budget.multiply(tuple(actual_rows), right_inverse) == identity,
             'full original A*R identity through the retained literal product')
        fact = dict(kind='FULL_CYCLIC_SPAN_MATRIX_ALGEBRA_ONLY', dimension=7,
                    basis=[list(row) for row in actual_rows],
                    right_inverse=[list(row) for row in right_inverse],
                    parent_edges=edges, nongeneration_claim=False,
                    ambient_generation_claim=False, IP_claim=False)
    need(work.used-start <= 10000, 'prospective per-case linear bound')
    status = 'UNTRUSTED_FULL_CYCLIC_CARRIER_PROPOSED' if fact else 'INCONCLUSIVE_NO_FULL_CYCLIC_CARRIER'
    return dict(status=status, certificate=fact, dimension=len(actual_rows), row_images=images,
                new_linear_scalar_units=work.used-start,
                generation_claim=False, IP_claim=False, paid_credit=0)


def projector(seed, marks, form, delta, budget, work):
    """Check the actual endpoint product equals the acquired orthogonal line projector."""
    need(canonical_row(seed) and type(delta) is int and 1 <= delta < 11
         and type(form) is tuple and len(form) == 7
         and all(canonical_row(row) for row in form)
         and all(form[i][j] == form[j][i] for i in range(7) for j in range(7)),
         'same acquired symmetric form and nonsingular seed norm')
    work.charge(98 + 686 + 49 + 98 + 14)
    left = tuple(tuple((int(i == j)+marks[0][i][j]) % 11 for j in range(7))
                 for i in range(7))
    right = tuple(tuple((int(i == j)+marks[3][i][j]) % 11 for j in range(7))
                  for i in range(7))
    product = budget.multiply(left, right)
    product = tuple(tuple(3*x % 11 for x in row) for row in product)
    covector = tuple(sum(form[i][j]*seed[j] for j in range(7)) % 11 for i in range(7))
    need(sum(seed[i]*covector[i] for i in range(7)) % 11 == delta,
         'actual nonzero norm, not a supplied arbitrary projector')
    inverse = work.inverse(delta)
    factors = tuple(work.multiply(x, inverse) for x in covector)
    expected = tuple(tuple(work.multiply(x, y) for y in seed) for x in factors)
    need(product == expected, 'complete actual orthogonal rank-one projector equation')
