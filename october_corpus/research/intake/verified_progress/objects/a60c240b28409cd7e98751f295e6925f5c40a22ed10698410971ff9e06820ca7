# Lexically find object member spans; array and matrix contents remain opaque.
# Only explicitly selected scalar/boolean fields below are JSON-decoded.
def members(raw):
    n=len(raw);i=0
    def ws(i):
        while i<n and raw[i]in b' \n\r\t':i+=1
        return i
    def string_end(i):
        need(raw[i]==34,'JSON string');i+=1
        while i<n:
            if raw[i]==92:i+=2
            elif raw[i]==34:return i+1
            else:i+=1
        raise ValueError('unterminated JSON string')
    i=ws(i);need(raw[i]==123,'object span');i=ws(i+1);out={}
    while raw[i]!=125:
        j=string_end(i);k=json.loads(raw[i:j]);need(k not in out,'duplicate object key')
        i=ws(j);need(raw[i]==58,'colon');i=ws(i+1);start=i
        if raw[i]==34:i=string_end(i)
        elif raw[i]in b'[{':
            stack=[raw[i]];i+=1
            while stack:
                need(i<n,'container end')
                if raw[i]==34:i=string_end(i);continue
                if raw[i]in b'[{':stack.append(raw[i])
                elif raw[i]in b']}':
                    need((stack.pop(),raw[i])in((91,93),(123,125)),'balanced JSON container')
                i+=1
        else:
            while i<n and raw[i]not in b',} \n\r\t':i+=1
        out[k]=raw[start:i];i=ws(i)
        if raw[i]==44:i=ws(i+1)
        else:need(raw[i]==125,'object separator')
    need(not raw[ws(i+1):],'whole object span');return out

