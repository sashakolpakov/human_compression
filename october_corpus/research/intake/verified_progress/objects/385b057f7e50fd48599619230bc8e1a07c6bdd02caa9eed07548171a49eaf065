    assert sig(a)==sig(b)==sig(p.stat())and len(raw)==r['bytes']and hashlib.sha256(raw).hexdigest()==r['sha256']
    scope=dict(__file__=r['path'],__name__='Root_owned_bounded_prelaunch_reader')
    exec(compile(raw,r['path'],'exec'),scope);return scope

