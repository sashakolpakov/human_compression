        need(type(previous)is dict and set(previous)=={'NG','NOT_IP'}and A['typed_union'](list(previous.items()),additional,maximum)==typed,
             'complete inherited NG/NOT_IP partition')
    meta.field_NG_application=field_application;meta.field_admission_refs=merge(field_refs+[ADMISSION]);meta.typed_prior=typed
    tried=[]
