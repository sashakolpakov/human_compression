    receipt_ref=meta.pin(base/'receipt.json');stdout_ref=meta.pin(base/'stdout.log');stderr_ref=meta.pin(base/'stderr.log')
    receipt=meta.document(receipt_ref);frames=capture['all_genuine_api_frames']
