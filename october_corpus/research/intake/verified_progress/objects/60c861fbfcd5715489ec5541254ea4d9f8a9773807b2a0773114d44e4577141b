             and fact['finite_miss_positions_without_IP_credit']==trial['finite_miss_positions'],
             'same unchanged-method finite trials, kept unpaid')
        trial_gate=meta.document(fact['source_gate'])
        need(trial_gate['schema']=='ROOT_AUTHORIZED_Q11_RANK4_SECTION37_BATCH_PROPOSER_V1'
             and trial_gate['root']=='/root'and trial_gate['adopted']is True
             and trial_gate['program']==trial['source']and trial_gate['kernel']==source['kernel']
             and trial_gate['helpers']==source['helpers'],'exact historical method source gate, not current-driver identity')
        trial_gates.append(fact['source_gate']);tried+=trial['finite_miss_positions']
    tried.sort();need(len(tried)==len(set(tried))and tried==unresolved[:len(tried)]
        and tried==source['previous_method_miss_positions'],'exact skipped unpaid miss prefix')
