    unresolved=expand(selector['unresolved_position_runs'],maximum)
    need(baseline==sorted(set(baseline))and additional==sorted(set(additional))
         and len(baseline)+len(additional)+len(unresolved)==maximum
         and sorted(baseline+additional+unresolved)==list(range(1,maximum+1))
         and len(unresolved)==selector['unresolved_positions']==source['all_unresolved_positions']
         and digest(unresolved)==selector['expanded_unresolved_sha256'],'complete actual original partition')
