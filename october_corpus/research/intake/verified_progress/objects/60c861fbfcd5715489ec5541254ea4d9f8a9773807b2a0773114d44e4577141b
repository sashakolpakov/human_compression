         and all(type(frame)is dict and type(frame.get('output'))is str for frame in frames)
         and frames[-1]['exit_code']==0 and 'session_id'not in frames[-1],
         'complete actual terminal frames, not prospective output hashes')
    issued=capture['issued_argv'];need(type(issued)is list and '--'in issued
        and issued[issued.index('--')+1:]==expected_child,'actual exact supervised scientific argv')
    need(receipt['status']=='PASS'and receipt['stop']=='RETURNED'and receipt['returncode']==0
         and receipt['command']==expected_child and type(receipt['cleanup'])is dict
         and receipt['cleanup']['remaining']==[]and receipt['cleanup']['errors']==[]
         and receipt['limits']['total_rss']==128*2**20 and receipt['limits']['wall_seconds']==125
         and receipt['logs']['stdout']==stdout_ref['bytes']and receipt['logs']['stderr']==stderr_ref['bytes'],
         'actual unchanged scientific guard and known birth-pinned cleanup')
    emitted=decode(''.join(frame['output']for frame in frames))
    need(emitted['status']=='PASS'and emitted['stop']=='RETURNED'and emitted['receipt']==receipt_ref['path'],
         'terminal supervisor report joins the full actual receipt')
    return dict(capture=capture_ref,guard=receipt_ref,stdout=stdout_ref,stderr=stderr_ref,
        known_cleanup_qualification=receipt['cleanup']['qualification']),decode(meta.whole(stdout_ref))


