            app=meta.document(field_application);proposal=meta.document(fact['proposal']);review=meta.document(fact['independent_review'])
            field_refs.extend([field_application,fact['proposal'],fact['independent_review']])
        adopted.append(A['classify'](fact,reference,source,maximum,baseline,projection,app,proposal,review))
    typed=A['typed_union'](adopted,additional,maximum)
