 need([list(r)for r in base]==fact['base_word_value'],'whole base evaluation')
 Y=kernel['power'](base,6,budget)
 need(Y!=I and kernel['power'](Y,37,budget)==I and [list(r)for r in Y]==fact['prime_word_value'],'exact cofactor6/order37')
 v=fact['nonzero_fixed_row'];need(any(v)and list(budget.image(v,Y))==v,'actual nonzero fixed row')
