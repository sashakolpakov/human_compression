import argparse,hashlib,json,resource,runpy,sys,time
from pathlib import Path
START=time.monotonic()

def need(ok,why):
 if not ok:raise ValueError(why)
class Halt(Exception):pass
class Budget:
 def __init__(self,limit=50000):self.need=need;self.products=0;self.limit=limit
 def tick(self,soft=False):
  rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin'else 1024)
  need(rss<128*2**20 and time.monotonic()-START<100,'control128MiB/100s envelope')
  if self.products>=self.limit:raise Halt()
 def check(self):self.tick(True)
 def multiply(self,A,B):
  self.tick(True);self.products+=1;n=len(A)
  return tuple(tuple(sum(A[i][k]*B[k][j]for k in range(n))%11 for j in range(n))for i in range(n))
 def image(self,v,g):
  self.tick(True);return tuple(sum(v[k]*g[k][j]for k in range(7))%11 for j in range(7))

def load(path,sha,cap,name):
 p=Path(path);raw=p.read_bytes();need(len(raw)<=cap and hashlib.sha256(raw).hexdigest()==sha,'exact finite new control subject')
 return runpy.run_path(str(p),run_name=name)

