    need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(s.st_mode)
         and s.st_nlink==1 and s.st_size<=cap,'bounded canonical whole bootstrap before read')
    with p.open('rb')as f:a=os.fstat(f.fileno());raw=f.read(cap+1);z=os.fstat(f.fileno())
    ref=reference(p,raw)
    need(sig(s)==sig(a)==sig(z)==sig(p.lstat())and len(raw)==s.st_size
         and(expected is None or ref['sha256']==expected),'stable exact bootstrap whole EOF')
    return ref,raw

