    for j in range(n):
        p=next((i for i in range(j,n)if w[i][j]),None);b.scalar(n-j)
        need(p is not None,'nondegenerate acquired pure norm')
        w[j],w[p]=w[p],w[j];b.scalar(2);z=pow(w[j][j],-1,11)
        for k in range(14):b.scalar(1);w[j][k]=w[j][k]*z%11
        for i in range(n):
            if i!=j:
                c=w[i][j]
                for k in range(14):b.scalar(2);w[i][k]=(w[i][k]-c*w[j][k])%11
    return tuple(tuple(row[7:])for row in w)

