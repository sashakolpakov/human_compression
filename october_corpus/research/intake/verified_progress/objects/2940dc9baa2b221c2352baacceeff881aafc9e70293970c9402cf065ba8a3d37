"""Fresh synthetic controls; no Original inputs."""
import retained_math as M
import runtime as R
import linear as L
import words as W


def main():
    b, mf, mr, plan, pr, gate, gr = R.start('CONTROLS', __file__)
    passed = []

    def check(name, value):
        M.need(value, 'control failed: '+name)
        passed.append(name)

    def refuse(name, call):
        try:
            call()
        except (ValueError, TypeError, KeyError, IndexError):
            passed.append(name)
        else:
            raise ValueError('control unexpectedly accepted: '+name)

    clone = lambda x: M.decode(M.can(x))
    job = [7, 4]
    p = dict(original_job=job, projection='toyP', Root_projection_acceptance='toyA', selector='toyS',
             selected_orbit_positions=[3], cyclic_input_schema='UNTRUSTED_ORIGINAL_QUARTET_CYCLIC_ROWS_V1',
             require_prior_job20_cyclic_adoption=False)
    s = dict(schema='ROOT_ACCEPTED_Q11_RANK4_UNRESOLVED_SELECTOR_V1', root='/root', adopted=True,
             original_job=job, projection='toyP', Root_projection_acceptance='toyA',
             original_paid_positions=[1], accepted_new_paid_positions=[2], original_paid_count=1,
             unresolved_position_runs=[[3, 4]], unresolved_positions=2, expanded_unresolved_sha256=M.digest([3, 4]))
    meta = dict(original_job=job, original_orbit_rows=4, baseline_paid_positions=[1],
                original_domain_whole_pins='toyDomain', original_orbit_array_sha256='toyDigest')
    scope = dict(schema='ROOT_GENERIC_Q11_QUARTET_GENERATION_SCOPE_V1', root='/root', Root_authority=True,
                 adopted=True, original_job=job, selector='toyS', selected_orbit_positions=[3],
                 original_domain_whole_pins='toyDomain', original_orbit_array_sha256='toyDigest')
    flags = ('complete_original_model_frame_member_and_transport_meanings_owned',
             'all_selector_adoptions_have_exact_per_job_typed_meanings_owned',
             'fresh_cyclic_rows_untrusted_and_directly_rechecked_owned',
             'same_quartet_prime37_and_projector_theory_owned',
             'generation_only_no_IP_or_settled_case_credit_owned')
    scope.update({k: True for k in flags})
    admit = lambda pp=p, ss=s, rr=scope: R.admit(pp, ss, meta, rr, M.digest, M.expand_runs)
    check('dynamic_same_job_scope', admit()['selected'] == [3])
    for name, key, value in [('wrong_job', 'original_job', [8, 4]), ('bool_job', 'original_job', [True, 4]),
                             ('paid', 'selected_orbit_positions', [1]), ('duplicate', 'selected_orbit_positions', [3, 3]),
                             ('bool_position', 'selected_orbit_positions', [True]), ('empty', 'selected_orbit_positions', [])]:
        q = clone(p); q[key] = value
        refuse(name, lambda q=q: admit(q))
    q = clone(s); q['accepted_new_paid_positions'] = [1, 2]
    refuse('overlap_partition', lambda: admit(ss=q))
    q = clone(s); q['expanded_unresolved_sha256'] = 'wrong'
    refuse('wrong_run_digest', lambda: admit(ss=q))
    q = clone(scope); q[flags[1]] = False
    refuse('global_fact_without_typed_job_ownership', lambda: admit(rr=q))
    q = clone(scope); q['Root_authority'] = False
    refuse('unissued_scope', lambda: admit(rr=q))
    work = L.ScalarWork(b.tick)
    seed = (1, 0, 0, 0, 0, 0, 0)
    perm = lambda f: tuple(tuple(int(j == f(i)) for j in range(7)) for i in range(7))
    marks = (perm(lambda i: -i % 7), perm(lambda i: (1-i) % 7), M.I7, M.I7)
    fact = L.acquire(seed, marks, b, work)['certificate']
    ctx = dict(seed=seed)
    check('full_actual_rows', M.direct_fact(fact, ctx, marks, b)['full_cyclic_span_verified'])
    lifts = W.basis_words(fact)
    for i, word in enumerate(lifts):
        row = seed
        for label in word:
            work.charge(98)
            row = b.image(row, marks[label])
        check('right_word_lift_'+str(i), list(row) == fact['basis'][i])
    pool = W.candidate_words(fact)
    check('finite_genuine_quartet_words', 1 <= len(pool) <= 128
          and all(1 <= len(w) <= 32 and set(w) == {0, 1, 2, 3} for w in pool))
    check('distant_cancellation_only', W.reduced([0, 2, 0]) == (2,)
          and W.reduced([0, 1, 0]) == (0, 1, 0))
    twice = tuple(2*x for x in seed)
    scaled = L.acquire(twice, marks, b, work)['certificate']
    check('unreduced_rows_kept', all(2 in row for row in scaled['basis'])
          and M.direct_fact(scaled, dict(seed=twice), marks, b)['full_cyclic_span_verified'])
    small = (perm(lambda i: -i % 3 if i < 3 else i), perm(lambda i: (1-i) % 3 if i < 3 else i), M.I7, M.I7)
    miss = L.acquire(seed, small, b, work)
    check('proper_rank_is_inconclusive', miss['dimension'] == 3 and miss['certificate'] is None and miss['paid_credit'] == 0)
    q = clone(fact); q['parent_edges'][0][1] = (q['parent_edges'][0][1]+1) % 4
    refuse('wrong_parent_action', lambda: M.direct_fact(q, ctx, marks, b))
    q = clone(fact); q['right_inverse'][0][0] = (q['right_inverse'][0][0]+1) % 11
    refuse('wrong_inverse', lambda: M.direct_fact(q, ctx, marks, b))
    refuse('zero_seed', lambda: L.acquire((0,)*7, marks, b, work))
    a = tuple(tuple((1 if i == 0 or i in (1, 2) else 10) if i == j else 0 for j in range(7)) for i in range(7))
    e = tuple(tuple((1 if i in (0, 3, 4) else 10) if i == j else 0 for j in range(7)) for i in range(7))
    L.projector(seed, (a, M.I7, M.I7, e), M.I7, 1, b, work)
    check('actual_rank_one_projector', True)
    refuse('cyclic_vector_is_not_projector', lambda: L.projector(seed, (M.I7,)*4, M.I7, 1, b, work))
    refuse('wrong_seed_norm', lambda: L.projector(seed, (a, M.I7, M.I7, e), M.I7, 2, b, work))
    stopped = L.ScalarWork(b.tick, 12000)
    refuse('scalar_stop_before_operation', lambda: stopped.charge(12001))
    for _ in range(8):
        stopped.begin_case()
    refuse('ninth_case_preflight', stopped.begin_case)
    check('no_partial_scalar_charge', stopped.used == 0)
    M.need(work.used <= 200000 and len(passed) == len(set(passed)) == 32,
           'whole synthetic linear bank and all32 unique controls')
    result = dict(schema='Q11_GENERIC_QUARTET37_CONTROLS_RESULT_V1', status='ALL_SYNTHETIC_CONTROLS_PASS',
                  program=mf['roles']['CONTROLS']['program'], Source_manifest=mr, plan=pr, Root_gate=gr,
                  controls=passed, controls_count=len(passed), new_linear_scalar_units=work.used,
                  Original_inputs_loaded=False, old_arithmetic_controls_replayed=False, paid_credit=0)
    R.finish(result, plan, b)


if __name__ == '__main__':
    main()
