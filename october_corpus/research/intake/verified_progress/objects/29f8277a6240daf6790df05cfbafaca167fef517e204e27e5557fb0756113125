def opaque_normal(b):
 out,quoted,escape=bytearray(),False,False
 for c in b:
  if quoted:
   out.append(c)
   if escape:
    escape=False
   elif c==92:
    escape=True
   elif c==34:
    quoted=False
  elif c==34:
   out.append(c)
   quoted=True
  elif c not in b' \r\n\t':
   out.append(c)
 assert not quoted
 return bytes(out)

