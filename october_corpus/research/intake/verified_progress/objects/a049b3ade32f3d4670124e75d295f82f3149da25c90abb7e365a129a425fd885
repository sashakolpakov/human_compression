def apply_cas(replacements,old_bodies,whole,read_stage,replace,sync,read_after):
    """The actual production ordering, also used by synthetic callback controls."""
    for item in replacements:
        assert whole(item['old_ref'])==old_bodies[item['path']]
        assert read_stage(item['staged_path'])==item['new_body_bytes']
    # Both complete old bodies are rechecked before the FIRST replacement.
    for item in replacements:
        assert whole(item['old_ref'])==old_bodies[item['path']]
    for item in replacements:
        replace(item['staged_path'],item['path'])
        sync(Path(item['path']).parent)
        assert read_after(item['path'])==item['new_body_bytes']

