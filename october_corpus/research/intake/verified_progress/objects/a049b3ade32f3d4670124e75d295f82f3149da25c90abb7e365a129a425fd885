def read_prepaid(source_bytes,documents,inventory):
    """All Source loads and outer-profile reads outside the child Ledger."""
    assert type(source_bytes)is int and 0<source_bytes<=131072
    for item in documents:descriptor(item)
    existing=[row['existing']for row in inventory if row['existing']is not None]
    for item in existing:descriptor(item)
    # Three whole namespaces dominate the interpreter/entry, explicit module
    # loads and twice-read profile/base Sources. Outer documents and every
    # preflight-existing target are charged once in addition to child reads.
    return 3*source_bytes+sum(r['bytes']for r in documents+existing)

def read_upper(first,planned,cas,prepaid):
    assert all(type(n)is int and n>=0 for n in(first,planned,cas,prepaid))
    return 2*first+2*planned+2*cas+prepaid

