def module(ref,name,bindings=None):
    body=Path(ref['path']).read_bytes()
    assert len(body)==ref['bytes']and hashlib.sha256(body).hexdigest()==ref['sha256']
    scope=dict(__file__=ref['path'],__name__=name)
    scope.update(bindings or {})
    exec(compile(body,ref['path'],'exec'),scope)
    return scope

