      or(k in old and canonical(old[k])!=canonical(new[k])))
    allowed={'accepted_new_paid_positions','accepted_new_paid_by_kind','unresolved_position_runs','unresolved_positions',
      'expanded_unresolved_sha256','source_adoptions','previous_selector','current_method_attempt_frontiers'}
    need(set(changed)<=allowed,'no hidden extra top-level change')
