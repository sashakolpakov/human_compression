    return dict(schema='Q11_PROPER_ADOPTION_WHOLE_INVERSE_V1',changed_top_level_fields=changed,
      exact_before_bytes_sha256=hashlib.sha256(before).hexdigest(),exact_after_bytes_sha256=hashlib.sha256(after).hexdigest(),
      full_original_beforeimage_required=True,semantic_inverse_complete=True,
