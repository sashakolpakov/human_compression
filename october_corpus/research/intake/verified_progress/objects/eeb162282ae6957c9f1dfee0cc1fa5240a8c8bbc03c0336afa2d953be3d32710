# Lexical container navigation skips all Original certificate/word/matrix values.
def whitespace(b,i):
    while i<len(b)and b[i]in b' \t\r\n':i+=1
    return i
def string_end(b,i):
    need(b[i]==34,'string');i+=1
    while i<len(b):
        if b[i]==92:i+=2
        elif b[i]==34:return i+1
        else:i+=1
    raise ValueError('unterminated string')
def value_end(b,i):
    if b[i]==34:return string_end(b,i)
    if b[i]in b'[{':
        stack=[b[i]];i+=1
        while stack:
            need(i<len(b),'bounded container')
            if b[i]==34:i=string_end(b,i);continue
            if b[i]in b'[{':stack.append(b[i])
            elif b[i]in b']}':need((stack.pop(),b[i])in((91,93),(123,125)),'balanced container')
            i+=1
        return i
    while i<len(b)and b[i]not in b',]} \n\r\t':i+=1
    return i
def members(b):
    i=whitespace(b,0);need(b[i]==123,'object');i=whitespace(b,i+1);d={}
    while b[i]!=125:
        j=string_end(b,i);k=parse(b[i:j]);need(k not in d,'unique object keys')
        i=whitespace(b,j);need(b[i]==58,'colon');i=whitespace(b,i+1)
        j=value_end(b,i);d[k]=b[i:j];i=whitespace(b,j)
        if b[i]==44:i=whitespace(b,i+1)
        else:need(b[i]==125,'object separator')
    need(not b[whitespace(b,i+1):],'whole object');return d
def array_spans(b):
    i=whitespace(b,0);need(b[i]==91,'array');i=whitespace(b,i+1)
    while b[i]!=93:
        j=value_end(b,i);yield b[i:j];i=whitespace(b,j)
        if b[i]==44:i=whitespace(b,i+1)
        else:need(b[i]==93,'array separator')
