def can(x):
    return (json.dumps(x, sort_keys=True, separators=(',', ':')) + '\n').encode()
def read(path, sha):
    b = Path(path).read_bytes()
    assert len(b) <= 262144 and hashlib.sha256(b).hexdigest() == sha
    return json.loads(b)
def reference(path):
    b = Path(path).read_bytes()
    return dict(path=str(path), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())
def write(path, x):
    assert not path.exists() and path.parent.resolve(strict=True) == path.parent
    b = can(x)
    with path.open('xb') as f:
        f.write(b)
        f.flush()
        os.fsync(f.fileno())
    assert path.read_bytes() == b
    return reference(path)

