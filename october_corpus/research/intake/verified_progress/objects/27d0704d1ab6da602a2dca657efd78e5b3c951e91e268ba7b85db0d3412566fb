def ref(p, b):
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())


def whole(p, r=None, fresh=False):
    global read_bytes
    p = Path(p); k = str(p)
    if k not in bodies or fresh:
        s = p.lstat()
        assert p.resolve(strict=True) == p and stat.S_ISREG(s.st_mode) and s.st_nlink == 1 and s.st_size <= 2**21
        b = p.read_bytes(); t = p.lstat()
        assert (s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns) == (t.st_dev,t.st_ino,t.st_size,t.st_mtime_ns,t.st_ctime_ns)
        v = ref(p,b); assert len(b) == s.st_size and pins.get(k,v) == v and bodies.get(k,b) == b
        pins[k] = v; bodies[k] = b; read_bytes += len(b)
        assert len(pins) <= 128 and read_bytes <= 2**24
    assert r is None or pins[k] == r
    return bodies[k]


def pin(p):
    whole(p); return pins[str(p)]


def doc(p, r=None):
    def pairs(rows):
        d = {}
        for k,v in rows:
            assert k not in d; d[k] = v
        return d
    return json.loads(whole(p,r), object_pairs_hook=pairs)


