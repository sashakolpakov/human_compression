def metadata_argv(program,argv):
    prefix=['/usr/bin/env']
    for name in ENV:prefix+=['-u',name]
    return prefix+[C.PYTHON,'-E','-B','-S',program]+argv

def command_kind(argv,program):
    """Distinguish our direct entry from the inherited profiled entry."""
    direct=metadata_argv(program,[])
    if argv[:len(direct)]==direct:return'standalone'
    # The inherited metadata profile uses -E -B, without the child -S.
    env=['/usr/bin/env']
    for name in ENV:env+=['-u',name]
    profiled=env+[C.PYTHON,'-E','-B',C.PROFILE_REF['path']]
    if argv[:len(profiled)]==profiled and '--'in argv:return'profiled'
    raise AssertionError('not an admitted metadata command shape')

def standalone_call(argv,program,packet,op):
    assert command_kind(argv,program)=='standalone'
    child=argv[len(metadata_argv(program,[])):]
    sizes={'actor':1,'op':1,'packet':3,'request':3,'Root-gate':3,'out':1}
    parts={};cursor=0
    while cursor<len(child):
        key=child[cursor]
        assert type(key)is str and key.startswith('--')and key[2:]in sizes
        name=key[2:];assert name not in parts
        n=sizes[name];value=child[cursor+1:cursor+1+n]
        assert len(value)==n and all(type(v)is str for v in value)
        parts[name]=value;cursor+=n+1
    assert set(parts)==set(sizes)and parts['actor']==['/root']and parts['op']==[op]
    assert C.can(cli(parts['packet']))==C.can(packet)
    return dict(request=cli(parts['request']),gate=cli(parts['Root-gate']),out=parts['out'][0])

