def exact(ref):
    assert type(ref)is dict and set(ref)=={'path','bytes','sha256'}
    assert type(ref['bytes'])is int and 0<=ref['bytes']<=4*2**20
    p=Path(ref['path']);assert p.is_absolute()and p.resolve(strict=True)==p
    assert p.stat().st_size==ref['bytes']
    with p.open('rb')as f:body=f.read(ref['bytes']+1)
    assert len(body)==ref['bytes']and hashlib.sha256(body).hexdigest()==ref['sha256']
    return body

def module(ref,name,bindings=None):
    scope=dict(__file__=ref['path'],__name__=name);scope.update(bindings or {})
    exec(compile(exact(ref),ref['path'],'exec'),scope)
    return types.SimpleNamespace(**scope)

