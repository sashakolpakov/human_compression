    def emit(self,result,replacements=None):
        replacements=replacements or []
        assert bool(replacements)==(self.g['canonical_writes_authorized']is True)
        assert not replacements or self.op=='register.py'
        canonical={str(C.PROGRESS/'current_intake.json'),str(C.PROGRESS/'controllers/current.json')}
        if replacements:
            assert self.g['serial_sole_writer_no_atomicity_claim']is True
            assert len(replacements)==2 and {r['path']for r in replacements}==canonical
            assert len({r['staged_path']for r in replacements})==2
            for r in replacements:
                assert r['old_ref']['path']==r['path']and C.raw(self.L,r['old_ref'])==self.L.pins[r['path']][0]
                assert next(b for p,b in self.planned if p==r['staged_path'])==r['new_body_bytes']
        first=self.L.bytes;written=sum(len(b)for _,b in self.planned)
        cas=sum(len(r['new_body_bytes'])+r['old_ref']['bytes']for r in replacements)
        upper=2*first+2*written+2*cas+self.bootstrap_read_upper
        assert upper<=64*2**20 and written<=16*2**20 and len(self.L.pins)+3*len(self.planned)+32<=512
        self.L.close();C.check()
        for p,b in self.planned:
            path=Path(p);assert not os.path.lexists(path)
            path.parent.mkdir(mode=0o700,parents=True,exist_ok=True)
            with path.open('xb')as f:assert f.write(b)==len(b)
        if replacements:
            def sync(path):
                fd=os.open(path,os.O_RDONLY)
                try:os.fsync(fd)
                finally:os.close(fd)
            C.apply_cas(replacements,{r['path']:self.L.pins[r['path']][0]for r in replacements},
                C.P['whole'],lambda p:fixed_read(p,next(r['new_body_bytes']for r in replacements if r['staged_path']==p)),
                os.replace,sync,lambda p:fixed_read(p,next(r['new_body_bytes']for r in replacements if r['path']==p)))
        refs=[C.ref(p,b)for p,b in self.planned if p not in{r['staged_path']for r in replacements}]
        result.update(outputs=refs,packet=self.packet_ref,base_packet=self.base_ref,program=self.packet['supplement']['program'],
            Source_manifest=self.manifest_ref,Source_peer=self.peer_ref,Root_gate=self.gate_ref,request=self.request_ref,
