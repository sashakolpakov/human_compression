def fixed_read(path,expected):
    """Known-size CAS stage/afterimage reads; refuse growth before reading."""
    assert type(expected)is bytes and len(expected)<=4*2**20
    p=Path(path)
    with p.open('rb')as f:
        before=os.fstat(f.fileno())
        assert before.st_size==len(expected)
        body=f.read(len(expected)+1)
        after=os.fstat(f.fileno())
    signature=lambda v:(v.st_dev,v.st_ino,v.st_mode,v.st_nlink,v.st_size,v.st_mtime_ns,v.st_ctime_ns)
    assert signature(before)==signature(after)==signature(p.stat())and body==expected
    return body
