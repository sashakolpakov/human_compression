def read(r):
 global BYTES
 p=Path(r['path']);a=p.stat();assert type(r['bytes'])is int and a.st_size==r['bytes']<=4*2**20
 with p.open('rb')as f:b=f.read(r['bytes']+1)
 z=p.stat();assert(a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_ctime_ns)==(z.st_dev,z.st_ino,z.st_size,z.st_mtime_ns,z.st_ctime_ns)
 assert pin(p,b)==r;BYTES+=len(b);assert BYTES<=64*2**20
 PINS[(str(p),r['sha256'])]=r;return b

