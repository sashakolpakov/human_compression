def pin(path, body):
    return dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())

def sig(s):
    return (s.st_dev, s.st_ino, s.st_mode, s.st_size, s.st_mtime_ns, s.st_ctime_ns)

def budget():
    assert time.monotonic() - START < 115
    scale = 1 if sys.platform == 'darwin' else 1024
    assert resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * scale <= 256 * 2**20
    assert READ <= 64 * 2**20 and len(PINS) <= 512

def read(path, expected=None):
    global READ
    budget()
    p = Path(path)
    if str(p) in PINS:
        r, body, signature = PINS[str(p)]
        assert expected is None or r == expected
        return body
    s = p.lstat()
    assert p.is_absolute() and p.resolve(strict=True) == p
    assert stat.S_ISREG(s.st_mode) and s.st_size <= 4 * 2**20
    body = p.read_bytes()
    assert len(body) == s.st_size and sig(p.lstat()) == sig(s)
    r = pin(p, body)
    assert expected is None or r == expected
    PINS[str(p)] = (r, body, sig(s))
    READ += len(body)
    budget()
    return body

