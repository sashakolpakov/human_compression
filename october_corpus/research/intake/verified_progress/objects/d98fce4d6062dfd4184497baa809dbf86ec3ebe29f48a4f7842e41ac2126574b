def write(name, value):
    body = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
    p = OUT / name
    with p.open('xb') as stream:
        stream.write(body)
        stream.flush()
        os.fsync(stream.fileno())
    return pin(p, body)

