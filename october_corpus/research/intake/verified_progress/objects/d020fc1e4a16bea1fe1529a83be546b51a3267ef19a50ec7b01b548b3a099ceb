def read(p,r=None):
    global READ
    assert time.monotonic()-START<115
    assert resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024)<=256*2**20
    p=Path(p);assert p.is_absolute()and p.resolve(strict=True)==p and not p.is_symlink()
    before=p.stat();assert p.is_file()and before.st_size<=4*2**20
    b=p.read_bytes();assert p.stat()==before
    READ+=len(b);assert READ<=64*2**20
    got=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    if r is not None:assert got==r
    PINS[str(p)]=got;BODIES[str(p)]=b;assert len(PINS)<=512
    return b,got
