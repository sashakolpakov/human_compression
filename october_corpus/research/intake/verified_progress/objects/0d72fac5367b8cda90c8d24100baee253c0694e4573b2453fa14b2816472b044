def whole(p, wanted=None, fresh=False):
    global READ
    p = Path(p)
    k = str(p)
    if k in BODIES and not fresh:
        b = BODIES[k]
    else:
        a = p.lstat()
        sig = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
        need(p.is_absolute() and p.resolve(strict=True) == p and stat.S_ISREG(a.st_mode)
             and a.st_nlink == 1 and a.st_size <= 4*2**20, 'ordinary single-link bounded input')
        need(READ+a.st_size <= 64*2**20 and len(set(PINS) | {k}) <= 512, '64MiB512paths review')
        with p.open('rb') as f:
            x = os.fstat(f.fileno()); b = f.read(a.st_size+1); y = os.fstat(f.fileno())
        need(sig(a) == sig(x) == sig(y) == sig(p.lstat()) and len(b) == a.st_size, 'same-FD stable whole input')
        r = ref(p, b)
        need(PINS.get(k, r) == r and BODIES.get(k, b) == b, 'first/closing byte identity')
        PINS[k] = r; BODIES[k] = b; READ += len(b)
    need(wanted is None or PINS[k] == wanted, 'exact descriptor')
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if os.uname().sysname == 'Darwin' else 1024)
    need(rss <= 256*2**20 and time.monotonic()-START <= 125, 'own256MiB125s review')
    return b


def decode(b):
    def pairs(rows):
        out = {}
        for k, v in rows:
            need(k not in out, 'unique metadata keys'); out[k] = v
        return out
    def finite(s):
        x = float(s); need(math.isfinite(x), 'finite metadata'); return x
    def bad(_):
        raise ValueError('nonfinite metadata')
    return json.loads(b, object_pairs_hook=pairs, parse_constant=bad, parse_float=finite)


def doc(r):
    return decode(whole(r['path'], r))


def pathref(p):
