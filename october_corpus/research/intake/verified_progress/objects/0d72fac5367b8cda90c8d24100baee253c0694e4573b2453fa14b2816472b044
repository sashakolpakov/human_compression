def put(name, value):
    raw = (json.dumps(value, sort_keys=True, indent=2, allow_nan=False)+'\n').encode()
    p = O/name
    with p.open('xb') as f:
        need(f.write(raw) == len(raw), 'whole exclusive review output')
    return ref(p, raw)


