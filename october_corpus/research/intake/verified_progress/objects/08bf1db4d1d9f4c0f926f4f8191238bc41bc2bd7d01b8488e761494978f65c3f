"""Pure metadata admission; no group, matrix, action or scientific calls.
Author /root/forest_resume. Root application and actual activation are separate.
"""
FIELD='ROOT_ACCEPTED_Q11_RANK4_FIELD_CENTRALIZER_DEDUCTIONS_V1'
APPLICATION='ROOT_Q11_RANK4_FIELD_NG_JOB_APPLICATION_V1'
OWNED=('complete_adopted_field_job_set_owned','same_original_domain_frame_membership_and_transport_premises_owned',
       'conditional_nongeneration_not_IP_failure_owned','no_new_group_or_full_stabilizer_evaluation_owned')

def need(value,message):
    if not value:raise ValueError(message)

def positions(value,maximum):
    need(type(maximum)is int and 1<=maximum<=14763,'same original at-most14763-orbit domain')
    need(type(value)is list and len(value)<=maximum and all(type(i)is int and 1<=i<=maximum for i in value)
         and value==sorted(set(value)),'complete sorted distinct integer positions')
    return value

def job(value):
    need(type(value)is list and len(value)==2 and all(type(i)is int for i in value)
         and value[0]>0 and value[1]==4,'typed original rank-four job')
    return value

def classify(fact,reference,source,maximum,baseline,projection,application=None,proposal=None,review=None):
    """Return NG or NOT_IP positions of one existing adopted fact, never new credit."""
    current=job(source['original_job']);positions(baseline,maximum)
    need(fact['root']=='/root'and fact['adopted']is True,'existing genuine Root adoption')
    schema=fact['schema']
    if schema!=FIELD:
        need(job(fact['original_job'])==current and type(fact['whole_original_credit'])is int
             and fact['whole_original_credit']==0,'same-job old partial adoption, no whole credit')
        if schema=='ROOT_ACCEPTED_Q11_RANK4_CYCLIC_PILOT_V1':
            need(fact['all64_directly_checked']is True,'actual old64 arithmetic checks, never a field alias')
            kind='NG';paid=fact['nongeneration_positions']
        else:
            need(schema=='ROOT_ACCEPTED_Q11_RANK4_SECTION_IP_OBSTRUCTIONS_V1'
                 and fact['independent_direct_word_power_row_minor_checks']is True,'old actual direct section-IP adoption')
            kind='NOT_IP';paid=fact['new_IP_failure_positions']
        return kind,positions(paid,maximum)
    need(application is not None and proposal is not None and review is not None,'global field fact needs separate per-job Root application')
    app=application
    need(app['schema']==APPLICATION and app['root']=='/root'and app['Root_authority']is app['adopted']is True
         and all(app[k]is True for k in OWNED),'new explicit Root-owned field application')
    need(job(app['original_job'])==current and app['projection']==source['projection']
         and app['Root_projection_acceptance']==source['Root_projection_acceptance']
         and app['original_orbit_positions']==maximum and type(app['original_orbit_positions'])is int
         and positions(app['original_paid_positions'],maximum)==baseline,'exact same-job projection/domain/baseline')
    need(app['original_domain_whole_pins']==projection['original_domain_whole_pins']
         and job(projection['original_job'])==current and type(projection['original_orbit_rows'])is int and projection['original_orbit_rows']==maximum,
         'same accepted whole original domain/frame references')
    need(app['global_field_adoption']==reference and app['field_proposal']==fact['proposal']
         and app['field_review']==fact['independent_review']and fact['Root_projection_acceptance']==source['Root_projection_acceptance']
         and fact['complete_full_stabilizer_model_frame_membership_premises_retained']is True
         and type(fact['new_census_conjecture_Lean_or_compression_credit'])is int
         and fact['new_census_conjecture_Lean_or_compression_credit']==0,'exact qualified adopted global field subject')
    need(review['verdict']=='SUPPORTED_CONDITIONAL_METADATA_DEDUCTIONS'and review['blockers']==[]
         and review['proposed_partition']==fact['proposal'],'same accepted independent field metadata review')
    rows=proposal['jobs'];need(type(rows)is list and len(rows)<=512,'bounded accepted global field table')
    selected=[r for r in rows if job(r['original_job'])==current]
    need(len(selected)==1,'exactly one job in the adopted global proposal')
    row=selected[0]
    need(row['projection']==source['projection']and row['original_Saved_domain']==projection['original_domain_whole_pins']['Saved_result'],
         'same adopted per-job original Saved carrier')
    paid=positions(row['proposed_new_positions'],maximum)
    need(app['disposition']=='NG'and app['IP_failure_claimed']is False
         and type(app['whole_original_credit'])is int and app['whole_original_credit']==0
         and positions(app['nongeneration_positions'],maximum)==paid and not set(paid)&set(baseline),
         'complete adopted field NG set only, never baseline repayment or IP failure')
    return 'NG',paid

def typed_union(rows,additional,maximum):
    out={'NG':[],'NOT_IP':[]};all_paid=[]
    for kind,paid in rows:
        need(kind in out,'only typed existing NG or NOT_IP dispositions')
        positions(paid,maximum);out[kind].extend(paid);all_paid.extend(paid)
    need(len(all_paid)==len(set(all_paid))and sorted(all_paid)==positions(additional,maximum),
         'complete disjoint accepted adoption union without kind coercion')
    return {kind:sorted(values)for kind,values in out.items()}
