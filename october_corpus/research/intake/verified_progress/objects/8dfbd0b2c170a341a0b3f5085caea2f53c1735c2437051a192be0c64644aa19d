FACT_SCHEMA='ROOT_ACCEPTED_Q11_RANK4_PROPER_SUBSPACE_OBSTRUCTIONS_V1'

def need(ok,why):
    if not ok:raise ValueError(why)

def positions(v,maximum):
    need(type(maximum)is int and 1<=maximum<=14763,'bounded original domain')
    need(type(v)is list and all(type(p)is int and 1<=p<=maximum for p in v)
         and v==sorted(set(v)),'sorted distinct typed positions')
    return v

def adopted_proper_fact(fact,source,maximum,proof_subject):
    """New classification branch; not old all64 or section-IP predicates."""
    need(fact['schema']==FACT_SCHEMA and fact['root']=='/root'
         and fact['Root_authority']is fact['adopted']is True,'adopted properness subject')
    j=fact['original_job']
    need(type(j)is list and len(j)==2 and all(type(i)is int for i in j)
         and j==source['original_job']and j[0]>0 and j[1]==4,'same typed original job')
    need(fact['projection']==source['projection']and fact['Root_projection_acceptance']==source['Root_projection_acceptance']
         and fact['proper_scientific_subject']==proof_subject,'same domain and exact new Source')
    need(fact['disposition']=='NG'and fact['IP_claim']is fact['GEN_claim']is False
         and type(fact['whole_original_credit'])is int and fact['whole_original_credit']==0,
         'NG only, no IP/GEN/whole-job substitution')
    return 'NG',positions(fact['verified_nongeneration_positions'],maximum)

def candidate(prior,prior_ref,positive,proposed_adoption,digest,expand,pack):
    """FALSE prospective wrapper. Old history is preserved verbatim.

    Callbacks are attributed existing metadata digest/run codecs, whose
    actual Source and IO belong in the future reviewed issuer's invoice.
    This helper authenticates no execution or mathematical proof.
    """
    need(prior['schema']=='ROOT_ACCEPTED_Q11_RANK4_UNRESOLVED_SELECTOR_V1'
         and prior['root']=='/root'and prior['adopted']is True,'accepted predecessor')
    total=prior['original_orbit_positions'];baseline=positions(prior['original_paid_positions'],total)
    paid=positions(prior['accepted_new_paid_positions'],total)
    unpaid=positions(expand(prior['unresolved_position_runs'],total),total)
    need(type(prior['unresolved_positions'])is int and prior['unresolved_positions']==len(unpaid)
         and prior['expanded_unresolved_sha256']==digest(unpaid),'whole unpaid frontier')
    need(sorted(baseline+paid+unpaid)==list(range(1,total+1))
         and len(baseline)+len(paid)+len(unpaid)==total,'complete disjoint original partition')
    typed=prior['accepted_new_paid_by_kind'];need(type(typed)is dict and set(typed)=={'NG','NOT_IP'},'two inherited types')
    ng=positions(typed['NG'],total);not_ip=positions(typed['NOT_IP'],total)
    need(sorted(ng+not_ip)==paid and len(ng)+len(not_ip)==len(paid),'complete typed paid union')
    positions(positive,total);need(positive and set(positive)<=set(unpaid),'verified positive subset only')
    remain=sorted(set(unpaid)-set(positive));new_paid=sorted(paid+positive)
    need(len(new_paid)==len(set(new_paid))and sorted(baseline+new_paid+remain)==list(range(1,total+1)),
         'one new NG per previously unpaid positive')
    selector=dict(prior)
    selector.update(accepted_new_paid_positions=new_paid,
      accepted_new_paid_by_kind=dict(NG=sorted(ng+positive),NOT_IP=list(not_ip)),
      unresolved_position_runs=pack(remain),unresolved_positions=len(remain),expanded_unresolved_sha256=digest(remain),
      source_adoptions=list(prior['source_adoptions'])+[proposed_adoption],previous_selector=prior_ref)
    attempts=prior.get('previous_method_attempts',[])
    need(selector.get('previous_method_attempts',[])==attempts,'all old journals preserved')
    frontier=[]
    for number,row in enumerate(attempts):
        misses=positions(row['finite_miss_positions'],total)
        frontier.append(dict(history_entry=number,criterion=row['criterion'],Root_adoption=row['Root_adoption'],
          still_unpaid_finite_miss_positions=sorted(set(misses)&set(remain)),
          finite_miss_positions_now_settled=sorted(set(misses)-set(remain)),historical_journal_unchanged=True))
    need(not_ip==selector['accepted_new_paid_by_kind']['NOT_IP']and baseline==selector['original_paid_positions'],
         'old NOT_IP and baseline unchanged')
    return dict(schema='UNADOPTED_Q11_PROPER_SUBSPACE_FRONTIER_CANDIDATE_V1',Root_authority=False,adopted=False,
      proposed_selector=selector,new_kind='NG',new_positions=list(positive),current_method_attempt_frontiers=frontier,
      old_history_bytes_must_be_preserved=True,operational_or_global_pointer_writes=False,IP_or_GEN_or_whole_original_credit=0)
