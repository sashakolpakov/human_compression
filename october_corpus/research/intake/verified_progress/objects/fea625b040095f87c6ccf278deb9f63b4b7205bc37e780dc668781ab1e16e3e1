def raw(p, r=None):
    global READ
    p = Path(p)
    name = str(p)
    assert time.monotonic() - START < 115
    assert resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == 'darwin' else 1024) <= 256 * 2 ** 20
    if name in BANK:
        b = BANK[name]
        got = PINS[name]
    else:
        assert p.is_absolute() and p.resolve(strict=True) == p and (not p.is_symlink())
        st = p.stat()
        assert p.is_file() and st.st_size <= 4 * 2 ** 20
        b = p.read_bytes()
        after = p.stat()
        signature = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
        assert signature(after) == signature(st)
        READ += len(b)
        assert READ <= 64 * 2 ** 20
        got = dict(path=name, bytes=len(b), sha256=hashlib.sha256(b).hexdigest())
        PINS[name] = got
        BANK[name] = b
        assert len(BANK) <= 512
    if r is not None:
        assert got == r, (got, r)
    return (b, got)

def doc(p, r=None):
    b, rr = raw(p, r)
    return (json.loads(b), rr)

def get(r):
    return doc(r['path'], r)[0]

def enc(v):
    return json.dumps(v, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode('ascii') + b'\n'

def save(p, v):
    b = enc(v)
    with p.open('xb') as f:
        f.write(b)
        f.flush()
        os.fsync(f.fileno())
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

def white(b, i):
    while i < len(b) and b[i] in b' \r\n\t':
        i += 1
    return i

def endstr(b, i):
    assert b[i] == 34
    i += 1
    while i < len(b):
        if b[i] == 92:
            i += 2
        elif b[i] == 34:
            return i + 1
        else:
            i += 1
    raise ValueError('string')

def end(b, i):
    if b[i] == 34:
        return endstr(b, i)
    if b[i] in b'[{':
        stack = [b[i]]
        i += 1
        while stack:
            if b[i] == 34:
                i = endstr(b, i)
                continue
            if b[i] in b'[{':
                stack.append(b[i])
            elif b[i] in b']}':
                assert (stack.pop(), b[i]) in ((91, 93), (123, 125))
            i += 1
        return i
    while i < len(b) and b[i] not in b',]} \r\n\t':
        i += 1
    return i

def fields(b):
    i = white(b, 0)
    assert b[i] == 123
    i = white(b, i + 1)
    out = {}
    while b[i] != 125:
        j = endstr(b, i)
        k = json.loads(b[i:j])
        assert k not in out
        i = white(b, j)
        assert b[i] == 58
        i = white(b, i + 1)
        j = end(b, i)
        out[k] = b[i:j]
        i = white(b, j)
        if b[i] == 44:
            i = white(b, i + 1)
        else:
            assert b[i] == 125
    assert white(b, i + 1) == len(b)
    return out

def array(b):
    i = white(b, 0)
    assert b[i] == 91
    i = white(b, i + 1)
    out = []
    while b[i] != 93:
        j = end(b, i)
        out.append(b[i:j])
        i = white(b, j)
        if b[i] == 44:
            i = white(b, i + 1)
        else:
            assert b[i] == 93
    assert white(b, i + 1) == len(b)
    return out

