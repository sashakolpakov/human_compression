  need(rss<128*2**20 and time.monotonic()-START<125,'hard125s128MiB verifier envelope')
 def read(self,r,again=False):
  self.tick();need(type(r)is dict and set(r)=={'path','bytes','sha256'}and type(r['path'])is str
   and type(r['bytes'])is int and 0<=r['bytes']<=2**21 and type(r['sha256'])is str
   and len(r['sha256'])==64 and set(r['sha256'])<=set('0123456789abcdef'),'complete bounded input reference')
  need(self.refs.get(r['path'],r)==r,'one immutable version per path')
  if r['path']in self.raw and not again:return self.raw[r['path']]
  need(self.bytes+r['bytes']<=8*2**20 and(r['path']in self.refs or len(self.refs)<96),'96 files8MiB including every real reread')
  p=Path(r['path']);a=p.lstat();need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
   and a.st_nlink==1 and a.st_size==r['bytes'],'canonical single-link bounded input')
  with p.open('rb')as f:b=os.fstat(f.fileno());raw=f.read(r['bytes']+1);c=os.fstat(f.fileno())
  sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
  need(sig(a)==sig(b)==sig(c)==sig(p.lstat())and len(raw)==r['bytes']
   and hashlib.sha256(raw).hexdigest()==r['sha256'],'whole stable physical input')
  self.refs[r['path']]=r;self.raw[r['path']]=raw;self.bytes+=len(raw);return raw
