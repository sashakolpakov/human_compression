def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def integer(value, maximum, reason):
    need(type(value) is int and 0 <= value <= maximum, reason)
    return value


def descriptor(ref):
    need(type(ref) is dict and set(ref) == {'path', 'bytes', 'sha256'}, 'whole descriptor')
    path(ref['path'])
    integer(ref['bytes'], 4*MIB, 'bounded descriptor bytes')
    need(type(ref['sha256']) is str and len(ref['sha256']) == 64
         and set(ref['sha256']) <= set('0123456789abcdef'), 'lowercase SHA256')
    return ref


def path(text):
    need(type(text) is str and 0 < len(text) <= 1024
         and all(32 <= ord(c) < 127 and c not in ('"', '\\') for c in text),
         'finite unescaped ASCII path')
    p = Path(text)
    need(p.is_absolute() and str(p) == text and '..' not in p.parts,
         'normalized absolute path')
    return p


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                       ensure_ascii=True, allow_nan=False)+'\n').encode('ascii')


def whole(ref):
    descriptor(ref)
    p = path(ref['path'])
    before = p.lstat()
    signature = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_nlink,
                           s.st_size, s.st_mtime_ns, s.st_ctime_ns)
    need(p.resolve(strict=True) == p and stat.S_ISREG(before.st_mode)
         and before.st_nlink == 1 and before.st_size == ref['bytes'],
         'canonical single-link complete input')
    with os.fdopen(os.open(p, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as stream:
        opened = os.fstat(stream.fileno())
        raw = stream.read(ref['bytes']+1)
        closed = os.fstat(stream.fileno())
    need(signature(before) == signature(opened) == signature(closed) == signature(p.lstat())
         and len(raw) == ref['bytes'] and hashlib.sha256(raw).hexdigest() == ref['sha256'],
         'stable complete input SHA and EOF')
    return raw


def decode(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            need(key not in out, 'unique JSON keys')
            out[key] = value
        return out
    def bad(_):
        raise ValueError('nonfinite JSON')
    def finite(text):
        value = float(text)
        need(math.isfinite(value), 'finite JSON float')
        return value
    return json.loads(raw, object_pairs_hook=pairs, parse_float=finite, parse_constant=bad)


def document(ref):
    return decode(whole(ref))


def validate_inventory(budget):
    rows = budget['inventory']
    need(type(rows) is list and len(rows) <= 512, 'at most512 explicit write paths')
    totals = {key: 0 for key in CAPS}
    counts = {key: 0 for key in CAPS}
    seen = set()
    for row in rows:
        need(type(row) is dict and set(row) == {'component', 'path', 'maximum_bytes', 'existing'},
             'complete typed inventory row')
        component = row['component']
        need(type(component) is str and component in CAPS, 'known writer component')
        p = path(row['path'])
        need(p.is_relative_to(path(budget['volume'])) or p.is_relative_to('/private/tmp'),
             'declared project-volume or private temporary writer')
        need(str(p) not in seen, 'every destination and staging path charged exactly once')
        seen.add(str(p))
        maximum = integer(row['maximum_bytes'], CAPS[component], 'finite per-path bound')
        if component in ('sdk', 'retention', 'images'):
            need(maximum <= 4*MIB, '4MiB per SDK/copy/image path')
        if component == 'primary':
            need(maximum <= (131072 if budget['role_kind'] == 'science' else 4*MIB),
                 'unchanged science output or bounded metadata body')
        if row['existing'] is not None:
            descriptor(row['existing'])
            need(component in ('retention', 'images') and row['existing']['path'] == str(p)
                 and row['existing']['bytes'] <= maximum, 'only exact equal retained targets may be reused')
        totals[component] += maximum
        counts[component] += 1
        need(totals[component] <= CAPS[component], 'component subtotal bound')
    need(counts['sdk'] == 2 and counts['retention'] <= 512
         and counts['primary'] <= (2 if budget['role_kind'] == 'science' else 8),
         'exact two SDK destinations and bounded primary/copy counts')
    guard = path(budget['guard'])
    expected = {str(guard/name): maximum for name, maximum in (
        ('stdout.log', 262144), ('stderr.log', 262144), ('started.json', 131072),
        ('receipt.json', 131072), ('started.json.staged', 131072), ('receipt.json.staged', 131072))}
    actual = {row['path']: row['maximum_bytes'] for row in rows if row['component'] == 'guard'}
    need(actual == expected, 'all six exact guard log/record/staging allowances')
    if budget['role_kind'] == 'science':
        projection = budget['command_projection']
        need('--out' in projection, 'science output is explicit')
        out = path(projection[projection.index('--out')+1])
        primary = {row['path']: row['maximum_bytes'] for row in rows if row['component'] == 'primary'}
        need(primary == {str(out/'result.json'): 131072, str(out/'certificate.json'): 131072},
             'only the unchanged two128KiB scientific writers')
    metadata_cas_declarations(budget)
    need(sum(totals.values())+ALLOWANCE <= 169*MIB <= RESERVE, 'typed169MiB ledger inside256MiB reserve')
    return dict(totals=totals, counts=counts, content_upper=sum(totals.values()),
                allocation_allowance=ALLOWANCE, declared_upper=sum(totals.values())+ALLOWANCE)



def metadata_cas_declarations(budget):
    rows = budget.get('metadata_cas_targets', [])
    need(type(rows) is list, 'typed optional metadata CAS list')
    if not rows:
        return []
    need(budget['role_kind'] == 'metadata' and budget['role'] == 'register.py'
         and len(rows) == 2, 'only the reviewed two-pointer registrar may replace metadata')
    inventory = {row['path']: row for row in budget['inventory']}
    targets, stages = set(), set()
    for row in rows:
        need(type(row) is dict and set(row) == {'path', 'existing', 'staged_path', 'maximum_bytes'},
             'complete metadata CAS declaration')
        target, stage = str(path(row['path'])), str(path(row['staged_path']))
        maximum = integer(row['maximum_bytes'], 4*MIB, 'bounded new canonical metadata body')
        old = descriptor(row['existing'])
        need(target in CAS_PATHS and old['path'] == target and old['bytes'] <= maximum
             and target not in targets and stage not in stages and stage not in CAS_PATHS,
             'two fixed canonical pointers, exact old refs and distinct fresh images')
        expected = dict(component='images', path=target, maximum_bytes=maximum, existing=old)
        staged = dict(component='images', path=stage, maximum_bytes=maximum, existing=None)
        need(inventory.get(target) == expected and inventory.get(stage) == staged,
             'both canonical and stage bodies are explicitly billed to images')
        targets.add(target); stages.add(stage)
    need(targets == set(CAS_PATHS), 'complete fixed two-pointer set')
    return rows


def validate_metadata_cas(budget, peer, replacements):
    rows = metadata_cas_declarations(budget)
    need(rows and budget['role_source'] in peer['metadata_cas_programs'],
         'distinct combined Source peer explicitly admits this metadata CAS program')
    need(type(replacements) is list and len(replacements) == 2, 'both concrete replacements before any write')
    declarations = {row['path']: row for row in rows}
    planned, seen = [], set()
    for item in replacements:
        need(type(item) is dict and set(item) == {'path', 'staged_path', 'old_ref', 'new_body_bytes'},
             'complete in-memory canonical replacement')
        row = declarations.get(item['path'])
        need(row is not None and item['path'] not in seen and item['staged_path'] == row['staged_path']
             and item['old_ref'] == row['existing'] and type(item['new_body_bytes']) is bytes,
             'actual replacement joins its exact frozen old pointer and declared stage')
        need(len(item['new_body_bytes']) <= row['maximum_bytes'], 'actual new canonical body fits its declaration')
        seen.add(item['path'])
        planned.extend([('images', row['staged_path'], item['new_body_bytes']),
                        ('images', row['path'], item['new_body_bytes'])])
    preflight_writes(budget, planned)
    return planned


