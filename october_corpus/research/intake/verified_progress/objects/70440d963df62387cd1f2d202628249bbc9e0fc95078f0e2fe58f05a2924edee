def preflight_targets(budget):
    volume = path(budget['volume'])
    need(volume.resolve(strict=True) == volume and volume.is_dir(), 'canonical existing monitored volume')
    device = volume.stat().st_dev
    need(not os.path.lexists(budget['guard']), 'fresh guard output directory')
    missing_directories = set()
    for row in budget['inventory']:
        target = path(row['path'])
        ancestor = target.parent
        while not ancestor.exists():
            need(not ancestor.is_symlink(), 'no dangling symbolic ancestry')
            missing_directories.add(str(ancestor))
            need(len(missing_directories) <= 1024, 'bounded new directory/index allocation allowance')
            ancestor = ancestor.parent
        need(ancestor.resolve(strict=True) == ancestor and ancestor.is_dir()
             and ancestor.stat().st_dev == device, 'canonical same-volume writer destination')
        if os.path.lexists(target):
            need(row['existing'] is not None, 'fresh writer target or explicit exact reuse only')
            whole(row['existing'])


def preflight_writes(budget, planned):
    need(type(planned) is list and len(planned) <= 512, 'finite serialized write transaction')
    inventory = {row['path']: row for row in budget['inventory']}
    seen, totals = set(), {key: 0 for key in CAPS}
    for component, target, body in planned:
        target = str(path(str(target)))
        need(component in CAPS and type(body) is bytes and target not in seen, 'one exact byte body per destination')
        row = inventory.get(target)
        need(row is not None and row['component'] == component and len(body) <= row['maximum_bytes'],
             'actual serialized bytes fit the declared writer/path bound')
        totals[component] += len(body)
        need(totals[component] <= CAPS[component], 'actual transaction component subtotal')
        seen.add(target)
    return totals


def write_files(budget, planned):
    preflight_writes(budget, planned)
    canonical_cas = {row['path'] for row in metadata_cas_declarations(budget)}
    need(all(str(target) not in canonical_cas for component, target, body in planned),
         'canonical CAS is performed only by the separately reviewed fixed-path registrar')
    inventory = {row['path']: row for row in budget['inventory']}
    # Every body, path, multiplicity and existing equal target is checked before
    # the first open. Unlisted writes remain forbidden in the admitted caller.
    for component, target, body in planned:
        p = path(str(target)); row = inventory[str(p)]
        if os.path.lexists(p):
            need(row['existing'] is not None and whole(row['existing']) == body, 'existing target is exact reusable bytes')
        else:
            ancestor = p.parent
            while not ancestor.exists():
                ancestor = ancestor.parent
            need(ancestor.resolve(strict=True) == ancestor, 'canonical writer parent')
    refs = []
    for component, target, body in planned:
        p = path(str(target))
        if os.path.lexists(p):
            need(inventory[str(p)]['existing'] is not None, 'no raced undeclared existing output')
        else:
            p.parent.mkdir(parents=True, exist_ok=True)
            need(p.parent.resolve(strict=True) == p.parent, 'canonical final writer parent')
            with p.open('xb') as stream:
                need(stream.write(body) == len(body), 'whole exclusive write')
                stream.flush(); os.fsync(stream.fileno())
        ref = dict(path=str(p), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())
        need(whole(ref) == body, 'whole stable output readback')
        refs.append(ref)
    return refs
