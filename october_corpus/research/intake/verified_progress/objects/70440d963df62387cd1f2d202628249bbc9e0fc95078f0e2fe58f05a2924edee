def executed_role_projection(budget):
    # Only this exact Core controls entry may use the trusted platform site
    # needed by the original guard's psutil. All ordinary roles keep E-B-S.
    flags = ['-E', '-B'] if budget['role_kind'] == 'controls' else ['-E', '-B', '-S']
    prefix = [TRUSTED_PYTHON] + flags + [budget['role_source']['path']]
    need(budget['command_projection'][:len(prefix)] == prefix,
         'exact trusted interpreter, flags and actual reviewed script slot; no code-mode or unused-path bypass')


def resolve_projection(projection, bindings):
    need(type(projection) is list and 1 <= len(projection) <= 128, 'bounded command projection')
    used, output = set(), []
    for token in projection:
        if type(token) is str:
            need(len(token) <= 4096 and '\x00' not in token, 'literal argument')
            output.append(token)
        else:
            need(type(token) is dict and set(token) == {'reference', 'part'}
                 and token['reference'] in ('budget', 'request', 'Root_gate')
                 and token['part'] in PARTS, 'typed dependent descriptor slot')
            label = token['reference']
            used.add(label)
            if bindings is not None:
                ref = descriptor(bindings[label])
                output.append(str(ref[token['part']]))
    for label in used:
        indexes = [i for i, token in enumerate(projection)
                   if type(token) is dict and token['reference'] == label]
        need(len(indexes) == 2 and indexes[1] == indexes[0]+1 and indexes[0] >= 1
             and projection[indexes[0]]['part'] == 'bytes'
             and projection[indexes[1]]['part'] == 'sha256', 'one adjacent bytes/SHA pair per typed reference')
        if bindings is not None:
            need(projection[indexes[0]-1] == bindings[label]['path'],
                 'literal argument path and referenced descriptor path are identical')
    if bindings is not None:
        need(set(bindings) == used | {'budget'}, 'no extra or omitted launch reference bindings')
        need(sum(len(x.encode('utf-8')) for x in output) <= 16384, 'bounded exact command encoding')
    return output


