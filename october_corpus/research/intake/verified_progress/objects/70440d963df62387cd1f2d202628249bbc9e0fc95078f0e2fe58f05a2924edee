         'fixed explicit256MiB reserve')
    need(path(budget['volume']) == path(str(volume)) and path(budget['guard']) == path(str(guard)),
         'exact monitored volume and fresh guard')
    for key in ('profile_source', 'policy_source', 'Source_peer', 'role_manifest', 'role_source', 'caller_source'):
        descriptor(budget[key])
