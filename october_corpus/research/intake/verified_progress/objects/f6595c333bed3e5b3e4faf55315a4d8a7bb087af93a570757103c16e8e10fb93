def pin(path):
    p = Path(path)
    n = p.stat().st_size
    assert n <= 4*1024**2
    with p.open('rb') as f:
        body = f.read(n + 1)
    assert len(body) == n
    ref = dict(path=str(p), bytes=n, sha256=hashlib.sha256(body).hexdigest())
    pins[str(p)] = ref
    return body, ref

def get(ref):
    b, actual = pin(ref['path'])
    assert actual == ref
    return b

def doc(path):
    b, ref = pin(path)
    return json.loads(b), ref

def same(a, b):
    assert json.dumps(a, sort_keys=True) == json.dumps(b, sort_keys=True)

def ws(b, i):
    while i < len(b) and b[i] in b' \t\r\n':
        i += 1
    return i

def string_end(b, i):
    assert b[i] == 34
    i += 1
    while i < len(b):
        if b[i] == 92:
            i += 2
        elif b[i] == 34:
            return i+1
        else:
            i += 1
    raise ValueError('unterminated string')

def value_end(b, i):
    if b[i] == 34:
        return string_end(b, i)
    if b[i] in b'[{':
        stack = [b[i]]
        i += 1
        while stack:
            assert i < len(b) and len(stack) < 4096
            if b[i] == 34:
                i = string_end(b, i)
                continue
            if b[i] in b'[{':
                stack.append(b[i])
            elif b[i] in b']}':
                assert (stack.pop(), b[i]) in ((91,93), (123,125))
            i += 1
        return i
    start = i
    while i < len(b) and b[i] not in b',]} \t\r\n':
        i += 1
    assert i > start
    return i

def fields(b):
    """Return complete raw value spans; never decode the parents field."""
    i = ws(b, 0)
    assert b[i] == 123
    i = ws(b, i+1)
    out = {}
    while b[i] != 125:
        end = string_end(b, i)
        key = json.loads(b[i:end])
        assert key not in out
        i = ws(b, end)
        assert b[i] == 58
        i = ws(b, i+1)
        end = value_end(b, i)
        out[key] = b[i:end]
        i = ws(b, end)
        if b[i] == 44:
            i = ws(b, i+1)
        else:
            assert b[i] == 125
    assert ws(b, i+1) == len(b)
    return out

