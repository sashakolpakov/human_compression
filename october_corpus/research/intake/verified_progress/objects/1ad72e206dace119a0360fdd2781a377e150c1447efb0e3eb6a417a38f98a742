    assert not (rawdir/('frame_%04d.json'%len(frames))).exists()
    if argv[:5] == ['/Users/sasha/.venvs/global/bin/python', '-E', '-B', '-S', '-c']:
        ast.parse(argv[5])
    return data, ref

def guarded(name):
    data, ref = sdk(name)
    argv = data['issued_argv']
    assert argv[0] == '/usr/bin/env'
    split = argv.index('--')
    child = argv[split+1:]
    guard = Path(argv[argv.index('--output')+1])
    wrapper = Path(argv[14])
    # Environment omission order is immaterial, but all five pairs are exact.
    omitted = argv[1:11]
    assert omitted[::2] == ['-u']*5
    assert set(omitted[1::2]) == {'COVERAGE_PROCESS_START', 'COVERAGE_PROCESS_CONFIG', 'COVERAGE_CONFIG', 'OPENSSL_CONF', 'OPENSSL_MODULES'}
    assert argv[11:14] == ['/Users/sasha/.venvs/global/bin/python', '-E', '-B']
    science = wrapper.name == 'supervise_matrix.py'
    assert wrapper.name in ('supervise_matrix.py', 'supervise_validation.py')
    assert child[:4] == ['/Users/sasha/.venvs/global/bin/python', '-E', '-B', '-S']
    start, sr = document(guard/'started.json')
    receipt, rr = document(guard/'receipt.json')
    assert start['command'] == receipt['command'] == child
    ram = 3*2**30+128*2**20+512*2**20 if science else 4*2**30
    limits = dict(admit_disk=10*2**30, admit_ram=ram, disk_floor=8*2**30, ram_floor=3*2**30,
                  total_rss=(128 if science else 256)*2**20, wall_seconds=125.0,
                  sample_seconds=.5, log_bytes_each=262144, metadata_bytes_each=131072, owned_pids=128)
    assert start['limits'] == receipt['limits'] == limits
    assert start['admission'] == receipt['admission']
    assert start['admission']['free_disk'] >= limits['admit_disk'] and start['admission']['available_ram'] >= limits['admit_ram']
    assert receipt['status'] == 'PASS' and receipt['stop'] == 'RETURNED' and receipt['returncode'] == 0 and receipt['error'] is None
    assert receipt['cleanup']['remaining'] == receipt['cleanup']['errors'] == []
    assert len(start['identities']) == len(receipt['identities']) == 1
    for k in ('pid', 'birth', 'initial_parent', 'group', 'session'):
        assert start['identities'][0][k] == receipt['identities'][0][k]
    assert receipt['seconds'] < 125 and receipt['peaks']['total_rss'] <= limits['total_rss']
    assert receipt['peaks']['min_free_disk'] >= limits['disk_floor'] and receipt['peaks']['min_available_ram'] >= limits['ram_floor']
    stdout, sout = document(guard/'stdout.log')
    err, serr = read(guard/'stderr.log')
    assert not err and receipt['logs'] == dict(stdout=sout['bytes'], stderr=0)
    assert list((guard/'tmp').iterdir()) == []
    assert json.loads(''.join(f['output'] for f in data['all_genuine_api_frames'])) == dict(status='PASS', stop='RETURNED', receipt=str(guard/'receipt.json'))
    return dict(SDK=ref, started=sr, receipt=rr, stdout=sout, stderr=serr,
                child=child, result=stdout, limits=limits, peaks=receipt['peaks'], seconds=receipt['seconds'])

