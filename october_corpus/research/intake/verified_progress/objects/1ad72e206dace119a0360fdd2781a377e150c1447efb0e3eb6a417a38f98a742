def read(path, expected=None):
    global reads
    path = Path(path)
    before = path.lstat()
    assert path.is_absolute() and path.resolve() == path
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1
    assert 0 <= before.st_size <= 4*2**20
    raw = path.read_bytes()
    after = path.lstat()
    assert (before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) == (after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
    ref = dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
    assert expected is None or ref == expected
    assert pins.get(str(path), ref) == ref
    pins[str(path)], bodies[str(path)] = ref, raw
    reads += len(raw)
    assert reads <= 64*2**20 and len(pins) <= 512
    return raw, ref

def document(path, expected=None):
    raw, ref = read(path, expected)
    return json.loads(raw), ref

def space(raw, i):
    while i < len(raw) and raw[i] in b' \r\n\t':
        i += 1
    return i

def finish_value(raw, i):
    stack, quoted, escape = [], False, False
    while i < len(raw):
        x = raw[i]
        if quoted:
            if escape:
                escape = False
            elif x == 92:
                escape = True
            elif x == 34:
                quoted = False
        elif x == 34:
            quoted = True
        elif x in (91, 123):
            stack.append(x)
        elif x in (93, 125):
            if not stack:
                break
            assert stack.pop() == (91 if x == 93 else 123)
        elif x == 44 and not stack:
            break
        i += 1
    assert not stack and not quoted
    return i

def fields(raw):
    i, result = space(raw, 0), {}
    assert raw[i] == 123
    i = space(raw, i+1)
    while raw[i] != 125:
        j = finish_value(raw, i)
        item = raw[i:j]
        colon = item.find(b':')
        key = json.loads(item[:colon])
        assert type(key) is str and key not in result
        result[key] = item[colon+1:].strip()
        i = space(raw, j)
        if raw[i] == 44:
            i = space(raw, i+1)
        else:
            break
    assert raw[i] == 125 and space(raw, i+1) == len(raw)
    return result

def array(raw):
    i, result = space(raw, 0), []
    assert raw[i] == 91
    i = space(raw, i+1)
    while raw[i] != 93:
        j = finish_value(raw, i)
        result.append(raw[i:j].strip())
        i = space(raw, j)
        if raw[i] == 44:
            i = space(raw, i+1)
        else:
            break
    assert raw[i] == 93 and space(raw, i+1) == len(raw)
    return result

def selected(raw, keys):
    prohibited = {'records', 'checked_records', 'certificate', 'matrices', 'context', 'frame_key', 'catalogue', 'orbits'}
    assert not prohibited.intersection(keys)
    data = fields(raw)
    return {k: json.loads(data[k]) for k in keys if k in data}

def packed_fields(path, expected=None):
    raw, ref = read(path, expected)
    decoder = zlib.decompressobj(16+zlib.MAX_WBITS)
    logical = decoder.decompress(raw, 4*2**20+1)
    assert decoder.eof and not decoder.unconsumed_tail and len(logical) <= 4*2**20
    return logical, ref

def expand(runs):
    out, last = [], 0
    for lo, hi in runs:
        assert type(lo) is type(hi) is int and last < lo <= hi <= 807
        out.extend(range(lo, hi+1))
        last = hi
    return out

