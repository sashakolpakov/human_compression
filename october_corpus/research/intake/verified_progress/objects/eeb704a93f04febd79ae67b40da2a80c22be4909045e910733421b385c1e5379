import common as C
import budget,point_kernel as K,frame,bindings,fixed_subset as F

SCOPE='7795d9d9d4bbf392cb5a943053372149950eef15d4bd468a63e0cc41f5fcce3a'
CHECKER='07d4654718c10795635e7dbda66555b4929285f6e699339bf60b683d353d3751'
CURRENT='/Users/sasha/medusa/research/leemans/maintenance/intake/l026_fi22_neighborhood_orbits/operations/triangle_quotients/paid_status_ledger/CURRENT.json'
DUTIES=('named_inner_Fi22_simple_perfect_transitive_degree3510_owned',
 'same_original_endpoint_reader_member_model_H_two_fibre_scope_owned',
 'same_d0_ordered_A_signed_tree_full_equivariant_bridge_owned',
 'same_actual_singleton351_subset_and_endpoint_invariance_owned',
 'fresh_unissued_batch_current_unpaid_no_bookkeeping_replay_and_known_duplicates_skipped_owned',
 'untrusted_candidates_only_old_Saved_checker_required_owned')

def main():
    b,q,g,pins,out=C.start('propose.py',(C,budget,K,frame,bindings,F));C.admission(b,g,pins)
    C.need(q['schema']=='L026_FIXED_SUBSET_PROPOSER_REQUEST_V1','fixed subset request')
    imp=b.doc(q['Root_import']);header=q['old_checker_header'];scope=header['scope'];pair=q['pair']
    C.need(imp['root']=='/root'and imp['Root_authority']is imp['adopted']is True and imp['manifest']==pins['manifest']
        and all(imp[k]is True for k in DUTIES),'new explicit Root ownership, including no bookkeeping replay')
    for k in('pair','old_checker_header','cases','context','known_identical_prior_rows'):C.need(imp[k]==q[k],'exact Root input binding '+k)
    C.need(header['schema']=='L026_PROCEDURAL_GEN_NEG_CARRIER_V1'and header['Source_manifest']['sha256']==CHECKER,'old checker ABI, never a new proof identity')
    C.need(set(header)=={'schema','Source_manifest','Root_import','procedural_D_import','scope','family_key','operands','witness_bank','current_snapshot'},'complete old certificate header')
    C.need(len(C.can(header))<=24576 and type(scope['context'])is list and len(scope['context'])<=12
        and sum(C.ref(r)['bytes']for r in scope['context'])<=32768,'old Saved header and context bounds')
    C.need(scope['degree']==3510 and scope['rows']==28908 and scope['original_scope_digest']==SCOPE,'same original selector')
    cases=q['cases'];C.need(type(cases)is list and 1<=len(cases)<=8,'bounded old checker batch')
    C.need(type(q['context'])is list and len(q['context'])<=12 and sum(C.ref(r)['bytes']for r in q['context'])<=900000,'whole accepted premise context')
    C.need(set(pair)=={'certificate','proof','actual_review'},'one existing accepted endpoint pair')
    snap=header['current_snapshot'];C.need(set(snap)=={'CURRENT','receipt','bank'}and snap['CURRENT']['path']==CURRENT
        and sum(C.ref(r)['bytes']for r in snap.values())<=65536,'whole live canonical typed snapshot')
    refs=q['context']+list(pair.values())+[header[k]for k in('Source_manifest','Root_import','procedural_D_import','operands','witness_bank')]+list(snap.values())
    # At most3 D factors, each42 charged point units, for351 points and8 cases.
    # Shape, complete frame, bookkeeping and publication retain explicit slack.
    F.fits(b,refs,1500000+513000*len(cases))
    for r in q['context']:b.read(r)
    proof=b.doc(pair['proof']);review=b.doc(pair['actual_review']);native=b.read(pair['certificate'])
    C.need(proof['schema']=='L026_SUBSET_PAIR_PROOF_V1'and proof['status']=='VERIFIED_ENDPOINT_PAIR'and proof['mode']=='pair'
        and proof['subset_size']==351 and proof['members']==1 and proof['endpoint_pair_checks']is True
        and proof['certificate']==pair['certificate'],'accepted singleton subset claim')
    C.need(review['schema']=='L026_SUBSET_PAIR_ACTUAL_REUSE_V1'and review['status']=='SUPPORTED_ACTUAL_ENDPOINT_PAIR_ONLY'
        and review['reviewer']not in('/root','/root/artifact_audit')and review['blockers']==[]and review['actual_guard_and_raw_frames_verified']is True
        and review['whole_Source_and_inputs_closed']is True and review['certificate']==pair['certificate']and review['proof']==pair['proof'],'exact borrowed pair actual review')
    for v in(proof,review):
        C.need(v['scope']=={k:scope[k]for k in('degree','root','rows','original_scope_digest','selector')}
            and v['family_key']==header['family_key']and v['operands']==header['operands'],'same pair/model/endpoint/bridge')
    points=F.subset_from_pair(native,b.work)
    for k in('Source_manifest','Root_import','procedural_D_import'):b.read(header[k])
    ctx,nodes,key=frame.frame(K,b.read(header['operands']),b.work)
    C.need(key==header['family_key'],'actual complete d0/orderedA/tree frame key')
    cur=b.doc(snap['CURRENT']);receipt=b.doc(snap['receipt']);status=b.read(snap['bank'])
    C.need(cur['schema']=='ROOT_CURRENT_L026_TYPED_PAID_STATUS_LEDGER_V1'and cur['root']=='/root'and cur['adopted']is True
        and cur['scope_digest']==SCOPE and cur['ledger_receipt']==snap['receipt']and cur['status_bank']==snap['bank']
        and receipt['status_bank']==snap['bank']and receipt['scope_digest']==SCOPE and receipt['witness_bank']==header['witness_bank'],'same fresh canonical typed scope')
    C.need(len(status)==28908 and header['witness_bank']['bytes']==462528,'whole business status and original witness domain')
    witness=b.read(header['witness_bank']);selected,skipped=F.unpaid_cases(cases,status,q['known_identical_prior_rows'])
    C.need(selected,'no fresh selected row remains; do not issue an empty old Saved batch')
    old_import=b.doc(header['Root_import'])
    C.need(old_import['root']=='/root'and old_import['Root_authority']is old_import['adopted']is True
        and old_import['manifest']==header['Source_manifest']and old_import['cases']==selected,'old checker import binds exactly the effective fresh rows')
    records,checked=F.propose_batch(K,ctx,points,selected,witness,bindings.binding,b.work)
    carrier=dict(header,records=records);body=C.can(carrier);C.need(len(body)<=65536,'old bounded canonical Saved carrier')
    b.close()
    note=dict(schema='L026_FIXED_SUBSET_UNTRUSTED_PROPOSER_PROOF_V1',status='UNTRUSTED_FIXED_SUBSET_HINTS_FINISHED',pins=pins,
        Root_import=q['Root_import'],pair=pair,old_checker_header=header,cases=selected,requested_cases=cases,
        skipped_known_identical_prior_rows=skipped,fixed_subset_size=351,
        proposed_proper=sum(r['outcome']=='PROPER_HINT'for r in records),misses_unpaid=True,checked_subset_edges=checked,
        full_middle_product_checked_not_factorwise=True,old_checker_still_required=True,no_GEN_IP_or_class_or_case_credit=True,
        no_full_D_maps_generated_or_imported=True,no_scientific_success_or_old_fullmap_equation_replayed=True,
        physical_reads=b.bytes,point_units=b.work.units,canonical_writes=0)
    files=b.emit(out,{'certificate.json':body,'proof.json':C.can(note)})
    print(C.can(dict(status=note['status'],outputs=files,new_case_credit=0,old_strict_Saved_and_actual_review_required=True)).decode(),end='')
if __name__=='__main__':main()
