def closer_actual(L,c,dr,h,hr,sr,s):
 control=Path(hr['path']).parent
 sdkref=refat(L,control/'Root_SDK'/'close_summary_v1.json')
 d=pure(L,sdkref)
 key='Root_f009_cohort%04d_close_summary_v1'%h['begin']
 attemptsref=pure(L,dr)['metadata_attempts']
 if c['_owner_V2']:
  p=c['_preparation']
  assert s['closer_program']==c['closer_program'] and s['closer_Source_peer']==c['preparation_peer']
  assert s['preparation_packet']==c['preparation_packet'] and s['preparation_Source_manifest']==p['entry_manifests']['close_cohort.py']
  stem=[PY,'-E','-B','-S',c['closer_program']['path'],'--actor','/root','--cohort']+trip(hr)
  peerargs=['--Source-peer']+trip(c['preparation_peer'])
  retryargs=['--attempts']+trip(attemptsref)
  candidates=[stem+peerargs,stem+peerargs+retryargs,stem+retryargs+peerargs]
 else:
  owner=pure(L,refat(L,control/'Root_close_Source_ownership.json'))
  assert owner['root']=='/root' and owner['Root_authority'] is True and owner['program']==c['closer_program'] and owner['independent_Source_peer']==c['legacy_closer_peer']
  candidates=[[PY,'-E','-B','-S',c['closer_program']['path'],hr['path'],attemptsref['path']]]
 argv=d['issued_argv']
 if argv in candidates:
  api(L,sdkref,key,argv,True)
  printed=json.loads(d['full_tool_return']['output'])
  mode='Root API execution of the reviewed self-bounded metadata entry'
 else:
  child=argv[argv.index('--')+1:]
  assert child in candidates
  guard=argv[argv.index('--output')+1]
  printed,_=actual(L,sdkref,key,child,guard,False)
  mode='Root API execution under the existing metadata supervisor'
 assert printed['summary']==sr
 if c['_owner_V2']:
  assert printed['metadata_phase_attempts']==attemptsref and printed['registered_prefix_unchanged']==h['begin']
 return dict(actual_SDK=sdkref,raw_key=key,execution_mode=mode)

def aggregate_audit(L,a,state):
 config,configref,decisionref,cohort,cohortref,packet,sm,tm,roster,parents,overrides,source_total=state
 assert a.batch is None and a.batch_review and len(a.batch_review)==len(cohort['batches'])
 entries=[]
 for b,args in zip(cohort['batches'],a.batch_review):
  r=descriptor(args)
  h=pure(L,r)
  assert h['schema']=='F009_COHORT_BATCH_ACTUAL_REUSE_V1' and h['status']=='SUPPORTED_ACTUAL' and h['reviewer']==REVIEWER and h['blockers']==[]
  assert h['cohort']==cohortref and h['progress_snapshot']==cohort['progress_snapshot'] and h['current_roster']==roster
  assert h['source_indices']==b['source_indices'] and h['batch']==b['batch'] and h['parent_count']==len(b['source_indices']) and h['strict_slots']==156*h['parent_count']
  full=pure(L,h['full_actual_review'])
  assert full['program']==config['programs']['audit_batch.py'] and full['common']==config['common'] and full['config']==configref and full['status']=='SUPPORTED_ACTUAL' and full['blockers']==[]
  assert full['Root_decision']==decisionref and full['cohort']==cohortref and full['batch']==b['batch']
  assert full['Original_payloads_decoded_by_this_actual'] is False and full['scientific_executions']==0 and full['canonical_writes']==0
  assert full['first_closing_inputs_stable'] is True
  raw(L,h['pairing'])
  raw(L,h['strict_certificate'])
  raw(L,h['assembled_certificate'])
  for flag in BATCH_TRUE:
   assert h[flag] is True
  sdkref=descriptor(a.batch_SDK[b['batch']])
  d=pure(L,sdkref)
  argv=d['issued_argv']
  child=argv[argv.index('--')+1:]
  assert child[:5]==[PY,'-E','-B','-S',config['programs']['audit_batch.py']['path']]
  assert child[child.index('--batch')+1]==str(b['batch'])
  assert child[child.index('--config')+1:child.index('--config')+4]==trip(configref)
  assert child[child.index('--Root-decision')+1:child.index('--Root-decision')+4]==trip(decisionref)
  guard=child[child.index('--guard')+1]
  stdout,outputs=actual(L,sdkref,a.batch_key[b['batch']],child,guard,False)
  assert outputs==[h['full_actual_review'],r]
  entries.append(dict(b,parent_count=h['parent_count'],strict_slots=h['strict_slots'],target_occurrences=h['target_occurrences'],pairing=h['pairing'],actual_review=r))
 summaryref=refat(L,Path(cohortref['path']).parent/'cohort_actual_summary.json')
 summary=pure(L,summaryref)
 assert summary['schema']=='ROOT_F009_COMPLETED_COHORT_ACTUAL_SUMMARY_V1' and summary['cohort']==cohortref and summary['source_indices']==cohort['source_indices']
 assert summary['strict_slots']==156*(cohort['end']-cohort['begin']) and summary['target_occurrences']==sum(e['target_occurrences'] for e in entries)
 assert summary['scientific_roles']==cohort['end']-cohort['begin']+len(entries) and summary['metadata_phases']==3*len(entries)
 assert summary['all_scientific_roles_terminal_first_v1'] is True and summary['cache_registration_performed'] is False and summary['whole_R5_or_census_credit'] is False
 assert summary['all_roles_terminal_first_v1'] is (not bool(overrides)) and summary['metadata_phase_attempts']==pure(L,decisionref)['metadata_attempts']
 assert summary['frozen_progress_snapshot']==cohort['progress_snapshot']
 assert len(summary['batches'])==len(entries)
 for sb,entry,args in zip(summary['batches'],entries,a.batch_review):
  h=pure(L,descriptor(args))
  full=pure(L,h['full_actual_review'])
  assert sb['batch']==entry['batch'] and sb['pairing']==entry['pairing'] and sb['source_indices']==entry['source_indices']
  assert sb['strict_slots']==entry['strict_slots'] and sb['target_occurrences']==entry['target_occurrences']
  assert sb['scientific_actuals']==full['details']['scientific_actuals'] and sb['metadata_actuals']==full['details']['metadata_actuals']
 close_evidence=closer_actual(L,config,decisionref,cohort,cohortref,summaryref,summary)
 leaf=dict(schema='F009_CONTIGUOUS_PARENT_COHORT_ACTUAL_REUSE_V1',status='SUPPORTED_ACTUAL',reviewer=REVIEWER,blockers=[],cohort=cohortref,progress_snapshot=cohort['progress_snapshot'],current_roster=roster,begin=cohort['begin'],end=cohort['end'],source_indices=cohort['source_indices'],parent_count=cohort['end']-cohort['begin'],strict_slots=156*(cohort['end']-cohort['begin']),target_occurrences=sum(e['target_occurrences'] for e in entries),Source_manifest=packet['strict_manifest'],supplier_Source_manifest=packet['supplier_manifest'],batches=entries,all_batch_pairings_and_per_cover_bindings_verified=True,frozen_progress_snapshot_authenticated=True,all_source_indices_exactly_once=True,all_selected_attempts_and_prior_refusals_audited=True,cache_registration_performed=False,whole_R5_level_or_census_claimed=False)
 return leaf,dict(close_summary=summaryref,closing_execution=close_evidence)


def main():
 p=argparse.ArgumentParser(allow_abbrev=False)
 p.add_argument('--config',nargs=3,required=True)
 p.add_argument('--Root-decision',nargs=3,required=True)
 p.add_argument('--out',required=True)
 p.add_argument('--guard',required=True)
 p.set_defaults(batch=None)
 p.add_argument('--batch-review',nargs=3,action='append',required=True)
 p.add_argument('--batch-SDK',nargs=3,action='append',required=True)
 p.add_argument('--batch-key',action='append',required=True)
 a=p.parse_args()
 L=Ledger()
 state=bootstrap(L,a)
 leaf,details=aggregate_audit(L,a,state)
 finish(L,a,state,leaf,details)

if __name__=='__main__':main()
