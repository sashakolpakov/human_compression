def metadata_call(L,sdkref,key,candidates):
 d=pure(L,sdkref)
 argv=d['issued_argv']
 if argv in candidates:
  api(L,sdkref,key,argv,True)
  printed=json.loads(d['full_tool_return']['output'])
  mode='direct reviewed metadata entry'
 else:
  child=argv[argv.index('--')+1:]
  assert child in candidates
  guard=argv[argv.index('--output')+1]
  printed,_=actual(L,sdkref,key,child,guard,False)
  mode='existing metadata supervisor'
 return printed,mode

