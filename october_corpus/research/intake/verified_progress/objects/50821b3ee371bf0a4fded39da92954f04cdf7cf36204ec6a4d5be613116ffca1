 assert summary['schema']=='ROOT_F009_COMPLETED_COHORT_ACTUAL_SUMMARY_V1' and summary['cohort']==cohortref and summary['source_indices']==cohort['source_indices']
 assert summary['strict_slots']==156*(cohort['end']-cohort['begin']) and summary['target_occurrences']==sum(e['target_occurrences'] for e in entries)
 assert summary['scientific_roles']==cohort['end']-cohort['begin']+len(entries) and summary['metadata_phases']==3*len(entries)
 assert summary['all_scientific_roles_terminal_first_v1']is False and summary['all_other_scientific_roles_terminal_first_v1']is True and summary['scientific_attempts']==config['_science_ref']
 assert summary['cache_registration_performed']is summary['whole_R5_or_census_credit']is summary['all_roles_terminal_first_v1']is False
 assert summary['metadata_phase_attempts']==pure(L,decisionref)['metadata_attempts']
 assert summary['frozen_progress_snapshot']==cohort['progress_snapshot']
 assert len(summary['batches'])==len(entries)
 for sb,entry,args in zip(summary['batches'],entries,a.batch_review):
  h=pure(L,descriptor(args))
