  entries.append(dict(b,parent_count=h['parent_count'],strict_slots=h['strict_slots'],target_occurrences=h['target_occurrences'],pairing=h['pairing'],actual_review=r))
 summaryref=refat(L,Path(cohortref['path']).parent/'cohort_actual_summary.json')
