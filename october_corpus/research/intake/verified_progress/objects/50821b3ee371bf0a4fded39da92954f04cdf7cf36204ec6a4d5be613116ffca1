 stem=[PY,'-E','-B','-S',s['closer_program']['path'],'--actor','/root','--retry-packet']+trip(c['retry_packet'])+['--Source-peer']+trip(c['_retry_peer'])+['--scientific-attempts']+trip(c['_science_ref'])+['--cohort']+trip(hr)
