def aggregate_audit(L,a,state):
 config,configref,decisionref,cohort,cohortref,packet,sm,tm,roster,parents,overrides,source_total=state
 assert a.batch is None and a.batch_review and len(a.batch_review)==len(cohort['batches'])
 entries=[]
 for b,args in zip(cohort['batches'],a.batch_review):
