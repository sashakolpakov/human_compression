def emit(L,planned,bootstrap,folders=()):
    check();assert len(planned)<=8 and all(len(body)<=4*2**20 for p,body in planned)
    assert len(set(L.pins)|{str(p)for p,b in planned})<=512
    assert 2*L.bytes+bootstrap+2*sum(len(b)for p,b in planned)<=64*2**20
    L.close();check()
    for folder in folders:
        if not folder.exists():folder.mkdir()
        assert folder.resolve(strict=True)==folder and folder.is_dir()and not folder.is_symlink()
    refs=[];copy_bytes=0
    for p,b in planned:
        fresh(p);assert p.parent.resolve(strict=True)==p.parent
        with p.open('xb')as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
        actual=p.read_bytes();copy_bytes+=len(actual);assert actual==b;refs.append(file_ref(p,b))
    for folder in {p.parent for p,b in planned}:
        fd=os.open(folder,os.O_RDONLY)
        try:os.fsync(fd)
        finally:os.close(fd)
    check();signal.alarm(0)
    return refs,dict(first_and_closing_explicit_read_bytes=L.bytes,nominal_project_Source_bootstrap_bytes=bootstrap,
        output_verification_bytes=copy_bytes,combined_read_bytes=L.bytes+bootstrap+copy_bytes,input_paths=len(L.pins),
        scientific_calls=0,canonical_writes=0)
