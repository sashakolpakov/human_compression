# Navigate JSON members lexically.  Unselected Original forest/cache values are
# never passed to json.loads, eval or a scientific function.
def ws(b,i):
    while i<len(b)and b[i]in b' \n\r\t':i+=1
    return i
def string_end(b,i):
    assert b[i]==34;i+=1
    while i<len(b):
        if b[i]==92:i+=2
        elif b[i]==34:return i+1
        else:i+=1
    raise ValueError('unterminated string')
def value_end(b,i):
    if b[i]==34:return string_end(b,i)
    if b[i]in b'[{':
        stack=[b[i]];i+=1
        while stack:
            assert i<len(b)and len(stack)<=4096
            if b[i]==34:i=string_end(b,i);continue
            if b[i]in b'[{':stack.append(b[i])
            elif b[i]in b']}':assert(stack.pop(),b[i])in((91,93),(123,125))
            i+=1
        return i
    while i<len(b)and b[i]not in b',]} \n\r\t':i+=1
    return i
def members(b):
    assert len(b)<=4*2**20;i=ws(b,0);assert b[i]==123;i=ws(b,i+1);out={}
    while b[i]!=125:
        j=string_end(b,i);key=json.loads(b[i:j]);assert type(key)is str and len(key)<=4096 and key not in out
        i=ws(b,j);assert b[i]==58;i=ws(b,i+1);j=value_end(b,i);out[key]=b[i:j];i=ws(b,j)
        if b[i]==44:i=ws(b,i+1)
        else:assert b[i]==125
    assert not b[ws(b,i+1):];return out
def array_spans(b):
    i=ws(b,0);assert b[i]==91;i=ws(b,i+1)
    while b[i]!=93:
        j=value_end(b,i);yield b[i:j];i=ws(b,j)
        if b[i]==44:i=ws(b,i+1)
        else:assert b[i]==93
    assert not b[ws(b,i+1):]
def projection(raw,keys):
    m=members(raw);assert set(keys)<=set(m)
    return{k:json.loads(m[k])for k in keys}
def runtime_view(raw):
    m=members(raw);counts=json.loads(m['counts']);keys=set(members(m['cache_entries']))
    banks=[]
    for value in array_spans(m['cache_banks']):
        r=json.loads(members(value)['ref']);assert type(r)is dict;banks.append(r)
    assert len(banks)<=128
    return counts,keys,banks

