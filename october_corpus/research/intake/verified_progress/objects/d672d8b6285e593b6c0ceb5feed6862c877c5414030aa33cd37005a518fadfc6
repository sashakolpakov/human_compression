    need(len(known) == len(set(known)) and known == unresolved[:len(known)],
         'unchanged proposer requires every old miss still unpaid and forming its exact prefix; use another method otherwise')
    need(len(known) < len(unresolved), 'no fresh section37 positions remain; finite misses stay unpaid')
    return known


