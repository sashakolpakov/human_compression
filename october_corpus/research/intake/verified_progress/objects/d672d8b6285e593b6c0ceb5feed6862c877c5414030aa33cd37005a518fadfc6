def need(value, message):
    if not value:
        raise ValueError(message)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'),
                      ensure_ascii=True, allow_nan=False).encode('ascii')


def digest(value):
    return hashlib.sha256(canonical(value)).hexdigest()


def decode(raw):
    def pairs(items):
        result = {}
        for key, value in items:
            need(key not in result, 'unique JSON keys')
            result[key] = value
        return result
    def floating(text):
        value = float(text)
        need(math.isfinite(value), 'finite historical observations')
        return value
    return json.loads(raw, object_pairs_hook=pairs, parse_float=floating,
                      parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


def reference(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


class Metadata:
    def __init__(self):
        self.refs, self.raw, self.bytes = {}, {}, 0

    def read(self, ref, fresh=False):
        need(type(ref) is dict and set(ref) == {'path', 'bytes', 'sha256'}
             and type(ref['path']) is str and type(ref['bytes']) is int
             and 0 <= ref['bytes'] <= 2**21 and type(ref['sha256']) is str
             and len(ref['sha256']) == 64 and set(ref['sha256']) <= set('0123456789abcdef'),
             'complete bounded metadata reference')
        need(self.refs.get(ref['path'], ref) == ref, 'one physical identity per path')
        if not fresh and ref['path'] in self.raw:
            return self.raw[ref['path']]
        need(len(self.refs) < 512 or ref['path'] in self.refs, '512 metadata input paths')
        need(self.bytes+ref['bytes'] <= 64*2**20, '64MiB actual metadata reads')
        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform == 'darwin' else 1024)
        need(rss < 128*2**20 and time.monotonic()-START < 125, '128MiB/125s metadata envelope')
        path = Path(ref['path']); before = path.lstat()
        need(path.is_absolute() and path.resolve(strict=True) == path
             and stat.S_ISREG(before.st_mode) and before.st_nlink == 1
             and before.st_size == ref['bytes'], 'ordinary canonical single-link input')
        with path.open('rb') as handle:
            opened = os.fstat(handle.fileno()); raw = handle.read(ref['bytes']+1)
            closed = os.fstat(handle.fileno())
        signature = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
        need(signature(before) == signature(opened) == signature(closed) == signature(path.lstat())
             and reference(path, raw) == ref, 'whole stable metadata pin')
        self.refs[ref['path']] = ref; self.raw[ref['path']] = raw; self.bytes += len(raw)
        return raw

    def file(self, path, sha):
        path = Path(path)
        ref = dict(path=str(path), bytes=path.stat().st_size, sha256=sha)
        return ref, self.read(ref)

    def document(self, ref):
        return decode(self.read(ref))

    def final(self):
        for ref in list(self.refs.values()):
            self.read(ref, True)


def merge(rows):
    values = {}
    for ref in rows:
        need(values.get(ref['path'], ref) == ref, 'one complete input version')
        values[ref['path']] = ref
    return [values[key] for key in sorted(values)]


def positions(values, maximum):
    need(type(values) is list and values == sorted(set(values))
         and all(type(i) is int and 1 <= i <= maximum for i in values), 'sorted original positions')
    return values


def expand(runs, maximum):
    result = []; last = 0
    need(type(runs) is list, 'position runs')
    for row in runs:
        need(type(row) is list and len(row) == 2, 'complete run pair')
        lo, hi = row
        need(type(lo) is type(hi) is int and last < lo <= hi <= maximum, 'disjoint ordered bounded runs')
        result.extend(range(lo, hi+1)); last = hi
    return result


def pack(values):
    runs = []
    for i in values:
        if runs and runs[-1][1]+1 == i:
            runs[-1][1] = i
        else:
            runs.append([i, i])
    return runs


def temporary(path):
    text = str(path)
    path = Path(text)
    need(path.is_absolute() and path.is_relative_to('/private/tmp')
         and str(path) == text and '..' not in path.parts,
         'normalized new output without parent components, only under /private/tmp')
    parent = path.parent
    while not parent.exists():
        parent = parent.parent
    need(parent.resolve(strict=True) == parent, 'canonical output ancestry')
    need(not os.path.lexists(path), 'fresh output path')
    return path


def put(path, raw):
    path = temporary(path); path.parent.mkdir(parents=True, exist_ok=True)
    need(path.parent.resolve(strict=True) == path.parent
         and path.parent.is_relative_to('/private/tmp'), 'final canonical temporary parent')
    with path.open('xb') as handle:
        handle.write(raw); handle.flush(); os.fsync(handle.fileno())
    return reference(path, raw)


