    known = []
    for trial in selector['previous_method_attempts']:
        need(trial['criterion'] == 'SECTION37_FIXED_DICTIONARY' and trial['kernel'] == seed['kernel']
             and trial['helpers'] == seed['helpers'] and trial['finite_misses_are_NOT_paid'] is True
             and trial['do_not_repeat_unchanged_search'] is True and trial['Root_adoption'] in selector['source_adoptions'],
             'exact unchanged-method attempt authority')
        fact = meta.document(trial['Root_adoption'])
        need(fact['schema'] == 'ROOT_ACCEPTED_Q11_RANK4_SECTION_IP_OBSTRUCTIONS_V1'
             and fact['root'] == '/root' and fact['adopted'] is True
             and fact['original_job'] == selector['original_job']
             and fact['independent_direct_word_power_row_minor_checks'] is True
             and fact['finite_miss_positions_without_IP_credit'] == trial['finite_miss_positions'],
             'actual independently checked unchanged-method misses')
