def ref(p, body=None):
    if body is None:
        body = p.read_bytes()
    return dict(path=str(p), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())


def save(name, value):
    body = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
    p = HERE / name
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_bytes(body)
    return ref(p, body)


