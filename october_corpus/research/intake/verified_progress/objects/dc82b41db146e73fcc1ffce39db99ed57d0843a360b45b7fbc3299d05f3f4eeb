def pin(path):
 path=Path(path);a=path.stat();need(path.is_file(),'ordinary input file')
 h=hashlib.sha256()
 with path.open('rb')as stream:
  while True:
   block=stream.read(262144)
   if not block:break
   h.update(block);need(True,'bounded streaming hash')
 b=path.stat();need((a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns)==(b.st_dev,b.st_ino,b.st_size,b.st_mtime_ns),'stable whole input')
 return dict(path=str(path),bytes=a.st_size,sha256=h.hexdigest())

def document(row,cap=2*MIB):
