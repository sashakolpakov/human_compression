assert review['proposal'] == proposal_ref and review['theorem'] == proposal['theorem']
assert review['written_application'] == proposal['written_application']
assert review['all_original_member_Reader_action_class_witness_H_B_qualifications_preserved']
assert review['no_internal_partner_commutation_inference_used']
assert proposal['Root_authority'] is False and proposal['Root_application_issued'] is False
