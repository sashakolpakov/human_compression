    assert application['canonical_generation_fact'] in batch['new_facts']
    assert bank[ident['free_index']] == 2
    assert application['old_strict_generation_IP_credit_remains_zero'] is True
frozen = []
for path, size, sha in (
    (BASE / 'progress/current_intake.json', 274476, '354926b02a2347402cf9c72d7e7aebc0b27738d4165a03fd5e28823cb8c0b8c3'),
    (BASE / 'progress/controllers/current.json', 789, '779d238ad12646c913f47659eee5ef207fcda47737f7423bc96fe051b179efa1'),
    (BASE / 'progress/stages/forest_extensions_0318_0329_cohort_shared_strict/runtime.json', 4009280, '87ff06e7abd3849ce10da375309786cbc157f812b87fad77d4acf4b85f1a2794'),
):
    ref = dict(path=str(path), bytes=size, sha256=sha)
    L.raw(path, ref)
    frozen.append(ref)
assert len(L.pins) + 1 <= 512 and 2 * L.bytes + len(hb) <= 64 * 2**20
first_read_bytes = L.bytes
L.close()
assert L.bytes == 2 * first_read_bytes
