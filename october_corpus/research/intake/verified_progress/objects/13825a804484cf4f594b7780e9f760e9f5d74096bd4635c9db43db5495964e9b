start = time.monotonic()
signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError('metadata limit')))
signal.alarm(125)


def bounded():
    assert time.monotonic() - start < 115
    assert resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == 'darwin' else 1024) <= 256 * 2**20


def document(path, size, sha):
    bounded()
    ref = dict(path=str(path), bytes=size, sha256=sha)
    return L.document(path, ref)[0], ref


_, program_ref = L.raw(__file__)
L.raw(HELPER)
