import json
import resource
import signal
import sys
import time

assert sys.argv[1:] == ['--actor', '/root']
assert sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode
assert not sys.flags.optimize
HERE = Path(__file__).resolve().parent
BASE = Path('/Users/sasha/medusa/research/leemans/maintenance/intake')
