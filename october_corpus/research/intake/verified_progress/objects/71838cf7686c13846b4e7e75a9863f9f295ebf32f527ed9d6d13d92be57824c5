"""Root-only one-parent supplier, for the unchanged old strict156 consumer."""
import common as io
import types
ROLE='f009_complete_parent_stabilizer_supplier'

def main():
    bank,q,manifest,pins,out=io.main_args(ROLE)
    io.need(q['mode']=='supply'and q['saved']is None and type(q['parents'])is list and len(q['parents'])==1,'one exact parent, no inherited verdict')
    io.need(out.isascii()and len(out)<=1024,'finite output path')
    for r in list(bank.refs.values())+list(pins.values())+[q['Root_import']]:
        io.descriptor(r);io.need(len(r['path'])<=1024 and all(32<=ord(c)<127 and c not in('"','\\')for c in r['path']),'finite unescaped ASCII descriptor')
    io.need(q['Root_import']['bytes']<=32768,'finite exact Root import');root=bank.doc(q['Root_import'])
    io.need(root['schema']=='ROOT_F009_COMPLETE_PARENT_STABILIZER_IMPORT_V1'and root['root']=='/root'
        and root['Root_authority']is True and root['adopted']is True and root['parents']==q['parents']
        and root['original_row']=='F009.TABLE.3.10.8','fresh Root subject/theorem import')
    for key in('literal72_vertex_seed_and156_host_owned','complete_tree2048_times_S8_action_proof_owned',
        'hereditary_rejections_necessary_for_every_target_owned','full_parent_kernel_image_and_U7_proof_owned',
        'greedy_image_basis_and_right_action_lifts_owned','no_original_five_class_census_assumed',
        'whole_level_and_crossing_and_census_authority_separate','incremental_distance_equivalence_proof_owned'):
        io.need(root[key]is True,'owned mathematical import '+key)
    io.need(root['canonical_or_ledger_writes_authorized']is False,'local certificate only')
    spaces=[]
    for key in('budget','kernel','support','incremental_used','full_stabilizer'):
        io.descriptor(q[key]);spaces.append(bank.module(q[key],'full_parent_'+key))
    B,K,S,R,N=spaces
    for fn in vars(B['Meter']).values():
        if isinstance(fn,types.FunctionType):io.need(fn.__globals__ is B and fn.__code__.co_filename==q['budget']['path'],'whole Meter methods own Source')
    work=B['Meter'](bank.tick);work.start=bank.start;bank.work=work
    work.reserve_publication(262144);work.charge(393216,'prepaid_ASCII_extent_and_comparison')
    certificate,evidence=N['cover'](K,S,R,q['parents'][0],work)
    io.need(len(io.canonical(certificate))<=98304,'same old strict saved extent')
    bank.close();work.charge(0)
    result=dict(schema='F009_COMPLETE_PARENT_STABILIZER_SUPPLIER_FACT_V1',status='PROPOSED_COMPLETE_PARENT_COVER',
        pins=pins,parent_count=1,slots_per_parent=156,stabilizer=evidence,whole_inputs=list(bank.refs.values()),
        coded_units=work.units,declared_read_bytes=bank.bytes,nominal_project_body_bytes=bank.nominal_project_body_bytes,
        certificate_for_literal_old_strict156=True,complete_selected_stabilizer_not_graph_isomorphism=True,
        canonical_or_ledger_writes=False,Original_graph_inputs_loaded=False,new_census_or_case_credit=0)
    io.need(len(io.canonical(result))<=49152,'finite result with compact generators and descriptor roster')
    outputs=bank.emit(out,result,certificate);answer=io.canonical(dict(status=result['status'],outputs=outputs,new_case_credit=0))
    work.final(len(answer));print(answer.decode(),end='')

if __name__=='__main__':main()
