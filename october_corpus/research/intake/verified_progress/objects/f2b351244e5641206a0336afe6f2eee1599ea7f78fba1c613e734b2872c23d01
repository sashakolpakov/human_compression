def ws(b,i):
    while i<len(b)and b[i]in b' \r\n\t':i+=1
    return i

def end_string(b,i):
    assert b[i]==34;i+=1
    while i<len(b):
        if b[i]==92:i+=2
        elif b[i]==34:return i+1
        else:i+=1
    raise ValueError('unterminated string')

def end_value(b,i):
    if b[i]==34:return end_string(b,i)
    if b[i]in b'[{':
        stack=[b[i]];i+=1
        while stack:
            assert i<len(b)and len(stack)<=4096
            if b[i]==34:i=end_string(b,i);continue
            if b[i]in b'[{':stack.append(b[i])
            elif b[i]in b']}':assert(stack.pop(),b[i])in((91,93),(123,125))
            i+=1
        return i
    while i<len(b)and b[i]not in b',]} \r\n\t':i+=1
    return i

def fields(b):
    i=ws(b,0);assert b[i]==123;i=ws(b,i+1);out={}
    while b[i]!=125:
        j=end_string(b,i);key=json.loads(b[i:j]);assert key not in out
        i=ws(b,j);assert b[i]==58;i=ws(b,i+1);j=end_value(b,i);out[key]=b[i:j];i=ws(b,j)
        if b[i]==44:i=ws(b,i+1)
        else:assert b[i]==125
    assert ws(b,i+1)==len(b);return out

def array(b):
    i=ws(b,0);assert b[i]==91;i=ws(b,i+1);out=[]
    while b[i]!=93:
        j=end_value(b,i);out.append(b[i:j]);i=ws(b,j)
        if b[i]==44:i=ws(b,i+1)
        else:assert b[i]==93
    assert ws(b,i+1)==len(b);return out

