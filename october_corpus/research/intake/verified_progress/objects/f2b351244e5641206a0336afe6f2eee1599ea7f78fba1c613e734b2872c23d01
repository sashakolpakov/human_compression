    if b[:1]==b'{':
        f=fields(b);assert not FORBIDDEN&set(f)
        return{k:metadata(v)for k,v in f.items()}
    if b[:1]==b'[':return[metadata(v)for v in array(b)]
    return json.loads(b)

def equivalent(a,b):
    budget()
    if a==b:return True
    a,b=a.strip(),b.strip()
    if a==b:return True
    if a[:1]==b'{':
        if b[:1]!=b'{':return False
        af,bf=fields(a),fields(b)
        return set(af)==set(bf)and all(equivalent(af[k],bf[k])for k in af)
    if a[:1]==b'[':
        if b[:1]!=b'[':return False
        aa,ba=array(a),array(b)
        return len(aa)==len(ba)and all(equivalent(x,y)for x,y in zip(aa,ba))
    return False

