"""Ten UNRUN synthetic word/admission designs; no Original fixtures."""
import retained_math as M
import word_consumer as W
import word_admission as A

def run(budget):
 passed=[];work=W.Work(budget.tick)
 def check(name,value):M.need(value,'word control '+name);passed.append(name)
 def refuse(name,call):
  try:call()
  except(ValueError,TypeError,KeyError,IndexError):passed.append(name)
  else:raise ValueError('control accepted '+name)
 def swap(a,b):
  return tuple(tuple(int(j==(b if i==a else a if i==b else i))for j in range(7))for i in range(7))
 K=(swap(0,1),swap(1,2),swap(2,3));C=swap(0,4);identity=[list(r)for r in M.I7]
 marks=K+(budget.multiply(K[0],K[2]),)
 fact=dict(K_words=[[0],[1],[2],[0,2]],conjugator_word=[],conjugator_inverse=identity)
 check('four_whole_positive_words',W.consume(marks,K,(C,M.I7),fact,budget,work)['all_four_marks_in_conjugate_K'])
 check('noncommuting_right_word_orientation',W.word([0,1],K,budget,work)!=W.word([1,0],K,budget,work))
 moved=tuple(budget.multiply(budget.multiply(C,g),C)for g in marks)
 conjugate=dict(fact,conjugator_word=[0],conjugator_inverse=[list(r)for r in C])
 check('known_G_positive_conjugator',W.consume(moved,K,(C,M.I7),conjugate,budget,work)['all_four_marks_in_conjugate_K'])
 refuse('one_wrong_full_mark_word',lambda:W.consume(marks,K,(C,M.I7),dict(fact,K_words=[[0],[1],[2],[1]]),budget,work))
 refuse('wrong_supplied_inverse',lambda:W.consume(moved,K,(C,M.I7),dict(conjugate,conjugator_inverse=identity),budget,work))
 refuse('Boolean_word_letter',lambda:W.word([True],K,budget,work))
 before=budget.products
 refuse('overlong_word_before_products',lambda:W.word([0]*4097,K,budget,work))
 M.need(budget.products==before,'no overlong arithmetic')
 refuse('missing_fourth_word',lambda:W.consume(marks,K,(C,M.I7),dict(fact,K_words=[[0],[1],[2]]),budget,work))
 fields=('original_job','selector','selected_orbit_positions','original_domain_whole_pins',
  'original_orbit_array_sha256','matrix_frame_result','known_K','known_K_evidence','properness_argument')
 plan={k:'toy_'+k for k in fields};plan['known_K_evidence']=['toy accepted evidence']
 imported=dict(plan,schema='ROOT_IMPORTED_Q11_KNOWN_PROPER_SUBGROUP_WORDS_V1',
  root='/root',Root_authority=True,issued=True,known_K_order=24)
 imported.update({k:True for k in A.PREMISES})
 M.need(A.known(plan,imported),'toy positive premise grammar')
 refuse('unissued_proper_K_premise',lambda:A.known(plan,dict(imported,Root_authority=False)))
 refuse('different_actual_frame',lambda:A.known(plan,dict(imported,matrix_frame_result='wrong toy frame')))
 stopped=W.Work(budget.tick)
 try:stopped.charge(200001)
 except ValueError:pass
 else:raise ValueError('scalar bank')
 for _ in range(8):stopped.begin_case()
 try:stopped.begin_case()
 except ValueError:pass
 else:raise ValueError('ninth case')
 M.need(stopped.used==0 and len(passed)==len(set(passed))==10,'ten unique controls and prospective resource refusal')
 return dict(status='ALL_TEN_SYNTHETIC_WORD_CONTROLS_PASS',controls=10,control_names=passed,
  Original_inputs_loaded=False,old_controls_replayed=False,old_K_order_recomputed=False,
  new_word_scalar_units=work.used,paid_credit=0)
