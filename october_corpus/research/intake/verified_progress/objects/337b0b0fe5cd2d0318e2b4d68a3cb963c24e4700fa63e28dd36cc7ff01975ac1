import runtime as rt
import algebra
from role import loaded
AUTHOR='/root/ledger_preparation'
DUTIES=('whole_new_Source_distinct_peer_and_fresh24_controls_owned',
 'same_Original_four_marks_frame_named_G2_members_and_current_unpaid_owned',
 'accepted_positive_H_and_R_tensor_congruences_and_root_aliases_owned',
 'accepted_complete_middle_D22_journal_same_marks_owned',
 'candidate_form_and_all_four_special_isometry_equations_decide_admission_owned',
 'row_covariance_adjoint_and_truncated_dihedral_lemma_owned',
 'common_commutant_dimension_and_full_minors_not_assumed_owned',
 'no_old_tensor_span_dihedral_group_or_orbit_repeated_owned',
 'one_role_acquisition_not_independent_numeric_replay_owned',
 'IP_GEN_saved_row_and_canonical_credit_remain_separate_owned')
def original(q,b,pins):
    keys={'schema','Root_authority','case','old_operand_job','old_Root_import','current_selector',
        'local_actual_review','H_tensor_actual_review','R_tensor_actual_review','theory','new_Source_peer',
        'new_controls_actual_review','Root_input_import'}
    rt.need(type(q)is dict and set(q)==keys and q['schema']=='F004_PROJECTION_STAR_CENTRALIZER_JOB_V1'
        and q['Root_authority']is False,'exact untrusted commutant diagnostic job')
    c=q['case'];rt.need(type(c)is dict and set(c)=={'position','original_row_id','marks_sha256','model_sha256'}
        and type(c['position'])is int and 1<=c['position']<=3779 and len(rt.encoded(c))<=4096,'bounded Original identity')
    root=loaded(q['Root_input_import'],b,32768)
    rt.need(root['schema']=='ROOT_F004_PROJECTION_STAR_CENTRALIZER_IMPORT_V1'and root['root']=='/root'
        and root['Root_authority']is root['adopted']is True and root['Source_manifest_sha256']==pins['Source_manifest_sha256']
        and all(root[k]is True for k in DUTIES),'separately issued positive Root ownership')
    for k in keys-{'schema','Root_authority','Root_input_import'}:rt.need(root[k]==q[k],'exact Root binding '+k)
    peer=loaded(q['new_Source_peer'],b,32768);control=loaded(q['new_controls_actual_review'],b,16384)
    rt.need(peer['status'].startswith('SUPPORTED_STATIC')and peer['blockers']==[]and peer['reviewer']not in('/root',AUTHOR)
        and peer['Source_manifest']['sha256']==pins['Source_manifest_sha256'],'distinct whole new Source peer')
    rt.need(control['status'].startswith('SUPPORTED_ACTUAL')and control['reviewer']not in('/root',AUTHOR)
        and control['blockers']==[]and control['Source_manifest']==peer['control_Source_manifest']
        and control['count']==24 and control['Original_inputs_loaded']is False,'fresh actual24 artificial fixtures')
    cur=loaded(q['current_selector'],b,262144)
    rt.need(cur['root']=='/root'and cur['adopted']is True and cur['original_job']==[20,4]
        and type(cur['unresolved_position_runs'])is list and len(cur['unresolved_position_runs'])<=3779,'fresh unpaid domain')
    b.scalar(8192+3*len(cur['unresolved_position_runs']));last=total=0;present=False
    for lo,hi in cur['unresolved_position_runs']:
        rt.need(type(lo)is type(hi)is int and last<lo<=hi<=3779,'ordered unresolved runs');last=hi;total+=hi-lo+1;present|=lo<=c['position']<=hi
    rt.need(type(cur['unresolved_positions'])is int and cur['unresolved_positions']==total and present,'same case still unpaid')
    tensors=[]
    for side,key,schema,proofschema,rank,labels in(
        ('H','H_tensor_actual_review','F004_LEFT_SPAN_TENSOR2739_ACTUAL_REUSE_V1','F004_LEFT_SPAN_TENSOR_INTERSECTION_PROOF_V1',4,[0,1,2]),
        ('R','R_tensor_actual_review','F004_INVARIANT_TENSOR2739_ACTUAL_REUSE_V1','F004_INVARIANT_TENSOR_INTERSECTION_PROOF_V1',3,[1,2,3])):
        v=loaded(q[key],b,32768)
        rt.need(v['schema']==schema and v['status'].startswith('SUPPORTED_ACTUAL')and v['reviewer']!='/root'
            and v['blockers']==[]and v['case']==c and v['tensor_signs']==[1,1,1]
            and v['whole_Source_and_inputs_closed']is v['actual_guard_and_raw_frames_verified']is True,'accepted positive '+side+' tensor application')
        sp=loaded(v['proof'],b,131072);sr=loaded(v['result'],b,16384)
        rt.need(sp['schema']==proofschema and sp['case']==sr['case']==c and sp['inputs_closed']is True
            and sp['Root_input_import']==v['Root_input_import']and sp['current_selector']==v['current_selector']
            and sp['old_operand_job']==q['old_operand_job']and sp['old_Root_import']==q['old_Root_import']
            and sp['local_actual_review']==q['local_actual_review']and sp['tensor_signs']==sr['tensor_signs']==[1,1,1]
            and sp['construction']['gram_rank']==rank and sp['construction']['branch']=='nondegenerate_span',
            'same whole saved positive tensor and nondegenerate span')
        if side=='H':rt.need(v['all_H_tensor_congruences_verified']is True and v['tensor_preserved_by_labels']==labels
            and v['root_A_H_proof_field']=='orbit/root_tensor_hex','explicit H application')
        value=sp['orbit']['root_tensor_hex']
        rt.need(type(value)is str and len(value)==98 and all(x in'0123456789abcdef'for x in value),'canonical saved tensor hex')
        tensors.append(bytes.fromhex(value))
    local=loaded(q['local_actual_review'],b,32768)
    rt.need(local['schema']=='F004_BOUNDED_ADJACENT_LOCAL_IP_ACTUAL_REUSE_V1'and local['status'].startswith('SUPPORTED_ACTUAL')
        and local['reviewer']!='/root'and local['blockers']==[]and local['case']==c
        and local['whole_Source_and_inputs_closed']is local['actual_guard_and_raw_frames_verified']is local['all_adjacent_cycles_complete']is True,
        'same accepted complete middle journal')
    result=loaded(local['result'],b,32768);raw=b.read(local['certificate']['path'],local['certificate'],84807)
    rt.need(result['case']==c and result['inputs_closed']is True and result['certificate']==local['certificate']
        and result['Root_input_import']==local['Root_input_import']and result['old_operand_job']==q['old_operand_job']
        and result['old_Root_import']==q['old_Root_import']and result['trace_record_bytes']==53
        and type(result['trace_records'])is int and 0<=result['trace_records']<=1600
        and len(raw)==7+53*result['trace_records']and raw[:7]==b'F4ADJ1\n','exact whole accepted D journal')
    pair=result['state']['pairs'][1];n=pair['rotation_order']
    rt.need(pair['labels']==[1,2]and pair['complete']is pair['rotation_closed']is True
        and type(n)is int and n==11 and local['middle_order']==22
        and len(pair['rotation_events'])==len(pair['reflection_events'])==n,'complete middle normal forms')
    D=set()
    for kind,events in(('rotation',pair['rotation_events']),('reflection',pair['reflection_events'])):
        for exponent,e in enumerate(events):
            b.scalar(53);rt.need(type(e)is int and 0<=e<result['trace_records'],'bounded old D event')
            o=7+53*e;tag,p=raw[o:o+2];power=int.from_bytes(raw[o+2:o+4],'little');value=raw[o+4:o+53]
            expected=4 if kind=='reflection'else(1 if exponent==0 else 3)
            rt.need(p==1 and tag==expected and power==exponent and len(value)==49 and all(x<11 for x in value),'whole exact old dihedral word value')
            D.add(value)
    rt.need(len(D)==2*n and algebra.I in D,'entire distinct old middle table')
    old=loaded(q['old_operand_job'],b,16384);frame=loaded(q['old_Root_import'],b,16384)
    rt.need(old['original_job']==[20,4]and old['position']==c['position']and old['original_row_id']==c['original_row_id']
        and old['Root_input_import']==q['old_Root_import']and rt.digest(rt.encoded(old['marks']))==c['marks_sha256']
        and rt.digest(rt.encoded(old['model']))==c['model_sha256'],'same Original operands, no recomputation')
    rt.need(frame['root']=='/root'and frame['Root_authority']is frame['adopted']is True
        and frame['marks_sha256']==c['marks_sha256']and frame['model_sha256']==c['model_sha256']
        and all(frame[k]is True for k in('same_faithful_right_row_natural_F11_frame_checked',
        'literal_original_mark_order_preserved_without_reversal','named_inner_G2_11_membership_for_all_four_marks_checked')),'borrowed same natural frame')
    rt.ref(q['theory']);b.read(q['theory']['path'],q['theory'],32768)
    rt.need(n==11 and len(D)==22,'this theorem uses the prime-field middle D22')
    def saved(event):return raw[7+53*event+4:7+53*event+53]
    U=saved(pair['rotation_events'][1]);U2=saved(pair['rotation_events'][2]);B=saved(pair['reflection_events'][0])
    return old['marks'],old['model']['form'],tensors[0],tensors[1],B,U,U2
