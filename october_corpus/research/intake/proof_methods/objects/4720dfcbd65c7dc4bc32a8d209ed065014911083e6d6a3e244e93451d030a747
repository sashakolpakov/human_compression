files = {}
read_bytes = 0
def include(original, source=None, expected=None):
    global read_bytes
    original = str(original)
    p = Path(source or original)
    before = p.stat()
    assert p.is_file() and not p.is_symlink() and before.st_size <= 4 * 2**20
    body = p.read_bytes()
    read_bytes += len(body)
    assert read_bytes <= 32 * 2**20
    digest = hashlib.sha256(body).hexdigest()
    if expected:
        assert len(body) == expected['bytes'] and digest == expected['sha256']
    target = dest / 'objects' / digest
    if not target.exists():
        with target.open('xb') as out:
            out.write(body)
            out.flush()
            os.fsync(out.fileno())
    assert target.read_bytes() == body
    after = p.stat()
    assert (before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) == (after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
    record = dict(original_path=original, object='objects/' + digest, bytes=len(body), sha256=digest)
    assert original not in files or files[original] == record
    files[original] = record

