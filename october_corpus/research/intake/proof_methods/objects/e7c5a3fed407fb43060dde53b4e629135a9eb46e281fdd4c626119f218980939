    for r in refs:C.ref(r);C.need(allrefs.get(r['path'],r)==r,'one exact prospective edition');allrefs[r['path']]=r
    future=sum(r['bytes']for p,r in allrefs.items()if p not in b.raw)+sum(r['bytes']for r in allrefs.values())
    C.need(b.bytes+future<=8388608 and len(allrefs)+2<=96,'complete first/closing IO and output paths')
