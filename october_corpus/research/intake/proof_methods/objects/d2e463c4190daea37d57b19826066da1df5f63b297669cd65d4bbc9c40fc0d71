\section{Hypotheses and the nilpotent ideal}
Let $V=\F_{11}^{\,7}$ and let $Q$ be a nonsingular symmetric matrix. Matrices
act on row vectors on the right, and the adjoint is
\[
 X^*=QX^{\mathsf T}Q^{-1}.
\]
Let $C\subseteq\operatorname{End}_{\F_{11}}(V)$ be a unital, $*$-stable
algebra. Assume that $I,B,N,BN,N^2,E$ is a basis of $C$, and that
\begin{align*}
 B^2&=I,& BN&=-NB,& N^3&=0,& N^2&\ne0,& BN^2&=-N^2,\\
 B^*&=B,&N^*&=-N,&E^*&=E,&E^2&=E,&\operatorname{rank}E&=1,\\
 BE&=EB=E,& EN&=NE=0,&\det B&=1.
\end{align*}
In particular, the relation $BN^2=-N^2$ is an explicit hypothesis, rather
than a conclusion inferred from a failed independent-basis test. Put
\[
 J=\langle N,BN,N^2\rangle,\qquad
 e=E,\quad p=\frac{I+B}{2}-E,\quad q=\frac{I-B}{2}.
\]

\begin{lemma}\label{ideal}
The subspace $J$ is a two-sided, $*$-stable ideal, $J^3=0$, and
$J^-:=\{z\in J:z^*=-z\}=\langle N\rangle$.
The matrices $e,p,q$ are pairwise orthogonal self-adjoint idempotents whose
sum is $I$. Their images form the three standard idempotents of
$C/J\simeq\F_{11}^{\,3}$, and the induced involution on this quotient is
the identity.
\end{lemma}
\begin{proof}
Multiplication on either side by $B$ carries $N,BN,N^2$ into their span;
here $N^2B=BN^2=-N^2$. Multiplication by $N$ or $BN$ carries $J$ into
$\langle N^2\rangle$, and multiplication by $E$ kills $J$. Thus $J$ is
an ideal, $J^2\subseteq\langle N^2\rangle$, and $J^3=0$.
Moreover $(BN)^*=BN$ and $(N^2)^*=N^2$, while $N^*=-N$.
The basis hypothesis and characteristic $11$ therefore give $J^-=\langle N\rangle$.
The relations for $E$ show that it is central in $C$; direct multiplication
gives all the stated idempotent identities. Modulo $J$, the three independent
classes $I,B,E$ span the quotient. The change of basis from them to $e,p,q$
is invertible, so these are three nonzero orthogonal quotient idempotents.
All are self-adjoint, proving the quotient description.
\end{proof}

\section{All norm-one and determinant-one elements}
Write
\[
 U(t)=I+tN+\frac{t^2}{2}N^2,\qquad U=U(1),\qquad \sigma=2E-I.
\]

\begin{theorem}\label{units}
Under the hypotheses above, the norm-one elements of $C$ are exactly
\[
 \bigl\{(s_e e+s_p p+s_q q)U(t):
       s_e,s_p,s_q\in\{1,-1\},\ t\in\F_{11}\bigr\}.
\]
They are $88$ distinct elements. Their determinant-one subgroup is
\[
 \SO(Q)\cap C=\langle B,U\rangle\times\langle\sigma\rangle,
 \qquad |\SO(Q)\cap C|=44,
\]
where $\langle B,U\rangle$ is dihedral of order $22$ and $\sigma$ is a
central involution outside that group.
\end{theorem}
\begin{proof}
For a square matrix, $x^*x=I$ implies invertibility and $xx^*=I$, so either
norm convention is equivalent. Reduction modulo $J$ gives three independent
equations $s_i^2=1$. Each of their eight solutions has the exact norm-one
lift $a=s_e e+s_p p+s_q q$, with $a^*=a$ and $a^2=I$.
If $x$ is norm one with this quotient, then $v=ax$ lies in $I+J$ and is
norm one. Thus it remains to determine the norm-one kernel in $I+J$.

For $v\in I+J$, the matrix $I+v=2I+j$ is invertible since $J$ is nilpotent.
The Cayley transform and its inverse are
\[
 z=(I-v)(I+v)^{-1},\qquad v=(I-z)(I+z)^{-1}.
\]
These are inverse bijections between norm-one $v\in I+J$ and skew-adjoint
$z\in J$. Indeed $v^*=v^{-1}$ implies $z^*=-z$, and the converse follows
by the same identities; polynomials and inverses in the single matrix
in question commute. This Cayley statement is used only on $I+J$, not on
arbitrary norm-one elements that may have eigenvalue $-1$.
By Lemma~\ref{ideal}, $z=tN$. Since $N^3=0$, its inverse Cayley transform is
\[
 I-2tN+2t^2N^2=U(-2t).
\]
Consequently the norm-one kernel is exactly $\{U(t):t\in\F_{11}\}$.
The product rule $U(s)U(t)=U(s+t)$ and independence of $N,N^2$ show that
these are eleven distinct elements, generated by $U$.

Because $B$ is an involution, $qV$ is its negative eigenspace.
The equation $\det B=1$ makes $\operatorname{rank}q$ even.
The orthogonal idempotent decomposition gives
$\operatorname{rank}p+\operatorname{rank}q=6$, so
$\operatorname{rank}p$ is even as well. Therefore
\[
 \det(s_e e+s_p p+s_q q)=s_e,
\]
and each unipotent $U(t)$ has determinant one. Exactly the four quotient
signs with $s_e=1$ survive. They are represented by
$I,B,\sigma,B\sigma$. Finally $BUB=U^{-1}$ and $B\notin\langle U\rangle$
(their quotient signs differ). Thus $D:=\langle B,U\rangle$ has order22.
Centrality of $E$ gives centrality of $\sigma$; its quotient has $p$-sign
$-1$, whereas every element of $D$ has $p$-sign $+1$.
It is therefore outside $D$, proving the asserted direct product and count.
\end{proof}

\section{Excluding the extra coset with a three-form}
Let $r_0,r_1,r_2,r_3$ be the exact same Original marks, and put
$H=\langle r_0,r_1,r_2\rangle$, $R=\langle r_1,r_2,r_3\rangle$.
Assume that separately certified premises give
\[
 D=\langle B,U\rangle=\langle r_1,r_2\rangle
 \ \le H\cap R\ \le\SO(Q)\cap C.
\]
For example, positive tensor congruences give the latter containment when
$C$ is the full common commutant of $P_H=QA_H$ and $P_R=QA_R$:
for a row isometry $g$, $g^{\mathsf T}Ag=A$ is equivalent to $gQA=QAg$.
This orientation must not be replaced by $gAg^{\mathsf T}$ for these
saved tensors.

\begin{corollary}\label{phi}
Suppose an alternating three-form $\Phi$ in this same frame is preserved by
all four marks, and $\sigma$ does not preserve $\Phi$. Then $H\cap R=D$.
\end{corollary}
\begin{proof}
Both ends, and hence $D$, preserve $\Phi$. Every element outside $D$ in
Theorem~\ref{units} is $d\sigma$ for some $d\in D$.
By centrality, $d\sigma=\sigma d$. Thus row pullback gives
$\Phi^{d\sigma}=\Phi^\sigma\ne\Phi$: move $d$ to the final action on
all three arguments and use its preservation of $\Phi$.
Thus none belongs to $H\cap R$, and the two containments prove equality.
\end{proof}

