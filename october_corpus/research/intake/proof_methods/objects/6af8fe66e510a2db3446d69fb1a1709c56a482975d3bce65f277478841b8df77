    "algebra.py": "\"\"\"Literal retained canonical matrix/marking/dihedral helpers; no model recognition.\"\"\"\nimport field as f\nI=f.I\n\ndef matrix(raw,b):\n    f.need(type(raw)is list and len(raw)==7,'seven whole matrix rows')\n    return bytes(x for row in raw for x in f.vector(row,7,b))\n\ndef rows(a):\n    return [list(a[7*i:7*i+7])for i in range(7)]\n\ndef marking(raw,b):\n    f.need(type(raw)is list and len(raw)==4,'four original marks in order')\n    g=tuple(matrix(a,b)for a in raw)\n    f.need(len(set(g))==4 and all(a!=I for a in g),'four distinct nonidentity marks')\n    for a in g:f.need(b.multiply(a,a)==I,'each complete involution equation')\n    for i,j in((0,2),(0,3),(1,3)):\n        f.need(b.multiply(g[i],g[j])==b.multiply(g[j],g[i]),'all three string commutations')\n    return g\n\ndef dihedral(a,c,b,cap=256):\n    r=b.multiply(a,c);power=I;rot=[]\n    for n in range(1,cap+1):\n        rot.append(power);power=b.multiply(power,r)\n        if power==I:break\n    else:return None\n    f.need(n>=2,'distinct nonidentity involutions have rotation order at least2')\n    reflections=[b.multiply(x,a)for x in rot]\n    group=set(rot+reflections)\n    f.need(len(group)==2*n,'complete dihedral normal form and full byte distinctness')\n    return n,group\n\n",
    "alternating.py": "\"\"\"Lexicographic alternating3form coefficients in the accepted row frame.\"\"\"\nimport runtime as rt\nTRIPLES=tuple((i,j,k)for i in range(7)for j in range(i+1,7)for k in range(j+1,7))\ndef coefficients(raw,b):\n    b.scalar(35);rt.need(type(raw)in(list,tuple)and len(raw)==35\n        and all(type(x)is int and 0<=x<11 for x in raw),'canonical35 alternating coefficients')\n    return tuple(raw)\ndef pullback(phi,g,b):\n    b.scalar(35);support=[(a,c)for a,c in zip(TRIPLES,phi)if c];out=[]\n    rt.need(type(g)is bytes and len(g)==49,'complete matrix for row pullback')\n    for i,j,k in TRIPLES:\n        total=0\n        for (a,c,d),value in support:\n            # Nine multiplications and five additions/subtractions for the\n            # determinant, then one coefficient product and one accumulation.\n            b.scalar(20)\n            x=g[7*i+a]*(g[7*j+c]*g[7*k+d]-g[7*j+d]*g[7*k+c])\n            x-=g[7*i+c]*(g[7*j+a]*g[7*k+d]-g[7*j+d]*g[7*k+a])\n            x+=g[7*i+d]*(g[7*j+a]*g[7*k+c]-g[7*j+c]*g[7*k+a])\n            total=(total+value*x)%11\n        out.append(total)\n    return tuple(out)\ndef certificate(phi,marks,sigma,b):\n    phi=coefficients(phi,b);images=[pullback(phi,g,b)for g in marks]\n    extra=pullback(phi,sigma,b);checks=[x==phi for x in images]\n    mismatch=next((dict(triple=list(t),expected=x,observed=y)for t,x,y in zip(TRIPLES,phi,extra)if x!=y),None)\n    return dict(nonzero=any(phi),coefficient_order='lexicographic increasing zero-based triples',\n        nonzero_coefficients=sum(x!=0 for x in phi),all_four_marks_preserve=all(checks),\n        mark_equalities=checks,mark_pullbacks=[bytes(x).hex()for x in images],\n        sigma_preserves=extra==phi,sigma_pullback=bytes(extra).hex(),sigma_mismatch=mismatch)\n",
    "centralizer.py": "\"\"\"A bounded common-commutant certificate; never assumes its dimension.\"\"\"\nimport runtime as rt\nimport field,algebra,small\nI=field.I\nZERO=bytes(49)\n\ndef trans(A,b):\n    b.scalar(49);return bytes(A[7*j+i]for i in range(7)for j in range(7))\ndef combine(terms,b):\n    b.scalar(49*len(terms));return bytes(sum(c*A[i]for c,A in terms)%11 for i in range(49))\ndef canonical(A,b):\n    b.scalar(49);rt.need(type(A)is bytes and len(A)==49 and all(x<11 for x in A),'canonical whole 7 by7 matrix')\n    return A\n\ndef inv7(A,b):\n    X=small.inverse(algebra.rows(A),b)\n    return None if X is None else bytes(x for r in X for x in r)\n\ndef frame(Q,marks,b):\n    canonical(Q,b);rt.need(Q==trans(Q,b),'symmetric candidate form')\n    Qi=inv7(Q,b);rt.need(Qi is not None,'nonsingular candidate form')\n    rt.need(len(marks)==4,'all four Original marks')\n    determinants=[]\n    for g in marks:\n        canonical(g,b);determinants.append(small.det(algebra.rows(g),b))\n        rt.need(b.multiply(b.multiply(g,Q),trans(g,b))==Q,'full row isometry equation for every mark')\n    rt.need(determinants==[1]*4,'all four marks have determinant one')\n    return Qi,determinants\n\ndef algebra_relations(Q,Qi,B,U,U2,b):\n    for A in(B,U,U2):canonical(A,b)\n    N=combine(((2,U),(4,I),(5,U2)),b)\n    # N=(U-I)-(U^2-2U+I)/2; 1/2=6 in F11.\n    N2=b.multiply(N,N);N3=b.multiply(N2,N);BN=b.multiply(B,N)\n    m=2 if N!=ZERO and N2==ZERO else(3 if N2!=ZERO and N3==ZERO else None)\n    basis=[I,B,N,BN]+([N2,b.multiply(B,N2)]if m==3 else [])\n    checks=dict(B_squared_is_identity=b.multiply(B,B)==I,\n        BN_equals_minus_NB=BN==combine(((10,b.multiply(N,B)),),b),\n        B_self_adjoint=b.multiply(b.multiply(Q,trans(B,b)),Qi)==B,\n        N_skew_adjoint=b.multiply(b.multiply(Q,trans(N,b)),Qi)==combine(((10,N),),b),\n        nilpotence_degree=m,\n        U_is_truncated_exponential=U==combine(((1,I),(1,N))+(((6,N2),)if m==3 else()),b))\n    E=[[A[i]for A in basis]for i in range(49)];ind=small.minor(E,b)\n    good=m in(2,3)and all(v is True for k,v in checks.items()if k!='nilpotence_degree')and ind['rank']==2*m\n    return dict(accepted=good,nilpotence_degree=m,checks=checks,basis=[A.hex()for A in basis],\n        N=N.hex(),N_squared=N2.hex(),N_cubed=N3.hex(),basis_entry_minor=ind)\n\ndef calculate(Q,marks,AH,AR,B,U,U2,b):\n    proof=dict(stage='form_and_marks');Qi,dets=frame(Q,marks,b)\n    proof.update(Q_inverse=Qi.hex(),mark_determinants=dets)\n    for A in(AH,AR):canonical(A,b);rt.need(A==trans(A,b),'both saved tensors symmetric')\n    PH=b.multiply(Q,AH);PR=b.multiply(Q,AR)\n    proof.update(P_H=PH.hex(),P_R=PR.hex(),stage='saved_projections')\n    if b.multiply(PH,PH)!=PH or b.multiply(PR,PR)!=PR:\n        return 'INCONCLUSIVE_SAVED_TENSOR_NOT_PROJECTOR',proof\n    RR,piv,rows=small.rref(algebra.rows(PH),7,b)\n    _,prank,_=small.rref(algebra.rows(PR),7,b)\n    proof.update(projection_ranks=[len(piv),len(prank)])\n    if len(piv)!=4 or len(prank)!=3:return 'INCONCLUSIVE_PROJECTION_RANKS',proof\n    KT,kp,_=small.rref(algebra.rows(trans(PH,b)),7,b);null=[]\n    for j in range(7):\n        if j not in kp:\n            v=[0]*7;v[j]=1\n            for i,k in enumerate(kp):b.scalar(1);v[k]=-KT[i][j]%11\n            null.append(v)\n    S=bytes(x for row in([algebra.rows(PH)[i]for i in rows]+null)for x in row);Si=inv7(S,b)\n    rt.need(Si is not None,'image and row-kernel direct decomposition')\n    diag=bytes(int(i==j and i<4)for i in range(7)for j in range(7))\n    rt.need(b.multiply(b.multiply(S,PH),Si)==diag,'full four-plus-three projection diagonalization')\n    T=b.multiply(b.multiply(S,PR),Si)\n    positions=[(a,c)for a in range(7)for c in range(7)if(a<4)==(c<4)]\n    b.scalar(3*49*25)\n    M=[[(int(i==a)*T[7*c+j]-T[7*i+a]*int(c==j))%11 for a,c in positions]for i in range(7)for j in range(7)]\n    mc=small.minor(M,b);dim=25-mc['rank']\n    proof.update(stage='common_commutant',S=S.hex(),S_inverse=Si.hex(),\n        conjugated_P_R=T.hex(),block_positions=positions,commutation_matrix=M,\n        commutation_minor=mc,common_commutant_dimension=dim)\n    relation=algebra_relations(Q,Qi,B,U,U2,b);proof['truncated_dihedral_algebra']=relation\n    bases=[bytes.fromhex(x)for x in relation['basis']];commutes=[]\n    for A in bases:\n        commutes.append(b.multiply(A,PH)==b.multiply(PH,A)and b.multiply(A,PR)==b.multiply(PR,A))\n    proof['basis_commutes_with_both_projections']=commutes\n    d=2*relation['nilpotence_degree']if relation['nilpotence_degree']else None\n    good=relation['accepted']and dim==d and all(commutes)\n    proof['stage']='complete';proof['all_required_equations_verified']=good\n    return('VERIFIED_CONDITIONAL_END_INTERSECTION_CERTIFICATE'if good else 'INCONCLUSIVE_COMMUTANT_OR_RELATIONS'),proof\n",
    "controls.py": "\"\"\"Twenty-four fresh fixed-line/third-form designs, including full C6; UNRUN.\"\"\"\nimport sys\nimport runtime as rt\nimport field,algebra,small,centralizer as old,fixed_line as F,alternating as A,role\n\ndef diag(v):return bytes(v[i]if i==j else 0 for i in range(7)for j in range(7))\ndef fixture(b):\n    Q=bytearray(49);N=bytearray(49);PR=bytearray(49)\n    for i,z in enumerate((1,10,1)):\n        for a in range(2):Q[7*(2*i+a)+2*(2-i)+a]=z\n    Q[48]=1\n    for i in range(2):\n        for a in range(2):N[7*(2*i+a)+2*(i+1)+a]=1\n    for i in range(3):\n        for a in range(2):\n            for c in range(2):PR[7*(2*i+a)+2*i+c]=6\n    PR[4]=5;PR[12]=6\n    Q,N,PR=bytes(Q),bytes(N),bytes(PR);N2=b.multiply(N,N)\n    B=diag([10,10,1,1,10,10,1]);PH=diag([1,0,1,0,1,0,1]);E=diag([0,0,0,0,0,0,1])\n    U=F.combine(((1,field.I),(1,N),(6,N2)),b);U2=F.combine(((1,field.I),(2,N),(2,N2)),b)\n    U3=F.combine(((1,field.I),(3,N),(10,N2)),b)\n    marks=(b.multiply(B,U3),B,b.multiply(B,U),b.multiply(B,U2))\n    phi=[int(t in((0,2,4),(1,3,5)))for t in A.TRIPLES]\n    AH=b.multiply(Q,PH);AR=b.multiply(Q,PR)\n    return Q,B,N,N2,PH,PR,E,U,U2,marks,phi,AH,AR\n\ndef fixtures(b):\n    names=[]\n    def yes(name,v):rt.need(v,name);names.append(name)\n    def no(name,call):\n        try:call()\n        except(ValueError,TypeError,KeyError):names.append(name);return\n        raise AssertionError(name)\n    Q,B,N,N2,PH,PR,E,U,U2,marks,phi,AH,AR=fixture(b)\n    status,prior=old.calculate(Q,marks,AH,AR,B,U,U2,b)\n    yes('full_two_projection_fixture_has_commutant_dimension_six',prior['common_commutant_dimension']==6 and prior['commutation_minor']['rank']==19)\n    T=prior['truncated_dihedral_algebra'];basis=[bytes.fromhex(x)for x in T['basis']]\n    yes('old_candidate_basis_has_rank_five_not_six',T['basis_entry_minor']['rank']==5 and status=='INCONCLUSIVE_COMMUTANT_OR_RELATIONS')\n    Qi=bytes.fromhex(prior['Q_inverse']);status,cert=F.calculate(Q,Qi,basis,PH,PR,marks,phi,6,b)\n    yes('full_fixed_line_third_form_fixture_is_positive',status=='VERIFIED_FIXED_LINE_AND_THIRD_FORM_INTERSECTION_CERTIFICATE')\n    L=cert['fixed_line'];yes('common_positive_fixed_line_is_unique',L['dimension']==1 and L['vector']==[0,0,0,0,0,0,1])\n    yes('nondegenerate_line_gives_the_last_coordinate_projector',L['Gram']==1 and bytes.fromhex(L['projector_E'])==E)\n    checks=cert['projector_checks'];yes('new_projector_idempotence_and_adjoint_hold',checks['E_squared']and checks['E_self_adjoint'])\n    yes('middle_involution_fixes_projector_and_radical_annihilates_it',all(checks[k]for k in('BE_equals_E','EB_equals_E','EN_zero','NE_zero'))and cert['BN_squared_equals_minus_N_squared'])\n    yes('new_projector_commutes_with_both_saved_projections',checks['E_commutes_P_H']and checks['E_commutes_P_R'])\n    yes('new_six_element_basis_is_independent',cert['new_basis_entry_minor']['rank']==6)\n    yes('extra_involution_has_special_isometry_frame',all(cert['sigma_checks'].values()))\n    forms=cert['alternating_form'];yes('all_four_synthetic_marks_preserve_the_complete_form',forms['all_four_marks_preserve']and forms['mark_equalities']==[True]*4)\n    yes('extra_involution_is_excluded_by_an_actual_coefficient',not forms['sigma_preserves']and forms['sigma_mismatch']is not None)\n    shear=bytearray(field.I);shear[3]=1;f=[int(t==(1,2,3))for t in A.TRIPLES]\n    image=A.pullback(f,bytes(shear),b);yes('row_pullback_uses_rows_not_columns',image==tuple(int(t in((0,1,2),(1,2,3)))for t in A.TRIPLES))\n    swap=bytearray(field.I);swap[0]=swap[8]=0;swap[1]=swap[7]=1;f=[int(t==(0,1,2))for t in A.TRIPLES]\n    yes('odd_permutation_changes_alternating_sign',A.pullback(f,bytes(swap),b)==tuple(10*x%11 for x in f))\n    sigma=bytes.fromhex(cert['sigma']);f=[int(t==(0,1,6))for t in A.TRIPLES]\n    yes('a_form_through_the_fixed_line_need_not_exclude_sigma',A.pullback(f,sigma,b)==tuple(f))\n    status,_=F.calculate(Q,Qi,basis,PH,PR,marks,[0]*35,6,b)\n    yes('zero_form_never_gives_an_intersection_certificate',status=='INCONCLUSIVE_EXTRA_INVOLUTION_PRESERVES_PHI')\n    bad=list(marks);bad[3]=bytes(shear);status,_=F.calculate(Q,Qi,basis,PH,PR,bad,phi,6,b)\n    yes('one_bad_original_mark_prevents_positive_form_credit',status=='INCONCLUSIVE_ORIGINAL_MARK_DOES_NOT_PRESERVE_PHI')\n    bad=basis[:];bad[5]=bytes(49);status,_=F.calculate(Q,Qi,bad,PH,PR,marks,phi,6,b)\n    yes('missing_BN_squared_relation_is_inconclusive',status=='INCONCLUSIVE_REQUIRED_BN_SQUARED_RELATION')\n    _,line=F.line(Q,F.combine(((10,field.I),),b),N,b)\n    yes('no_common_positive_fixed_line_is_inconclusive',line['dimension']==0)\n    _,line=F.line(Q,field.I,bytes(49),b)\n    yes('multiple_fixed_lines_are_not_arbitrarily_selected',line['dimension']==7)\n    value,line=F.line(bytes(49),B,N,b)\n    yes('isotropic_candidate_line_does_not_make_a_projector',value is None and line['dimension']==1 and line['Gram']==0)\n    no('short_third_form_is_refused',lambda:A.coefficients([0]*34,b))\n    no('noncanonical_third_form_coefficient_is_refused',lambda:A.coefficients([11]+[0]*34,b))\n    dependent=basis[:5]+[N2];mc=small.minor([[a[i]for a in dependent]for i in range(49)],b)\n    yes('an_old_dependent_candidate_cannot_complete_the_basis',mc['rank']==5)\n    rt.need(len(names)==len(set(names))==24,'24 distinct genuinely new fixture designs');return names\n\ndef main():\n    b,q,out,pins=role.start(sys.argv,'controls.py',(rt,field,algebra,small,old,F,A,role))\n    rt.need(q=={'schema':'F004_FIXED_LINE_TENSOR_INTERSECTION_CONTROLS_V1','Root_authority':False},'new Original-free controls request')\n    names=fixtures(b);rt.close_inputs(b)\n    result=dict(schema='F004_FIXED_LINE_TENSOR_INTERSECTION_CONTROLS_RESULT_V1',status='PASS',count=24,names=names,Original_inputs_loaded=False)\n    proof=dict(Source=pins,inputs_closed=True,counts=b.snapshot(),Original_inputs_loaded=False,\n        old_successful_controls_not_replayed=True,full_positive_commutant_fixture_included=True)\n    refs=rt.emit(out,result,proof,b);print(rt.encoded(dict(status='PASS',count=24,outputs=refs,counts=b.snapshot())).decode(),end='')\nif __name__=='__main__':main()\n",
    "field.py": "\"\"\"Canonical F11 data and charged elementary arithmetic; no space solver.\"\"\"\nI=bytes(int(i==j)for i in range(7)for j in range(7))\nINV=(0,1,6,4,3,9,2,8,7,5,10)\n\ndef need(ok,message):\n    if not ok:raise ValueError(message)\n\ndef vector(raw,n,b):\n    b.scalar(n)\n    need(type(raw)in(list,tuple)and len(raw)==n and all(type(x)is int and 0<=x<11 for x in raw),'whole canonical field row')\n    return tuple(raw)\n\ndef middle(raw,b):\n    need(type(raw)is list and len(raw)==2,'exact two ordered middle marks')\n    out=[]\n    for mat in raw:\n        need(type(mat)is list and len(mat)==7,'seven complete matrix rows')\n        out.append(bytes(x for row in mat for x in vector(row,7,b)))\n    for mat in out:need(b.multiply(mat,mat)==I,'both complete middle involution equations')\n    return tuple(out)\n\ndef inv(x,b):\n    b.scalar(2);need(type(x)is int and 0<x<11,'nonzero canonical pivot')\n    y=INV[x];need(x*y%11==1,'literal F11 inverse check');return y\n\ndef normalize(v,b):\n    first=None\n    for x in v:\n        b.scalar(1)\n        if x:first=x;break\n    need(first is not None,'nonzero supplied seed')\n    y=inv(first,b);out=[]\n    for x in v:b.scalar(1);out.append(x*y%11)\n    return out\n\ndef equations(g,signs,b):\n    rows=[]\n    for mat,sign in zip(g,signs):\n        for j in range(7):\n            row=[]\n            for i in range(7):\n                b.scalar(1);row.append((mat[7*i+j]-(sign if i==j else 0))%11)\n            rows.append(tuple(row))\n    return rows\n\ndef selected(blocks,b):\n    out=[]\n    for i,block in enumerate(blocks):\n        if block['nullspace_basis']:\n            out.append(dict(block=i,basis=0,signs=block['signs'],\n                vector=normalize(block['nullspace_basis'][0],b)))\n    return out\n",
    "fixed_line.py": "\"\"\"Complete a certified five-dimensional image by one fixed-line projector.\"\"\"\nimport runtime as rt\nimport field,algebra,small,alternating\nI=field.I\nZERO=bytes(49)\ndef trans(A,b):\n    b.scalar(49);return bytes(A[7*j+i]for i in range(7)for j in range(7))\ndef combine(terms,b):\n    b.scalar(49*len(terms));return bytes(sum(c*A[i]for c,A in terms)%11 for i in range(49))\ndef canonical(A,b):\n    b.scalar(49);rt.need(type(A)is bytes and len(A)==49 and all(x<11 for x in A),'canonical whole seven-dimensional matrix');return A\n\ndef line(Q,B,N,b):\n    b.scalar(147)\n    M=[[N[7*i+j]for i in range(7)]for j in range(7)]\n    M += [[(B[7*i+j]-int(i==j))%11 for i in range(7)]for j in range(7)]\n    cert=small.minor(M,b);d=7-cert['rank']\n    proof=dict(equations=M,rank_minor=cert,dimension=d)\n    if d!=1:return None,proof\n    piv=cert['pivot_columns'];R=cert['RREF'];j=next(j for j in range(7)if j not in piv);v=[0]*7;v[j]=1\n    for i,p in enumerate(piv):b.scalar(1);v[p]=-R[i][j]%11\n    v=bytes(v);rt.need(any(v)and b.image(v,N)==bytes(7)and b.image(v,B)==v,'complete direct fixed-line equations')\n    w=b.image(v,Q);b.scalar(14);s=sum(x*y for x,y in zip(w,v))%11\n    proof.update(vector=list(v),v_times_Q=list(w),Gram=s)\n    if not s:return None,proof\n    z=field.inv(s,b);b.scalar(98);E=bytes(w[i]*z*v[j]%11 for i in range(7)for j in range(7))\n    proof['Gram_inverse']=z;proof['projector_E']=E.hex();return E,proof\n\ndef calculate(Q,Qi,old_basis,PH,PR,marks,phi,old_dimension,b):\n    rt.need(type(old_dimension)is int and old_dimension==6 and len(old_basis)==6,'accepted old commutant dimension and candidate list')\n    for A in(Q,Qi,PH,PR,*old_basis):canonical(A,b)\n    rt.need(old_basis[0]==I,'same retained identity');_,B,N,BN,N2,BN2=old_basis\n    # The old product BN2 is reused; no old matrix power or product is rerun.\n    b.scalar(49);relation=BN2==bytes(-x%11 for x in N2)\n    proof=dict(old_dimension_borrowed=old_dimension,old_five_candidates_borrowed=True,\n        BN_squared_equals_minus_N_squared=relation)\n    if not relation:return 'INCONCLUSIVE_REQUIRED_BN_SQUARED_RELATION',proof\n    E,L=line(Q,B,N,b);proof['fixed_line']=L\n    if L['dimension']!=1:return 'INCONCLUSIVE_FIXED_LINE_DIMENSION',proof\n    if E is None:return 'INCONCLUSIVE_ISOTROPIC_FIXED_LINE',proof\n    checks=dict(E_squared=b.multiply(E,E)==E,\n        E_self_adjoint=b.multiply(b.multiply(Q,trans(E,b)),Qi)==E,\n        BE_equals_E=b.multiply(B,E)==E,EB_equals_E=b.multiply(E,B)==E,\n        EN_zero=b.multiply(E,N)==ZERO,NE_zero=b.multiply(N,E)==ZERO,\n        E_commutes_P_H=b.multiply(E,PH)==b.multiply(PH,E),\n        E_commutes_P_R=b.multiply(E,PR)==b.multiply(PR,E))\n    proof['projector_checks']=checks\n    if not all(checks.values()):return 'INCONCLUSIVE_PROJECTOR_RELATIONS',proof\n    basis=[I,B,N,BN,N2,E];mc=small.minor([[A[i]for A in basis]for i in range(49)],b)\n    proof['new_basis_entry_minor']=mc;proof['new_basis']=[A.hex()for A in basis]\n    if mc['rank']!=6:return 'INCONCLUSIVE_PROJECTOR_NOT_COMPLETING_BASIS',proof\n    sigma=combine(((2,E),(10,I)),b)\n    sigma_checks=dict(square=b.multiply(sigma,sigma)==I,\n        row_isometry=b.multiply(b.multiply(sigma,Q),trans(sigma,b))==Q,\n        determinant_one=small.det(algebra.rows(sigma),b)==1)\n    proof.update(sigma=sigma.hex(),sigma_checks=sigma_checks)\n    if not all(sigma_checks.values()):return 'INCONCLUSIVE_EXTRA_INVOLUTION_FRAME',proof\n    forms=alternating.certificate(phi,marks,sigma,b);proof['alternating_form']=forms\n    if not forms['all_four_marks_preserve']:return 'INCONCLUSIVE_ORIGINAL_MARK_DOES_NOT_PRESERVE_PHI',proof\n    if forms['sigma_preserves']:return 'INCONCLUSIVE_EXTRA_INVOLUTION_PRESERVES_PHI',proof\n    proof['conditional_algebra_and_third_form_hypotheses_verified']=True\n    return 'VERIFIED_FIXED_LINE_AND_THIRD_FORM_INTERSECTION_CERTIFICATE',proof\n",
    "role.py": "\"\"\"Whole Source and Root-only job admission. No import issues Root authority.\"\"\"\nimport sys\nfrom pathlib import Path\nimport runtime as rt\nBASE={'runtime.py','role.py','field.py','algebra.py','small.py','fixed_line.py','alternating.py'}\nEXTRA={'worker.py':{'scope.py'},'controls.py':{'centralizer.py'}}\ndef loaded(r,b,cap):\n    rt.ref(r);rt.need(r['bytes']<=cap,'bounded whole dependency');return rt.decode(b.read(r['path'],r,cap))\n\ndef start(argv,entry,modules):\n    mp,ms,jp,js,out=rt.arguments(argv)\n    rt.need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode\n        and not sys.flags.optimize and all(k not in rt.os.environ for k in rt.ENV4),'same EBS/ENV4')\n    b=rt.Budget();raw=b.read(mp,cap=65536);rt.need(rt.digest(raw)==ms,'Root-selected whole manifest')\n    mf=rt.decode(raw);rt.need(set(mf)=={'schema','caps','entry','sources','external_runtime'}\n        and mf['schema']=='F004_FIXED_LINE_TENSOR_INTERSECTION_SOURCE_V1' and mf['caps']==rt.CAPS\n        and entry in EXTRA and mf['entry']==entry,'exact closed role Source schema')\n    names=BASE|{entry}|EXTRA[entry];rt.need(len(mf['sources'])==len(names)and{x['path']for x in mf['sources']}==names,\n                             'exact complete active role Source bodies')\n    base=Path(mp).resolve().parent;total=0\n    for r in mf['sources']:\n        rt.ref(r);rt.need(Path(r['path']).name==r['path'],'same-directory Source');total+=len(b.read(base/r['path'],r))\n    used=set();external=0\n    for r in mf['external_runtime']:\n        rt.ref(r);name=Path(r['path']).name\n        rt.need(name in rt.EXTERNAL_RUNTIME and name not in used\n            and(r['bytes'],r['sha256'])==rt.EXTERNAL_RUNTIME[name],'literal inherited guards')\n        used.add(name);external+=len(b.read(r['path'],r))\n    rt.need(len(used)==2 and total+external+512<=65536,'complete Source plus512 entry reserve')\n    reserved=total+59889+512;rt.need(b.read_bytes+reserved<=8388608,'same8MiB project bootstrap')\n    b.read_bytes+=reserved;b.import_source_reserved_bytes=reserved\n    for module in modules:\n        name=module.__name__+'.py';rt.need(name in names and Path(module.__file__).resolve()==base/name,\n                                         'actual module origin')\n        for value in vars(module).values():\n            if type(value).__name__=='function'and value.__module__==module.__name__:\n                rt.need(value.__globals__ is vars(module)and Path(value.__code__.co_filename).resolve()==base/name,\n                        'actual whole function globals/filename')\n        for cls in vars(module).values():\n            if isinstance(cls,type)and cls.__module__==module.__name__:\n                for value in cls.__dict__.values():\n                    if type(value).__name__=='function':\n                        rt.need(value.__globals__ is vars(module)\n                            and Path(value.__code__.co_filename).resolve()==base/name,'actual whole helper method')\n    caller=sys._getframe(1).f_globals;rt.need(Path(caller['__file__']).resolve()==base/entry,'exact role entry')\n    for value in caller.values():\n        if type(value).__name__=='function'and value.__module__==caller['__name__']:\n            rt.need(value.__globals__ is caller and Path(value.__code__.co_filename).resolve()==base/entry,\n                    'whole actual caller definitions')\n    body=b.read(jp,cap=131072);rt.need(rt.digest(body)==js,'Root-selected whole role job')\n    return b,rt.decode(body),out,dict(Source_manifest_sha256=ms,worker_Source_bytes=total,\n        guard_Source_bytes=external,entry_reserve=512,Root_authority_created=False)\n\n",
    "runtime.py": "\"\"\"Declared arithmetic budgets and whole-file IO. No Root authority is created.\"\"\"\nimport hashlib,json,os,resource,stat,sys,time\nfrom pathlib import Path\nCAPS=dict(matrix_products=400000,row_images=200000,linear_units=200000,\n          read_bytes=8388608,paths=96,source_bytes=65536,\n          rss_bytes=134217728,seconds=100,output_files=2,output_bytes_each=131072)\nSOURCE_NAMES={'runtime.py','field.py','algebra.py','solve.py','schreier.py','request.py','propose.py','consume.py','controls.py'}\nENV4=('COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG','OPENSSL_CONF','OPENSSL_MODULES')\nEXTERNAL_RUNTIME={\n 'supervise_validation.py':(4806,'c3b626b86791ac355c3503a654136f49ad76abbcdfadf0455efb32dd5cca25f4'),\n 'supervise_transient.py':(18361,'5c7eed80537835e1a78c8489621d34741eeafc01f47fb394fec519e83f2c9b42')}\nclass Limit(RuntimeError):pass\n\ndef need(ok,message):\n    if not ok:raise ValueError(message)\n\ndef duplicate_free(pairs):\n    out={}\n    for k,v in pairs:\n        need(k not in out,'duplicate JSON key');out[k]=v\n    return out\n\ndef decode(data):\n    def bad_number(_):raise ValueError('only integer JSON numbers')\n    return json.loads(data,object_pairs_hook=duplicate_free,parse_float=bad_number,parse_constant=bad_number)\n\ndef encoded(value):\n    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode('ascii')+b'\\n'\n\ndef digest(data):return hashlib.sha256(data).hexdigest()\n\ndef ref(value):\n    need(type(value)is dict and set(value)=={'path','bytes','sha256'},'whole-file descriptor')\n    need(type(value['path'])is str and 0<len(value['path'])<=4096,'bounded file path')\n    need(type(value['bytes'])is int and 0<=value['bytes']<=8388608,'bounded byte count')\n    h=value['sha256'];need(type(h)is str and len(h)==64 and all(c in '0123456789abcdef'for c in h),'whole SHA256')\n    return value\n\nclass Budget:\n    Limit=Limit\n    def __init__(self):\n        self.started=time.monotonic();self.calls=0;self.products=0;self.rows=0;self.linear=0\n        self.read_bytes=0;self.explicit_read_bytes=0;self.import_source_reserved_bytes=0\n        self.paths=set();self.reads=[];self.peak_rss=0\n    def tick(self):\n        self.calls+=1\n        if time.monotonic()-self.started>90:raise Limit('90 second cooperative deadline; outer role remains 100/150 seconds')\n        if self.calls%256==1:\n            rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n            if sys.platform!='darwin':rss*=1024\n            self.peak_rss=max(self.peak_rss,rss)\n            if rss>117440512:raise Limit('112 MiB cooperative RSS; outer role remains 128 MiB')\n    def scalar(self,n):\n        self.tick();need(type(n)is int and n>=0,'nonnegative linear debit')\n        if self.linear+n>CAPS['linear_units']:raise Limit('shared 200000 linear-unit bank')\n        self.linear+=n\n    def multiply(self,a,b):\n        self.tick()\n        if self.products>=CAPS['matrix_products']:raise Limit('400000 complete matrix products')\n        self.products+=1\n        return bytes(sum(a[7*i+k]*b[7*k+j]for k in range(7))%11 for i in range(7)for j in range(7))\n    def image(self,v,a):\n        self.tick()\n        if self.rows>=CAPS['row_images']:raise Limit('200000 complete row images')\n        self.rows+=1\n        return bytes(sum(v[k]*a[7*k+j]for k in range(7))%11 for j in range(7))\n    def read(self,path,expected=None,cap=4194304):\n        self.tick();p=Path(path)\n        need(not p.is_symlink(),'no symlink input')\n        p=p.resolve(strict=True);name=str(p)\n        need(len(self.paths|{name})<=CAPS['paths'],'96 distinct whole input paths')\n        flags=os.O_RDONLY|getattr(os,'O_NOFOLLOW',0)\n        fd=os.open(name,flags)\n        try:\n            before=os.fstat(fd);need(stat.S_ISREG(before.st_mode)and before.st_nlink==1 and before.st_size<=cap,'bounded regular single-link whole input')\n            need(self.read_bytes+before.st_size<=CAPS['read_bytes'],'8 MiB cumulative physical input reads')\n            with os.fdopen(fd,'rb',closefd=False)as f:data=f.read(before.st_size+1)\n            after=os.fstat(fd)\n            signature=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)\n            need(signature(before)==signature(after)==signature(p.lstat())\n                 and len(data)==before.st_size,'stable whole read including EOF')\n        finally:os.close(fd)\n        self.read_bytes+=len(data);self.explicit_read_bytes+=len(data);self.paths.add(name)\n        got=dict(path=name,bytes=len(data),sha256=digest(data))\n        if expected is not None:\n            ref(expected);need(got['bytes']==expected['bytes']and got['sha256']==expected['sha256'],'whole-file size and digest')\n        self.reads.append(got);return data\n    def snapshot(self):\n        self.tick();return dict(matrix_products=self.products,row_images=self.rows,linear_units=self.linear,\n            read_bytes=self.read_bytes,explicit_read_bytes=self.explicit_read_bytes,\n            import_source_reserved_bytes=self.import_source_reserved_bytes,\n            distinct_read_paths=len(self.paths),whole_read_events=len(self.reads),\n            whole_read_sequence_sha256=digest(encoded(self.reads)),\n            elapsed_microseconds=int((time.monotonic()-self.started)*1000000),peak_rss_bytes=self.peak_rss)\n\ndef startup(manifest_path,manifest_sha,job_path,job_sha):\n    need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode and not sys.flags.optimize,'require -E -B -S without -O')\n    need(all(name not in os.environ for name in ENV4),'original matrix-role ENV4 variables absent')\n    b=Budget();raw=b.read(manifest_path,cap=65536);need(digest(raw)==manifest_sha,'Root-selected manifest digest')\n    need(len(raw)<=65536,'bounded manifest before JSON decoding')\n    m=decode(raw);need(type(m)is dict and set(m)=={'schema','caps','sources','external_runtime'},'complete Source manifest')\n    need(m['schema']=='F004_SMALL_STABILIZER_SCHREIER_ORDER_SOURCE_V1'and m['caps']==CAPS,'unchanged declared caps')\n    files=m['sources'];need(type(files)is list and len(files)==9,'nine whole worker Source files')\n    names=[x['path']for x in files];need(set(names)==SOURCE_NAMES and len(set(names))==9,'exact complete worker Source namespace')\n    total=0;base=Path(manifest_path).resolve().parent\n    for x in files:\n        ref(x);need(Path(x['path']).name==x['path'],'same-directory Source only')\n        data=b.read(base/x['path'],x);total+=len(data)\n    external=m['external_runtime'];need(type(external)is list and len(external)==2,'two disclosed external guard Sources')\n    used=set();external_total=0\n    for x in external:\n        ref(x);name=Path(x['path']).name\n        need(name in EXTERNAL_RUNTIME and name not in used and (x['bytes'],x['sha256'])==EXTERNAL_RUNTIME[name],'exact acquired external runtime')\n        used.add(name);external_total+=len(b.read(x['path'],x))\n    need(total+external_total<=CAPS['source_bytes'],'worker plus disclosed external runtime union at most65536')\n    # Nominal project bootstrap bodies are additional to explicit Source pins.\n    # The supervisor reads the transient body twice then loads it once.\n    reserved=total+4806+3*18361\n    need(b.read_bytes+reserved<=CAPS['read_bytes'],'project bootstrap reservation in the same 8 MiB bank')\n    b.read_bytes+=reserved;b.import_source_reserved_bytes=reserved\n    body=b.read(job_path,cap=262144);need(digest(body)==job_sha,'Root-selected whole arithmetic job digest')\n    need(len(body)<=262144,'256 KiB arithmetic job before JSON decoding')\n    job=decode(body);need(type(job)is dict,'complete job object')\n    need(Path(__file__).resolve()==base/'runtime.py','actual runtime origin is the manifest directory')\n    return b,job,dict(manifest_sha256=manifest_sha,job_sha256=job_sha,manifest_directory=str(base),worker_Source_union_bytes=total,\n        external_runtime_Source_bytes=external_total,combined_Source_union_bytes=total+external_total,\n        source_names=sorted(names),Root_authority_created=False)\n\ndef origins(pins,script_file,modules):\n    base=Path(pins['manifest_directory']);script=Path(script_file).resolve()\n    need(script.parent==base and script.name in {'propose.py','consume.py','controls.py'},'actual reviewed caller origin')\n    need(Path(__file__).resolve()==base/'runtime.py','actual reviewed runtime origin')\n    for module in modules:\n        name=module.__name__+'.py'\n        need(name in SOURCE_NAMES and Path(module.__file__).resolve()==base/name,'all actually loaded scientific module origins')\n        for value in vars(module).values():\n            if type(value).__name__=='function'and value.__module__==module.__name__:\n                need(value.__globals__ is vars(module)and Path(value.__code__.co_filename).resolve()==base/name,'whole actual function body/globals origin')\n        for cls in vars(module).values():\n            if isinstance(cls,type)and cls.__module__==module.__name__:\n                for method in cls.__dict__.values():\n                    if type(method).__name__=='function':\n                        need(method.__globals__ is vars(module)and Path(method.__code__.co_filename).resolve()==base/name,'actual helper class method origins')\n    current=sys.modules[__name__]\n    for value in vars(current).values():\n        if type(value).__name__=='function'and value.__module__==__name__:\n            need(value.__globals__ is vars(current)and Path(value.__code__.co_filename).resolve()==base/'runtime.py','actual runtime function origin')\n    for value in Budget.__dict__.values():\n        if type(value).__name__=='function':\n            need(value.__globals__ is vars(current)and Path(value.__code__.co_filename).resolve()==base/'runtime.py','actual arithmetic Budget method origin')\n    caller=sys._getframe(1).f_globals\n    for value in caller.values():\n        if type(value).__name__=='function'and value.__module__==caller['__name__']:\n            need(value.__globals__ is caller and Path(value.__code__.co_filename).resolve()==script,'whole actual caller function origin')\n\n\ndef close_inputs(b):\n    for r in list(b.reads):b.read(r['path'],r)\n\ndef provenance(job,b):\n    \"\"\"Pin supplied context files without interpreting their scientific authority.\"\"\"\n    refs=job['context_refs'];need(type(refs)is list and len(refs)<=80,'finite explicit context bank')\n    seen=set()\n    for x in refs:\n        ref(x);name=str(Path(x['path']).resolve(strict=True));need(name not in seen,'no duplicate context role')\n        seen.add(name);b.read(x['path'],x)\n    return dict(pinned_context_files=len(refs),local_pins_issue_Root_authority=False,\n        original_marking_frame_and_current_scope_joins='EXTERNAL_ROOT_DUTIES_NOT_INFERRED_FROM_HASHES')\n\ndef emit(outdir,result,proof,b):\n    p=Path(outdir);need(p.is_absolute()and p.is_relative_to('/private/tmp')and p.parent.resolve(strict=True)==p.parent and not p.exists(),'fresh canonical private output directory')\n    need(p.parent.is_dir()and not p.parent.is_symlink(),'existing regular output parent')\n    bodies=[encoded(result),encoded(proof)]\n    need(all(len(x)<=CAPS['output_bytes_each']for x in bodies),'two outputs at most 128 KiB each')\n    need(len(b.paths|{str(p.resolve()/'result.json'),str(p.resolve()/'proof.json')})<=CAPS['paths'],'96 paths including outputs')\n    b.tick();p.mkdir()\n    for name,data in zip(('result.json','proof.json'),bodies):\n        with open(p/name,'xb')as f:f.write(data)\n    return [dict(path=str((p/name).resolve()),bytes=len(data),sha256=digest(data))for name,data in zip(('result.json','proof.json'),bodies)]\n\ndef arguments(argv):\n    need(len(argv)==6,'manifest manifestSHA job jobSHA fresh-output-dir')\n    return argv[1:]\n\ndef emit_carrier(outdir,carrier,proposal,b):\n    p=Path(outdir);values=[('certificate.bin',carrier),('proposal.json',encoded(proposal))]\n