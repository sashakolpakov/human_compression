    "small.py": "\"\"\"Retained small F11 elimination, with explicit minor and inverse checks.\"\"\"\nimport runtime as rt\nimport field\n\ndef small_transpose(M):return [list(r)for r in zip(*M)]\ndef mm(A,B,b):\n    m,k,n=len(A),len(B),len(B[0]);rt.need(k and all(len(r)==k for r in A),'small matrix dimensions')\n    b.scalar(2*m*n*k)\n    return [[sum(A[i][t]*B[t][j]for t in range(k))%11 for j in range(n)]for i in range(m)]\ndef rref(M,columns,b):\n    A=[list(r)for r in M];piv=[];h=0;w=len(A[0]);ids=list(range(len(A)));chosen=[]\n    for j in range(columns):\n        b.scalar(len(A));p=next((i for i in range(h,len(A))if A[i][j]),None)\n        if p is None:continue\n        A[h],A[p]=A[p],A[h];ids[h],ids[p]=ids[p],ids[h];chosen.append(ids[h])\n        b.scalar(w);z=field.inv(A[h][j],b);A[h]=[(x*z)%11 for x in A[h]]\n        for i in range(len(A)):\n            if i==h:continue\n            b.scalar(1);z=A[i][j]\n            if z:\n                b.scalar(2*w);A[i]=[(x-z*y)%11 for x,y in zip(A[i],A[h])]\n        piv.append(j);h+=1\n        if h==len(A):break\n    return A,piv,chosen\n\ndef identity(n):return [[int(i==j)for j in range(n)]for i in range(n)]\ndef inverse(M,b):\n    n=len(M);rt.need(1<=n<=25 and all(len(r)==n for r in M),'small square inverse')\n    R,p,_=rref([r+e for r,e in zip(M,identity(n))],n,b)\n    if len(p)!=n:return None\n    X=[r[n:]for r in R]\n    rt.need(mm(M,X,b)==identity(n),'full small inverse product')\n    return X\n\ndef minor(M,b,columns=None):\n    n=len(M[0])if columns is None else columns\n    R,cols,rows=rref(M,n,b);r=len(cols)\n    A=[[M[i][j]for j in cols]for i in rows];X=inverse(A,b)if r else []\n    rt.need(X is not None,'selected original minor is nonsingular')\n    return dict(rank=r,RREF=R,pivot_rows=rows,pivot_columns=cols,minor=A,inverse=X)\n\ndef det(M,b):\n    A=[list(r)for r in M];n=len(A);v=1\n    rt.need(n==7 and all(len(r)==n for r in A),'seven-dimensional determinant')\n    for j in range(n):\n        b.scalar(n