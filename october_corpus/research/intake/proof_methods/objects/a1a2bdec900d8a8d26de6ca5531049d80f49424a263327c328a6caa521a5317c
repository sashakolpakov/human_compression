def squash(b):
 s=b.decode();out=[];quoted=False;escaped=False
 for c in s:
  if quoted:
   out.append(c)
   if escaped:escaped=False
   elif c=='\\':escaped=True
   elif c=='"':quoted=False
  elif c=='"':quoted=True;out.append(c)
  elif c not in' \r\n\t':out.append(c)
