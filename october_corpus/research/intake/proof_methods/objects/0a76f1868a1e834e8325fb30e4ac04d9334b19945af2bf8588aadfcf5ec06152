def enc(x):return (json.dumps(x,sort_keys=True,separators=(',',':'))+'\n').encode()
def sha(x):return hashlib.sha256(x).hexdigest()
def descriptor(p,body):return dict(path=str(p),bytes=len(body),sha256=sha(body))
def whole(p,expected=None):
 global READ
 p=Path(p);assert p.is_absolute() and not p.is_symlink()
 p=p.resolve(strict=True);assert len(CACHE|{str(p):None})<=512
 fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
 try:
  a=os.fstat(fd);assert stat.S_ISREG(a.st_mode) and a.st_size<=4*2**20
  assert READ+a.st_size<=64*2**20 and time.monotonic()-START<100
  with os.fdopen(fd,'rb',closefd=False) as f:body=f.read(a.st_size+1)
  b=os.fstat(fd);c=p.stat()
  sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
  assert sig(a)==sig(b)==sig(c) and len(body)==a.st_size
 finally:os.close(fd)
 r=descriptor(p,body);READ+=len(body)
 if expected is not None:assert r==expected,(str(p),'descriptor mismatch')
 if str(p) in CACHE:assert CACHE[str(p)][0]==r and CACHE[str(p)][1]==body
 CACHE[str(p)]=(r,body);EVENTS.append(r);return body
