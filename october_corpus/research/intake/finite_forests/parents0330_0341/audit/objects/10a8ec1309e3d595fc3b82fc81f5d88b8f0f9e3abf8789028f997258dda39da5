    b=p.read_bytes();assert p.stat()==st;READ+=len(b);assert READ<=64*2**20
    rr=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    if r is not None:assert rr==r
    PINS[str(p)]=rr;BANK[str(p)]=b;assert len(PINS)<=512
    return b,rr
