def descriptor_closure(L,blob):
 fields=spans(blob)
 if set(fields)=={'path','bytes','sha256'}:
  ref=selected(blob,['path','bytes','sha256'])
  raw(L,ref)
  return
 for key,value in fields.items():
  if key in FORBIDDEN:
   continue
  if value.startswith(b'{'):
   descriptor_closure(L,value)
  elif value.startswith(b'['):
   for item in array(value):
    if item.startswith(b'{'):
     descriptor_closure(L,item)

def opaque_normal(b):
 out,quoted,escape=bytearray(),False,False
 for c in b:
  if quoted:
   out.append(c)
   if escape:
    escape=False
   elif c==92:
    escape=True
   elif c==34:
    quoted=False
  elif c==34:
   out.append(c)
   quoted=True
  elif c not in b' \r\n\t':
   out.append(c)
 assert not quoted
 return bytes(out)

