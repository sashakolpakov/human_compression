 assert Path(r['path']).is_absolute() and 0<=r['bytes']<=4*2**20 and len(r['sha256'])==64
 return r

def lexend(s,i):
 stack,quoted,escape=[],False,False
 while i < len(s):
  c=s[i]
  if quoted:
   if escape:
    escape=False
   elif c==92:
    escape=True
   elif c==34:
    quoted=False
  elif c==34:
   quoted=True
  elif c in (91,123):
   stack.append(c)
  elif c in (93,125):
   if not stack:
    break
   assert stack.pop()==(91 if c==93 else 123)
  elif c==44 and not stack:
   break
  i += 1
 assert not quoted and not stack
 return i

def ws(s,i):
 while i < len(s) and s[i] in b' \r\n\t':
  i += 1
 return i

def spans(b):
 i=ws(b,0)
 assert b[i]==123
 i,out=ws(b,i+1),{}
 while b[i]!=125:
  assert b[i]==34
  j,escape=i+1,False
  while True:
   assert j < len(b)
   if not escape and b[j]==34:
    break
   escape=not escape if b[j]==92 else False
   j += 1
  key=json.loads(b[i:j+1])
  assert type(key) is str and key not in out
  i=ws(b,j+1)
  assert b[i]==58
  i=ws(b,i+1)
  j=lexend(b,i)
  out[key]=b[i:j].rstrip()
  i=ws(b,j)
  if b[i]==44:
   i=ws(b,i+1)
   assert b[i]!=125
  else:
   break
 assert b[i]==125 and ws(b,i+1)==len(b)
 return out

def array(b):
 i=ws(b,0)
 assert b[i]==91
 i,out=ws(b,i+1),[]
 while b[i]!=93:
  j=lexend(b,i)
  out.append(b[i:j].rstrip())
  i=ws(b,j)
  if b[i]==44:
   i=ws(b,i+1)
   assert b[i]!=93
  else:
   break
 assert b[i]==93 and ws(b,i+1)==len(b)
 return out

def selected(b,keys):
 assert not set(keys).intersection(FORBIDDEN)
 p=spans(b)
 return {k: json.loads(p[k]) for k in keys if k in p}

