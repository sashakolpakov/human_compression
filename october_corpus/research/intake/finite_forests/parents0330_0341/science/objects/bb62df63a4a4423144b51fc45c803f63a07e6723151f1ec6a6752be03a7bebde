    for value in space.values():
        if type(value)is type and value.__module__==space['__name__']:
            for f in vars(value).values():
                if isinstance(f,types.FunctionType):io.need(f.__globals__ is space and f.__code__.co_filename==ref['path'],'whole class method origin')

