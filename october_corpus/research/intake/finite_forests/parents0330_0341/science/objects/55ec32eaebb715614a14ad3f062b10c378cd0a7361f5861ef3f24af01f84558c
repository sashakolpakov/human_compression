"""Generic incremental cover: exact hereditary predicates, never a census."""

PREPARE_FEE=400000
CHILD_FEE=2048
SUBGROUP_FEE=100000
DECODE_FEE=4096

def need(ok,why):
    if not ok:raise ValueError(why)

def structural(K,f):
    # Literal rejection precedence: this DSU contains DEFECT edges only.
    S=K['S'];degree=[0]*80;parent=list(range(80))
    def root(v):
        while parent[v]!=v:v=parent[v]
        return v
    for u,v in f:
        degree[u]+=1;degree[v]+=1
        if degree[u]>(1 if u==61 else 2 if u in S else 3)or degree[v]>(1 if v==61 else 2 if v in S else 3):return 'DEGREE_BUDGET'
        a,b=root(u),root(v)
        if a==b:return 'FOREST_CYCLE'
        parent[a]=b
    for u,v in K['SEED']:degree[u]+=1;degree[v]+=1
    if any(d>3 for d in degree):return 'DEGREE_BUDGET'
    return 'NONE'

def prepare(K,parent,work):
    f=K['shaped'](parent)
    need(len(f)<6 and K['rejection'](f,work)=='NONE','passing parent at level0through5')
    work.charge(PREPARE_FEE,'prepaid80_full_parent_BFS_and_matrix_storage')
    adj=[[]for _ in range(80)]
    for u,v in K['SEED']+f:adj[u].append(v);adj[v].append(u)
    rows=[]
    for start in range(80):
        d=[80]*80;d[start]=0;queue=[start];at=0
        while at<len(queue):
            u=queue[at];at+=1
            for v in adj[u]:
                if d[v]==80:d[v]=d[u]+1;queue.append(v)
        rows.append(d)
    return f,rows

def graph_reason(dist,u,v):
    if dist[u][v]<9:return 'FULL_SEED_SHORT_CYCLE'
    if min(dist[0][62],dist[0][u]+1+dist[v][62],dist[0][v]+1+dist[u][62])<8:return 'ROOT_DISTANCE'
    return 'NONE'

def disposition(K,f,dist,slot,work):
    need(type(slot)is int and 0<=slot<156,'typed entire host slot')
    edge=K['HOST'][slot]
    if edge in f:return dict(slot=slot,kind='EXISTING')
    work.charge(CHILD_FEE,'prepaid_sorted_child_degree_defect_DSU_and_incremental_distances')
    child=tuple(sorted(f+(edge,)));why=structural(K,child)
    if why=='NONE':why=graph_reason(dist,*edge)
    return dict(slot=slot,kind='ORBIT')if why=='NONE'else dict(slot=slot,kind='REJECT',reason=why)

def inverse(p):
    need(type(p)is list and len(p)==80 and all(type(v)is int for v in p)and sorted(p)==list(range(80)),'full80 permutation')
    q=[0]*80
    for i,v in enumerate(p):q[v]=i
    return q

def compact(K,p,work):
    """Recover source-coordinate swap bits, then compare ALL80 images."""
    work.charge(DECODE_FEE,'prepaid_full80_transversal_compact_decode_and_equality')
    inverse(p);need({p[v]for v in K['TREE']}==set(K['TREE'])and {p[v]for v in K['U']}==set(K['U']),'complete TREE and U domains')
    index={v:j for j,v in enumerate(K['TREE'])};mask=0
    for bit,j in enumerate(K['FREE']):
        at=index[p[K['TREE'][j]]];left=index[p[K['TREE'][2*j+1]]]
        need(left in(2*at+1,2*at+2),'TREE child image is a binary child')
        if left==2*at+2:mask|=1<<bit
    u=[p[v]-72 for v in K['U']]
    need(K['point_map'](mask,u)==p,'entire80 image equals original mask and U8 action')
    return mask,u

def stabilizer_transversals(K,f,work):
    # A subgroup is sufficient; these are NOT claimed to generate all Stab(f).
    work.charge(SUBGROUP_FEE,'prepaid18_candidates156slot_BFS_and_full80_transversals')
    identity=list(range(8));generators=[]
    candidates=[(1<<bit,identity)for bit in range(11)]
    for i in range(7):
        u=identity.copy();u[i],u[i+1]=u[i+1],u[i];candidates.append((0,u))
    for mask,u in candidates:
        p=K['point_map'](mask,u)
        if K['moved_edges'](f,p)==f:
            K['orbit_witness'](f,f,mask,u,work);generators.append(p)
    by_edge={e:j for j,e in enumerate(K['HOST'])};trans={};representative={}
    for seed in range(156):
        if seed in trans:continue
        trans[seed]=list(range(80));representative[seed]=seed;queue=[seed];at=0
        while at<len(queue):
            slot=queue[at];at+=1;u,v=K['HOST'][slot]
            for g in generators:
                target=by_edge[tuple(sorted((g[u],g[v])))]
                if target not in trans:
                    # First trans[slot], then g. Both fix the entire parent.
                    trans[target]=[g[x]for x in trans[slot]]
                    representative[target]=seed;queue.append(target)
    need(set(trans)==set(representative)==set(range(156)),'all156 host positions in subgroup cover')
    return representative,trans

def cover(K,parent,work,records=None,compress=True):
    need(type(compress)is bool,'typed optional subgroup compression')
    if records is not None:need(type(records)is list and len(records)==156,'exact156 supplied records')
    f,dist=prepare(K,parent,work)
    representatives=trans=None
    if records is None and compress:representatives,trans=stabilizer_transversals(K,f,work)
    result=[];targets=set()
    for slot in range(156):
        expected=disposition(K,f,dist,slot,work)
        if expected['kind']=='ORBIT':
            child=tuple(sorted(f+(K['HOST'][slot],)))
            if records is None:
                if compress:
                    p=inverse(trans[slot]);mask,u=compact(K,p,work)
                    target=tuple(sorted(f+(K['HOST'][representatives[slot]],)))
                else:mask,u,target=0,list(range(8)),child
                row=dict(slot=slot,kind='ORBIT',target=K['lists'](target),action_index=mask,U_permutation=u)
            else:
                row=records[slot]
                need(type(row)is dict and set(row)=={'slot','kind','target','action_index','U_permutation'}
                     and type(row['slot'])is int and row['slot']==slot and row['kind']=='ORBIT','typed full passing child witness')
                target=K['shaped'](row['target'])
            K['orbit_witness'](child,target,row['action_index'],row['U_permutation'],work)
            expected=row;targets.add(tuple(tuple(e)for e in row['target']))
        if records is not None:
            row=records[slot]
            need(type(row)is dict and type(row.get('slot'))is int and row==expected,'exact slot and old rejection precedence')
        result.append(expected)
    return dict(schema='F009_FOREST_EXTENSION_INTERVAL_V1',parent=K['lists'](f),parent_level=len(f),
                begin=0,end=156,records=result,next_parent_forests=[K['lists'](x)for x in sorted(targets)],
                all_slots_in_interval_accounted=True,whole156_parent_or_level_or_census_claimed=False)

def batch(K,parents,work,saved=None,compress=True):
    need(type(parents)is list and 1<=len(parents)<=3,'one to three finite parent subjects')
    subjects=[K['shaped'](f)for f in parents]
    need(len(set(subjects))==len(subjects),'distinct exact parents')
    if saved is not None:
        need(type(saved)is dict and set(saved)=={'schema','covers'}and saved['schema']=='F009_INCREMENTAL_PARENT_COVER_BATCH_V1'
             and type(saved['covers'])is list and len(saved['covers'])==len(parents),'exact supplied batch schema and roster')
    covers=[]
    for i,f in enumerate(subjects):
        old=None if saved is None else saved['covers'][i]
        if old is not None:need(type(old)is dict and old.get('parent')==K['lists'](f),'exact ordered parent subject')
        result=cover(K,f,work,None if old is None else old['records'],compress)
        if old is not None:need(result==old,'complete strict cover and target union recomputed')
        covers.append(result)
    return dict(schema='F009_INCREMENTAL_PARENT_COVER_BATCH_V1',covers=covers)
