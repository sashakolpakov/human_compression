"""UNRUN word-only admission; numerical equalities remain separate."""
from retained_math import need,can

PREMISES=(
 'faithful_Original_G_frame_member_and_transporter_meanings_owned',
 'four_reconstructed_marks_are_members_of_this_same_Original_G_owned',
 'two_actual_ambient_matrices_are_known_members_of_this_same_G_owned',
 'known_K_generators_are_exactly_the_previously_certified_generators_owned',
 'known_K_accepted_properness_in_this_same_Original_G_owned',
 'known_K_and_new_marks_use_exactly_the_same_actual_matrix_frame_owned',
 'all_current_selector_adoptions_have_exact_typed_per_job_meanings_owned',
 'selected_unpaid_cases_and_word_containment_implication_owned')

def typed(values,total):
 need(type(values)is list and all(type(i)is int and 1<=i<=total for i in values)
  and values==sorted(set(values)),'typed distinct original positions')
 return values

def known(plan,imported):
 """No numerical operation or reinterpretation of an old acceptance schema."""
 need(imported['schema']=='ROOT_IMPORTED_Q11_KNOWN_PROPER_SUBGROUP_WORDS_V1'
  and imported['root']=='/root'and imported['Root_authority']is imported['issued']is True,
  'separate issued Root known-proper-K/original-frame premises')
 for key in('original_job','selector','selected_orbit_positions','original_domain_whole_pins',
  'original_orbit_array_sha256','matrix_frame_result','known_K','known_K_evidence','properness_argument'):
  need(can(imported[key])==can(plan[key]),'exact typed Root word import '+key)
 need(type(imported['known_K_order'])is int and imported['known_K_order']>0
  and type(plan['known_K_evidence'])is list and bool(plan['known_K_evidence']),
  'explicit accepted finite K fact and exact evidence, never order discovery')
 for key in PREMISES:need(imported[key]is True,'Root premise '+key)
 return True

def select(plan,current,ctx,digest,expand):
 job=plan['original_job'];total=ctx['projection']['original_orbit_rows']
 need(type(job)is list and len(job)==2 and all(type(i)is int for i in job)
  and job[0]>0 and job[1]==4 and current['original_job']==job
  and type(total)is int and 1<=total<=14763,'same original rank-four domain')
 need(current['schema']=='ROOT_ACCEPTED_Q11_RANK4_UNRESOLVED_SELECTOR_V1'
  and current['root']=='/root'and current['adopted']is True
  and current['original_orbit_positions']==total
  and current['projection']==plan['projection']
  and current['Root_projection_acceptance']==plan['Root_projection_acceptance'],
  'same exact adopted current selector and projection')
 baseline=typed(current['original_paid_positions'],total)
 paid=typed(current['accepted_new_paid_positions'],total)
 pending=typed(expand(current['unresolved_position_runs'],total),total)
 need(baseline==ctx['paid']and type(current['original_paid_count'])is int
  and current['original_paid_count']==len(baseline)
  and type(current['unresolved_positions'])is int
  and current['unresolved_positions']==len(pending)
  and current['expanded_unresolved_sha256']==digest(pending)
  and len(baseline)+len(paid)+len(pending)==total
  and sorted(baseline+paid+pending)==list(range(1,total+1)),
  'complete disjoint current partition, no old paid replay')
 kinds=current['accepted_new_paid_by_kind']
 need(type(kinds)is dict and set(kinds)=={'NG','NOT_IP'},'typed old dispositions')
 ng=typed(kinds['NG'],total);ip=typed(kinds['NOT_IP'],total)
 need(sorted(ng+ip)==paid and len(ng)+len(ip)==len(paid),'whole typed paid union')
 selected=typed(plan['selected_orbit_positions'],total)
 need(1<=len(selected)<=8 and set(selected)<=set(pending),'one to eight current unpaid cases')
 need(ctx['refs']==plan['original_domain_whole_pins']
  and ctx['projection']['full_orbit_array_sha256']==plan['original_orbit_array_sha256'],
  'same complete original orbit/member/transporter meaning')
 history=[]
 for number,row in enumerate(current.get('previous_method_attempts',[])):
  misses=typed(row['finite_miss_positions'],total)
  history.append(dict(history_entry=number,criterion=row['criterion'],Root_adoption=row['Root_adoption'],
   still_unpaid_finite_miss_positions=sorted(set(misses)&set(pending)),
   finite_miss_positions_now_settled=sorted(set(misses)-set(pending)),
   historical_journal_unchanged=True))
 return selected,pending,history
