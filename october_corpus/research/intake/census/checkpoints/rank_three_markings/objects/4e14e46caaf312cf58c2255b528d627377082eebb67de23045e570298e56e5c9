"""Prepare FALSE next-cohort metadata only; no issuance or Source execution.

Only existing metadata is decoded. Intake/runtime and mathematical aliases
are whole-hashed opaquely; source parents are never decoded. No --issue path.
"""
import argparse,hashlib,json,os,re,stat
from pathlib import Path

WORK=Path('/Users/sasha/medusa/census')
M=Path('/Users/sasha/medusa/research/leemans/maintenance/intake')
G=M/'f009_bounded_io_transition'
CORE=M/'resource_profiles/bounded_output'

def reference(path):
    p=Path(path);before=p.lstat()
    assert p.resolve(strict=True)==p and stat.S_ISREG(before.st_mode) and before.st_nlink==1 and before.st_size<=8*2**20
    h=hashlib.sha256();count=0
    with p.open('rb') as stream:
        for block in iter(lambda:stream.read(65536),b''):
            count+=len(block);h.update(block)
    after=p.lstat()
    assert (before.st_ino,before.st_size,before.st_mtime_ns,before.st_ctime_ns)==(after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns)
    assert count==before.st_size
    return dict(path=str(p),bytes=count,sha256=h.hexdigest())

def metadata(path):
    p=Path(path);assert p.stat().st_size<=262144
    return json.loads(p.read_bytes())

def replace_paths(value,begin):
    if isinstance(value,str):
        return value.replace('cohort0438','cohort%04d'%begin).replace('cohort_from0438','cohort_from%04d'%begin)
    if isinstance(value,list):return [replace_paths(x,begin) for x in value]
    if isinstance(value,dict):return {k:replace_paths(v,begin) for k,v in value.items()}
    return value

def write(path,value):
    body=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode()
    assert len(body)<131072 and not os.path.lexists(path)
    with path.open('xb') as stream:assert stream.write(body)==len(body)
    return reference(path)

