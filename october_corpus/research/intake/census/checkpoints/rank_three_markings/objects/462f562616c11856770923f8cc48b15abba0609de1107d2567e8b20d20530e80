def need(value, why):
    if not value:
        raise ValueError(why)


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode('ascii')


def descriptor(path, data):
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())


def metadata(path, limit=32768, expected=None, allow_floats=False):
    """Read bounded metadata only; never use for a witness or status bank."""
    path = Path(path)
    need(path.is_absolute() and path.resolve(strict=True) == path and not path.is_symlink(), 'canonical metadata path')
    before = path.stat()
    need(before.st_size <= limit, 'bounded metadata file')
    data = path.read_bytes()
    after = path.stat()
    need((before.st_size, before.st_ino, before.st_mtime_ns) == (after.st_size, after.st_ino, after.st_mtime_ns), 'stable metadata')
    r = descriptor(path, data)
    need(expected is None or r == expected, 'exact historical metadata pin')
    def pairs(items):
        result = {}
        for k, v in items:
            need(k not in result, 'duplicate metadata key')
            result[k] = v
        return result
    def forbidden(_):
        raise ValueError('integer metadata only')
    value = json.loads(data, object_pairs_hook=pairs,
                       parse_float=float if allow_floats else forbidden,
                       parse_constant=forbidden)
    return value, r


def pinned(name):
    path, size, digest = PINS[name]
    return metadata(path, expected=dict(path=str(path), bytes=size, sha256=digest),
                    allow_floats=(name == 'SDK'))


def put(directory, name, value):
    path = directory / name
    data = canonical(value)
    need(len(data) <= 32768 and not os.path.lexists(path), 'fresh bounded metadata output')
    with path.open('xb') as stream:
        stream.write(data)
    return descriptor(path, data)


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('--cases', required=True, type=Path, help='Root-selected JSON list, or typed Root identity-selection result, with exactly two cases')
    parser.add_argument('--out', required=True, type=Path, help='Fresh directory inside census, with existing parent')
    parser.add_argument('--guard-output', required=True, type=Path, help='Unused absolute /private/tmp guard path')
    parser.add_argument('--numerical-output', required=True, type=Path, help='Unused absolute /private/tmp numerical output path')
