def canonical(v):return(json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode('ascii')
def same(a,b):return canonical(a)==canonical(b)
def trip(r):return[r['path'],str(r['bytes']),r['sha256']]
def cli(v):return dict(path=v[0],bytes=int(v[1]),sha256=v[2])

def bootstrap(r):
    p=Path(r['path']);assert p.resolve(strict=True)==p and type(r['bytes'])is int and 0<r['bytes']<=65536
    with p.open('rb')as f:
        before=os.fstat(f.fileno());assert before.st_size==r['bytes']
        b=f.read(r['bytes']+1);after=os.fstat(f.fileno())
    sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
    assert sig(before)==sig(after)==sig(p.stat())and len(b)==r['bytes']and hashlib.sha256(b).hexdigest()==r['sha256']
    ns=dict(__file__=r['path'],__name__='bounded_role_launch_reader')
    exec(compile(b,r['path'],'exec'),ns)
    return ns

def parent_rows(child,rawdir):
    """Existing ten-child/eighty-parent union, counting shared SDKs once."""
    rows=[dict(x)for x in child]
    rows.append(dict(component='raw',path=str(rawdir/'issued.json'),maximum_bytes=131072,existing=None))
    for i in range(32):rows.append(dict(component='raw',path=str(rawdir/('frame_%04d.json'%i)),maximum_bytes=262144,existing=None))
    for row in list(rows):
        if row['component']not in('sdk','raw'):continue
        upper=4*((row['maximum_bytes']+2)//3)
        for i,offset in enumerate(range(0,upper,3*2**20)):
            rows.append(dict(component='images',path=row['path']+'.encoding_'+str(i),maximum_bytes=min(3*2**20,upper-offset)+1,existing=None))
    assert len(child)==10 and len(rows)==len({r['path']for r in rows})==80
    assert sum(r['maximum_bytes']for r in rows)+16*2**20==57540737
    return rows

def output_path(text,policy):
    """Normalized target with a canonical existing directory ancestor."""
    path=policy['path'](text)
    ancestor=path.parent
    while not os.path.lexists(ancestor):ancestor=ancestor.parent
    assert ancestor.is_dir()and ancestor.resolve(strict=True)==ancestor
    return path

