def read(path):
    return json.loads(path.read_bytes())

def reference(path):
    body = path.read_bytes()
    return dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())

def write(path, value):
    assert not os.path.lexists(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    body = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
    assert len(body) < 65536
    with path.open('xb') as stream:
        stream.write(body)
    return reference(path)

def alias(edition, expected_exit):
    key = 'Root_f009_cohort0438_register_actual_v%d' % edition
    source = Path('/private/tmp/f009_generic_captures') / (key + '.json')
    body = source.read_bytes()
    sdk = json.loads(body)
    assert sdk['actual_tool']['exit_code'] == expected_exit
    raw = Path('/private/tmp/intake_actual_transports') / key
    intent = read(raw / 'issued.json')
    assert intent['argv'] == sdk['issued_argv'] and intent['tool_arguments'] == sdk['issued_tool_arguments']
    for i, frame in enumerate(sdk['all_genuine_api_frames']):
        assert read(raw / ('frame_%04d.json' % i)) == frame
    assert not (raw / ('frame_%04d.json' % len(sdk['all_genuine_api_frames']))).exists()
    target = C / ('metadata/SDK/register_v%d.json' % edition)
    with target.open('xb') as stream:
        stream.write(body)
    return reference(target), str(raw)

