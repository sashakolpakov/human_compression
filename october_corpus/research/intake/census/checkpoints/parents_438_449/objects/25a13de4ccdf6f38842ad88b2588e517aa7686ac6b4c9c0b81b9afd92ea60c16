def ref(path):
    h = hashlib.sha256()
    before = path.stat()
    assert stat.S_ISREG(before.st_mode) and not path.is_symlink() and before.st_size <= 8 * 2**20
    count = 0
    with path.open('rb') as stream:
        while block := stream.read(65536):
            count += len(block)
            h.update(block)
    after = path.stat()
    assert (before.st_size, before.st_mtime_ns, before.st_ino) == (after.st_size, after.st_mtime_ns, after.st_ino)
    assert count == before.st_size
    return dict(path=str(path), bytes=count, sha256=h.hexdigest())

with urllib.request.urlopen(urllib.request.Request(API, headers={'User-Agent': 'human-compression-census'}), timeout=30) as response:
    body = response.read(8 * 2**20 + 1)
assert len(body) <= 8 * 2**20
tree = json.loads(body)
assert tree['sha'] == INTAKE_TREE and tree['truncated'] is False
known = {}
for item in tree['tree']:
    if item['type'] == 'blob' and re.search(r'/objects/[0-9a-f]{64}$', item['path']):
        known.setdefault(Path(item['path']).name, dict(path='october_corpus/research/intake/' + item['path'], bytes=item['size']))

def files(root):
    for directory, dirs, names in os.walk(root):
        dirs[:] = [name for name in dirs if name not in ['.git', '__pycache__']]
        for name in names:
            if name in ['active.lock', '.DS_Store']:
                continue
            path = Path(directory) / name
            assert not name.endswith(('.pyc', '.download')) and '.encoding_' not in name
            yield path

selected = list(files(S)) + list(files(WORK))
active = json.loads((WORK / 'active_files.json').read_bytes())
for r in active['items']:
    path = Path(r['path'])
    if str(path).startswith(('/private/tmp/f009_', '/private/tmp/l026_')):
        assert ref(path) == {k: r[k] for k in ['path', 'bytes', 'sha256']}
        selected.append(path)
selected += list(files(Path('/private/tmp/f009_R5_parent_cohorts_actual/generic_cohort_from0438')))
selected += list(files(Path('/private/tmp/f004_fresh_schreier_covers')))
selected += [Path('/private/tmp/f004_schreier_controls_actual_v1_SDK.json')]
selected += list(Path('/private/tmp/f009_generic_captures').glob('Root_f009_cohort0438_*.json'))
for directory in Path('/private/tmp/intake_actual_transports').glob('Root_f009_cohort0438_*'):
    selected += list(files(directory))
selected += list(files(Path('/private/tmp/intake_actual_transports/Root_f004_schreier_controls_actual_v1')))
for name in ['field.py', 'solve.py', 'schreier.py', 'runtime.py', 'PROOF.tex']:
    selected.append(W / 'october_corpus/reproduction/finite_orbits_and_stabilizers' / name)
selected = sorted(set(selected))
assert len(selected) < 4000 and sum(p.stat().st_size for p in selected) < 80 * 2**20
assert not OUT.exists()
(OUT / 'objects').mkdir(parents=True)
rows = []
new = {}
for path in selected:
    r = ref(path)
    if r['sha256'] in known:
        old = known[r['sha256']]
        assert old['bytes'] == r['bytes']
        r['storage'] = dict(commit=BASELINE, path=old['path'])
    else:
        target = OUT / 'objects' / r['sha256']
        if not target.exists():
            with path.open('rb') as source, target.open('xb') as destination:
                shutil.copyfileobj(source, destination, 65536)
            assert ref(target)['sha256'] == r['sha256']
            new[r['sha256']] = r['bytes']
        r['storage'] = dict(path=str(target.relative_to(W)))
    rows.append(r)

