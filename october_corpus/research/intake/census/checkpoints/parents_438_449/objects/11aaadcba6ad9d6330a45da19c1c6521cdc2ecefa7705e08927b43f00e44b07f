def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def canonical(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False)+'\n').encode('ascii')


def reference(path, body):
    return dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())


def decode(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            need(key not in out, 'unique ordinary metadata key')
            out[key] = value
        return out
    return json.loads(raw, object_pairs_hook=pairs,
        parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


class Reader:
    def __init__(self):
        self.started = time.monotonic()
        self.bytes = 0
        self.bodies = {}
        self.pins = {}

    def check(self):
        need(time.monotonic()-self.started < CAPS['seconds']-5, 'metadata deadline')
        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
        if sys.platform != 'darwin':
            rss *= 1024
        need(rss <= CAPS['rss_bytes'], 'cooperative metadata self-RSS bound')

    def read(self, expected, fresh=False):
        self.check()
        p = Path(expected['path'])
        if str(p) in self.bodies and not fresh:
            need(self.pins[str(p)] == expected, 'one exact input edition')
            return self.bodies[str(p)]
        before = p.lstat()
        need(p.is_absolute() and p.resolve(strict=True) == p
            and stat.S_ISREG(before.st_mode) and before.st_nlink == 1,
            'canonical regular single-link input')
        need(type(expected['bytes']) is int and 0 <= expected['bytes'] <= CAPS['file_bytes']
            and before.st_size == expected['bytes'], 'bounded whole input extent')
        need(self.bytes+before.st_size <= CAPS['read_bytes']
            and len(set(self.pins)|{str(p)}) <= CAPS['paths'], 'complete metadata read ledger')
        sig = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink,
                         x.st_size, x.st_mtime_ns, x.st_ctime_ns)
        with os.fdopen(os.open(p, os.O_RDONLY|os.O_NOFOLLOW), 'rb') as f:
            opened = os.fstat(f.fileno())
            body = f.read(before.st_size+1)
            closed = os.fstat(f.fileno())
        need(sig(before) == sig(opened) == sig(closed) == sig(p.lstat())
            and reference(p, body) == expected, 'stable full input hash')
        self.bytes += len(body)
        self.pins[str(p)] = expected
        self.bodies[str(p)] = body
        return body

    def document(self, expected):
        return decode(self.read(expected))

    def close(self):
        need(self.bytes+sum(r['bytes'] for r in self.pins.values()) <= CAPS['read_bytes'],
             'prospective complete closing reads')
        for r in list(self.pins.values()):
            need(self.read(r, fresh=True) == self.bodies[r['path']], 'closing byte identity')


def cli_ref(values):
    return dict(path=values[0], bytes=int(values[1]), sha256=values[2])


def check_parent(path):
    p = Path(path)
    need(p.is_absolute() and '..' not in p.parts and '.' not in p.parts,
         'absolute canonical planned destination')
    ancestor = p.parent
    while not ancestor.exists():
        need(not ancestor.is_symlink(), 'no dangling symbolic parent')
        ancestor = ancestor.parent
    need(ancestor.resolve(strict=True) == ancestor and ancestor.is_dir()
        and ancestor.stat().st_dev == MEDUSA.stat().st_dev,
        'canonical same-volume writer ancestry')


def check_inventory(h):
    rows = h['parent_union_inventory']
    child = [rows[i] for i in h['child_inventory_row_indices']]
    caps = dict(primary=32*MIB, guard=MIB, sdk=8*MIB,
                raw=16*MIB, retention=64*MIB, images=32*MIB)
    need(len(rows) == 83 and len(child) == 13, 'exact parent and child row counts')
    seen, totals = set(), {k: 0 for k in caps}
    for r in rows:
        need(set(r) == {'component', 'path', 'maximum_bytes', 'existing'}
            and r['component'] in caps and r['existing'] is None
            and type(r['maximum_bytes']) is int
            and 0 <= r['maximum_bytes'] <= 4*MIB
            and r['path'] not in seen, 'typed unique fresh writer row')
        seen.add(r['path']); totals[r['component']] += r['maximum_bytes']
        check_parent(r['path'])
        need(not os.path.lexists(r['path']), 'every future final and encoding path is fresh')
    need(all(totals[k] <= caps[k] for k in caps), 'whole component subtotals')
    need(sum(totals.values()) == h['parent_unique_content_upper']
        and sum(totals.values())+16*MIB == h['parent_union_with_allocation'] <= 169*MIB < 256*MIB,
        'one complete unique-path ledger and one reserve')
    need(sum(r['maximum_bytes'] for r in child) == h['child_inventory_total_upper'],
         'all five child outputs plus guard and two SDKs')
    sdks = [r['path'] for r in rows if r['component'] == 'sdk']
    need(len(sdks) == 2 and sdks == [r['path'] for r in child if r['component'] == 'sdk']
        and sdks == h['proposed_layout']['SDK_destinations'], 'same two SDK destinations in both views')
    need(Path(sdks[1]).name == 'init_v1.json', 'later metadata audit requires exact init SDK basename')
    raw = [r for r in rows if r['component'] == 'raw']
    images = [r for r in rows if r['component'] == 'images']
    need(len(raw) == 33 and len(images) == 37, 'issued plus32 frame rows and37 encoding rows')
    expected_images = {}
    for r in [r for r in rows if r['component'] in ('raw', 'sdk')]:
        upper = 4*((r['maximum_bytes']+2)//3)
        for i, offset in enumerate(range(0, upper, 3*MIB)):
            expected_images[r['path']+'.encoding_'+str(i)] = min(3*MIB, upper-offset)+1
    need({r['path']: r['maximum_bytes'] for r in images} == expected_images,
         'every final body has all exact base64 chunks including newline bytes')
    final_bytes = sum(r['maximum_bytes'] for r in rows if r['component'] in ('raw', 'sdk'))
    encoded_bytes = sum(expected_images.values())
    need(final_bytes+encoded_bytes == 39452801 < 48*MIB
        and 2*MIB+final_bytes+encoded_bytes == 41549953 < 64*MIB,
        'complete separate caller IO with2MiB prepaid reads')
    expected_outputs = {r['path']: r['maximum_bytes'] for r in h['expected_init_outputs']}
    need({r['path']: r['maximum_bytes'] for r in child if r['component'] == 'primary'} == expected_outputs
        and sum(expected_outputs.values()) == h['child_planned_content_upper'] < 16*MIB,
        'all five exact init destinations and bounded planned bodies')
    return rows, child, sdks


def resolve(projection, bindings):
    return [str(bindings[t['reference']][t['part']]) if type(t) is dict else t
            for t in projection]


