"""Issue bounded metadata requests to the unchanged reviewed census checker."""
import argparse
import hashlib
import json
import os
from pathlib import Path

M = Path('/Users/sasha/medusa/research/leemans/maintenance/intake')
G = M / 'f009_bounded_io_transition'
D = M / 'f009_resource_binding_retries'
C = G / 'cohorts/cohort_from0438'
PYTHON = '/Users/sasha/.venvs/global/bin/python'

def reference(path):
    body = path.read_bytes()
    return dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())

def read(path):
    return json.loads(path.read_bytes())

def write(path, value):
    assert not os.path.lexists(path)
    body = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
    assert len(body) < 2**20
    path.parent.mkdir(parents=True, exist_ok=True)
    assert path.parent.resolve() == path.parent
    with path.open('xb') as stream:
        stream.write(body)
    return reference(path)

def execution(name):
    return read(C / 'metadata/executions' / (name + '.json'))

def phase_executions():
    return {str(b): {phase: execution('batch%02d_%s' % (b, phase))
                    for phase in ['prepare_suppliers', 'assemble_strict', 'close_pairing']}
            for b in range(4)}

def trip(ref):
    return [ref['path'], str(ref['bytes']), ref['sha256']]

parser = argparse.ArgumentParser()
parser.add_argument('--step', choices=['pair', 'close', 'batch', 'aggregate'], required=True)
parser.add_argument('--batch', type=int, choices=range(4))
args = parser.parse_args()
hr = reference(C / 'cohort.json')
packet_ref = reference(D / 'packet.json')
packet = read(D / 'packet.json')
key = args.step + ('%02d' % args.batch if args.batch is not None else '')
where = D / ('actual/cohort0438_' + key)
out = where / 'output'
q = dict(schema='F009_RESOURCE_BINDING_METADATA_REQUEST_V1', Root_authority=False, cohort=hr)
if args.step == 'pair':
    assert args.batch is not None
    indices = list(range(438 + 3 * args.batch, 441 + 3 * args.batch))
    selection = dict(schema='ROOT_F009_GENERIC_SELECTED_ATTEMPTS_V2', root='/root',
                     Root_authority=True, cohort=hr, batch=args.batch, phase='close_pairing', roles=[])
    selected = write(where / 'selected_attempts.json', selection)
    base = Path('/private/tmp/f009_R5_parent_cohorts_actual/generic_cohort_from0438') / ('parents%04d_%04d' % (indices[0], indices[-1]))
    q.update(op='phase.py', phase='close_pairing', batch=args.batch, selected_attempts=selected)
    targets = [(base / 'pairing.json', 262144)]
elif args.step == 'close':
    q.update(op='close.py', phase_executions=phase_executions())
    targets = [(C / 'cohort_actual_summary.json', 262144)]
elif args.step == 'batch':
    assert args.batch is not None
    q.update(op='audit_batch.py', batch=args.batch, phase_executions=phase_executions())
    targets = [(out / 'reuse_integer_only.json', 262144)]
else:
    q.update(op='audit_cohort.py',
             batch_reviews=[reference(D / ('actual/cohort0438_batch%02d/output/reuse_integer_only.json' % b)) for b in range(4)],
             batch_executions=[execution('audit_batch%02d' % b) for b in range(4)],
             init_execution=execution('init'), close_execution=execution('close'))
    targets = [(out / 'reuse_integer_only.json', 262144)]
q['outputs'] = [dict(path=str(path), maximum_bytes=maximum) for path, maximum in targets]
for path, maximum in targets:
    assert not os.path.lexists(path)
request_ref = write(where / 'request.json', q)
gate = read(G / 'cohort_preparation/parents0438_0449/batch00/Root_prepare_suppliers_gate_FALSE.json')
gate.update(op=q['op'], Source_manifest=packet['entry_manifests'][q['op']], request=request_ref)
for flag in ['Root_authority', 'adopted', 'whole_supplement_and_borrowed_Source_owned',
             'all_original_meanings_and_new_binding_scope_owned', 'no_successful_science_replayed', 'serial_sole_writer_scope_owned']:
    assert gate[flag] is False
    gate[flag] = True
assert gate['canonical_writes_authorized'] is False
gate_ref = write(where / 'Root_gate.json', gate)
out.mkdir()
argv = ['/usr/bin/env']
for name in ['COVERAGE_PROCESS_CONFIG', 'COVERAGE_CONFIG', 'COVERAGE_PROCESS_START', 'OPENSSL_CONF', 'OPENSSL_MODULES']:
    argv += ['-u', name]
argv += [PYTHON, '-E', '-B', '-S', packet['program']['path'], '--actor', '/root', '--op', q['op'],
         '--packet', *trip(packet_ref), '--request', *trip(request_ref), '--Root-gate', *trip(gate_ref), '--out', str(out)]
print(json.dumps(dict(argv=argv, request=request_ref, Root_gate=gate_ref, scientific_calls=0, canonical_writes=0)))
