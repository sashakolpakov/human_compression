                 'f004_R_word_proposals', 'f004_R_basis_proposals', 'f004_end_generation_actual']
for name in private_roots:
    selected += list(files(Path('/private/tmp') / name))
for pattern in ['f004_job155_*_SDK.json', 'f004_finite_controls*_SDK.json',
                'f004_end_generation*_SDK.json', 'f004_schreier_controls_actual_v1_SDK.json']:
    selected += list(Path('/private/tmp').glob(pattern))
for pattern in ['Root_f004_job155_*', 'Root_f004_finite_*', 'Root_f004_end_generation_*']:
    for directory in Path('/private/tmp/intake_actual_transports').glob(pattern):
        selected += list(files(directory))
for name in ['field.py', 'solve.py', 'schreier.py', 'runtime.py', 'PROOF.tex']:
    selected.append(W / 'october_corpus/reproduction/finite_orbits_and_stabilizers' / name)
selected = sorted(set(selected))
assert len(selected) < 6000 and sum(p.stat().st_size for p in selected) < 80 * 2**20
assert not OUT.exists()
(OUT / 'objects').mkdir(parents=True)
rows = []
new = {}
for path in selected:
    r = ref(path)
    if r['sha256'] in known:
        old = known[r['sha256']]
        assert old['bytes'] == r['bytes']
        r['storage'] = old['storage']
    else:
        target = OUT / 'objects' / r['sha256']
        if not target.exists():
            with path.open('rb') as source, target.open('xb') as destination:
                shutil.copyfileobj(source, destination, 65536)
            assert ref(target)['sha256'] == r['sha256']
            new[r['sha256']] = r['bytes']
        r['storage'] = dict(path=str(target.relative_to(W)))
    rows.append(r)

