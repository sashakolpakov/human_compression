assert prior_ref['sha256'] == 'ab84fe132dfcad85bfb1b02c3d1fd4f6e5772bf277e4aa4c13f31bdf5cf1a8e3'
prior = json.loads(PRIOR_PATH.read_bytes())
known = {}
for r in prior['files']:
    storage = dict(r['storage'])
    storage.setdefault('commit', PRIOR_COMMIT)
    known.setdefault(r['sha256'], dict(bytes=r['bytes'], storage=storage))
restored = WORK / 'l026_runtime_inputs_restored.json'
if restored.exists():
    for r in json.loads(restored.read_bytes())['files']:
        marker = '/' + '71454ae681ae8d8201b41ad3a54a4eb848c5fd90' + '/'
        assert marker in r['immutable_source']
        known.setdefault(r['sha256'], dict(bytes=r['bytes'], storage=dict(
            commit='71454ae681ae8d8201b41ad3a54a4eb848c5fd90',
            path=r['immutable_source'].split(marker, 1)[1])))

selected = list(files(S)) + list(files(WORK))
# Retain the exact small outside-workspace inputs already needed by F009/L026.
for r in prior['files']:
