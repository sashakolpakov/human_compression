PRIOR_COMMIT = 'f371ca6216ee2353faa476b338de7fbaa180058c'
PRIOR_PATH = CENSUS / 'checkpoints/parents_438_449/manifest.json'

def ref(path):
    before = path.stat()
    assert stat.S_ISREG(before.st_mode) and not path.is_symlink() and before.st_size <= 8 * 2**20
    size = 0
    h = hashlib.sha256()
    with path.open('rb') as stream:
        while block := stream.read(65536):
            size += len(block)
            h.update(block)
    after = path.stat()
    assert (before.st_size, before.st_mtime_ns, before.st_ino) == (after.st_size, after.st_mtime_ns, after.st_ino)
    assert size == before.st_size
    return dict(path=str(path), bytes=size, sha256=h.hexdigest())

def files(root):
    for directory, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if x not in ['.git', '__pycache__']]
        for name in names:
            if name in ['active.lock', '.DS_Store']:
                continue
            assert not name.endswith(('.pyc', '.download', '.olean', '.o'))
            yield Path(directory) / name

