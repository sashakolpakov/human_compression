    for pivot, row in sorted(echelon.items()):
        factor = vector[pivot]
        if factor:
            b.scalar(2 * (49 - pivot))
            for j in range(pivot, 49):
                vector[j] = (vector[j] - factor * row[j]) % 11
    if any(vector):
        pivot = next(j for j in range(49) if vector[j])
        inverse = F.inv(vector[pivot], b)
        b.scalar(49 - pivot)
        for j in range(pivot, 49):
            vector[j] = vector[j] * inverse % 11
        echelon[pivot] = vector

def exact24(word):
    element = F.I
    for label in word:
        element = b.multiply(element, marks[label])
    p2 = b.multiply(element, element)
    p4 = b.multiply(p2, p2)
    p8 = b.multiply(p4, p4)
    p12 = b.multiply(p8, p4)
    p24 = b.multiply(p12, p12)
    return p24 == F.I and p12 != F.I and p8 != F.I

order_word = [1, 2] if exact24([1, 2]) else None
attempts = 1
state = 17 + 7919 * selected[0]
while order_word is None and attempts < 257:
    word = []
    for unused in range(8 + attempts % 17):
        state = (1103515245 * state + 12345) % 2147483648
        choices = [label for label in [1,2,3] if not word or label != word[-1]]
        word.append(choices[(state >> 16) % len(choices)])
    attempts += 1
    if exact24(word):
