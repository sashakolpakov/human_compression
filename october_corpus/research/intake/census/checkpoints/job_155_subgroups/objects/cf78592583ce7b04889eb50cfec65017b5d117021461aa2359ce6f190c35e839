"""UNRUN metadata/conditional criterion envelope; no Original or theory proof."""
SUBJECT=('original_job','selected_orbit_positions','case','projection','Root_projection_acceptance',
 'original_domain_whole_pins','original_orbit_array_sha256','matrix_frame_result','unpaid_manifest',
 'old_sources','normalization_status','selector','meaning_evidence','model_statement','model_evidence',
 'original_inputs','certificate','criterion_note','criterion_review','criterion_statement','accepted_orders')
DUTIES=('same_faithful_Original_G2_11_frame_members_and_transporters_owned',
 'all_four_actual_marks_and_exact_right_end_are_members_of_this_same_G_owned',
 'all_current_selector_typed_adoptions_owned','same_complete_Original_domain_and_case_identity_owned',
 'fresh_result_not_replay_of_completed_same_subject_owned',
 'borrowed_criterion_complete_hypotheses_and_conditional_application_owned',
 'borrowed_maximal_cover_natural_module_identifications_and_review_qualifications_owned',
 'no_kernel_classification_or_automatic_case_credit_claim_owned')

def orders(values,M):
 M.need(type(values)is list and bool(values)and all(type(x)is int and x in(24,44)for x in values)
  and values==sorted(set(values)),'exact typed admitted criterion orders')

def scope(plan,imported,M):
 M.need(imported['schema']=='ROOT_IMPORTED_F004_END_GENERATION_CRITERION_V1'and imported['root']=='/root'
  and imported['Root_authority']is imported['issued']is True and imported['Source_manifest']==plan['Source_manifest']
  and imported['admitted_role']=='CHECK','issued exact right-end criterion import')
 M.need(M.can(imported['subject'])==M.can({k:plan[k]for k in SUBJECT}),'whole typed case/model/criterion/input binding')
 for k in DUTIES:M.need(imported[k]is True,'explicit Root premise '+k)
 M.need(type(plan['original_job'])is list and plan['original_job']==[155,4]
  and all(type(i)is int for i in plan['original_job']),'typed Original job155')
 orders(plan['accepted_orders'],M)
 for k in('model_statement','criterion_statement'):
  M.need(type(plan[k])is str and bool(plan[k].strip()),'explicit exact model and conditional criterion statement')
 for k in('model_evidence','meaning_evidence'):
  M.need(type(plan[k])is list and bool(plan[k]),'whole model/meaning evidence')
 M.need(type(imported['history_qualification'])is str and bool(imported['history_qualification'].strip()),'finite known-history qualification')
 M.need(type(plan['original_inputs'])is list and len(plan['original_inputs'])==len({r['path']for r in plan['original_inputs']}),'unique whole Original/criterion input closure')
 selected=plan['selected_orbit_positions'];c=plan['case']
 M.need(type(selected)is list and len(selected)==1 and type(selected[0])is int
  and set(c)=={'position','representative_J_index','original_orbit_row_sha256'}
  and type(c['position'])is int and c['position']==selected[0]
  and type(c['representative_J_index'])is int and 1<=c['representative_J_index']<=14763
  and type(c['original_orbit_row_sha256'])is str and len(c['original_orbit_row_sha256'])==64
  and set(c['original_orbit_row_sha256'])<=set('0123456789abcdef'),'one exact current Original representative')

def selection(plan,current,A,M):
 total=current['original_orbit_positions']
 M.need(type(total)is int and 1<=total<=14763 and type(current['original_job'])is list
  and all(type(i)is int for i in current['original_job'])and M.can(current['original_job'])==M.can(plan['original_job'])
  and M.can(current['projection'])==M.can(plan['projection'])
  and M.can(current['Root_projection_acceptance'])==M.can(plan['Root_projection_acceptance']),'typed current job/projection references')
 ctx=dict(projection=dict(original_orbit_rows=total,full_orbit_array_sha256=plan['original_orbit_array_sha256']),
  paid=current['original_paid_positions'],refs=plan['original_domain_whole_pins'])
 return A.select(plan,current,ctx,M.digest,M.expand_runs)

def outcome(facts,plan,M):
 orders(plan['accepted_orders'],M)
 M.need(facts['status']=='VERIFIED_END_WORD_ALGEBRA_AND_ELEMENT_ORDER'
  and type(facts['dimension'])is int and facts['dimension']==7
  and type(facts['word_nodes'])is int and facts['word_nodes']==49
  and type(facts['flattened_rank'])is int and facts['flattened_rank']==49
  and type(facts['exact_element_order'])is int and facts['exact_element_order']in plan['accepted_orders']
  and facts['full_matrix_algebra_spanned']is facts['all_nodes_actual_end_words']is facts['no_classification_or_group_generation_conclusion']is True,
  'complete actual7D criterion inputs only')
 return 'VERIFIED_END_GENERATION_CRITERION_INPUTS'

def controls(b,A,M):
 b.scalar(65536);names=[]
 def refused(f):
  try:f()
  except(ValueError,TypeError,KeyError):return
  raise ValueError('expected metadata refusal')
 r=dict(path='/private/tmp/F004_END_TOY_NOT_READ',bytes=1,sha256='0'*64)
 p=dict(original_job=[155,4],selected_orbit_positions=[3],case=dict(position=3,representative_J_index=1,original_orbit_row_sha256='0'*64),
  projection=r,Root_projection_acceptance=r,original_domain_whole_pins=dict(toy=r),original_orbit_array_sha256='0'*64,matrix_frame_result=r,
  unpaid_manifest=r,old_sources={},normalization_status='toy',selector=r,meaning_evidence=[r],model_statement='Toy model metadata',model_evidence=[r],
  original_inputs=[r],certificate=r,criterion_note=r,criterion_review=r,criterion_statement='Toy conditional statement only',accepted_orders=[24,44],Source_manifest=r)
 imp=dict(schema='ROOT_IMPORTED_F004_END_GENERATION_CRITERION_V1',root='/root',Root_authority=True,issued=True,Source_manifest=r,admitted_role='CHECK',
  subject={k:p[k]for k in SUBJECT},history_qualification='Toy metadata only')
 imp.update({k:True for k in DUTIES});scope(p,imp,M);names.append('typed_conditional_meaning_import')
 refused(lambda:scope(p,dict(imp,Root_authority=False),M))
 refused(lambda:scope(p,dict(imp,subject=dict(imp['subject'],criterion_statement='wrong')),M))
 names.append('unissued_or_changed_criterion')
 for values in([True],[24.0],[22],[44,24]):
  q=dict(p,accepted_orders=values);v=dict(imp,subject={k:q[k]for k in SUBJECT});refused(lambda q=q,v=v:scope(q,v,M))
 names.append('Boolean_or_unlisted_orders')
 current=dict(schema='ROOT_ACCEPTED_Q11_RANK4_UNRESOLVED_SELECTOR_V1',root='/root',adopted=True,original_job=[155,4],original_orbit_positions=4,
  projection=r,Root_projection_acceptance=r,original_paid_positions=[1],original_paid_count=1,accepted_new_paid_positions=[2],accepted_new_paid_by_kind=dict(NG=[2],NOT_IP=[]),
  unresolved_position_runs=[[3,4]],unresolved_positions=2,expanded_unresolved_sha256=M.digest([3,4]))
 M.need(selection(p,current,A,M)[0]==[3],'positive scalar selector')
 for values in([True],[3,3],[2]):refused(lambda values=values:selection(dict(p,selected_orbit_positions=values),current,A,M))
 refused(lambda:selection(p,dict(current,original_job=[155.0,4]),A,M));names.append('typed_current_unpaid_selection')
 f=dict(status='VERIFIED_END_WORD_ALGEBRA_AND_ELEMENT_ORDER',dimension=7,word_nodes=49,flattened_rank=49,exact_element_order=24,
  full_matrix_algebra_spanned=True,all_nodes_actual_end_words=True,no_classification_or_group_generation_conclusion=True)
 M.need(outcome(f,p,M)=='VERIFIED_END_GENERATION_CRITERION_INPUTS','conditional inputs')
 for bad in(dict(f,flattened_rank=48),dict(f,exact_element_order=True),dict(f,no_classification_or_group_generation_conclusion=False)):
  refused(lambda bad=bad:outcome(bad,p,M))
 names.append('complete_rank_and_order_inputs_only');M.need(len(names)==len(set(names))==5,'five fresh envelope groups')
 return names
