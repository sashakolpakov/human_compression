"""UNRUN Root-only synthetic controls; no Original inputs."""

def run(W,B,identity,limit_exception):
    names=[]
    def need(ok,why):
        if not ok:raise AssertionError(why)
    need(W.MAGIC==b'F004IPW1' and W.MAX_BYTES==60586,'codec pins')
    def refused(f):
        try:f()
        except ValueError:return
        raise AssertionError('expected ValueError')
    def group(name,f):
        f();names.append(name)
    def side(lifts=None,recipes=None,tree=None,selected=1):
        return (lifts or [],[(0,0,0)] if recipes is None else recipes,
                [(0,0)] if tree is None else tree,selected)
    def permutation(p,flip=False):
        return bytes((10 if flip and i==j==3 else int(j==p[i]))
                     for i in range(7) for j in range(7))
    a=permutation((1,0,2,3,4,5,6));b=permutation((0,2,1,3,4,5,6))
    z=permutation(tuple(range(7)),True)
    za=permutation((1,0,2,3,4,5,6),True);marks=(z,a,b,za)
    left=side();right=side(recipes=[(0,0,0),(0,2,0)],tree=[(0,0),(1,1)],selected=2)
    raw=W.encode(3,left,right)
    def positive(body,quartet=marks,unit=identity,witness=z):
        meter=B();before=meter.row_images
        result=W.check(quartet,body,meter,unit)
        need(result['status']=='VERIFIED_IP_INTERSECTION_COUNTEREXAMPLE'
             and result['witness']==witness,'positive witness')
        need(all(k in result for k in ('left_word_nodes','right_word_nodes','meter_deltas')),
             'word/meter facts')
        need(meter.row_images==before,'row debit')
    def bad(body,quartet=marks,unit=identity):
        refused(lambda:W.check(quartet,body,B(),unit))
    def patch(body,offset,value):
        return body[:offset]+value+body[offset+len(value):]
    def each(values,f):
        for value in values:f(value)
    group('central_intersection',lambda:positive(raw))
    # T2=a*b; T2*a*T2^-1=b. Inverse orientation changes w.
    oriented=side([(0,1),(1,2)],[(0,0,0),(2,1,2)],[(0,0),(1,1)],2)
    rb=side(recipes=[(0,0,0),(0,2,0),(0,1,0)],tree=[(0,0),(1,1),(2,2)],selected=3)
    oriented_raw=W.encode(3,oriented,rb)
    zb=permutation((0,2,1,3,4,5,6),True)
    group('inverse_orientation',lambda:positive(oriented_raw,witness=zb))
    group('whole_header_extent',lambda:each(
        [b'',b'X'+raw[1:],raw[:-1],raw+b'\0',b'\0'*(W.MAX_BYTES+1)],bad))
    group('bounded_header_fields',lambda:each(
        [(8,b'\0\0'),(8,b'\1\x10'),(10,b'\0\0'),(10,b'\x11\x27'),
         (12,b'\0'),(12,b'\x81'),(13,b'\11'),(14,b'\2')],
        lambda p:bad(patch(raw,*p))))
    group('strict_provenance_references',lambda:each(
        [(20,b'\1\0'),(22,b'\3'),(26,b'\11\0'),(28,b'\3\0'),
         (34,b'\1'),(35,b'\2'),(14,b'\3')],
        lambda p:bad(patch(oriented_raw,*p))))
    def boolean_slots():
        refused(lambda:W.encode(True,left,right))
        variants=[side([(False,0)]),side([(0,False)]),side(recipes=[(False,0,0)]),
                  side(recipes=[(0,True,0)]),side(recipes=[(0,0,False)]),
                  side(tree=[(False,0)]),side(tree=[(0,False)]),side(selected=True)]
        for value in variants:
            refused(lambda value=value:W.encode(3,value,right))
            refused(lambda value=value:W.encode(3,left,value))
    group('boolean_slots',boolean_slots)
    group('unequal_witnesses',lambda:bad(W.encode(3,left,side())))
    empty=side(recipes=[],tree=[],selected=0)
    group('identity_witness',lambda:bad(W.encode(3,empty,empty)))
    middle_left=side(recipes=[(0,1,0)])
    group('middle_dihedral_witness',lambda:bad(W.encode(3,middle_left,side())))
    group('least_positive_closing_order',lambda:each([1,2,4,6],
        lambda d:bad(W.encode(d,left,right))))
    def malformed_python():
        for d in (0,4097,-1):refused(lambda d=d:W.encode(d,left,right))
        for value in (side([(0,3)]),side([(1,0)]),side(recipes=[(1,0,0)]),
                      side(recipes=[(0,0,1)]),side(tree=[(1,0)]),
                      side(tree=[(0,1)]),side(selected=2),side(recipes=[])):
            refused(lambda value=value:W.encode(3,value,right))
    group('producer_strict_grammar',malformed_python)
    group('involutions',lambda:each(
        [(identity,a,b,za),(z,a,a,za),(bytes(49),a,b,za),
         (bytes([11])+z[1:],a,b,za),(z[:-1],a,b,za),
         (z,permutation((1,2,0,3,4,5,6)),b,za)],lambda q:bad(raw,q)))
    group('explicit_identity',lambda:each(
        [z,bytes(49),identity[:-1],bytes([11])+identity[1:]],lambda unit:bad(raw,unit=unit)))
    def exhausted(field,cap):
        meter=B()
        need(meter.products==meter.linear==meter.row_images==0,'fresh meter')
        if field=='products':meter.products=cap
        else:meter.linear=cap
        try:W.check(marks,raw,meter,identity)
        except limit_exception:pass
        else:raise AssertionError('exhausted meter accepted')
        need(meter.products==(400000 if field=='products' else 0),'positive arithmetic at cap')
        if field=='linear':need(meter.linear==200000,'linear debit at cap')
    group('artificial_product_cap',lambda:exhausted('products',400000))
    group('artificial_linear_cap',lambda:exhausted('linear',200000))
    need(len(names)==len(set(names))==15,'fifteen distinct fresh groups')
    return dict(status='ALL_FRESH_INTERSECTION_WORD_CONTROLS_PASS',groups=names,
                count=len(names),Original_inputs_loaded=False,Root_authority=False,case_credit=0)
