"""UNRUN finite-closure meaning/selection admission; metadata only."""
COMMON_SUBJECT=('criterion','original_job','selected_orbit_positions','case','projection',
 'Root_projection_acceptance','original_domain_whole_pins','original_orbit_array_sha256',
 'matrix_frame_result','unpaid_manifest','old_sources','normalization_status','selector',
 'meaning_evidence','model_statement','model_evidence','original_inputs')
DUTIES=('same_faithful_Original_G2_11_frame_members_and_transporters_owned',
 'all_four_reconstructed_marks_belong_to_this_same_Original_G_owned',
 'all_current_selector_typed_adoptions_owned',
 'same_complete_Original_domain_and_case_identity_owned',
 'fresh_result_not_replay_of_completed_same_subject_owned',
 'only_selected_finite_criterion_no_type_maximality_or_GEN_owned')

def subject(plan):
 out={k:plan[k]for k in COMMON_SUBJECT}
 if plan['criterion']=='FINITE_CLOSURE_NG':
  out.update(cap=plan['cap'],ambient_order_strict_lower_bound=plan['ambient_order_strict_lower_bound'])
 elif plan['criterion']=='INTERSECTION_WORD_NOT_IP':out['word_file']=plan['word_file']
 else:raise ValueError('exact finite criterion')
 return out

def scope(plan,imported,M,role='CHECK'):
 M.need(imported['schema']=='ROOT_IMPORTED_F004_FINITE_CLOSURE_V1'and imported['root']=='/root'
  and imported['Root_authority']is imported['issued']is True
  and imported['Source_manifest']==plan['Source_manifest'],'issued exact finite-closure meaning')
 words=role=='CHECK_WORDS';roles=['CHECK_WORDS']if words else['PRODUCE','CHECK']
 M.need(role in roles and plan['criterion']==('INTERSECTION_WORD_NOT_IP'if words else'FINITE_CLOSURE_NG')
  and M.can(imported['admitted_roles'])==M.can(roles),'exact role and selected finite criterion')
 M.need(M.can(imported['subject'])==M.can(subject(plan)),'whole typed role/case/model/input binding')
 for k in DUTIES:M.need(imported[k]is True,'explicit Root premise '+k)
 M.need(type(imported['history_qualification'])is str and bool(imported['history_qualification'].strip()),
  'finite known-history scope, never unbounded absence')
 M.need(type(plan['original_job'])is list and plan['original_job']==[155,4]and all(type(i)is int for i in plan['original_job']),'typed job155')
 if words:
  r=plan['word_file'];M.need(type(r)is dict and set(r)=={'path','bytes','sha256'}
   and type(r['bytes'])is int and 0<=r['bytes']<=60586,'bounded supplied word descriptor')
 else:
  M.need(type(plan['cap'])is int and 1<=plan['cap']<=32768
   and type(plan['ambient_order_strict_lower_bound'])is int and plan['ambient_order_strict_lower_bound']>=32768
   and imported['Original_G_order_strictly_exceeds_bound_owned']is True,'typed cap and strictly owned ambient lower bound')
 for k in('meaning_evidence','model_evidence'):
  M.need(type(plan[k])is list and bool(plan[k]),'explicit whole proof/model evidence')
 M.need(type(plan['model_statement'])is str and bool(plan['model_statement'].strip()),'explicit same faithful model')
 M.need(type(plan['original_inputs'])is list and len(plan['original_inputs'])==len({r['path']for r in plan['original_inputs']}),
  'complete unique scientific input closure')
 selected=plan['selected_orbit_positions'];case=plan['case']
 M.need(type(selected)is list and len(selected)==1 and type(selected[0])is int
  and set(case)=={'position','representative_J_index','original_orbit_row_sha256'}
  and type(case['position'])is int and case['position']==selected[0]
  and type(case['representative_J_index'])is int and 1<=case['representative_J_index']<=14763
  and type(case['original_orbit_row_sha256'])is str and len(case['original_orbit_row_sha256'])==64
  and set(case['original_orbit_row_sha256'])<=set('0123456789abcdef'),'one exact typed Original representative')

def selection(plan,current,A,M):
 total=current['original_orbit_positions']
 M.need(type(total)is int and 1<=total<=14763,'bounded scalar selector domain')
 M.need(type(current['original_job'])is list and len(current['original_job'])==2
  and all(type(i)is int for i in current['original_job'])
  and M.can(current['original_job'])==M.can(plan['original_job'])
  and M.can(current['projection'])==M.can(plan['projection'])
  and M.can(current['Root_projection_acceptance'])==M.can(plan['Root_projection_acceptance']),
  'typed current job and complete projection references')
 ctx=dict(projection=dict(original_orbit_rows=total,full_orbit_array_sha256=plan['original_orbit_array_sha256']),
  paid=current['original_paid_positions'],refs=plan['original_domain_whole_pins'])
 return A.select(plan,current,ctx,M.digest,M.expand_runs)

def outcome(facts,cap,bound,M):
 M.need(type(cap)is int and 1<=cap<=32768 and type(bound)is int and bound>=32768
  and facts['status']=='VERIFIED_EXACT_FOUR_GENERATOR_CLOSURE'
  and type(facts['exact_order'])is int and 1<=facts['exact_order']<=cap
  and facts['all_word_matrices_distinct']is facts['all_elements_actual_generator_words']is facts['complete_right_generator_closure']is True,
  'complete finite actual subgroup below strictly imported ambient order')
 return 'VERIFIED_PROPER_FOUR_MARK_SUBGROUP'

def word_outcome(facts,M):
 M.need(facts['status']=='VERIFIED_IP_INTERSECTION_COUNTEREXAMPLE'
  and type(facts['witness'])is bytes and len(facts['witness'])==49 and all(x<11 for x in facts['witness'])
  and type(facts['middle_order'])is int and 1<=facts['middle_order']<=4096
  and facts['actual_end_words_verified']is facts['whole_matrix_equality_verified']is facts['complete_middle_exclusion_verified']is True,
  'complete actual word and middle exclusion facts')
 return 'VERIFIED_IP_INTERSECTION_COUNTEREXAMPLE'

def controls(b,A,M,words=False):
 """Five new metadata groups, not filesystem/Original/authority actuals."""
 M.need(type(words)is bool,'typed control family');role='CHECK_WORDS'if words else'CHECK'
 b.scalar(65536);names=[]
 def refused(f):
  try:f()
  except(ValueError,TypeError,KeyError):return
  raise ValueError('unrefused envelope control')
 r=dict(path='/private/tmp/F004_FINITE_TOY_NOT_READ',bytes=1,sha256='0'*64)
 p=dict(criterion='INTERSECTION_WORD_NOT_IP'if words else'FINITE_CLOSURE_NG',original_job=[155,4],selected_orbit_positions=[3],case=dict(position=3,representative_J_index=1,original_orbit_row_sha256='0'*64),
  projection=r,Root_projection_acceptance=r,original_domain_whole_pins=dict(toy=r),original_orbit_array_sha256='0'*64,
  matrix_frame_result=r,unpaid_manifest=r,old_sources={},normalization_status='toy',selector=r,meaning_evidence=[r],
  model_statement='Toy metadata only',model_evidence=[r],original_inputs=[r],Source_manifest=r)
 if words:p['word_file']=r
 else:p.update(cap=32768,ambient_order_strict_lower_bound=32768)
