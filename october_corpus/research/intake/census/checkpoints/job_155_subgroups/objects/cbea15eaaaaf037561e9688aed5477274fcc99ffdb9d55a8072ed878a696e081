  Source_manifest=r,subject=subject(p),admitted_roles=['CHECK_WORDS']if words else['PRODUCE','CHECK'],history_qualification='Toy metadata, no historical fact')
 imp.update({k:True for k in DUTIES})
 if not words:imp['Original_G_order_strictly_exceeds_bound_owned']=True
 scope(p,imp,M,role);names.append('typed_complete_meaning_metadata')
 refused(lambda:scope(p,dict(imp,Root_authority=False),M,role))
 wrong=dict(imp,subject=dict(imp['subject'],model_statement='wrong frame'))
 refused(lambda:scope(p,wrong,M,role));refused(lambda:scope(p,dict(imp,admitted_roles=[]),M,role))
 names.append('unissued_or_changed_model_or_role_import')
 changes=[('word_file',dict(r,bytes=True)),('word_file',dict(r,bytes=60587)),('word_file',None)]if words else[
  ('cap',True),('ambient_order_strict_lower_bound',True),('ambient_order_strict_lower_bound',32767)]
 for key,value in changes:
  q=dict(p,**{key:value});v=dict(imp,subject=subject(q));refused(lambda q=q,v=v:scope(q,v,M,role))
 names.append('typed_word_ref_or_closure_bound')
 current=dict(schema='ROOT_ACCEPTED_Q11_RANK4_UNRESOLVED_SELECTOR_V1',root='/root',adopted=True,original_job=[155,4],
  original_orbit_positions=4,projection=r,Root_projection_acceptance=r,original_paid_positions=[1],original_paid_count=1,
  accepted_new_paid_positions=[2],accepted_new_paid_by_kind=dict(NG=[2],NOT_IP=[]),unresolved_position_runs=[[3,4]],
  unresolved_positions=2,expanded_unresolved_sha256=M.digest([3,4]))
 M.need(selection(p,current,A,M)[0]==[3],'positive scalar selection')
 for selected in([True],[3,3],[2]):refused(lambda selected=selected:selection(dict(p,selected_orbit_positions=selected),current,A,M))
 refused(lambda:selection(p,dict(current,original_job=[155.0,4]),A,M))
 refused(lambda:selection(p,dict(current,projection=dict(r,bytes=True)),A,M))
 names.append('Boolean_duplicate_or_paid_before_Original')
 if words:
  toy=bytes(10 if i==j==3 else int(i==j)for i in range(7)for j in range(7))
  f=dict(status='VERIFIED_IP_INTERSECTION_COUNTEREXAMPLE',witness=toy,middle_order=3,
   actual_end_words_verified=True,whole_matrix_equality_verified=True,complete_middle_exclusion_verified=True)
  M.need(word_outcome(f,M)=='VERIFIED_IP_INTERSECTION_COUNTEREXAMPLE','typed word implication')
  for bad in(dict(f,middle_order=True),dict(f,witness=bytes(48)),dict(f,complete_middle_exclusion_verified=False)):
   refused(lambda bad=bad:word_outcome(bad,M))
 else:
  f=dict(status='VERIFIED_EXACT_FOUR_GENERATOR_CLOSURE',exact_order=32768,
   all_word_matrices_distinct=True,all_elements_actual_generator_words=True,complete_right_generator_closure=True)
  M.need(outcome(f,32768,32768,M)=='VERIFIED_PROPER_FOUR_MARK_SUBGROUP','strict imported-bound implication')
  for bad in(dict(f,exact_order=True),dict(f,exact_order=32769),dict(f,complete_right_generator_closure=False)):
   refused(lambda bad=bad:outcome(bad,32768,32768,M))
 names.append('typed_selected_finite_implication');M.need(len(names)==len(set(names))==5,'five fresh envelope groups')
