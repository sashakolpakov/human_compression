\documentclass[10pt]{article}
\usepackage[a4paper,margin=25mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\newtheorem{lemma}{Lemma}
\newtheorem{theorem}{Theorem}
\title{Three vertices outside a Moore tree}
\author{Human Compression project}
\date{13 October 2026}
\begin{document}\maketitle
We use the degree-four Moore edge tree and its leaf notation from
\emph{A graph from fourteen points and fourteen blocks}.
Its two leaf sets $A,B$ each have nine vertices in three branches.
All internal tree vertices have their degrees filled; a further
edge between tree vertices can only join $A$ to $B$.

\begin{lemma}
Let $G$ have degree four and girth at least six. For a fixed edge,
let $Y$ consist of the $m$ vertices outside its Moore tree, and let
$\lambda$ be the number of six-cycles through that edge. Then
\[
                       |E(G[Y])|=2m-27+\lambda.
\]
If $m=3$ and $Y$ is independent, no such graph exists.
\end{lemma}
\begin{proof}
Each edge from $A$ to $B$ closes exactly one six-cycle through the
fixed edge, and every such cycle has exactly that form. Hence there
are $\lambda$ cross edges. The eighteen leaves have fifty-four
unfilled degree slots besides their parent edges. Cross edges use
$2\lambda$ of those slots, so the number of edges from the leaves
to $Y$ is $54-2\lambda$. Counting degrees within $Y$ gives
$4m=54-2\lambda+2|E(G[Y])|$.

Suppose now that $Y$ is independent and $|Y|=3$. For $p\in Y$, put
$a_p=|N(p)\cap A|$ and $b_p=|N(p)\cap B|$.
Then $a_p+b_p=4$, and $1\leq a_p,b_p\leq3$, since two neighbours
in the same branch would give a four-cycle.
If $x\in A\cap N(p)$ and $y\in B\cap N(p)$, then $x$ has no
cross neighbour in the branch of $y$: joining $y$ gives a triangle,
and joining another leaf of that branch gives a five-cycle through
$p,y$ and their branch parent. Since the $b_p$ neighbours of $p$
in $B$ belong to different branches, $x$ has at most $3-b_p$ cross
neighbours. Thus $d_Y(x)\geq b_p$; symmetrically
$d_Y(y)\geq a_p$ for $y\in B\cap N(p)$.
It follows that
\[
 \sum_{z\in N(p)}(d_Y(z)-1)
       \geq a_p(b_p-1)+b_p(a_p-1)=2a_pb_p-4.
\]
The left side also equals
$\sum_{q\in Y\setminus\{p\}}|N(p)\cap N(q)|\leq2$,
because two common neighbours would give a four-cycle.
Therefore $a_pb_p\leq3$ and $a_p\in\{1,3\}$ for every $p\in Y$.
Counting cross edges from the two leaf sets, however, gives
\[
       27-\sum_{p\in Y}a_p=27-\sum_{p\in Y}b_p,
       \qquad\sum_{p\in Y}a_p=6.
\]
Three odd integers cannot sum to six, which is the contradiction.
\end{proof}

\begin{theorem}
An edge-girth-regular graph with parameters $(k,g,\lambda)=(4,6,21)$
has at least thirty vertices.
\end{theorem}
\begin{proof}
The acquired Moore bound excludes orders below twenty-six.
The acquired classification at order twenty-six gives the plane
of order three, whose edges are on twenty-seven six-cycles.
The acquired order-twenty-eight proof excludes twenty-seven and
gives a unique graph at twenty-eight, with twenty-four six-cycles
per edge. At order twenty-nine the lemma has $m=3$ and
$|E(G[Y])|=6-27+21=0$, which it proves impossible.
\end{proof}

\paragraph{Attribution.}
This recovers the lower bound thirty in Table~2, physical page~18,
of J.~Goedgebeur and J.~Jooken, \emph{Exhaustive generation of
edge-girth-regular graphs}, arXiv:2401.08271v2, 25 June 2024.
That table attributes the previous bound twenty-nine to
Drglin, Filipovski, Jajcay and Raiman, its reference~[8, Theorem~2.3].
The Moore construction and counting arguments are established
methods; the explicit independent-exterior argument above is the
project's derivation of this particular entry. We make no claim
of historical priority. The example at thirty vertices and its
attribution remain as in the source; its uniqueness is a separate
question, not a consequence of this note.
\end{document}
