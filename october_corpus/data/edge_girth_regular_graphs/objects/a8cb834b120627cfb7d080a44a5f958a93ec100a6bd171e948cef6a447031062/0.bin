// Exact degree completion with a prescribed five-cycle. Working implementation.
#include <algorithm>
#include <array>
#include <chrono>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <vector>
using U=std::uint32_t;
struct Search{
 int n,z;std::vector<int>targets;std::array<int,5>a,b;std::array<U,24>adj{},allow{};std::array<int,24>rem{};
 std::array<U,5>left{},right{};std::uint64_t nodes=0,positives=0;std::vector<std::vector<U>>examples;
 std::chrono::steady_clock::time_point start;double cap;
 static int bits(U x){return __builtin_popcount(x);} static int first(U x){return __builtin_ctz(x);}
 void need(bool x,const char*msg){if(!x)throw std::runtime_error(msg);}
 void init(){
  need(15<=n&&n<=21,"unsupported order");need(!targets.empty(),"empty targets");
  std::vector<U>profiles;
  for(int i=0;i<5;i++)profiles.push_back((1u<<((i+4)%5))|(1u<<((i+1)%5)));
  for(int i=0;i<5;i++){
   need(a[i]>=1&&b[i]>=0,"class size");
   for(int j=1;j<a[i];j++)profiles.push_back(profiles[i]);
   for(int j=0;j<b[i];j++)profiles.push_back(1u<<i);
  }
  need(z>=0,"negative Z");for(int j=0;j<z;j++)profiles.push_back(0);
  need(static_cast<int>(profiles.size())==n,"class total");
  for(int x=0;x<n;x++)for(int y=0;y<5;y++)if(profiles[x]>>y&1u){adj[x]|=1u<<y;adj[y]|=1u<<x;}
  for(int x=0;x<n;x++){rem[x]=6-bits(adj[x]);need(rem[x]>=0,"initial deficit");if(x<5)need(rem[x]==0,"cycle degree");}
  for(int x=5;x<n;x++)for(int y=x+1;y<n;y++)if(!(profiles[x]&profiles[y])){allow[x]|=1u<<y;allow[y]|=1u<<x;}
  for(int i=0;i<5;i++){int j=(i+1)%5;left[i]=adj[i]&~(1u<<j);right[i]=adj[j]&~(1u<<i);}
 }
 void visit(U active){
  ++nodes;if(nodes%4096==0&&std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count()>cap)throw 1;
  std::array<U,24>candidates{};int chosen=-1,bestSlack=99,bestCount=99;
  for(U todo=active;todo;todo&=todo-1){int x=first(todo);U pool=active&allow[x];
   for(U ys=pool;ys;ys&=ys-1){int y=first(ys);if(rem[y]>0&&!(adj[x]&adj[y]))candidates[x]|=1u<<y;}
   int count=bits(candidates[x]);if(count<rem[x])return;int slack=count-rem[x];
   if(slack<bestSlack||(slack==bestSlack&&count<bestCount)){chosen=x;bestSlack=slack;bestCount=count;}
  }
  bool feasible=false;
  U closed=((1u<<n)-1)&~active;
  for(int target:targets){bool ok=true;
   for(U xs=closed;xs&&ok;xs&=xs-1){int x=first(xs);
    for(U ys=adj[x]&closed&~((1u<<(x+1))-1);ys&&ok;ys&=ys-1){int y=first(ys),lower=0,upper=0;
     U L=adj[x]&~(1u<<y),R=adj[y]&~(1u<<x);
     for(U us=L;us;us&=us-1){int u=first(us);lower+=bits(adj[u]&R);if(active>>u&1u)upper+=bits(candidates[u]&R&~adj[u]);}
     if(lower>target||lower+upper<target)ok=false;
    }
   }
   if(ok){feasible=true;break;}
  }
  if(!feasible)return;
  if(!active){
   for(int x=0;x<n;x++)need(rem[x]==0&&bits(adj[x])==6,"leaf degree");
   int value=-1;
   for(int x=0;x<n;x++)for(U ys=adj[x]&~((1u<<(x+1))-1);ys;ys&=ys-1){int y=first(ys),count=0;need(!(adj[x]&adj[y]),"leaf triangle");
    for(U us=adj[x]&~(1u<<y);us;us&=us-1)count+=bits(adj[first(us)]&adj[y]&~(1u<<x));
    if(value<0)value=count;else if(value!=count)return;
   }
   if(std::find(targets.begin(),targets.end(),value)==targets.end())return;
   ++positives;examples.emplace_back(adj.begin(),adj.begin()+n);return;
  }
  need(chosen>=0,"missing chosen vertex");
  choose(chosen,candidates[chosen],rem[chosen],0,active&~(1u<<chosen));
 }
 void apply_choice(int x,U picked,U tail){
  int old=rem[x];for(U ys=picked;ys;ys&=ys-1){int y=first(ys);adj[x]|=1u<<y;adj[y]|=1u<<x;--rem[y];}
  rem[x]=0;visit(tail);rem[x]=old;
  for(U ys=picked;ys;ys&=ys-1){int y=first(ys);adj[x]&=~(1u<<y);adj[y]&=~(1u<<x);++rem[y];}
 }
 void choose_cells(int x,const std::vector<std::vector<int>>&cells,int index,int count,U picked,U tail){
  if(count==0){apply_choice(x,picked,tail);return;}
  if(index==static_cast<int>(cells.size()))return;
  int remaining=0;for(int i=index;i<static_cast<int>(cells.size());i++)remaining+=cells[i].size();
  if(remaining<count)return;
  U selected=0;int limit=std::min(count,static_cast<int>(cells[index].size()));
  for(int j=0;j<=limit;j++){
   choose_cells(x,cells,index+1,count-j,picked|selected,tail);
   if(j<limit)selected|=1u<<cells[index][j];
  }
 }
 void choose(int x,U candidates,int count,U picked,U tail){
  need(picked==0,"initial picked set");
  std::vector<std::vector<int>>cells;std::vector<U>keys;
  for(U ys=candidates;ys;ys&=ys-1){int y=first(ys);need(!(adj[y]&(tail|(1u<<x))),"active vertices must be independent");
   auto it=std::find(keys.begin(),keys.end(),adj[y]);
   if(it==keys.end()){keys.push_back(adj[y]);cells.push_back({y});}
   else cells[it-keys.begin()].push_back(y);
  }
  choose_cells(x,cells,0,count,0,tail);
 }
 void run(int id){
  init();start=std::chrono::steady_clock::now();bool complete=true;
  try{visit(((1u<<n)-1)&~31u);}catch(int){complete=false;}
  std::cout<<"{\"case\":"<<id<<",\"n\":"<<n<<",\"status\":\""<<(complete?"COMPLETE":"TIMEOUT")<<"\",\"nodes\":"<<nodes<<",\"positives\":"<<positives<<",\"seconds\":"<<std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count()<<",\"examples\":[";
  for(std::size_t i=0;i<examples.size();i++){if(i)std::cout<<',';std::cout<<'[';for(int j=0;j<n;j++){if(j)std::cout<<',';std::cout<<examples[i][j];}std::cout<<']';}std::cout<<"]}"<<std::endl;
 }
};
int main(){try{int id,n,t;while(std::cin>>id>>n>>t){Search s;s.n=n;if(t<1||t>10)throw std::runtime_error("target count");for(int i=0,v;i<t;i++){std::cin>>v;s.targets.push_back(v);}for(int&i:s.a)std::cin>>i;for(int&i:s.b)std::cin>>i;std::cin>>s.z>>s.cap;if(!std::cin||s.cap<=0)throw std::runtime_error("invalid input");s.run(id);}return 0;}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}
