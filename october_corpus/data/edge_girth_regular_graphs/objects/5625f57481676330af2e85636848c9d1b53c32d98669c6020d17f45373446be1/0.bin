  nodes++;int n1=0,n2=0,n3=0;for(int mask:blocks){int w=weight(mask);n1+=w==1;n2+=w==2;n3+=w==3;}
  bool extendable=false;for(auto shape:final_sizes){int total=shape[0]+shape[1]+shape[2];if(n3<=shape[2]&&n2+n3<=shape[1]+shape[2]&&(int)blocks.size()<=total&&(int)(blocks.size()+items.size()-position)>=total)extendable=true;}
  if(!extendable)return;
