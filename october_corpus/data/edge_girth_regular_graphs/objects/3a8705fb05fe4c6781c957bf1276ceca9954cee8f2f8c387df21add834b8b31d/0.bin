import itertools as it
import json
import sys
from pathlib import Path
if sys.flags.optimize:
    raise RuntimeError('optimized Python is not an accepted checker')

def need(v,m):
    if not v: raise RuntimeError(m)

def good(E):
    d=[sum(i in e for e in E) for i in range(9)]
    if max(d)>4: return False
    # Literal triangles, rather than intersections of adjacency sets.
    for e in E:
        n=sum(all(tuple(sorted(f)) in E for f in it.combinations(t,2))
              for t in it.combinations(range(9),3) if set(e)<=set(t))
        if n>1: return False
    return True

def run():
    universe=set(it.combinations(range(9),2)); seed={(0,i) for i in range(1,5)}
    cases=[]
    # All four initial current choices and all six orders of their three
    # horizontal neighbors. Reconstruct actual earlier edge exclusions.
    for current in range(1,5):
        for order in it.permutations(set(range(1,5))-{current}):
            forbidden=set()
            for nxt in order:
                first=tuple(sorted((current,nxt))); E=seed|{first}
                legal={e for e in universe-E-forbidden if good(E|{e})}
                ds=[sum(i in e for e in E) for i in range(9)]
                choices={i:sum(i in e for e in legal) for i in range(1,5) if ds[i]<4}
                mins={i for i,x in choices.items() if x==min(choices.values())}
                need(mins==set(first),'bad minimizing leaves')
                need(all(not any(i in e and set(e)<={1,2,3,4} for e in legal) for i in mins),'empty printed branch')
                need(all(ds[i]+sum(i in e for e in legal)>=4 for i in range(9)),'capacity does not prune')
                deficient={1,2,3,4}-set(first)
                correction=tuple(sorted(deficient))
                need(correction in legal,'corrected deficient-group branch survives')
                cases.append([current,list(order),list(first),sorted(mins),list(correction)])
                forbidden.add(first)
    need(len(cases)==72,'history cases')
    rook={e for e in universe if e[0]//3==e[1]//3 or e[0]%3==e[1]%3}
    need(good(rook) and all(sum(i in e for e in rook)==4 for i in range(9)),'rook regular')
    triangles=[t for t in it.combinations(range(9),3) if all(e in rook for e in it.combinations(t,2))]
    need(len(triangles)==6 and all(sum(set(e)<=set(t) for t in triangles)==1 for e in rook),'rook cycles')
    seen={0}
    while True:
        newer=seen|{v for e in rook if set(e)&seen for v in e}
        if newer==seen: break
        seen=newer
    need(len(seen)==9,'connected rook')
    return {'status':'PASS_INDEPENDENT_PRINTED_PHASE_ONE_COUNTEREXAMPLE','history_cases':cases,'rook_edges':sorted(rook),'rook_triangles':triangles,'corrected_group_rule_survives_all_cases':True,'scope':'Printed June 2024 Algorithm 2 only; later December C selection differs; no census refutation.'}
if __name__=='__main__':
    out=Path(sys.argv[1]); out.mkdir(parents=True,exist_ok=False)
    report=run(); (out/'report.json').write_text(json.dumps(report,indent=2)+'\n'); print(report['status'])
