#include "literal_graph.h"
using namespace std;
int main(int argc,char**argv){try{require(argc==2,"one representative file");nauty_check(WORDSIZE,1,26,NAUTYVERSIONID);RepresentativeIndex targets(argv[1],true);int checked=0,rejected=0;for(int j=0;j<(int)targets.graphs.size();j+=137){const auto&g=targets.graphs[j];vector<int>p(26);iota(p.begin(),p.end(),0);for(int root:{0,13})for(int i=0;i<3;i++){p[root+4+3*i]=root+5+3*i;p[root+5+3*i]=root+6+3*i;p[root+6+3*i]=root+4+3*i;}Graph h(26);for(int u=0;u<26;u++){U b=g[u];while(b){int v=first(b);b&=b-1;h[p[u]]|=U(1)<<p[v];}}targets.cover(h);checked++;auto c=propose_canonical_map(g,true);auto bad=c.lab;bad[0]=bad[1];try{check_literal_map(g,g,c.lab,bad,true);}catch(const runtime_error&){rejected++;}}require(checked==rejected,"all bad maps reject");cout<<"{\"status\":\"PASS_LITERAL_MAP_CONTROLS\",\"changed_label_graphs\":"<<checked<<",\"bad_bijections\":"<<rejected<<"}\n";return 0;}catch(const exception&e){cerr<<e.what()<<'\n';return 1;}}
