"""Fresh exact F012 cubic catalogue application; no generator rerun."""
import sys
if sys.flags.optimize:raise RuntimeError('optimized Python is not permitted')
import argparse,copy,gzip,hashlib,json,math,os,pathlib,shutil,subprocess
P=pathlib.Path(__file__).resolve().parent

def need(x,m):
 if not x:raise ValueError(m)
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def read(p):return json.loads(p.read_text())
def write(p,x):p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(x,indent=2)+'\n')
def safe(base,name):
 q=pathlib.Path(name);need(not q.is_absolute() and '..' not in q.parts,'unsafe relative path');return base/q

def validate_routes(routes,outputs,scope):
 need(scope['whole_original_credit']==scope['new_question_credit']==scope['new_formal_declarations']==scope['measurement_credit']==0,'bounded scope')
 expected_counts={(5,2,20,1),(6,2,24,2),(6,4,18,1),(6,6,16,1),(6,8,14,1),(7,4,28,1),(8,8,40,1),(8,16,30,1)}
 expected_bounds={(6,2,24),(7,2,42),(7,6,42),(8,4,48),(8,6,48),(8,8,40),(8,10,48),(8,12,48)}
 need(len(routes['exact_counts'])==8 and {(x['g'],x['lambda'],x['minimum_order'],x['classes']) for x in routes['exact_counts']}==expected_counts,'exact source count contract')
 need(len(routes['new_lower_bounds'])==8 and {(x['g'],x['lambda'],x['bound']) for x in routes['new_lower_bounds']}==expected_bounds,'exact finite bound contract')
 need(len(outputs)==16 and len({(r['order'],r['minimum_girth']) for r in outputs})==16,'complete list-index domain')
 indexed={(r['order'],r['minimum_girth']):r for r in outputs}
 def bmod(g,l):
  s=g//2;B=1+3*(2**s-1)+2**s-l if g%2 else 2*(2**s-1)+(2*(2**s-l)+2)//3;mod=math.lcm(2,2*g//math.gcd(3*l,2*g));return ((B+mod-1)//mod)*mod,mod
 def count(n,g,l):
  need((n,g) in indexed,'required complete catalogue missing');r=indexed[n,g];return sum(x['count'] for x in r['positive'] if (x['g'],x['lambda'])==(g,l))
 for x in routes['new_lower_bounds']:
  b,mod=bmod(x['g'],x['lambda']);need(x['prior_tree_bound']==b and x['modulus']==mod,'inherited exact lower interface');need(x['orders_excluded']==list(range(b,x['bound'],mod)),'every admissible lower order');need(all(count(n,x['g'],x['lambda'])==0 for n in x['orders_excluded']),'finite exclusions')
 lower={(x['g'],x['lambda']):x['bound'] for x in routes['new_lower_bounds']}
 for x in routes['exact_counts']:
  b,_=bmod(x['g'],x['lambda']);need(x['prior_tree_bound']==b,'count lower interface');need(max(b,lower.get((x['g'],x['lambda']),b))==x['minimum_order'],'complete minimum proof');need(count(x['minimum_order'],x['g'],x['lambda'])==x['classes'],'exact extremal census')

def main():
 ap=argparse.ArgumentParser();ap.add_argument('--study',type=pathlib.Path,required=True);ap.add_argument('--out',type=pathlib.Path,required=True);ap.add_argument('--render',action='store_true');args=ap.parse_args();args.out.mkdir(parents=True,exist_ok=False)
 manifest=read(P/'manifest.json');verified=0
 for x in manifest['exports']:
  p=safe(P,x['path']);need(p.stat().st_size==x['bytes'] and sha(p)==x['sha256'],'author export pin');verified+=1
 deps=read(P/'dependencies.json');roots={k:pathlib.Path(v) for k,v in deps['root_locations'].items()};roots['private_study']=args.study
 for x in deps['bindings']:
  p=safe(roots[x['root']],x['path']);need(p.stat().st_size==x['bytes'] and sha(p)==x['sha256'],'acquired dependency pin')
 env=os.environ.copy();env.pop('PYTHONOPTIMIZE',None);env['PYTHONDONTWRITEBYTECODE']='1'
 def run(cmd,name,cap):
  try:r=subprocess.run(cmd,capture_output=True,timeout=cap,env=env)
  except subprocess.TimeoutExpired as e:
   (args.out/(name+'.stdout')).write_bytes(e.stdout or b'');(args.out/(name+'.stderr')).write_bytes(e.stderr or b'');raise
  (args.out/(name+'.stdout')).write_bytes(r.stdout);(args.out/(name+'.stderr')).write_bytes(r.stderr);need(r.returncode==0 and not r.stderr,'fresh execution '+name);return r.stdout
 sources=args.out/'sources';sources.mkdir();shutil.copyfile(P/'source_roster01.json',sources/'source_roster01.json');assets=read(P/'input_assets.json')
 for x in assets:
  compressed=safe(P,x['compressed_asset']);need(sha(compressed)==x['compressed_sha256'],'compressed input pin');raw=gzip.decompress(compressed.read_bytes());need(hashlib.sha256(raw).hexdigest()==x['sha256'] and len(raw)==x['bytes'],'exact decompression');target=safe(sources,x['file']);target.parent.mkdir(exist_ok=True);target.write_bytes(raw)
 shutil.copytree(P/'recorded/classify02',sources/'classify02')
 for p in (P/'historical').iterdir():
  if p.is_file() and (p.name.startswith('cubic_n') or p.name.startswith('snark_n')):shutil.copyfile(p,sources/p.name)
 # All original completed calls retain exact executed binaries and output pins.
 for x in assets:
  name=pathlib.Path(x['file']).name;rec=read(P/'recorded/classify02'/(name+'.receipt.json'));need(rec['exit_code']==0 and rec['input_sha256']==x['sha256'],'old classifier complete input');need(rec['binary_sha256']==sha(P/'historical/classify_cubic'),'old classifier binary');need(rec['output_sha256']==sha(P/'recorded/classify02'/(name+'.stdout')),'old classifier output');need((P/'recorded/classify02'/(name+'.stderr')).read_bytes()==b'','old classifier stderr')
 for p in (P/'historical').glob('*.receipt.json'):
  x=read(p)
  if x['status']!='TERMINAL':need(p.name=='cubic_n24_g6.receipt.json' and x['status']=='TIME_LIMIT_NO_CONCLUSION','only declared timeout');continue
  exe=P/'historical'/('snarkhunter-64' if p.name.startswith('snark_') else 'geng_executed');need(x['binary_sha256']==sha(exe),'provider exact executed binary')
 exe=args.out/'classify_cubic';run(['/usr/bin/clang++','-std=c++17','-O2','-Wall','-Wextra','-pedantic',str(P/'classify_cubic.cpp'),'-o',str(exe)],'compile',60)
 actual=[]
 for row in assets:
  name=pathlib.Path(row['file']).name;out=run([str(exe.resolve()),str((sources/row['file']).resolve()),str(row['n']),str(row['minimum_girth'])],'filter_'+name,120);need(out==(P/'recorded/classify02'/(name+'.stdout')).read_bytes(),'fresh full census equality');x=json.loads(out);need(x['graphs']==row['classes'],'primary cardinality');actual.append(x)
 run([sys.executable,str(P/'audit_catalogues.py'),'--sources',str(sources),'--out',str(args.out/'canonical')],'canonical',300);need(read(args.out/'canonical/report.json')==read(P/'recorded/canonical01/report.json'),'fresh all canonical classes')
 run([sys.executable,str(P/'controls.py'),'--sources',str(sources),'--witness-input',str(P/'source_witnesses.input.gz'),'--binary',str(exe),'--out',str(args.out/'controls')],'controls',60)
 for f in ['report.json','profiles.json','source_maps.json']:need(read(args.out/'controls'/f)==read(P/'recorded/controls02'/f),'fresh independent control/source map equality')
 run([sys.executable,str(P/'compare_generators.py'),'--sources',str(sources),'--out',str(args.out/'generators')],'generators',60);need(read(args.out/'generators/report.json')==read(P/'recorded/generator_comparison01/report.json'),'provider class comparisons')
 # Check every successful sanitizer receipt; do not reinterpret the preserved failed attempt.
 san=P/'recorded/sanitized02';sr=read(san/'report.json');need(sr['status']=='PASS' and sr['source_sha256']==sha(P/'classify_cubic.cpp') and sr['binary_sha256']==sha(san/'filter'),'sanitizer exact source/binary')
 for row in assets:
  name=pathlib.Path(row['file']).name;r=read(san/(name+'.receipt.json'));need(r['returncode']==0 and (san/(name+'.stderr')).read_bytes()==b'','sanitizer successful termination');need(r['stdout_sha256']==sha(san/(name+'.stdout')) and r['stderr_sha256']==sha(san/(name+'.stderr')),'sanitizer receipt closure');need((san/(name+'.stdout')).read_bytes()==(P/'recorded/classify02'/(name+'.stdout')).read_bytes(),'sanitizer original byte equality')
 routes=read(P/'claim_routes.json');scope=read(P/'scope.json');validate_routes(routes,actual,scope)
 controls=[]
 for kind in ['whole','question','formal','measure','omit_order','false_count','infinity','missing_list']:
  a=copy.deepcopy(routes);o=copy.deepcopy(actual);s=copy.deepcopy(scope)
  if kind in ['whole','question','formal','measure']:s[{'whole':'whole_original_credit','question':'new_question_credit','formal':'new_formal_declarations','measure':'measurement_credit'}[kind]]=1
  elif kind=='omit_order':a['new_lower_bounds'][0]['orders_excluded'].pop()
  elif kind=='false_count':a['exact_counts'][0]['classes']=2
  elif kind=='infinity':a['new_lower_bounds'][0]['bound']='infinity'
  elif kind=='missing_list':o.pop()
  try:validate_routes(a,o,s)
  except (ValueError,TypeError):controls.append(kind)
  else:raise ValueError('damaged claim admitted')
 pages=None
 if args.render:
  native=args.out/'native';native.mkdir()
  for i in range(2):run(['/opt/homebrew/bin/pdflatex','-interaction=nonstopmode','-halt-on-error','-output-directory',str(native),str(P/'cubic_catalogues.tex')],f'native{i}',60)
  log=(native/'cubic_catalogues.log').read_text();need('Overfull' not in log,'native overflow')
  import pypdf
  new=pypdf.PdfReader(native/'cubic_catalogues.pdf');old=pypdf.PdfReader(P/'cubic_catalogues.pdf');need([p.extract_text() for p in new.pages]==[p.extract_text() for p in old.pages],'native full text identity');pages=len(new.pages)
 result={'status':'PASS','exports_verified':verified,'direct_bindings':len(deps['bindings']),'graphs':sum(r['graphs'] for r in actual),'lists':len(actual),'canonical_classes_checked':285148,'exact_count_entries':8,'new_lower_bounds':8,'independent_cycle_profiles':378,'source_bijections':11,'required_extremal_bijections':9,'generator_comparisons':8,'malformed_graph_controls':9,'scope_controls':controls,'native_pages':pages,'whole_original_credit':0};write(args.out/'report.json',result);print(json.dumps(result,sort_keys=True))
if __name__=='__main__':main()
