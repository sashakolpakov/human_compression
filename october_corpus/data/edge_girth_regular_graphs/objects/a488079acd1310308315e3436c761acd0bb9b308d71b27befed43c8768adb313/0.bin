#include "vertex_ball_lambda.h"
struct Block{int i,j,k,dir;vector<array<int,3>>choices;};
int main(int argc,char**argv){try{
 need(argc==6,"usage PATTERNS ROOTS REPORT SECONDS LAMBDA");int lambda=stoi(argv[5]);need(lambda>=2&&lambda<=4,"lambda two to four");Deadline deadline(stod(argv[4]));ifstream in(argv[1]);int count;need(bool(in>>count)&&count==(lambda==2?2:3),"exact pattern count");
 const std::map<int,std::set<array<int,6>>> inventories={{2,{{0,0,2,2,0,0},{0,1,1,1,1,0}}},{3,{{0,0,3,3,0,0},{0,1,2,2,1,0},{1,1,1,1,1,1}}},{4,{{0,1,3,3,1,0},{0,2,2,2,2,0},{1,1,2,2,1,1}}}}; const auto&expected=inventories.at(lambda);std::set<array<int,6>>seen;const array<pair<int,int>,6>edges={{{0,1},{0,2},{0,3},{1,2},{1,3},{2,3}}};Cover cover(true);U products=0,leaves=0,nodes=0;
 for(int id=0;id<count;id++){
  vector<Block>blocks;array<int,6>sizes;sizes.fill(-1);array<int,4>component{0,1,2,3},indegree{};auto find=[&](int v){while(component[v]!=v)v=component[v];return v;};U prod=1;
  for(int z=0;z<6;z++){
   Block b;need(bool(in>>b.i>>b.j>>b.k>>b.dir),"complete block");need(b.i>=0&&b.i<b.j&&b.j<4&&b.k>=0&&b.k<=3&&b.dir>=0&&b.dir<=2,"block bounds");int e=find_if(edges.begin(),edges.end(),[&](auto p){return p==make_pair(b.i,b.j);})-edges.begin();need(e<6&&sizes[e]<0,"one block each");sizes[e]=b.k;
   if(b.dir){need(b.k>0&&find(b.i)!=find(b.j),"positive forest");component[find(b.i)]=find(b.j);need(++indegree[b.dir==1?b.j:b.i]==1,"oriented forest");for(int mask=0;mask<8;mask++)if(wt(mask)==b.k){array<int,3>q{-1,-1,-1};int at=0;for(int x=0;x<3;x++)if(mask>>x&1){if(b.dir==1)q[x]=at;else q[at]=x;at++;}b.choices.push_back(q);}}
   else for(int x=-1;x<3;x++)for(int y=-1;y<3;y++)for(int z=-1;z<3;z++){array<int,3>q{x,y,z};if(count_if(q.begin(),q.end(),[](int x){return x>=0;})!=b.k)continue;bool good=true;for(int i=0;i<3;i++)for(int j=0;j<i;j++)if(q[i]>=0&&q[i]==q[j])good=false;if(good)b.choices.push_back(q);}
   need(b.choices.size()==static_cast<size_t>(b.dir?(b.k==3?1:3):array<int,4>{1,9,18,6}[b.k]),"exact block choices");prod*=b.choices.size();blocks.push_back(b);
  }
  need(expected.count(sizes)&&seen.insert(sizes).second,"exact size representative");products+=prod;Graph g=ball();
  function<void(int)>visit=[&](int at){if((++nodes&4095)==0)deadline.check();if(at==6){validate_root_lambda(g,lambda);leaves++;cover.take(g);return;}auto&b=blocks[at];for(auto q:b.choices){vector<pair<int,int>>added;bool okay=true;for(int x=0;x<3;x++)if(q[x]>=0){int u=5+3*b.i+x,v=5+3*b.j+q[x];if(wt(g[u])>=4||wt(g[v])>=4){okay=false;break;}add(g,u,v);added.emplace_back(u,v);if(!girth5(g)){okay=false;break;}}if(okay)visit(at+1);for(auto[u,v]:added)remove_edge(g,u,v);}};
  visit(0);need(g==ball(),"root restoration");cout<<"PATTERN "<<id<<" NODES "<<nodes<<" ROOTS "<<cover.graphs.size()<<'\n'<<flush;
 }
 string extra;need(!(in>>extra)&&seen==expected&&products==array<U,3>{252,19927,20196}[lambda-2],"complete pattern inventory");cover.write(argv[2]);ofstream out(argv[3]);out<<"{\"status\":\"PASS_COMPLETE_PARAMETERIZED_PENTAGON_ROOTS\",\"normalized_products\":"<<products<<",\"nodes\":"<<nodes<<",\"girth_roots\":"<<leaves<<",\"literal_maps\":"<<cover.verified<<",\"root_classes\":"<<cover.graphs.size()<<"}\n";need(bool(out),"complete report");return 0;
 }catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
