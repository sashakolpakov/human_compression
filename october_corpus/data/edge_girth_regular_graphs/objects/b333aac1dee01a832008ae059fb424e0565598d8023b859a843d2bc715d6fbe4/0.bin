Algorithm 1 calculateNumberGirthCycles(Graph G, Girth g, Edge u1u2)
1: // This algorithm calculates ngc(G, u 1u2)
2: // Array with |V| entries intialized to ∞ ; the array stores d(G− u1u2, u, u 1)
3: dist← newArray (|V|,∞ )
4: // Array with |V| entries intialized to 0; the array stores nsp(G− u1u2, u, u 1)
5: nsp← newArray (|V|, 0)
6: dist[u1] = 0 // base case
7: nsp[u1] = 1 // base case
8: q← emptyQueue()
9: q.addLastElement (u1)
10: while q is not empty do
11: currentV ertex← q.f irstElement ()
12: q.eraseF irstElement ()
13: // dist[u2] and nsp[u2] cannot change anymore
14: if currentV ertex = u2 then
15: if dist[u2] > g− 1 then
16: return 0
17: else
18: return nsp[u2]
19: end if
20: end if
21: for u′∈ NG−u1u2 (currentV ertex ) do
22: if dist[u′] =∞ then
23: dist[u′]← dist[currentV ertex ] + 1 // recursive case
24: q.addLastElement (u′)
25: end if
26: if dist[u′] = dist[currentV ertex ] + 1 then
27: nsp[u′]← nsp[u′] + nsp[currentV ertex ] // recursive case
28: end if
29: end for
30: end while
31: return 0
