\documentclass[11pt,a4paper]{article}
\usepackage[margin=25mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\setlength{\emergencystretch}{2em}
\newtheorem{lemma}{Lemma}\newtheorem{theorem}[lemma]{Theorem}
\title{Equality in the count of third neighbours}
\author{Human Compression project}\date{}
\begin{document}\maketitle
All graphs below are finite and simple. A graph with parameters
$(n,k,6,\lambda)$ is $k$-regular on $n$ vertices, has girth six,
and has exactly $\lambda$ six-cycles through each edge. We recover the
unique graph with parameters $(35,4,6,9)$ by a local reconstruction.
The proof does not use an exhaustive graph catalogue or a classification
of distance-regular graphs.

\begin{lemma}\label{moments}
Put $S=k(k-1)^2$. For any graph with parameters $(n,k,6,\lambda)$,
\[
 n\ \ge\ 1+k^2+\frac{S^2}{S+k\lambda}.
\]
If equality holds, every vertex outside the ball of radius two about
any root has exactly $(S+k\lambda)/S$ neighbours in its second layer.
\end{lemma}
\begin{proof}
Fix a root $v$. Its first and second layers have sizes $k$ and
$k(k-1)$: repetition would give a triangle or a quadrangle.
The first layer is independent. A second-layer vertex has just one
first-layer neighbour, and no two second-layer vertices are adjacent:
an edge between them would give a triangle or a pentagon, according
as their parents agree or differ. Thus the ball has $1+k^2$ vertices,
and exactly $S$ edges leave its second layer.

For each vertex $x$ outside the ball let $c_x$ count its neighbours
in the second layer. Consequently $\sum c_x=S$.
Two such neighbours of $x$ have different parents, since a common
parent would give a quadrangle. They therefore determine a six-cycle
through $v$. Conversely, the opposite vertex of any six-cycle through
$v$ lies outside the ball: a shortcut of length at most two, together
with one of the two three-edge halves, would produce a cycle of length
at most five. The pair of second-layer neighbours recovers that cycle
uniquely. Counting cycles through the $k$ root edges gives
\[
 \sum_x\binom{c_x}{2}=\frac{k\lambda}{2},\qquad
 \sum_x c_x^2=S+k\lambda.
\]
There are $t=n-1-k^2$ summands. Cauchy's inequality gives
$S^2\le t(S+k\lambda)$. Equality holds precisely when all $c_x$
are equal; their common value is $(S+k\lambda)/S$.
\end{proof}

For $(n,k,\lambda)=(35,4,9)$, the two sums are $36$ and $72$,
and $t=18$. Equality therefore gives $c_x=2$ for all eighteen
outside vertices. This holds about every root. Every vertex has
distance at most three from every root, and the respective numbers
of neighbours in the preceding layer are $1,1,2$. In the usual
notation this is the intersection array
\[
                         \{4,3,3;1,1,2\}.                 \tag{1}
\]
We give the needed uniqueness proof explicitly.

\begin{lemma}\label{reconstruction}
A quartic graph of girth at least six with the layer counts in (1)
is uniquely determined up to isomorphism.
\end{lemma}
\begin{proof}
Fix a root $v$, its four neighbours $p_1,\ldots,p_4$, and the
three second-layer vertices in each branch $L_i=N(p_i)\setminus\{v\}$.
Write $L=\bigcup L_i$ and let $Y$ be the eighteen vertices of
the third layer. Each $y\in Y$ has two neighbours in $L$ and two
in $Y$. Its two neighbours in $L$ are in different branches. Distinct
vertices of $Y$ cannot have the same pair, since this would be a
quadrangle. Regard each $y$ as an edge of a graph $H$ on $L$.
Every vertex of $L$ has three neighbours in $Y$, so $H$ is cubic.

Let $u\in L_i$ and $j\ne i$. Its distance from $p_j$ is exactly
three, along $p_j,v,p_i,u$; any shorter path would give a cycle of
length at most five. By (1), exactly two neighbours of $u$ have
distance two from $p_j$. One is $p_i$. A neighbour $y\in Y$ of $u$
has distance two from $p_j$ exactly when its other leaf is in $L_j$:
the neighbours of $p_j$ are $v$ and $L_j$. Hence $u$ has exactly
one $H$-neighbour in each other branch. In particular, the $H$-edges
between any two branches form a matching of size three.

Suppose $y_e\in Y$ represents an $H$-edge $e$ between branches
$i,j$, and let $k,l$ be the other two branches. Relative to $p_k$,
the vertex $y_e$ has neither distance one nor distance two, and thus
has distance three. Both its leaf neighbours have distance three
from $p_k$, by the preceding paragraph. Its two neighbours inside
$Y$ must therefore both have distance two from $p_k$, and their
corresponding $H$-edges touch $L_k$. Applying the same argument to
$p_l$ shows that both these edges join $L_k$ to $L_l$.

There are only three $H$-edges between $L_k$ and $L_l$.
Exactly two represent the two neighbours of $y_e$ in $Y$;
write $f_0$ for the remaining edge. If $y_e,y_f$ are adjacent
in $Y$, no endpoint $u$ of $e$ can be adjacent in $H$ to an
endpoint $w$ of $f$. Indeed, if that edge is $g$, the five distinct
vertices
\[
                         y_e,u,y_g,w,y_f
\]
form a pentagon in the original graph. The four branches are
different, so none of the stated vertices or edges coincides.

Each endpoint of $e$ has a unique $H$-neighbour in each of $L_k$
and $L_l$. Each of these four neighbours belongs to exactly one
of the three matching edges between those branches. That edge
cannot represent a neighbour of $y_e$, by the pentagon obstruction.
It must be $f_0$ in all four cases. Thus both endpoints of $e$
are adjacent to both endpoints of $f_0$. Together with $e,f_0$
they form a $K_4$ with one vertex in each branch. All their degrees
in $H$ are now filled. Every edge of the cubic graph $H$ consequently
belongs to an entire component $K_4$, and $H$ is the disjoint union
of three such components.

The preceding argument also fixes every adjacency inside $Y$.
An edge in one component of $H$ is adjacent, as a vertex of $Y$,
to precisely the two edges on the complementary branch pair in
the other two components. All other adjacencies of the original
graph were already specified. This proves uniqueness.
\end{proof}

\begin{theorem}
The smallest order of a graph with parameters $(n,4,6,9)$ is $35$.
At that order there is exactly one isomorphism class, the graph on
the three-element subsets of a seven-element set in which adjacency
means disjointness.
\end{theorem}
\begin{proof}
The lower bound follows from Lemma~\ref{moments}; its equality case
and Lemma~\ref{reconstruction} prove uniqueness if a graph exists.
For clarity, the reconstruction gives a literal identification.
Label the three components of $H$ by $a\in A=\{1,2,3\}$ and
the four branches by $b\in B=\{4,5,6,7\}$. Assign the following
three-element subsets of $A\cup B$:
\[
\begin{array}{c|c}
 v&A\\
 p_b&B\setminus\{b\}\\
 \text{leaf in component }a\text{ and branch }b
       &(A\setminus\{a\})\cup\{b\}\\
 y_e,\ e\text{ in component }a\text{ between branches }b,c
       &\{a\}\cup(B\setminus\{b,c\}).
\end{array}                                                    \tag{2}
\]
These are all $35$ three-element subsets, without repetition.
The root, branch and leaf adjacencies in the construction correspond
exactly to disjointness. Inside $Y$, disjointness means different
component labels and complementary branch pairs, which is precisely
the adjacency just proved. Formula (2) is therefore an isomorphism.

We also verify existence directly. Each triple has four disjoint
triples, so the graph is quartic. A triangle would require nine
distinct elements. Two distinct triples have union of size at least
four and hence at most one common disjoint triple, excluding a
quadrangle. In a pentagon, any element can occur in at most two
of the five triples, since consecutive triples are disjoint; this
would give $15\le2\cdot7$, a contradiction.

Relative to a root triple $A$, the other triples intersect it in
zero, two or one elements, with counts $4,12,18$, respectively.
The first are its neighbours. A triple meeting it in two elements
has exactly one common neighbour with it, so lies at distance two.
A triple meeting it in one element has exactly two neighbours of
the preceding kind and no path of length at most two to $A$.
It therefore lies at distance three. The cycle count in
Lemma~\ref{moments} now gives $18$ six-cycles through each root.
Permuting the seven elements is transitive on edges. If $\lambda$
is their common number of six-cycles, then $4\lambda=2\cdot18$,
so $\lambda=9$. In particular, the girth is exactly six.
\end{proof}

\paragraph{Attribution and scope.}
Goedgebeur and Jooken, \emph{Exhaustive generation of edge-girth-regular
graphs}, arXiv:2401.08271v2 (25 June 2024), Table 2, record the order
$35$ and its unique graph. Their table attributes the lower bound
to Drglin, Filipovski, Jajcay and Raiman, Theorem 2.3. The graph is
the classical odd graph $O_4$. Its uniqueness from the intersection
array is also classical; it is a special case of the characterization
of odd graphs by Aeryung Moon (1982), and appears in the account
of Brouwer, Cohen and Neumaier, Section 9.1D.
Here we supply the full local proof needed for this particular array,
rather than taking that classification as a premise. The source graph
is identified by a checked literal map. No mathematical-priority,
open-conjecture, Lean, full-paper or compression claim is made by
this component. The computational checks verify examples and maps;
the universal uniqueness assertion is established by the proof above.
\end{document}
