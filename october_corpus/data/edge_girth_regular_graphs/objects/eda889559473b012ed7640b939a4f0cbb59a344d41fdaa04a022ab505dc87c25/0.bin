#include "literal_graph.h"
using namespace std;
int main(int argc,char**argv){try{
 require(argc==3,"two complete root lists");nauty_check(WORDSIZE,1,26,NAUTYVERSIONID);
 RepresentativeIndex old(argv[1],true),fresh(argv[2],true);
 for(auto&g:fresh.graphs)old.cover(g);for(auto&g:old.graphs)fresh.cover(g);
 require(all_of(old.hits.begin(),old.hits.end(),[](U n){return n>0;})&&all_of(fresh.hits.begin(),fresh.hits.end(),[](U n){return n>0;}),"two-way literal cover");
 cout<<"{\"status\":\"PASS_TWO_WAY_LITERAL_ROOT_CONTROL\",\"acquired_targets\":"<<old.graphs.size()<<",\"fresh_targets\":"<<fresh.graphs.size()<<"}\n";return 0;
 }catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
