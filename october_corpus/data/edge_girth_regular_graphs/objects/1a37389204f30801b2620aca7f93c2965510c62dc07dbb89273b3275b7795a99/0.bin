#include "literal_graph.h"
using namespace std;
struct Probe {vector<int> blocks,items;int final_a;U nodes=0;bool accepted=false;
 void check(size_t position){
#include "size_guard.inc"
 accepted=true;
 }
};
int main(){try{
 cout<<"{\"rows\":[";bool comma=false;int count=0;
 for(int a=0;a<=3;a++)for(int n1=0;n1<=8;n1++)for(int n2=0;n2<=8-n1;n2++)for(int n3=0;n3<=8-n1-n2;n3++){
  int position=n1+2*n2+3*n3;if(position>14)continue;
  Probe p;p.final_a=a;p.items.resize(14);p.blocks.insert(p.blocks.end(),n1,1);p.blocks.insert(p.blocks.end(),n2,3);p.blocks.insert(p.blocks.end(),n3,7);p.check(position);
  if(comma)cout<<',';comma=true;cout<<'['<<a<<','<<n1<<','<<n2<<','<<n3<<','<<p.accepted<<']';count++;
 }
 cout<<"],\"cases\":"<<count<<"}\n";return 0;
 }catch(const exception&e){cerr<<"NO_CERTIFICATE: "<<e.what()<<'\n';return 1;}}
