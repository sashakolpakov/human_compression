#define main acquired_root_main
#include "root_cover.cpp"
#undef main
int main(){try{
 vector<int>p;vector<pair<vector<int>,int>>rows;
 function<void(int,int)>visit=[&](int left,int lo){if(!left){if(p.size()<=9)rows.push_back({p,capacity(p)});return;}for(int k=lo;k<=min(3,left);k++){p.push_back(k);visit(left-k,k);p.pop_back();}};visit(12,1);
 cout<<"{"<<"\"rows\":[";for(size_t i=0;i<rows.size();i++){if(i)cout<<',';cout<<"[ [";for(size_t j=0;j<rows[i].first.size();j++){if(j)cout<<',';cout<<rows[i].first[j];}cout<<"],"<<rows[i].second<<']';}cout<<"]}\n";return 0;
 }catch(const exception&e){cerr<<e.what()<<'\n';return 1;}}
