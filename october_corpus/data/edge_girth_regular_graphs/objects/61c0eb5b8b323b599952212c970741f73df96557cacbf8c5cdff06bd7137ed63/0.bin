\documentclass[11pt]{article}
\usepackage[a4paper,margin=26mm]{geometry}
\usepackage{amsmath,amssymb,amsthm,hyperref}
\setlength{\emergencystretch}{2em}
\newtheorem{lemma}{Lemma}\newtheorem{corollary}{Corollary}
\title{Edges outside a Moore ball}\author{Human Compression project}\date{}
\begin{document}\maketitle
Let $G$ be a finite simple $k$-regular graph of girth five in which
every edge belongs to exactly $\lambda$ pentagons. Put
$d=(k-1)^2-\lambda$. Fix a vertex $v$, and let $Y$ be the set of
vertices at distance at least three from $v$. The radius-two Moore
ball has $1+k+k(k-1)=k^2+1$ vertices; write $t=|Y|$.

\begin{lemma}
The number of edges induced by $Y$ satisfies
\[
                         2e(Y)=k(t-d).
\]
\end{lemma}
\begin{proof}
The $k$ neighbours of $v$ have disjoint sets of $k-1$ further
neighbours, which we call leaves. No leaf is adjacent to another
neighbour of $v$, and two leaves in the same branch cannot be
adjacent: these would give a quadrangle or a triangle, respectively.
An edge between leaves in different branches corresponds uniquely
to a pentagon through $v$, by joining its ends to their parents
and then to $v$. Conversely, every pentagon through $v$ has this
form. There are $k\lambda/2$ such pentagons, since summing the
pentagon counts on the $k$ edges at $v$ counts each twice.

The leaves have $k(k-1)^2$ degree incidences left after their
parent edges are removed. Exactly $k\lambda$ of these belong to
edges between leaves. Thus the number of edges from the ball
to $Y$ is $k((k-1)^2-\lambda)=kd$. Only leaves can meet $Y$.
Summing degrees on $Y$ now gives $kt=kd+2e(Y)$, as asserted.
\end{proof}

\begin{corollary}
If $(k,\lambda)=(6,23)$ or $(6,24)$, then $|V(G)|\geq45$.
\end{corollary}
\begin{proof}
The Moore bound gives $|V(G)|\geq37$. Counting all pentagon-edge
incidences gives $5\mid 3\lambda |V(G)|$. Since $3\lambda$ is
coprime to five in both cases, the order is divisible by five.
An order less than forty-five must therefore be forty.

At order forty there are $t=3$ exterior vertices. For $\lambda=23$
the lemma gives $e(Y)=3$, forcing a triangle. For $\lambda=24$ it
gives $e(Y)=6$, impossible even for a simple graph on three vertices.
Both contradict the hypotheses.
\end{proof}

\paragraph{Attribution and limits.}
These are the two lower-bound entries in Table~4, physical page~20,
of J.~Goedgebeur and J.~Jooken, \emph{Exhaustive generation of
edge-girth-regular graphs}, \nolinkurl{arXiv:2401.08271v2}, 25 June 2024.
The table attributes its earlier bound of forty to Exoo and Jajcay,
reference~[10]. The same leaf-incidence count is used in our acquired
note \emph{Three exterior vertices in a graph of girth five}; here
it is stated for arbitrary exterior order and applied to two more
entries. We claim no historical priority. Neither existence at
forty-five nor nonexistence at all orders is asserted. The proof
is the argument above; finite controls check its arithmetic and
its identity on retained examples. No Lean verification is claimed.
\end{document}
