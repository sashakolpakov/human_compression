\usepackage{amsmath,amssymb,amsthm,hyperref}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}[theorem]{Lemma}
\newcommand{\N}{N}
\title{Four-cycle counts determine a fourteen-vertex graph}
\author{Human Compression project}
\date{13 October 2026}
\begin{document}\maketitle
\begin{abstract}
We prove directly that a triangle-free graph on fourteen vertices,
regular of degree four and with exactly three four-cycles on each
edge, is unique up to isomorphism. Its bipartition and every edge
are forced by the local cycle counts. The result supplies the
uniqueness entry for these parameters in the tables of Goedgebeur
and Jooken, without an exhaustive search through regular graphs.
\end{abstract}

\section{The source entry}
All graphs are finite, simple and undirected. Write
$\operatorname{egr}(n,k,g,\lambda)$ for a connected graph on $n$
vertices of degree $k$ and girth $g$, with exactly $\lambda$ cycles
of length $g$ through each edge. Table~2 of the fixed edition
\nolinkurl{arXiv:2401.08271v2} of Goedgebeur and Jooken~\cite{GJ}
records minimum order fourteen and one graph at the minimum for
$(k,g,\lambda)=(4,4,3)$. It attributes the earlier bounds to its
reference~[8]. Our separately reviewed small-order component already
excludes all smaller orders, and the positive-witness component
supplies an example. The present note supplies the missing uniqueness
proof. It does not claim a new classification or an open-problem
solution. The complement of the Fano incidence graph used below is
a classical construction; no historical priority for the argument
is claimed.

\begin{theorem}\label{main}
There is exactly one triangle-free graph on fourteen vertices with
degree four and exactly three four-cycles through each edge. It is
the bipartite complement of the incidence graph of the Fano plane.
\end{theorem}

\section{Local restrictions}
Let $X$ satisfy the hypotheses. Its neighbourhoods are independent.
For an edge $pq$, counting its four-cycles by the neighbour of $p$
opposite $q$ gives
\begin{equation}\label{edge}
 \sum_{s\in\N(p)\setminus\{q\}}
       \bigl(|\N(s)\cap\N(q)|-1\bigr)=3.
\end{equation}
The subtracted common neighbour is $p$; every remaining choice
gives exactly one four-cycle on $pq$.

Fix $v$, and label its four neighbours $a,b,c,d$. There are nine
other vertices. A vertex $x$ among them with $m=|\N(x)\cap\N(v)|$
contributes a clique on those $m$ labels: each of its label pairs
gives a four-cycle through $v$. Count these cliques with multiplicity.
Equation~\eqref{edge} says that the resulting weighted graph on
$\{a,b,c,d\}$ has degree three at every label. Also
\begin{equation}\label{paths}
 \sum_{x\notin\{v\}\cup\N(v)}m(x)=4\cdot3=12,
 \qquad
 \sum_{x\notin\{v\}\cup\N(v)}\binom{m(x)}2=6.
\end{equation}
We shall first exclude $m=4$ and $m=3$, at every choice of $v$.

\begin{lemma}\label{four}
Two distinct vertices cannot have four common neighbours.
\end{lemma}
\begin{proof}
Suppose $x$ has all four neighbours of $v$. Its clique already
uses the full weighted degree three at each label. Every other
outside vertex has at most one neighbour among $a,b,c,d$.
Equation~\eqref{paths} requires eight such single incidences. Since
there are precisely eight vertices other than $x$ outside
$\{v\}\cup\N(v)$, all of them have one incidence. Each label $i$
therefore has precisely two associated vertices $z_i^0,z_i^1$, with
\[
                  \N(i)=\{v,x,z_i^0,z_i^1\}.
\]
Apply \eqref{edge} to $iz_i^0$. The terms from $v$ and $x$ are
zero, since $z_i^0$ has only $i$ as a neighbour in their common
neighbourhood. The remaining term gives
$|\N(z_i^0)\cap\N(z_i^1)|=4$. Thus the two vertices of each
pair have identical neighbourhoods and are not adjacent.

Each $z_i^\epsilon$ has three neighbours among the other six
vertices $z_j^\eta$, with $j\ne i$: it has just the one neighbour
$i$ among $a,b,c,d$, and neither $v$ nor $x$ is adjacent to it.
But its adjacency to each other pair is all or nothing, because
the two vertices in that pair have identical neighbourhoods.
Those three neighbours would be a union of two-element pairs,
which is impossible. The contradiction proves the assertion.
\end{proof}

\begin{lemma}\label{three}
Two distinct vertices cannot have three common neighbours.
\end{lemma}
\begin{proof}
Suppose $x$ is adjacent to $a,b,c$ but not $d$. By
Lemma~\ref{four}, no outside vertex has four incidences. There
cannot be a second vertex with three incidences: its three labels
would overlap $\{a,b,c\}$ in at least two places, producing weighted
degree at least four at each shared label. The clique of $x$
leaves residual weighted degrees $1,1,1,3$ at $a,b,c,d$.
The vertices with two incidences must therefore be exactly
$y_a,y_b,y_c$, with label sets $\{a,d\},\{b,d\},\{c,d\}$.
Indeed, the three edges remaining in the weighted graph must all
meet $d$ and must meet each of $a,b,c$ once.

Ordinary degree four now forces one vertex $z_i$ with the single
label $i$, for each $i\in\{a,b,c\}$, and none with single label
$d$. The remaining two outside vertices have no label at all.
Thus
\[
 \N(i)=\{v,x,y_i,z_i\}\quad(i=a,b,c),\qquad
 \N(d)=\{v,y_a,y_b,y_c\}.
\]
The fourth neighbour of $x$ must be one of the two vertices with
no label: a $y_i$ or $z_i$ would form a triangle with $i$.
Call that neighbour $h$, and call the last outside vertex $w$.

Apply \eqref{edge} to $ix$. The term from $v$ is two. The
terms from $y_i$ and $z_i$ are respectively one or zero according
as that vertex is adjacent to $h$, since the only other neighbours
of $x$ are the three labels $a,b,c$. Hence exactly one of
$y_i,z_i$ is adjacent to $h$, for each $i$. Together with $x$,
these are all four neighbours of $h$.

Put $\delta_i=1$ if $h$ is adjacent to $y_i$, and put
$\delta_i=0$ otherwise. Let $Y=\{y_a,y_b,y_c,z_a,z_b,z_c,w\}$.
The numbers of neighbours of $y_i,z_i$ in $Y$ are respectively
$2-\delta_i$ and $2+\delta_i$. Their only common neighbour
outside $Y$ is $i$: they cannot both be adjacent to $h$, and
their incidences with $v,x,a,b,c,d$ have already been specified.
Applying \eqref{edge} to $iz_i$ therefore gives
\[
 0+(1-\delta_i)+|\N(y_i)\cap\N(z_i)\cap Y|=3.
\]
The common-neighbour term is at most $2-\delta_i$, the number
of neighbours of $y_i$ in $Y$. It follows that
$2+\delta_i\le2-\delta_i$, so every $\delta_i$ is zero.
Moreover $y_i$ and $z_i$ have the same two neighbours in $Y$.

Now $h$ is adjacent to all three $z_i$, and $d$ is adjacent to
all three $y_i$. Triangle-freeness forbids adjacency between
two $y$ vertices, between two $z$ vertices, or between $y_i$
and $z_i$. The common two-element neighbour set of $y_i,z_i$
inside $Y$ can consequently contain neither a $y$ vertex nor
a $z$ vertex. It would have to be contained in $\{w\}$, a
contradiction.
\end{proof}

\section{The bipartition and all remaining edges}
The two lemmas apply with every vertex as root. Thus any two
distinct vertices have at most two common neighbours. For a fixed
$v$, two different labels in $\N(v)$ already have the common
neighbour $v$, so at most one outside vertex can contribute that
pair to the weighted graph. Its edges have multiplicity at most
one. Since its degree is three at each of four labels, it is $K_4$.
There are precisely six vertices $y_{ij}$, one adjacent to each
pair $\{i,j\}\subset\{a,b,c,d\}$. These use all twelve incidences
in \eqref{paths}; the last three vertices, forming a set $Z$,
have no neighbour in $\N(v)$. This also proves, at every root,
that distinct vertices have either zero or two common neighbours.

Two vertices $y_{ij},y_{kl}$ could be adjacent only when their
label pairs are disjoint, or they would form a triangle with a
shared label. Each pair has just one disjoint partner. Suppose
$y_{ab}$ and $y_{cd}$ were adjacent. Their fourth neighbours
would have to be vertices $z,z'\in Z$, respectively. A four-cycle
through $y_{ab}y_{cd}$ is an edge between
$\{a,b,z\}$ and $\{c,d,z'\}$. There are no edges between the
labels, or between a label and $Z$, so only the possible edge
$zz'$ remains. There would be at most one four-cycle, rather
than three. Therefore the six $y$ vertices are independent.

Every $y$ vertex has exactly two neighbours in $Z$, giving twelve
edges from the six $y$ vertices to the three vertices of $Z$.
Those twelve incidences exhaust the degrees of $Z$, so $Z$ is
independent as well. We have obtained the bipartition
\[
       \{v\}\cup\{y_{ij}\}\quad\text{and}\quad\N(v)\cup Z.
\]

For $z\in Z$, view its four neighbours $y_{ij}$ as four edges of
$K_4$ on the labels $a,b,c,d$. The degree of a label $i$ in
this four-edge graph is $|\N(i)\cap\N(z)|$, which is zero or
two. The four degrees sum to eight, so each is two. Hence these
four edges form a cycle of length four, and the two missing edges
are a perfect matching. Each $y_{ij}$ is adjacent to two of the
three vertices of $Z$, so its edge $ij$ is omitted by exactly one
of the three matchings. These matchings partition the six edges
of $K_4$. They must be precisely its three perfect matchings,
which determine every remaining adjacency. This proves uniqueness.

For existence, take two copies of the seven nonzero vectors of
$\mathbb F_2^3$, and join a vector $p$ in the first copy to a
vector $\ell$ in the second when $p\cdot\ell=1$. This is the
bipartite complement of the Fano incidence graph. Every vertex
has degree four. Two distinct vectors in either part are linearly
independent, so the two corresponding affine linear equations
have exactly two solutions in the other part, both nonzero.
Thus every pair in a part has two common neighbours. In particular
the graph is connected. For an edge $p\ell$, each of the other
three neighbours $q$ of $\ell$ has exactly one common neighbour
with $p$ besides $\ell$. These give precisely three four-cycles
through that edge. The graph has the required parameters, proving
Theorem~\ref{main}.

\paragraph{Certificates and limits.}
The accompanying verifier constructs this graph over $\mathbb F_2$,
checks its cycles and local configurations, and verifies a literal
bijection to the previously acquired source example. Small exhaustive
local checks are supplementary: the two exclusions and the complete
adjacency reconstruction above are written proofs. This note adds one
uniqueness entry to the earlier reviewed lower bound and existence;
it does not complete the original's tables or add a conjecture,
compression measurement or Lean claim.

