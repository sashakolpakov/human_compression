class SoftStop(Exception):pass
class Budget:
    def __init__(self):
        self.refs={};self.raw={};self.read_bytes=0;self.products=0;self.images=0;self.scalar_units=0;self.peak=0
    def tick(self,soft=False):
        self.peak=max(self.peak,resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024))
        elapsed=time.monotonic()-START
        need(self.peak<128*2**20 and elapsed<125,'128MiB/125s hard inner envelope')
        if soft and (self.scalar_units>=900000 or elapsed>=110):raise SoftStop('900000scalar/110s soft stop')
    def scalar(self,units,soft=False):
        need(type(units)is int and units>=0,'integer nonnegative work debit')
        self.scalar_units+=units;need(self.scalar_units<=1000000,'1000000 additional scalar hard cap');self.tick(soft)
    def read(self,ref,again=False):
        refcheck(ref);self.tick();need(self.refs.get(ref['path'],ref)==ref,'one whole version per path')
        if ref['path']in self.raw and not again:return self.raw[ref['path']]
        need(self.read_bytes+ref['bytes']<=8*2**20 and (ref['path']in self.refs or len(self.refs)<96),
             'all initial and repeated reads within8MiB/96paths')
        p=Path(ref['path']);a=p.lstat()
        need(p.is_absolute() and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
             and a.st_nlink==1 and a.st_size==ref['bytes'],'canonical single-link bounded regular input')
        with p.open('rb')as handle:
            b=os.fstat(handle.fileno());raw=handle.read(ref['bytes']+1);c=os.fstat(handle.fileno())
        signature=lambda z:(z.st_dev,z.st_ino,z.st_mode,z.st_nlink,z.st_size,z.st_mtime_ns,z.st_ctime_ns)
        need(signature(a)==signature(b)==signature(c)==signature(p.lstat()) and len(raw)==ref['bytes']
             and hashlib.sha256(raw).hexdigest()==ref['sha256'],'stable whole input bytes and SHA')
        self.refs[ref['path']]=ref;self.raw[ref['path']]=raw;self.read_bytes+=len(raw);return raw
    def doc(self,ref):return decode(self.read(ref))
    def recheck(self):
        for ref in list(self.refs.values()):self.read(ref,True)
    def multiply(self,A,B,soft=False):
        need(type(A)is bytes and type(B)is bytes and len(A)==len(B)==49,'whole packed7x7 operands')
        self.products+=1;need(self.products<=400000,'400000 matrix products');self.scalar(64,soft)
        return bytes(sum(A[7*i+k]*B[7*k+j]for k in range(7))%11 for i in range(7)for j in range(7))
    def image(self,row,A,soft=False):
        need(type(row)is tuple and len(row)==7 and type(A)is bytes and len(A)==49,'whole row/right action')
        self.images+=1;need(self.images<=200000,'200000 row images');self.scalar(49,soft)
        return tuple(sum(row[k]*A[7*k+j]for k in range(7))%11 for j in range(7))
    def snapshot(self):
        self.tick();return dict(physical_read_bytes=self.read_bytes,paths=len(self.refs),matrix_products=self.products,
            row_images=self.images,additional_scalar_units=self.scalar_units,peak_RSS=self.peak,
            seconds=time.monotonic()-START,before_output_IO=True)
def word_header(word,power):
    need(type(word)is str and 1<=len(word)<=64 and set(word)<=set('012'),'bounded same-end literal012 word')
    need(type(power)is int and 1<=power<=256,'bounded positive exact-integer word power')
def end_indices(mask):
    need(type(mask)is int and mask in(7,14),'original rank3 end mask7or14')
    return (0,1,2)if mask==7 else(1,2,3)
def unpack_operand(raw):
    need(type(raw)is bytes and len(raw)==294 and all(x<11 for x in raw),'all294 canonical GF11 operand bytes')
    return tuple(raw[49*i:49*(i+1)]for i in range(6))
def power(A,n,budget,soft=False):
    need(type(n)is int and n>=0,'nonnegative exact integer exponent')
    result=I7
    while n:
        if n&1:result=budget.multiply(result,A,soft)
        n>>=1
        if n:A=budget.multiply(A,A,soft)
    return result
def word_value(parts,mask,word,exponent,budget,soft=False):
    word_header(word,exponent);indices=end_indices(mask);value=I7
    for letter in word:value=budget.multiply(value,parts[indices[int(letter)]],soft)
    return power(value,exponent,budget,soft)
