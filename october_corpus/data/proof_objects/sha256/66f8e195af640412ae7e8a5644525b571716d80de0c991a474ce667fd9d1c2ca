def derive_fixed_row(Y,budget):
    # Row vY=v means transpose(Y-I)*transpose(v)=0. Seven variables only.
    rows=[[(Y[7*i+j]-int(i==j))%11 for i in range(7)]for j in range(7)]
    pivots=[];rank=0
    for column in range(7):
        budget.tick(True);pivot=next((k for k in range(rank,7)if rows[k][column]),None)
        if pivot is None:continue
        rows[rank],rows[pivot]=rows[pivot],rows[rank];inverse=pow(rows[rank][column],9,11)
        budget.scalar(7,True);rows[rank]=[(x*inverse)%11 for x in rows[rank]]
        for k in range(7):
            if k!=rank and rows[k][column]:
                factor=rows[k][column];budget.scalar(14,True)
                rows[k]=[(x-factor*y)%11 for x,y in zip(rows[k],rows[rank])]
        pivots.append(column);rank+=1
    free=[i for i in range(7)if i not in pivots]
    if len(free)!=1:return None
    row=[0]*7;row[free[0]]=1
    for k,column in enumerate(pivots):row[column]=(-rows[k][free[0]])%11
    vector=tuple(row)
    need(budget.image(vector,Y,True)==vector,'proposed full fixed row rechecked')
    return vector
def propose_hint(plan,parts,budget):
    Y=word_value(parts,plan['mask'],plan['word'],plan['power'],budget,True)
    if Y==I7 or power(Y,37,budget,True)!=I7:return None,'FINITE_MISS_SUPPLIED_WORD_NOT_EXACT37'
    row=derive_fixed_row(Y,budget)
    if row is None:return None,'FINITE_MISS_NO_UNIQUE_FIXED_ROW_PROPOSED'
    for label in end_indices(plan['mask']):
        image=budget.image(row,parts[label],True)
        for i in range(7):
            for j in range(i+1,7):
                budget.scalar(4,True)
                if (row[i]*image[j]-row[j]*image[i])%11:
                    hint=dict(hint_header(plan),vector=list(row),escape_generator=label,minor=[i,j])
                    verify_hint(hint,plan,parts,budget)
                    return hint,'UNTRUSTED_SAME_END37_LINE_ESCAPE_HINT'
    return None,'FINITE_MISS_SAME_END_LINE_ESCAPE_NOT_FOUND'
