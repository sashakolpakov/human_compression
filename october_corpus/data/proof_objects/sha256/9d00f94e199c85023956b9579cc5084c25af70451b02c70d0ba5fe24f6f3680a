import argparse,hashlib,json,os,stat
from pathlib import Path

_F9_SOURCE_TAG = 'Root_Source_rows_reference'
_F9_DOMAIN_TAG = 'Root_Input_rows_reference'
_F9_CLOSURE_TAG = 'Root_Native_closure_rows_reference'
_F9_LOGICAL_LIMIT = 8 * 2**20


def f9_canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                       ensure_ascii=True, allow_nan=False) + '\n').encode('ascii')


def f9_need(condition, message):
    if not condition:
        raise ValueError(message)


def f9_rows(rows, limit):
    f9_need(type(rows) is list and len(rows) <= limit, 'bounded literal row list')
    previous = ''; total = 0
    for row in rows:
        f9_need(type(row) is dict and set(row) == {'path', 'bytes', 'sha256'},
                'exact complete row fields')
        path, size, digest = row['path'], row['bytes'], row['sha256']
        f9_need(type(path) is str and path.startswith('/') and path > previous
                and '\x00' not in path and all(x not in ('.', '..') for x in path.split('/'))
                and type(size) is int and size >= 0 and type(digest) is str
                and len(digest) == 64 and set(digest) <= set('0123456789abcdef'),
                'ordered unique absolute paths and exact finite row types')
        previous = path; total += size
    f9_need(total <= 2**31, 'unchanged whole2GiB descriptor extent')
    return rows


def f9_image(value):
    raw = f9_canonical(value)
    f9_need(len(raw) <= _F9_LOGICAL_LIMIT, 'existing8MiB logical metadata role')
    return len(raw), hashlib.sha256(raw).hexdigest()


def f9_encode_job(job):
    f9_need(type(job) is dict and job.get('schema') == 'ROOT_F009_STANDALONE_JOB_V1'
            and job.get('role') in ('native', 'reader') and _F9_SOURCE_TAG not in job,
            'one ordinary logical standalone job')
    rows = f9_rows(job['declared_inputs'], 40000)
    sources = f9_rows(job['source_inputs'], 1024)
    f9_need(sum(row['bytes'] for row in sources) <= 128*2**20,
            'unchanged128MiB functional Source extent')
    by_path = {row['path']: i for i, row in enumerate(rows)}
    indices = []
    for source in sources:
        f9_need(source['path'] in by_path and rows[by_path[source['path']]] == source,
                'every Source role is the same exact declared row')
        indices.append(by_path[source['path']])
    size, digest = f9_image(job)
    wire = dict(job); wire.pop('source_inputs')
    wire[_F9_SOURCE_TAG] = dict(schema='F009_SOURCE_ROW_INDICES_V1', indices=indices,
        Source_rows_sha256=hashlib.sha256(f9_canonical(sources)).hexdigest(),
        declared_rows_sha256=hashlib.sha256(f9_canonical(rows)).hexdigest(),
        logical_bytes=size, logical_sha256=digest)
    f9_need(f9_expand_job(wire) == job, 'entire exact Source-reference inverse')
    return f9_encode_declared(wire)


def f9_expand_job(wire):
    wire = f9_expand_declared(wire)
    if type(wire) is not dict or _F9_SOURCE_TAG not in wire:
        return wire
    f9_need(wire.get('schema') == 'ROOT_F009_STANDALONE_JOB_V1'
            and wire.get('role') in ('native', 'reader') and 'source_inputs' not in wire,
            'explicit Source-reference wire, never a mixed representation')
    tag = wire[_F9_SOURCE_TAG]
    f9_need(type(tag) is dict and set(tag) == {'schema', 'indices', 'Source_rows_sha256',
            'declared_rows_sha256', 'logical_bytes', 'logical_sha256'}
            and tag['schema'] == 'F009_SOURCE_ROW_INDICES_V1', 'exact reference encoding')
    rows = f9_rows(wire['declared_inputs'], 40000); indices = tag['indices']
    f9_need(type(indices) is list and len(indices) <= 1024,
            'bounded Source-index list')
    last = -1
    for index in indices:
        f9_need(type(index) is int and last < index < len(rows),
                'strictly increasing nonboolean unique in-range indices')
        last = index
    sources = [rows[index] for index in indices]
    f9_need(sum(row['bytes'] for row in sources) <= 128*2**20,
            'unchanged128MiB functional Source extent')
    f9_need(hashlib.sha256(f9_canonical(rows)).hexdigest() == tag['declared_rows_sha256']
            and hashlib.sha256(f9_canonical(sources)).hexdigest() == tag['Source_rows_sha256'],
            'complete exact declared and Source table identities')
    logical = dict(wire); logical.pop(_F9_SOURCE_TAG); logical['source_inputs'] = sources
    size, digest = f9_image(logical)
    f9_need(type(tag['logical_bytes']) is int and tag['logical_bytes'] == size
            and tag['logical_sha256'] == digest, 'entire canonical semantic image')
    return logical


def f9_encode_table(domain, field, tag_name, version):
    f9_need(type(domain) is dict and tag_name not in domain,
            'ordinary complete Root domain')
    rows = f9_rows(domain[field], 40000)
    prefixes = sorted({row['path'][:row['path'].rfind('/')+1] for row in rows})
    lookup = {prefix: i for i, prefix in enumerate(prefixes)}
    packed = []
    for row in rows:
        cut = row['path'].rfind('/')+1; prefix = row['path'][:cut]
        packed.append([lookup[prefix], row['path'][cut:], row['bytes'], row['sha256']])
    size, digest = f9_image(domain)
    wire = dict(domain); wire.pop(field)
    wire[tag_name] = dict(schema=version,
        prefixes=prefixes, rows=packed, logical_bytes=size, logical_sha256=digest)
    f9_need(f9_expand_table(wire, field, tag_name, version) == domain, 'entire exact row-table inverse')
    return wire


def f9_expand_table(wire, field, tag_name, version):
    if type(wire) is not dict or tag_name not in wire:
        return wire
    f9_need(field not in wire, 'one explicit row-table representation')
    tag = wire[tag_name]
    f9_need(type(tag) is dict and set(tag) == {'schema', 'prefixes', 'rows',
            'logical_bytes', 'logical_sha256'} and tag['schema'] == version,
            'exact parent-path table encoding')
    prefixes, packed = tag['prefixes'], tag['rows']
    f9_need(type(prefixes) is list and len(prefixes) <= 40000
            and all(type(p) is str and p.startswith('/') and p.endswith('/')
                and '\x00' not in p and all(x not in ('.', '..') for x in p.split('/'))
                for p in prefixes)
            and prefixes == sorted(set(prefixes)), 'exact unique absolute parent prefixes')
    f9_need(type(packed) is list and len(packed) <= 40000, 'bounded complete packed table')
    rows = []
    for entry in packed:
        f9_need(type(entry) is list and len(entry) == 4, 'complete four-column row')
        index, name, size, digest = entry
        f9_need(type(index) is int and 0 <= index < len(prefixes)
                and type(name) is str and name not in ('', '.', '..') and '/' not in name,
                'nonboolean parent index and exact filename')
        rows.append(dict(path=prefixes[index]+name, bytes=size, sha256=digest))
    f9_rows(rows, 40000)
    logical = dict(wire); logical.pop(tag_name); logical[field] = rows
    size, digest = f9_image(logical)
    f9_need(type(tag['logical_bytes']) is int and tag['logical_bytes'] == size
            and tag['logical_sha256'] == digest, 'whole semantic Root-domain image')
    return logical


def f9_encode_domain(value):
    return f9_encode_table(value, 'inputs', _F9_DOMAIN_TAG, 'F009_PARENT_PATH_ROW_TABLE_V1')


def f9_expand_domain(value):
    return f9_expand_table(value, 'inputs', _F9_DOMAIN_TAG, 'F009_PARENT_PATH_ROW_TABLE_V1')


def f9_encode_closure(value):
    f9_need(type(value) is dict and value.get('schema') == 'ROOT_CLOSED_F009_STANDALONE_NATIVE_V1',
            'only the separately accepted Native closure role')
    return f9_encode_table(value, 'complete_actual_inputs', _F9_CLOSURE_TAG,
                           'F009_NATIVE_CLOSURE_ROW_TABLE_V1')


def f9_expand_closure(value):
    if type(value) is not dict or _F9_CLOSURE_TAG not in value:
        return value
    f9_need(value.get('schema') == 'ROOT_CLOSED_F009_STANDALONE_NATIVE_V1',
            'explicit accepted Native closure role')
    return f9_expand_table(value, 'complete_actual_inputs', _F9_CLOSURE_TAG,
                           'F009_NATIVE_CLOSURE_ROW_TABLE_V1')

_F9_DECLARED_TAG = 'Root_Declared_rows_reference'
_F9_REQUEST_TAG = 'Root_Request_rows_reference'
_F9_MANIFEST_TAG = 'Root_Output_manifest_reference'


def f9_encode_declared(value):
    return f9_encode_table(value, 'declared_inputs', _F9_DECLARED_TAG,
                           'F009_DECLARED_ROW_TABLE_V1')


def f9_expand_declared(value):
    return f9_expand_table(value, 'declared_inputs', _F9_DECLARED_TAG,
                           'F009_DECLARED_ROW_TABLE_V1')


def f9_request_limit(value):
    f9_need(type(value) is dict and value.get('schema') == 'LOCAL_SMALL_PYTHON_CHECK_V1'
            and type(value.get('provenance')) is dict
            and value['provenance'].get('role') in ('native', 'reader'),
            'explicit ordinary Owner request and retained role')
    return (8 if value['provenance']['role'] == 'native' else 16) * 2**20


def f9_encode_request(value):
    cap = f9_request_limit(value)
    f9_need(_F9_REQUEST_TAG not in value, 'encode one complete request once')
    rows = f9_rows(value['inputs'], 40000)
    prefixes = sorted({r['path'][:r['path'].rfind('/')+1] for r in rows})
    lookup = {p: i for i, p in enumerate(prefixes)}
    packed = []
    for row in rows:
        cut = row['path'].rfind('/')+1
        packed.append([lookup[row['path'][:cut]], row['path'][cut:],
                       row['bytes'], row['sha256']])
    raw = f9_canonical(value)
    f9_need(len(raw) <= cap, 'unchanged logical Native8MiB/Reader16MiB request')
    wire = dict(value); wire.pop('inputs')
    wire[_F9_REQUEST_TAG] = dict(schema='F009_OWNER_REQUEST_ROW_TABLE_V1',
        prefixes=prefixes, rows=packed, logical_bytes=len(raw),
        logical_sha256=hashlib.sha256(raw).hexdigest())
    f9_need(f9_expand_request(wire) == value, 'entire complete Owner request inverse')
    return wire


def f9_expand_request(wire):
    if type(wire) is not dict or _F9_REQUEST_TAG not in wire:
        return wire
    cap = f9_request_limit(wire)
    f9_need('inputs' not in wire, 'one explicit Owner request representation')
    tag = wire[_F9_REQUEST_TAG]
    f9_need(type(tag) is dict and set(tag) == {'schema', 'prefixes', 'rows',
            'logical_bytes', 'logical_sha256'}
            and tag['schema'] == 'F009_OWNER_REQUEST_ROW_TABLE_V1',
            'exact request table encoding')
    prefixes, packed = tag['prefixes'], tag['rows']
    f9_need(type(prefixes) is list and len(prefixes) <= 40000
            and prefixes == sorted(set(prefixes))
            and all(type(p) is str and p.startswith('/') and p.endswith('/')
                and '\x00' not in p and all(x not in ('.', '..') for x in p.split('/'))
                for p in prefixes), 'ordered exact absolute request parent prefixes')
    f9_need(type(packed) is list and len(packed) <= 40000,
            'bounded complete request rows')
    rows = []
    for entry in packed:
        f9_need(type(entry) is list and len(entry) == 4, 'complete four-column request row')
        index, name, size, digest = entry
        f9_need(type(index) is int and 0 <= index < len(prefixes)
                and type(name) is str and name not in ('', '.', '..') and '/' not in name,
                'nonboolean request parent index and exact filename')
        rows.append(dict(path=prefixes[index]+name, bytes=size, sha256=digest))
    f9_rows(rows, 40000)
    logical = dict(wire); logical.pop(_F9_REQUEST_TAG); logical['inputs'] = rows
    raw = f9_canonical(logical)
    f9_need(len(raw) <= cap and type(tag['logical_bytes']) is int
            and tag['logical_bytes'] == len(raw)
            and tag['logical_sha256'] == hashlib.sha256(raw).hexdigest(),
            'entire same canonical request; unchanged role-specific logical cap')
    return logical


def f9_output_bank(rows, directories):
    f9_rows(rows, 2048)
    f9_need(type(directories) is list and len(rows)+len(directories) <= 2049
            and all(type(d) is str and d.isascii() and len(d.encode('ascii')) <= 384
                and (d == '.' or (not d.startswith('/') and all(p not in ('', '.', '..')
                    for p in d.split('/')))) for d in directories)
            and directories == sorted(set(directories)) and '.' in directories,
            'complete bounded relative directories and root; same producer object allowance')
    f9_need(sum(r['bytes'] for r in rows) <= 16*2**20
            and all(len(f9_canonical(r)) <= 512 and r['path'].isascii()
                and len(r['path'].encode('ascii')) <= 384 for r in rows),
            'same complete Native output descriptor and byte bounds')
    return dict(schema='F009_COMPLETE_NATIVE_OUTPUT_ROWS_V1', files=rows, directories=directories)


def f9_encode_manifest(value, bank):
    f9_need(type(value) is dict and value.get('schema') ==
            'ROOT_F009_STANDALONE_CLOSED_OUTPUT_MANIFEST_V1'
            and _F9_MANIFEST_TAG not in value,
            'one complete logical output manifest')
    f9_rows([bank], 1)
    f9_need(bank['bytes'] <= 2*2**20, 'separately bounded complete output bank')
    f9_output_bank(value['files'], value['directories'])
    raw = f9_canonical(value); files = f9_canonical(value['files'])
    f9_need(len(raw) <= 2*2**20, 'finite whole logical output manifest')
    wire = dict(value); wire.pop('files'); wire.pop('directories')
    wire[_F9_MANIFEST_TAG] = dict(schema='F009_COMPLETE_OUTPUT_MANIFEST_BANK_V1',
        bank=bank, files_bytes=len(files), files_sha256=hashlib.sha256(files).hexdigest(),
        logical_bytes=len(raw), logical_sha256=hashlib.sha256(raw).hexdigest())
    return wire


def f9_expand_manifest(wire, read_bank):
    if type(wire) is not dict or _F9_MANIFEST_TAG not in wire:
        return wire
    f9_need(wire.get('schema') == 'ROOT_F009_STANDALONE_CLOSED_OUTPUT_MANIFEST_V1'
            and 'files' not in wire and 'directories' not in wire, 'one explicit output manifest representation')
    tag = wire[_F9_MANIFEST_TAG]
    f9_need(type(tag) is dict and set(tag) == {'schema', 'bank', 'files_bytes',
            'files_sha256', 'logical_bytes', 'logical_sha256'}
            and tag['schema'] == 'F009_COMPLETE_OUTPUT_MANIFEST_BANK_V1',
            'exact full output bank import')
    f9_rows([tag['bank']], 1)
    f9_need(tag['bank']['bytes'] <= 2*2**20, 'same finite whole bank role')
    # The caller must authenticate this exact whole physical bank first.
    value = read_bank(tag['bank'])
    f9_need(type(value) is dict and set(value) == {'schema', 'files', 'directories'}
            and value == f9_output_bank(value['files'], value['directories']), 'complete original bank shape')
    files = f9_canonical(value['files'])
    f9_need(type(tag['files_bytes']) is int and tag['files_bytes'] == len(files)
            and tag['files_sha256'] == hashlib.sha256(files).hexdigest(),
            'every exact complete output row in original order')
    logical = dict(wire); logical.pop(_F9_MANIFEST_TAG)
    logical['files'] = value['files']; logical['directories'] = value['directories']
    raw = f9_canonical(logical)
    f9_need(len(raw) <= 2*2**20 and type(tag['logical_bytes']) is int
            and tag['logical_bytes'] == len(raw)
            and tag['logical_sha256'] == hashlib.sha256(raw).hexdigest(),
            'whole original output manifest inverse, including every non-row field')
    return logical


def pack_main():
    ap = argparse.ArgumentParser(allow_abbrev=False)
    ap.add_argument('--input', nargs=2, required=True)
    ap.add_argument('--kind', choices=('job', 'native_closure', 'request'), required=True)
    ap.add_argument('--out', type=Path, required=True)
    ap.add_argument('--write', action='store_true')
    args = ap.parse_args()
    path = Path(args.input[0]); before = path.lstat()
    f9_need(path.resolve(strict=True) == path and stat.S_ISREG(before.st_mode)
            and before.st_nlink == 1 and before.st_size <= 8*2**20,
            'bounded immutable actual constructor job')
    with path.open('rb') as handle:
        opened = os.fstat(handle.fileno()); raw = handle.read(8*2**20+1)
        closed = os.fstat(handle.fileno())
    signature = lambda s: (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
    f9_need(signature(before) == signature(opened) == signature(closed) == signature(path.lstat())
            and len(raw) == before.st_size and hashlib.sha256(raw).hexdigest() == args.input[1],
            'complete stable actual raw parent identity')
    def pairs(items):
        result = {}
        for key, value in items:
            f9_need(key not in result, 'unique raw parent keys'); result[key] = value
        return result
    logical = json.loads(raw, object_pairs_hook=pairs,
        parse_constant=lambda _: (_ for _ in ()).throw(ValueError('finite JSON')))
    if args.kind == 'job':
        f9_need(_F9_SOURCE_TAG not in logical, 'encode a complete logical parent once')
        wire = f9_encode_job(logical); restored = f9_expand_job(wire)
        tag = wire[_F9_SOURCE_TAG]
    elif args.kind == 'request':
        f9_need(_F9_REQUEST_TAG not in logical, 'encode one complete logical Owner request')
        wire = f9_encode_request(logical); restored = f9_expand_request(wire)
        tag = wire[_F9_REQUEST_TAG]
    else:
        f9_need(_F9_CLOSURE_TAG not in logical, 'encode a complete closure once')
        wire = f9_encode_closure(logical); restored = f9_expand_closure(wire)
        tag = wire[_F9_CLOSURE_TAG]
    body = f9_canonical(wire)
    f9_need(len(body) <= 2*2**20 and restored == logical,
            'unchanged2MiB physical transport and exact complete inverse')
    out = args.out
    f9_need(out.is_absolute() and out.is_relative_to('/private/tmp')
            and '..' not in out.parts and out.parent.resolve(strict=True) == out.parent
            and not os.path.lexists(out), 'fresh ordinary temporary wire publication')
    if args.write:
        with out.open('xb') as handle:
            f9_need(handle.write(body) == len(body), 'whole exclusive wire publication')
            handle.flush(); os.fsync(handle.fileno())
        fd = os.open(out.parent, os.O_RDONLY)
        try: os.fsync(fd)
        finally: os.close(fd)
    print(json.dumps(dict(schema='F009_SOURCE_INDEX_JOB_DATA_PACKED_V1', written=args.write,
        actual_parent=dict(path=str(path), bytes=len(raw), sha256=args.input[1]),
        wire=dict(path=str(out), bytes=len(body), sha256=hashlib.sha256(body).hexdigest()),
        kind=args.kind,full_logical_canonical_bytes=tag['logical_bytes'],
        full_logical_canonical_sha256=tag['logical_sha256'],
        exact_source_rows=len(logical['source_inputs']) if args.kind=='job' else None,
        exact_declared_rows=len(logical['declared_inputs']) if args.kind=='job' else
            (len(logical['inputs']) if args.kind=='request' else len(logical['complete_actual_inputs'])),
        original_scientific_Source_or_Native_Reader_model_case_state_codec_calls=0,
        scientific_gate_or_checkpoint_authority=False), sort_keys=True))


if __name__ == '__main__':
    pack_main()
