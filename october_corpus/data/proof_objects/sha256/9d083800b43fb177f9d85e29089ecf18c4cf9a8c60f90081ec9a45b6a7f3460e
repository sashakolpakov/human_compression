from pathlib import Path
import gzip,hashlib,json
D=Path('/private/tmp/q11_large_end_spectrum/strict25_DATA');P=D.parent/'retained_imports'
def can(v):return(json.dumps(v,sort_keys=True,separators=(',',':'))+'\n').encode()
def ref(p):
 p=Path(p);b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
