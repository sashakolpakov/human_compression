class Meter:
    def __init__(self):self.units=0
    def charge(self,n,label):
        need(type(n)is int and n>=0 and n<=10000000-self.units,'generic shared10M units')
        bounded();self.units+=n

class DeliberateStop(Exception):pass

class FailWork(Meter):
    def __init__(self,label,ordinal):super().__init__();self.label=label;self.ordinal=ordinal;self.hits=0
    def charge(self,n,label):
        if label==self.label:
            self.hits+=1
            if self.hits==self.ordinal:raise DeliberateStop(label)
        super().charge(n,label)

def subject(pair):
    p=Path(pair[0]);a=p.lstat();need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
        and a.st_nlink==1 and a.st_size<=32768,'whole bounded ordinary Source subject')
    raw=p.read_bytes();need(hashlib.sha256(raw).hexdigest()==pair[1],'whole exact Source hash')
    return p,raw,dict(path=str(p),bytes=len(raw),sha256=pair[1])

