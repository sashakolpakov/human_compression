def descriptor(p,b):
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())


class HostIO:
    """Real control reads/writes; fixture fake I/O has a separate ledger."""
    def __init__(self):
        self.start=time.monotonic();self.read_bytes=0;self.new_bytes=0
        self.paths=set();self.opens=[];self.outputs=[];self.reserve=dict(bytes=0,read_bytes=0,paths=0)
    def budget(self):
        need(sys.platform=='darwin' and time.monotonic()-self.start<115
            and resource.getrusage(resource.RUSAGE_SELF).ru_maxrss<=256*2**20,
            'actual private CONTROL caller256MiB/115s under external125s guard')
    def path(self,p):
        self.paths.add(str(p));need(len(self.paths)+self.reserve['paths']<=512,'whole512-path control bank')
    def read(self,r):
        need(type(r)is dict and set(r)=={'path','bytes','sha256'}
            and type(r['bytes'])is int and 0<=r['bytes']<=4*2**20,'bounded exact control input')
        p=Path(r['path']);self.path(p);a=p.lstat()
        need(p.is_absolute() and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
            and a.st_nlink==1 and a.st_size==r['bytes'],'ordinary stable control input')
        need(self.read_bytes+self.reserve['read_bytes']+a.st_size<=64*2**20,'complete control64MiB read bank')
        with p.open('rb')as f:
            b=os.fstat(f.fileno());raw=f.read(a.st_size+1);c=os.fstat(f.fileno())
        sig=lambda z:(z.st_dev,z.st_ino,z.st_mode,z.st_nlink,z.st_size,z.st_mtime_ns,z.st_ctime_ns)
        need(sig(a)==sig(b)==sig(c)==sig(p.lstat()) and descriptor(p,raw)==r,'whole stable control bytes')
        self.read_bytes+=len(raw);self.opens.append(r);self.budget();return raw
    def doc(self,r):return json.loads(self.read(r))
    def write(self,p,b):
        need(p.is_relative_to(N) and p.parent.resolve(strict=True)==p.parent and not os.path.lexists(p),
            'control output in its fresh private namespace only')
        need(len(b)<=4*2**20 and self.new_bytes+self.reserve['bytes']+len(b)<=16*2**20,'whole16MiB control output bank')
        self.path(p)
        with p.open('xb')as f:
            need(f.write(b)==len(b),'whole control output');f.flush();os.fsync(f.fileno())
        self.new_bytes+=len(b);r=descriptor(p,b);self.outputs.append(r);return r


class MockIO:
    """Memory only: even fixture descriptors naming S never open S here."""
    def __init__(self,source):
        self.source=source;self.rows={};self.read_bytes=0;self.paths=set()
        self.read_calls=[];self.budget_calls=0;self.new_bytes=0
    def add(self,path,value,raw=False):
        body=value if raw else self.source['can'](value)
        row=descriptor(path,body);self.rows[str(path)]=body;return row
    def read(self,row,live=False):
        self.source['valid_ref'](row)
        body=self.rows[row['path']]
        need(self.source['equal'](descriptor(row['path'],body),row),'MOCK exact expected whole bytes')
        self.paths.add(row['path']);self.read_calls.append(copy.deepcopy(row));self.read_bytes+=len(body)
        return body
    def doc(self,row,live=False):return self.source['strict'](self.read(row,live=live))
    def budget(self):self.budget_calls+=1
    def fork(self):
        other=MockIO(self.source);other.rows=dict(self.rows);return other


