MIB = 2**20
START = time.monotonic()


def need(ok, why):
    if not ok:
        raise ValueError(why)


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                       ensure_ascii=True, allow_nan=False)+'\n').encode('ascii')


def strict(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            need(key not in out, 'unique metadata keys')
            out[key] = value
        return out
    return json.loads(raw, object_pairs_hook=pairs,
                      parse_constant=lambda _: (_ for _ in ()).throw(ValueError('finite JSON')))


def signature(s):
    return (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size,
            s.st_mtime_ns, s.st_ctime_ns)


def shape(ref):
    need(type(ref) is dict and set(ref) == {'path', 'bytes', 'sha256'}
         and type(ref['path']) is str and Path(ref['path']).is_absolute()
         and str(Path(os.path.normpath(ref['path']))) == ref['path']
         and type(ref['bytes']) is int and 0 <= ref['bytes'] <= 8*MIB
         and type(ref['sha256']) is str and len(ref['sha256']) == 64
         and set(ref['sha256']) <= set('0123456789abcdef'),
         'whole bounded metadata or Source descriptor')
    return ref


class Reads:
    def __init__(self):
        self.bytes = Path(__file__).stat().st_size
        need(self.bytes <= 65536, 'finite interpreter script bootstrap')
        self.refs = {}

    def tick(self):
        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
        if sys.platform != 'darwin':
            rss *= 1024
        need(rss < 256*MIB and time.monotonic()-START < 150,
             'metadata256MiB/150s envelope')

    def read(self, ref):
        shape(ref)
        self.tick()
        need(self.refs.get(ref['path'], ref) == ref, 'one current version per metadata path')
        need(self.bytes+ref['bytes'] <= 64*MIB
             and (ref['path'] in self.refs or len(self.refs) < 128),
             'bounded metadata-only128-file64MiB physical reads')
        p = Path(ref['path'])
        a = p.lstat()
        need(p.resolve(strict=True) == p and stat.S_ISREG(a.st_mode)
             and a.st_nlink == 1 and a.st_size == ref['bytes'],
             'ordinary canonical exact metadata/Source input')
        with p.open('rb') as stream:
            b = os.fstat(stream.fileno())
            raw = stream.read(ref['bytes']+1)
            c = os.fstat(stream.fileno())
        need(signature(a) == signature(b) == signature(c) == signature(p.lstat())
             and len(raw) == ref['bytes']
             and hashlib.sha256(raw).hexdigest() == ref['sha256'],
             'stable complete actual metadata/Source bytes')
        self.bytes += len(raw)
        self.refs[ref['path']] = ref
        return raw

    def observed(self, path):
        path = Path(path)
        a = path.lstat()
        need(path.is_absolute() and path.resolve(strict=True) == path
             and stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and a.st_size <= 2*MIB,
             'whole ordinary current metadata observation')
        # The first read is separately invoiced; the second authenticates the
        # complete observation against its computed descriptor.
        need(self.bytes+a.st_size <= 64*MIB, 'observation bytes before read')
        raw = path.read_bytes()
        need(signature(a) == signature(path.lstat()) and len(raw) == a.st_size,
             'stable complete metadata observation')
        self.bytes += len(raw)
        ref = dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
        need(self.read(ref) == raw, 'whole metadata observation independently rechecked')
        return ref, raw

    def doc(self, ref):
        return strict(self.read(ref))

    def recheck(self):
        for ref in list(self.refs.values()):
            self.read(ref)


def merge(*groups):
    by = {}
    for group in groups:
        for ref in group:
            need(type(ref) is dict and set(ref) == {'path', 'bytes', 'sha256'}
                 and type(ref['bytes']) is int and ref['bytes'] >= 0,
                 'whole retained descriptor row')
            need(by.get(ref['path'], ref) == ref, 'no conflicting input identity')
            by[ref['path']] = ref
    result = [by[p] for p in sorted(by)]
    need(len(result) <= 40000 and sum(r['bytes'] for r in result) <= 2**31,
         'unchanged full40000-row2GiB descriptor domain')
    return result


def reference(pair):
    p = Path(pair[0])
    return shape(dict(path=str(p), bytes=p.stat().st_size, sha256=pair[1]))


