            with (out/name).open('xb') as stream:
                need(stream.write(raw) == len(raw), 'whole exclusive DATA publication')
                stream.flush()
                os.fsync(stream.fileno())
        for directory in (out, out.parent):
            fd = os.open(directory, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
