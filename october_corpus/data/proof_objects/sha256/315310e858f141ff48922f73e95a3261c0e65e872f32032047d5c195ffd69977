def body(p):
    p = Path(p)
    b = p.read_bytes()
    r = {'path': str(p), 'bytes': len(b), 'sha256': hashlib.sha256(b).hexdigest()}
    old = read_log.setdefault(str(p), {'reference': r, 'reads': 0})
    assert old['reference'] == r, 'input changed during this metadata audit'
    old['reads'] += 1
    return b

def ref(p):
    body(p)
    return read_log[str(Path(p))]['reference']

def doc(p):
    return json.loads(body(p))

def verify(r):
    actual = ref(r['path'])
    assert all(actual[k] == r[k] for k in ('path', 'bytes', 'sha256')), r
    return actual

def canonical(v):
    return json.dumps(v, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode()

def runs(v):
    out = []
    for x in v:
        if out and out[-1][1] + 1 == x:
            out[-1][1] = x
        else:
            out.append([x, x])
    return out

def write(name, value):
    b = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True) + '\n').encode()
    p = T / name
    with p.open('xb') as f:
        f.write(b)
    return {'path': str(p), 'bytes': len(b), 'sha256': hashlib.sha256(b).hexdigest()}

