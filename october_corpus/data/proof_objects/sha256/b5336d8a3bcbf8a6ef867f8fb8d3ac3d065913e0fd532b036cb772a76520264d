def root_pin_text(contract, ref, name, kind=None):
    import ast
    raw=contract.source_text(ref)
    wanted=ast.FunctionDef if kind is None else kind
    nodes=[n for n in ast.parse(raw,filename=ref['path']).body if isinstance(n,wanted)and n.name==name]
    need(len(nodes)==1,'one exact whole retained definition for private pin storage')
    return ast.get_source_segment(raw,nodes[0])

def root_pin_edit(before, old, new):
    need(before.count(old)==1 and new not in before,'one exact private allocation/provider site')
    after=before.replace(old,new,1)
    need(after.replace(new,old,1)==before,'whole retained definition inverse')
    return after

def root_pin_rebind(original, replacements):
    """Same literal code/defaults/closure; only named private providers differ."""
    need(type(original)is types.FunctionType,'actual retained function provider')
    old=original.__globals__;private=dict(old)
    need(set(replacements)<=set(old),'replace only explicitly existing provider globals')
    private.update(replacements)
    result=types.FunctionType(original.__code__,private,original.__name__,original.__defaults__,original.__closure__)
    result.__kwdefaults__=original.__kwdefaults__;result.__annotations__=original.__annotations__
    result.__qualname__=original.__qualname__;result.__dict__.update(original.__dict__)
    need(result.__code__ is original.__code__ and result.__defaults__ is original.__defaults__
         and result.__closure__ is original.__closure__
         and all(private[k]is v for k,v in old.items()if k not in replacements),
         'literal function code and every unmodified provider identity')
    return result

def root_pin_expand(contract, codec, value, *, envelope):
    """Only dict allocation changes; index(pins,i) still validates EVERY call.

    The original whole pin_shape pass, logical size guard, complete raw LF
    authentication, reference fields, typed inverse and canonical compact
    equality are literal. Shared pin dictionaries are read-only here and in
    the retained Native chain. No occurrence/leaf dictionary is deduplicated.
    """
    need(Path(codec.__file__)==Path(ROOT_PIN_CODEC['path'])
         and codec.expand.__globals__ is vars(codec)
         and codec.expand.__code__.co_filename==ROOT_PIN_CODEC['path'],
         'the actual acquired original codec/provider, not a supplied decoder')
    original=codec.expand
    before=root_pin_text(contract,ROOT_PIN_CODEC,'expand')
    after=root_pin_edit(before,ROOT_PIN_BEFORE,ROOT_PIN_AFTER)
    private=dict(vars(codec))
    exec(compile(after,str(Path(__file__).resolve())+'::private_pin_expand','exec',dont_inherit=True),private)
    current=private['expand']
    need(current.__globals__ is private and all(private[k]is v for k,v in vars(codec).items()if k!='expand'),
         'all helpers, original START, limits and physical registry remain the original objects')
    try:
        result=current(value,envelope=envelope)
        need(codec.expand is original,'original imported expand never replaced')
        return result
    finally:
        # expand is nonrecursive; remove only the new private self-binding.
        private.pop('expand',None)

def root_pin_accessor(contract, accessor):
    """Fresh private class/providers; no imported accessor binding is assigned."""
    import ast
    need(isinstance(accessor,types.ModuleType)and Path(accessor.__file__)==Path(ROOT_PIN_ACCESSOR['path'])
         and accessor.load_direct.__globals__ is vars(accessor)
         and accessor.segment_class.__globals__ is vars(accessor),
         'actual retained accessor definitions and original module globals')
    old_load=accessor.load_direct;old_class=accessor.Admission;old_segment=accessor.segment_class
    before=root_pin_text(contract,ROOT_PIN_ACCESSOR,'load_direct')
    after=root_pin_edit(before,"state=c.expand(value['state'],envelope=envelope)",
        "state=ROOT_PRIVATE_PIN_EXPAND(c,value['state'],envelope=envelope)")
    namespace=dict(vars(accessor))
    need('ROOT_PRIVATE_PIN_EXPAND'not in namespace,'fresh private decoder binding')
    namespace['ROOT_PRIVATE_PIN_EXPAND']=lambda codec,value,**kw:root_pin_expand(contract,codec,value,**kw)
    exec(compile(after,str(Path(__file__).resolve())+'::private_load_direct','exec',dont_inherit=True),namespace)
    new_load=namespace['load_direct']
    # The Admission class body is byte literal. Its load_direct global alone
    # differs; ordinary parts/method/check and all acquisition predicates stay.
    class_before=root_pin_text(contract,ROOT_PIN_ACCESSOR,'Admission',ast.ClassDef)
    exec(compile(class_before,ROOT_PIN_ACCESSOR['path'],'exec',dont_inherit=True),namespace)
    new_class=namespace['Admission']
    # segment_class code is unchanged. Its freshly constructed Admission is
    # the sole different provider. Its returned original-named Segment keeps
    # the genuine runtime Source, slots, AUTHENTICATED checks and owned chain.
    new_segment=root_pin_rebind(old_segment,{'Admission':new_class})
    facade=types.SimpleNamespace(**vars(accessor))
    facade.Admission=new_class;facade.load_direct=new_load;facade.segment_class=new_segment
    need(new_class.acquire_base.__globals__ is namespace
         and new_class.acquire_base.__globals__['load_direct']is new_load
         and new_segment.__globals__['Admission']is new_class
         and accessor.Admission is old_class and accessor.load_direct is old_load
         and accessor.segment_class is old_segment,
         'complete private provider chain and every original accessor binding untouched')
    return facade

def root_pin_profile(contract, entry, application):
    need(Path(entry.__file__)==Path(ROOT_PIN_ENTRY['path'])
         and entry.profile_bind.__globals__ is vars(entry)
         and entry.profile_bind.__code__.co_filename==ROOT_PIN_ENTRY['path'],
         'same exact retained materialized profile provider')
    original=entry.profile_bind
    before=root_pin_text(contract,ROOT_PIN_ENTRY,'profile_bind')
    after=root_pin_edit(before,'CURRENT_ACCESSOR=A,','CURRENT_ACCESSOR=ROOT_PRIVATE_PIN_ACCESSOR(A),')
    private=dict(vars(entry));need('ROOT_PRIVATE_PIN_ACCESSOR'not in private,'fresh private profile accessor')
    private['ROOT_PRIVATE_PIN_ACCESSOR']=lambda accessor:root_pin_accessor(contract,accessor)
    exec(compile(after,str(Path(__file__).resolve())+'::private_profile_bind','exec',dont_inherit=True),private)
    current=private['profile_bind']
    need(all(private[k]is v for k,v in vars(entry).items()if k!='profile_bind'),
         'all original entry helpers and namespaces preserved')
    try:
        result=current(application)
        need(entry.profile_bind is original,'original imported profile_bind never replaced')
        return result
    finally:private.pop('profile_bind',None);private.pop('ROOT_PRIVATE_PIN_ACCESSOR',None)

def root_pin_sharing_route(contract, route, plan):
    """Count-neutral Native caller seam; Reader and IO routes stay identical."""
    need(plan['role']=='native'and plan['library_adapter']==ROOT_PIN_ADAPTER
         and Path(route.__file__)==Path(ROOT_PIN_ADAPTER['path'])
         and route.native.__globals__ is vars(route)
         and route.native.__code__.co_filename==ROOT_PIN_ADAPTER['path'],
         'only this exact paid Native workspace adapter and genuine Root job')
    original=route.native
    before=root_pin_text(contract,ROOT_PIN_ADAPTER,'native')
    after=root_pin_edit(before,'old,run=module.profile_bind(application)',
        'old,run=ROOT_PRIVATE_PIN_PROFILE(contract,module,application)')
    private=dict(vars(route));need('ROOT_PRIVATE_PIN_PROFILE'not in private,'fresh Native provider namespace')
    private['ROOT_PRIVATE_PIN_PROFILE']=root_pin_profile
    exec(compile(after,str(Path(__file__).resolve())+'::private_native','exec',dont_inherit=True),private)
    current=private['native'];facade=types.SimpleNamespace(**vars(route));facade.native=current
    need(facade.reader is route.reader and facade.io_budget is route.io_budget
         and route.native is original
         and all(private[k]is v for k,v in vars(route).items()if k!='native'),
         'only private Native profile provider changes; paid635a module and Reader/IO stay untouched')
    return facade

