def change(bank, path, after, patches, allow_absent=False):
    target = parent(bank,path)
    key = path[-1]
    need(type(target) is dict and (key in target or allow_absent), 'existing exact alias or declared new batch leaf')
    patch = dict(path=path,before_present=key in target,after_present=True,
                 before=copy.deepcopy(target.get(key)),after=copy.deepcopy(after))
    patches.append(patch)
    target[key] = copy.deepcopy(after)


def inverse(before, after, patches):
    restored = copy.deepcopy(after)
    paths = [tuple(p['path']) for p in patches]
    need(len(set(paths)) == len(paths), 'unique exact allowed change paths')
    for a in paths:
        for b in paths:
            need(a == b or not (len(a)<len(b) and b[:len(a)] == a), 'no overlapping alias paths')
    for patch in reversed(patches):
        target = parent(restored,patch['path'])
        key = patch['path'][-1]
        need(equal(target[key],patch['after']), 'exact full planned typed patch')
        if patch['before_present']:
            target[key] = copy.deepcopy(patch['before'])
        else:
            del target[key]
    need(equal(restored,before), 'whole exact typed inverse preserves EVERY unrelated/unknown/history value')


