           'Continue only current q11 latest pending register rank4 jobs; preserve accepted model/domain/classification premises. '
           'Do not rerun any of33 proved rank5 jobs. Complete q8/q11 field assembly and Aut/duality/tables.',changes['STATUS'])
    change(banks['STATUS'],['root_intake_batch_status'],
           '102/105 complete; F004,F009,L026 remain. F004: use current q8/q11 ledgers; q8 field assembly and '
           'q11 pending rank4/field assembly remain. F009: continue CURRENT.F009_checkpoint_current without '
           'replaying known passes. L026: use current paid coverage selectors. Complete all105, then STOP before measurement/Lean.',changes['STATUS'])
    old_actions=at(documents['STATUS'],['root_status_update_current','next_actions'])
    need(type(old_actions) is list and all(type(x) is str for x in old_actions), 'whole prior actions list')
    change(banks['STATUS'],['root_status_update_current','prior_next_actions_closed40_history'],
           dict(utc=documents['STATUS']['root_status_update_current']['utc'],next_actions=old_actions),
           changes['STATUS'],allow_absent=True)
    actions=['F004: follow F004_q11_latest_ledger pending rank4 register and current q8 ledger; finish field assembly/Aut/duality/tables.',
             'F009: continue CURRENT.F009_checkpoint_current; preserve accepted pending scope and do not replay known passes.',
             'L026: continue only unpaid current paid-ledger/coverage selector scopes.',
             'Complete all105 reviewed Originals, then STOP before measurement or Lean.']
    change(banks['STATUS'],['root_status_update_current','next_actions'],actions,changes['STATUS'])
    audit=at(documents['STATUS'],['root_goal_turn_audit_current'])
    change(banks['STATUS'],['root_goal_turn_audit_current','prior_qualification_closed40_history'],
           dict(utc=audit['utc'],qualification=audit['qualification']),changes['STATUS'],allow_absent=True)
    change(banks['STATUS'],['root_goal_turn_audit_current','qualification'],
           'The preceding dated proof context is retained in prior_qualification_closed40_history. Active F004/F009/L026 '
           'work follows current accepted ledgers and checkpoint;102/105 complete. Complete all105, then STOP before measurement/Lean.',changes['STATUS'])
    for name in banks:
        inverse(documents[name],banks[name],changes[name])
    idle(banks['CURRENT'],banks['STATUS'])
    need(equal(banks['CURRENT']['F004_q11_latest_ledger'],banks['STATUS']['F004_q11_latest_ledger']),
         'both complete new q11 ledger aliases agree')
    return banks,changes


def publication(io, plan, plan_ref, method, index, documents, raws, remaining):
    out = Path(plan['output_directory'])
    need(out.is_absolute() and out.is_relative_to(R/'runs') and not os.path.lexists(out)
         and out.parent.resolve(strict=True) == out.parent, 'fresh exact installed transaction namespace')
    blobs = {}
    refs = {}
    def add(role, name, value, raw=False):
        body = value if raw else can(value)
        need(len(body) <= LIMITS['file_bytes'], 'whole individual publication <=4MiB')
        blobs[name] = body
        refs[role] = ref(out/name,body)
        return refs[role]
    add('before_CURRENT','CURRENT.before.json',raws['CURRENT'],True)
    add('before_STATUS','STATUS.before.json',raws['STATUS'],True)
    pending_ref = add('pending','proposed_pending.json',remaining)
    need(pending_ref['bytes'] == 1196 and pending_ref['sha256'] == plan['proposed_pending_DATA']['sha256'],
         'exact installed pending1196/fc8377 bytes')
    registration = dict(schema='ROOT_F004_Q11_EXISTING_CLOSED40_TYPED_REGISTRATION_V1',
        root=ROOT,registrar=ROOT,method=method,proof_kind=KIND,
        Root_closure_import=plan['Root_closure_import'],closure_index=plan['closure_index'],
        complete_job_records=index['rows'],old_pending=plan['old_pending'],new_pending=pending_ref,
        ordered_removed_jobs=JOBS,added_jobs=[],required=272,closed_before=75,closed_after=115,
        pending_before=197,pending_after=157,remaining_by_rank={'4':157,'5':0},
        source_author=AUTHOR,Source_release=plan['Source_release'],before_live_roles=plan['before'],
        operational_commit_requires_separate_CAS_receipt=True,
        all_old_proof_actors_methods_scopes_preserved=True,scientific_replays=0,
        whole_Original_manuscript_conjecture_measurement_Lean_credit=0)
    record_ref = add('registration','root_closed40_registration.json',registration)
    banks,patches = replacements(documents,pending_ref,record_ref,plan['Root_closure_import'])
    add('inverse','whole_alias_inverse.json',dict(schema='F004_CLOSED40_WHOLE_TYPED_ALIAS_INVERSE_V1',
         before=plan['before'],patches=patches,complete_unrelated_values_preserved=True,
         old_single_job_proof_methods_and_unknown_alias_keys_preserved=True))
    add('planned_pair','complete_planned_state_pair.json',dict(
        schema='F004_CLOSED40_COMPLETE_PLANNED_STATE_PAIR_V1',CURRENT=banks['CURRENT'],STATUS=banks['STATUS']))
    state_raws = {k:can(v) for k,v in banks.items()}
    state_refs = {k:ref(CURRENT if k=='CURRENT' else STATUS,v) for k,v in state_raws.items()}
    need(equal(state_refs,plan['planned_states']), 'exact whole reviewed planned pair, still uncommitted')
    add('PREPARED','state_transaction_PREPARED.json',dict(
        schema='ROOT_F004_CLOSED40_PREPARED_SEQUENTIAL_CAS_V1',root=ROOT,phase='PREPARED',
        method=method,plan=plan_ref,Source_release=plan['Source_release'],
        before_live_roles=plan['before'],before_archives={k:refs['before_'+k] for k in banks},
        complete_planned_state_pair=refs['planned_pair'],planned_states=state_refs,
        inverse=refs['inverse'],registration=record_ref,pending=pending_ref,
        stage_paths=[str(p.with_name(p.name+STAGE_SUFFIX)) for p in (CURRENT,STATUS)],
        pair_crash_atomic=False,automatic_retry_cleanup_or_rollback=False,
        interrupted_commit_requires_Root_inspection=True))
    # Include complete future receipt reserve and wrappers BEFORE any mkdir/write.
    overhead = plan['guard_and_recorder_return_reserve']
    need(type(overhead) is dict and type(overhead.get('bytes')) is int
         and 0 <= overhead['bytes'] <= 2*MIB and type(overhead.get('paths')) is int
         and 0 <= overhead['paths'] <= 32 and type(overhead.get('read_bytes')) is int
         and 0 <= overhead['read_bytes'] <= 16*MIB
         and type(overhead.get('source_bootstrap_bytes')) is int
         and 0 <= overhead['source_bootstrap_bytes'] <= overhead['read_bytes'],
         'one actual wrapper output/read/Source-bootstrap reserve')
    output_bytes = sum(map(len,blobs.values())) + sum(map(len,state_raws.values()))
    # Receipt/read budget is a bound; every actual output verification is charged again by IO.
    need(output_bytes + 65536 + overhead['bytes'] <= LIMITS['new_bytes'],
         'entire before/planned/registration/inverse/PREPARED/stages/commit/wrappers <=16MiB')
    need(io.read_bytes + output_bytes + 65536 + overhead['bytes'] + overhead['read_bytes']
         + 2*sum(len(x) for x in raws.values())
         + 3*sum(r['bytes'] for r in plan['protected_progress'])
         + sum(len(x) for x in state_raws.values()) <= LIMITS['read_bytes'],
         'all actual output reopens, both finalCAS, after reads and final protected checks prepaid')
    need(len(io.paths)+len(blobs)+2+1+1+2*len(OLD_STAGE_SUFFIXES+(STAGE_SUFFIX,))
         +overhead['paths'] <= LIMITS['paths'],
         'single complete input/output/stage/wrapper512-path bank')
    return out,blobs,refs,banks,state_raws,state_refs,output_bytes


def run(args):
    io = IO()
    need(args.actor == ROOT and sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode
         and not sys.flags.optimize and Path(__file__).resolve() == R/'register_closed40.py',
         'Root-only installed own -E -B -S Source; unselected /private/tmp file cannot activate')
    need(not any(os.environ.get(k) for k in ('PYTHONSTARTUP','PYTHONPATH',
        'COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG','OPENSSL_CONF','OPENSSL_MODULES')),
        'injection environment cleared')
    method = valid_ref(dict(path=str(R/'register_closed40.py'),bytes=args.source_bytes,sha256=args.self_sha256))
    need(method['bytes'] <= LIMITS['source_bytes'], 'new functional Source <64KiB')
    io.charge_path(method['path'])
    io.read_bytes += method['bytes']  # Python's initial whole Source bootstrap, in addition to self-pin below.
    io.opens += 1
    io.read(method)
    plan_ref = valid_ref(dict(path=args.plan,bytes=args.plan_bytes,sha256=args.plan_sha256))
    plan = io.doc(plan_ref)
    need(plan.get('schema') == 'ROOT_F004_CLOSED40_LIVE_METADATA_CAS_PLAN_V1'
         and plan.get('root') == ROOT and plan.get('bound_after_CP11262') is True
         and plan.get('proof_kind') == KIND and equal(plan.get('method'),method)
         and equal(plan.get('limits'),LIMITS), 'fresh Root post-CP11262 exact batch plan')
    source_admission(io,plan,method,plan['Source_release'])
    runtime(io,plan,method)
    index = accepted(io,plan)
    _,remaining = pending(io,plan)
    protected(io,plan)
    documents,raws = state_pair(io,plan['before'])
    overview_import(io,plan,documents)
    need(equal(documents['CURRENT']['F004_q11_latest_ledger'],documents['STATUS']['F004_q11_latest_ledger']),
         'coherent actual registered q11 before ledger')
    q11 = documents['CURRENT']['F004_q11_latest_ledger']
    need(type(q11.get('closed')) is int and q11['closed'] == 75
         and type(q11.get('pending')) is int and q11['pending'] == 197
         and q11.get('required') == 272 and equal(q11.get('pending_file'),plan['old_pending']),
         'actual75/197/272 registration and exact old pending')
    for name in documents:
        q8 = documents[name]['F004_q8_latest_ledger']
        need(equal(q8.get('closed'),686) and equal(q8.get('required'),686)
             and equal(q8.get('pending'),0),
             'actual already complete q8 preserved, no old fixed q8 boundary')
    for name in documents:
        archived = io.read(plan['whole_before_archives'][name])
        need(archived == raws[name], 'exact fresh whole before archive matches live observation')
    out,blobs,refs,banks,state_raws,state_refs,output_bytes = publication(
        io,plan,plan_ref,method,index,documents,raws,remaining)
    if args.mode == 'forecast':
        observed,_ = state_pair(io,plan['before'])
        need(equal(observed,documents), 'both unchanged complete forecast states')
        protected(io,plan)
        io.budget()
        print(can(dict(status='VERIFIED_F004_CLOSED40_METADATA_FORECAST_ONLY',
              actual_registration=False,read_bytes=io.read_bytes,unique_paths=len(io.paths),
              complete_new_byte_bound=output_bytes+65536+plan['guard_and_recorder_return_reserve']['bytes'],
              closed_after_IF_Root_adopts=115,pending_after_IF_Root_adopts=157,
              scientific_replays=0,whole_Original_credit=0)).decode(),end='')
        return
    stages = [(path,path.with_name(path.name+STAGE_SUFFIX)) for path in (CURRENT,STATUS)]
    orphan_paths = [p.with_name(p.name+s) for p in (CURRENT,STATUS)
                    for s in OLD_STAGE_SUFFIXES+(STAGE_SUFFIX,)]
    for path in orphan_paths:
        io.charge_path(path)
    need(all(not os.path.lexists(p) for p in orphan_paths), 'no own or known predecessor orphan stage; no cleanup')
    lock_before = LOCK.lstat()
    need(LOCK.resolve(strict=True) == LOCK and stat.S_ISREG(lock_before.st_mode)
         and lock_before.st_nlink == 1, 'existing stable ordinary Root lock')
    io.charge_path(LOCK)
    with LOCK.open('r+') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        opened = os.fstat(lock.fileno())
        need((opened.st_dev,opened.st_ino) == (lock_before.st_dev,lock_before.st_ino)
             == (LOCK.lstat().st_dev,LOCK.lstat().st_ino), 'same opened stable Root lock')
        locked,_ = state_pair(io,plan['before'])
        need(equal(locked,documents), 'whole locked states exactly equal authenticated before')
        protected(io,plan)
        out.mkdir()
        for name,body in blobs.items():
            io.write(out/name,body)
        sync(out)
        sync(out.parent)
        for (path,stage),name in zip(stages,('CURRENT','STATUS')):
            io.write(stage,state_raws[name])
        immediate,_ = state_pair(io,plan['before'])
        need(equal(immediate,documents), 'fresh BOTH CAS immediately before first replace')
        protected(io,plan)
        io.budget()
        need((LOCK.lstat().st_dev,LOCK.lstat().st_ino) == (opened.st_dev,opened.st_ino),
             'stable Root lock at immediate commit')
        for path,stage in stages:
            os.replace(stage,path)
            sync(path.parent)
        after,_ = state_pair(io,state_refs)
        need(equal(after,banks), 'whole actual committed pair equals both plans')
        protected(io,plan)
        receipt = dict(schema='ROOT_F004_CLOSED40_COMMITTED_SEQUENTIAL_CAS_V1',root=ROOT,
            committed=True,method=method,plan=plan_ref,prepared=refs['PREPARED'],
            registration=refs['registration'],pending=refs['pending'],
            before=plan['before'],after=state_refs,ordered_removed_jobs=JOBS,
            required=272,closed=115,pending_count=157,remaining_by_rank={'4':157,'5':0},
            four_idle_arrays=True,whole_typed_inverse=True,pair_crash_atomic=False,
            automatic_retry_cleanup_or_rollback=False,all_old_proof_history_retained=True,
            q8_F009_L026_ownership_and_all_unrelated_values_preserved=True,
            actual_read_bytes_before_receipt=io.read_bytes,actual_new_bytes_before_receipt=io.new_bytes,
            scientific_replays=0,whole_Original_manuscript_conjecture_measurement_Lean_credit=0)
        body = can(receipt)
        need(len(body) <= 65536, 'complete prepaid commit receipt')
        committed = io.write(out/'state_transaction_COMMITTED.json',body)
        sync(out)
        io.budget()
    print(can(dict(status='ROOT_REGISTERED_F004_Q11_FORTY_EXISTING_CLOSURES',
          committed=committed,registration=refs['registration'],pending=refs['pending'],
          required=272,closed=115,pending_count=157,actual_read_bytes=io.read_bytes,
          actual_new_bytes=io.new_bytes,unique_paths=len(io.paths),
          scientific_replays=0,whole_Original_credit=0)).decode(),end='')


def main():
    ap = argparse.ArgumentParser(allow_abbrev=False)
    ap.add_argument('--actor',required=True)
    ap.add_argument('--mode',choices=('forecast','adopt'),required=True)
    ap.add_argument('--self-sha256',required=True)
    ap.add_argument('--source-bytes',required=True,type=int)
    ap.add_argument('--plan',required=True)
    ap.add_argument('--plan-sha256',required=True)
    ap.add_argument('--plan-bytes',required=True,type=int)
    run(ap.parse_args())


if __name__ == '__main__':
    main()
