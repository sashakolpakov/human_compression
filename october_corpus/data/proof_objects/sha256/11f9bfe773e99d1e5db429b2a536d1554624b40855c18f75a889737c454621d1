def need(ok, why):
    if not ok:
        raise ValueError(why)


def can(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                       ensure_ascii=True, allow_nan=False) + '\n').encode()


def equal(a, b):
    if type(a) is not type(b):
        return False
    if type(a) is dict:
        return a.keys() == b.keys() and all(equal(a[k], b[k]) for k in a)
    if type(a) is list:
        return len(a) == len(b) and all(equal(x,y) for x,y in zip(a,b))
    return a == b


def strict(raw):
    def pairs(rows):
        out = {}
        for key, value in rows:
            need(key not in out, 'duplicate JSON key')
            out[key] = value
        return out
    def bad(value):
        raise ValueError('nonfinite JSON token: ' + value)
    return json.loads(raw.decode('utf-8'), object_pairs_hook=pairs,
                      parse_constant=bad)


def ref(path, raw):
    return dict(path=str(path), bytes=len(raw),
                sha256=hashlib.sha256(raw).hexdigest())


def valid_ref(row):
    need(type(row) is dict and set(row) == {'path','bytes','sha256'}
         and type(row['path']) is str and Path(row['path']).is_absolute()
         and type(row['bytes']) is int and 0 <= row['bytes'] <= LIMITS['file_bytes']
         and type(row['sha256']) is str and len(row['sha256']) == 64
         and all(c in '0123456789abcdef' for c in row['sha256']),
         'complete bounded path/bytes/sha256 descriptor')
    return row


def signature(s):
    return (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,
            s.st_mtime_ns,s.st_ctime_ns)


class IO:
    """Count every explicit read/open and new byte; no hidden recheck bank."""
    def __init__(self):
        self.start = time.monotonic()
        self.read_bytes = 0
        self.new_bytes = 0
        self.paths = set()
        self.opens = 0
        self.writes = 0
        self.read_versions = {}

    def budget(self):
        need(sys.platform == 'darwin'
             and time.monotonic()-self.start <= LIMITS['internal_seconds']
             and resource.getrusage(resource.RUSAGE_SELF).ru_maxrss <= LIMITS['rss_bytes'],
             'Darwin metadata caller <=256MiB/115s; actual guard125s separately required')

    def charge_path(self, path):
        self.paths.add(str(path))
        need(len(self.paths) <= LIMITS['paths'], 'single complete512-path bank')

    def read(self, row, live=False):
        valid_ref(row)
        path = Path(row['path'])
        need(path.resolve(strict=True) == path, 'no symlink or noncanonical input')
        a = path.lstat()
        need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1
             and a.st_size == row['bytes'], 'ordinary single-link bounded whole input')
        self.charge_path(path)
        need(self.read_bytes + a.st_size <= LIMITS['read_bytes'], 'single64MiB actual read bank')
        self.read_bytes += a.st_size
        self.opens += 1
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            b = os.fstat(fd)
            chunks = []
            left = a.st_size
            while left:
                block = os.read(fd, min(left, 65536))
                need(bool(block), 'no short whole input')
                chunks.append(block)
                left -= len(block)
            need(os.read(fd, 1) == b'', 'no growing whole input')
            c = os.fstat(fd)
        finally:
            os.close(fd)
        raw = b''.join(chunks)
        need(signature(a) == signature(b) == signature(c) == signature(path.lstat())
             and equal(ref(path,raw),row), 'whole stable expected input bytes')
        if not live:
            prior = self.read_versions.setdefault(str(path), row)
            need(equal(prior,row), 'one immutable version per path')
        self.budget()
        return raw

    def doc(self, row, live=False):
        return strict(self.read(row, live=live))

    def write(self, path, raw):
        need(type(raw) is bytes and len(raw) <= LIMITS['file_bytes']
             and self.new_bytes + len(raw) <= LIMITS['new_bytes'],
             'whole <=4MiB output in same complete16MiB new bank')
        need(path.parent.resolve(strict=True) == path.parent
             and not os.path.lexists(path), 'fresh ordinary-parent output')
        self.charge_path(path)
        self.new_bytes += len(raw)
        self.writes += 1
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            done = 0
            while done < len(raw):
                n = os.write(fd, raw[done:])
                need(n > 0, 'whole output write')
                done += n
            os.fsync(fd)
        finally:
            os.close(fd)
        row = ref(path,raw)
        self.read(row)
        return row


def sync(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


