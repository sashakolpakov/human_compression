def fixed_line(y,budget):
    equations=[[(y[i][j]-int(i==j))%11 for i in range(7)]for j in range(7)]
    need(rank(equations,budget)==6,'independent exact rank6 pure prime fixed space')
    work=[row[:]for row in equations];pivots=[]
    for col in range(7):
        chosen=next((i for i in range(len(pivots),7)if work[i][col]),None)
        if chosen is None:continue
        k=len(pivots);work[k],work[chosen]=work[chosen],work[k]
        inverse=pow(work[k][col],9,11);work[k]=[x*inverse%11 for x in work[k]]
        for i in range(7):
