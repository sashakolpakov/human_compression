def schedule():
    """Exact old three-mark160-step rule, not the interval rule."""
    state,last,letters = 17,0,[]
    for i in range(1,161):
        state = (1103515245*state+12345) % 2147483648
        k = 1+(state//65536)%4
        if (last,k) in ((1,2),(2,1),(3,4),(4,3)): k = ((k+1)%4)+1
        letters.append(str(k)); last = k
    return tuple(''.join(letters[:i]) for i in range(4,161,4))

def expand_legacy(text):
    need(type(text)is str and 1<=len(text)<=160 and all(x in'1234'for x in text),
        'literal old rotation-letter word')
    return ''.join({'1':'01','2':'10','3':'12','4':'21'}[x]for x in text)

def free_product_form(text):
    """C2*V4 normal form uses only the actual end involution/V4 relations."""
    need(type(text)is str and all(x in'012'for x in text),'literal three involution marks')
    out=[]
    for letter in text:
        value={'0':1,'1':0,'2':2}[letter]
        if out and (out[-1]==0)==(value==0):
            previous=out.pop()
            if value!=0 and previous^value:out.append(previous^value)
        else:out.append(value)
    return tuple(out)

def new_dictionary():
    seen={free_product_form(expand_legacy(text))for text in schedule()}
    result=[];raw_count=0
    for size in range(1,5):
        for number in range(3**size):
            digits=[];rest=number
            for unused in range(size):digits.append(rest%3);rest//=3
            digits.reverse();raw_count+=1
            text=''.join('1'+('0','2','02')[x]for x in digits)
            key=free_product_form(text)
            if key in seen:continue
            seen.add(key)
            result.append(dict(raw_index=raw_count,syllables=[x+1 for x in digits],word=text))
    need(raw_count==120 and len(result)<=120,'fixed finite120 raw choices, no adaptive restart')
    return result

