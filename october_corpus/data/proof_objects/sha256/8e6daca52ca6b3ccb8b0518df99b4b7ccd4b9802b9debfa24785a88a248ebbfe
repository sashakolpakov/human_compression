      parse_constant=lambda _:(_ for _ in()).throw(ValueError('finite JSON'))))

def reader_job_doc(ref):
    # This is a job-role reader, not a larger generic metadata parser.
    need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}
         and type(ref['bytes'])is int and 0<=ref['bytes']<=8*MIB,
         'existing8MiB actual Reader job role before allocation')
    need(pin(ref['path'])==ref,'whole exact actual Reader job identity')
    raw=Path(ref['path']).read_bytes()
    need(len(raw)==ref['bytes']and hashlib.sha256(raw).hexdigest()==ref['sha256'],
         'same complete Reader job bytes before strict parsing')
    def pairs(items):
        out={}
