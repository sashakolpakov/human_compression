def pin(p):
    p=Path(p);a=p.lstat()
    need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
         and a.st_nlink==1 and a.st_size<=16*MIB,'bounded ordinary immutable metadata artifact')
