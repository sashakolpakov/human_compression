from pathlib import Path
import argparse, hashlib, json, os

D = Path(__file__).resolve().parent
C = D.parent
BASE = Path('/Users/sasha/medusa/research/leemans/maintenance/intake/l026_fi22_neighborhood_orbits/operations/triangle_quotients')
READ = Path(__file__).stat().st_size
SEEN = {}

def whole(p, expected=None):
    global READ
    p = Path(p)
    a = p.lstat()
    assert p.resolve(strict=True) == p and p.is_file() and a.st_nlink == 1 and a.st_size <= 16 * 2**20
    assert READ + a.st_size <= 64 * 2**20 and (str(p) in SEEN or len(SEEN) < 512)
    raw = p.read_bytes()
    b = p.lstat()
    sig = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
    assert sig(a) == sig(b) and len(raw) == a.st_size
    r = dict(path=str(p), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
    assert expected is None or r == expected
    assert SEEN.get(str(p), r) == r
    SEEN[str(p)] = r
    READ += len(raw)
    return r, raw

def document(p):
    return json.loads(whole(p)[1])

def write(p, raw):
    with p.open('xb') as f:
        assert f.write(raw) == len(raw)
        f.flush()
        os.fsync(f.fileno())
    return whole(p)[0]

