    signature=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns,x.st_ctime_ns)
    need(signature(a)==signature(b)==signature(c)==signature(p.lstat()) and len(raw)==ref['bytes'] and hashlib.sha256(raw).hexdigest()==ref['sha256'],
         'fresh whole Root metadata subject')
