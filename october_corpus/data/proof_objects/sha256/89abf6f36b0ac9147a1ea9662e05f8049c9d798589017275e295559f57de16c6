def replace_refs(value):
    if type(value)is dict:
        if value==ref(OLD):return program
        if value==ref(OLD_CONTROL):return control
        return {k:replace_refs(v)for k,v in value.items()}
    if type(value)is list:return [replace_refs(x)for x in value]
    if value==str(OLD):return program['path']
    if value==ref(OLD)['sha256']:return program['sha256']
    if value==str(OLD_CONTROL):return control['path']
    if value==ref(OLD_CONTROL)['sha256']:return control['sha256']
    return value
