def ref(path):
    p=Path(path);raw=p.read_bytes();return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def put(name,v):
    p=D/name;raw=(json.dumps(v,sort_keys=True,separators=(',',':'))+'\n').encode()
    with p.open('xb')as f:f.write(raw)
    return ref(p)
def write(name,source):
    ast.parse(source);p=D/name
    with p.open('x')as f:f.write(source)
    return ref(p)


