    need(pin_shape(snapshot)['bytes']<=MAX_PACKED,'unchanged packed input8MiB')
    gate=read(adoption);expected=dict(snapshot=snapshot,head=head,producer_case=producer_case,
        upstream_acceptance=upstream_acceptance,source_profile=source_profile)
    need(gate['root']=='/root'and gate['status']==ADOPTION and gate['adopted']is True
         and all(gate[k]==v for k,v in expected.items()),'exact separately Root-adopted new snapshot')
    report=read(gate['read_result'])
    if gate['adoption_kind']=='SAVED_TAIL':
        case=read(report['case'])
        need(report['status']==RESULT and report['top_level_load_calls']==0 and report['tail_load_calls']==1
             and report['native_launch_attempts']==[]and report['snapshot']==snapshot and report['head']==head
             and report['snapshot_profile']==source_profile and report['base_acceptance']==upstream_acceptance
             and report['snapshot_roundtrip']=='ENTIRE_TYPED_STATE_AND_NODE_DEBT_ORDER_EQUAL',
             'genuine complete unchanged Saved tail plus new whole-state wire roundtrip')
        need(case['schema']==CASE and case['producer_case']==producer_case and case['head']==head
             and case['base_acceptance']==upstream_acceptance and case['snapshot_profile']==source_profile
             and case['anchor']==report['anchor'],'exact exporting Reader case')
        method(case['method_acceptance'],source_profile)
    else:
        need(gate['adoption_kind']=='LOSSLESS_REFERENCE_REENCODING'
             and report['schema']=='F009_REFERENCE_LEAF_REENCODING_RESULT_V1'
             and report['status']=='VERIFIED_COMPLETE_TYPED_REFERENCE_REENCODING'
             and report['snapshot']==snapshot and report['head']==head and report['producer_case']==producer_case
             and report['upstream_acceptance']==upstream_acceptance and report['source_profile']==source_profile
             and report['complete_typed_ordered_roundtrip']is True
             and report['native_calls']==report['Reader_calls']==report['graph_calls']==0,
             'explicit conversion proof, never relabelled as a new Saved-tail run')
        old_snapshot=read(report['old_snapshot_adoption']);old_checkpoint=read(report['accepted_checkpoint'])
        need(old_snapshot['checkpoint_acceptance']==report['accepted_checkpoint']
             and old_checkpoint['root']==old_snapshot['root']=='/root'
             and old_checkpoint['adopted']is old_snapshot['adopted']is True
             and old_checkpoint['checkpoint']==old_snapshot['checkpoint']==report['checkpoint']==gate['checkpoint']
             and old_checkpoint['head']==old_snapshot['head']==head
             and old_checkpoint['snapshot']==old_snapshot['snapshot']==report['old_snapshot']
             and old_snapshot['producer_case']==producer_case and old_snapshot['upstream_acceptance']==upstream_acceptance
             and report['old_snapshot_adoption']==gate['lossless_from_snapshot_adoption']
             and report['accepted_checkpoint']==gate['checkpoint_acceptance'],
             'same entire already-acquired checkpoint and exact old representation, no new math credit')
        method(report['export_method'],source_profile)
        p=source_roles(report['source'])
        need(report['source']==gate['source']==profile(source_profile)['source']
             and report['program']==p['programs']['converter'],'genuine current converter Source identity')
    for ref in expected.values():acquire(ref)
    packed=Path(snapshot['path']).read_bytes();need(len(packed)==snapshot['bytes'],'whole packed input')
    value=legacy().W.decode(packed)
    need(type(value)is dict and set(value)=={'schema','head','producer_case','upstream_acceptance','source_profile','state'}
         and value['schema']==SCHEMA and all(value[k]==expected[k]for k in('head','producer_case','upstream_acceptance','source_profile')),
         'whole literal new envelope and provenance')
    need(legacy().W.encode(value)==packed,'canonical unchanged deterministic gzip')
    state=expand(value['state'],envelope={k:v for k,v in value.items()if k!='state'})
    logical_size({k:v for k,v in value.items()if k!='state'},state)
    if gate['adoption_kind']=='LOSSLESS_REFERENCE_REENCODING':
        observed=dict(sequence=state['sequence'],nodes=len(state['nodes']),pending=len(state['pending']),
            selected_raw_leaf_records=len(state['leaves']),reserved_debts=len(state['started']))
        need(observed==gate['checkpoint'],'no checkpoint/state count changed by representation conversion')
    producer,base=read(producer_case),read(upstream_acceptance)
    need(producer['base']==base['head']and state['target']==producer['target']and state['binary']==producer['binary']
         and state['completion_binary']==producer['completion_binary'],'exact complete inherited backend scope')
    for ref in(state['binary'],state['completion_binary']):acquire(ref)
    acquire(snapshot);return state
