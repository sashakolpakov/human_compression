True)\n    pending_ref = add('pending','proposed_pending.json',remaining)\n    need(pending_ref['bytes'] == 1196 and pending_ref['sha256'] == plan['proposed_pending_DATA']['sha256'],\n         'exact installed pending1196/fc8377 bytes')\n    registration = dict(schema='ROOT_F004_Q11_EXISTING_CLOSED40_TYPED_REGISTRATION_V1',\n        root=ROOT,registrar=ROOT,method=method,proof_kind=KIND,\n        Root_closure_import=plan['Root_closure_import'],closure_index=plan['closure_index'],\n        complete_job_records=index['rows'],old_pending=plan['old_pending'],new_pending=pending_ref,\n        ordered_removed_jobs=JOBS,added_jobs=[],required=272,closed_before=75,closed_after=115,\n        pending_before=197,pending_after=157,remaining_by_rank={'4':157,'5':0},\n        source_author=AUTHOR,Source_release=plan['Source_release'],before_live_roles=plan['before'],\n        operational_commit_requires_separate_CAS_receipt=True,\n        all_old_proof_actors_methods_scopes_preserved=True,scientific_replays=0,\n        whole_Original_manuscript_conjecture_measurement_Lean_credit=0)\n    record_ref = add('registration','root_closed40_registration.json',registration)\n    banks,patches = replacements(documents,pending_ref,record_ref,plan['Root_closure_import'])\n    add('inverse','whole_alias_inverse.json',dict(schema='F004_CLOSED40_WHOLE_TYPED_ALIAS_INVERSE_V1',\n         before=plan['before'],patches=patches,complete_unrelated_values_preserved=True,\n         old_single_job_proof_methods_and_unknown_alias_keys_preserved=True))\n    add('planned_pair','complete_planned_state_pair.json',dict(\n        schema='F004_CLOSED40_COMPLETE_PLANNED_STATE_PAIR_V1',CURRENT=banks['CURRENT'],STATUS=banks['STATUS']))\n    state_raws = {k:can(v) for k,v in banks.items()}\n    state_refs = {k:ref(CURRENT if k=='CURRENT' else STATUS,v) for k,v in state_raws.items()}\n    need(equal(state_refs,plan['planned_states']), 'exact whole reviewed planned pair, still uncommitted')\n    add('PREPARED','state_transaction_PREPARED.json',dict(\n        schema='ROOT_F004_CLOSED40_PREPARED_SEQUENTIAL_CAS_V1',root=ROOT,phase='PREPARED',\n        method=method,plan=plan_ref,Source_release=plan['Source_release'],\n        before_live_roles=plan['before'],before_archives={k:refs['before_'+k] for k in banks},\n        complete_planned_state_pair=refs['planned_pair'],planned_states=state_refs,\n        inverse=refs['inverse'],registration=record_ref,pending=pending_ref,\n        stage_paths=[str(p.with_name(p.name+STAGE_SUFFIX)) for p in (CURRENT,STATUS)],\n        pair_crash_atomic=False,automatic_retry_cleanup_or_rollback=False,\n        interrupted_commit_requires_Root_inspection=True))\n    # Include complete future receipt reserve and wrappers BEFORE any mkdir/write.\n    overhead = plan['guard_and_recorder_return_reserve']\n    need(type(overhead) is dict and type(overhead.get('bytes')) is int\n         and 0 <= overhead['bytes'] <= 2*MIB and type(overhead.get('paths')) is int\n         and 0 <= overhead['paths'] <= 32 and type(overhead.get('read_bytes')) is int\n         and 0 <= overhead['read_bytes'] <= 16*MIB\n         and type(overhead.get('source_bootstrap_bytes')) is int\n         and 0 <= overhead['source_bootstrap_bytes'] <= overhead['read_bytes'],\n         'one actual wrapper output/read/Source-bootstrap reserve')\n    output_bytes = sum(map(len,blobs.values())) + sum(map(len,state_raws.values()))\n    # Receipt/read budget is a bound; every actual output verification is charged again by IO.\n    need(output_bytes + 65536 + overhead['bytes'] <= LIMITS['new_bytes'],\n         'entire before/planned/registration/inverse/PREPARED/stages/commit/wrappers <=16MiB')\n    need(io.read_bytes + output_bytes + 65536 + overhead['bytes'] + overhead['read_bytes']\n         + 2*sum(len(x) for x in raws.values())\n         + 3*sum(r['bytes'] for r in plan['protected_progress'])\n         + sum(len(x) for x in state_raws.values()) <= LIMITS['read_bytes'],\n         'all actual output reopens, both finalCAS, after reads and final protected checks prepaid')\n    need(len(io.paths)+len(blobs)+2+1+1+2*len(OLD_STAGE_SUFFIXES+(STAGE_SUFFIX,))\n         +overhead['paths'] <= LIMITS['paths'],\n         'single complete input/output/stage/wrapper512-path bank')\n    return out,blobs,refs,banks,state_raws,state_refs,output_bytes\n\n\ndef run(args):\n    io = IO()\n    need(args.actor == ROOT and sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode\n         and not sys.flags.optimize and Path(__file__).resolve() == R/'register_closed40.py',\n         'Root-only installed own -E -B -S Source; unselected /private/tmp file cannot activate')\n    need(not any(os.environ.get(k) for k in ('PYTHONSTARTUP','PYTHONPATH',\n        'COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG','OPENSSL_CONF','OPENSSL_MODULES')),\n        'injection environment cleared')\n    method = valid_ref(dict(path=str(R/'register_closed40.py'),bytes=args.source_bytes,sha256=args.self_sha256))\n    need(method['bytes'] <= LIMITS['source_bytes'], 'new functional Source <64KiB')\n    io.charge_path(method['path'])\n    io.read_bytes += method['bytes']  # Python's initial whole Source bootstrap, in addition to self-pin below.\n    io.opens += 1\n    io.read(method)\n    plan_ref = valid_ref(dict(path=args.plan,bytes=args.plan_bytes,sha256=args.plan_sha256))\n    plan = io.doc(plan_ref)\n    need(plan.get('schema') == 'ROOT_F004_CLOSED40_LIVE_METADATA_CAS_PLAN_V1'\n         and plan.get('root') == ROOT and plan.get('bound_after_CP11262') is True\n         and plan.get('proof_kind') == KIND and equal(plan.get('method'),method)\n         and equal(plan.get('limits'),LIMITS), 'fresh Root post-CP11262 exact batch plan')\n    source_admission(io,plan,method,plan['Source_release'])\n    runtime(io,plan,method)\n    index = accepted(io,plan)\n    _,remaining = pending(io,plan)\n    protected(io,plan)\n    documents,raws = state_pair(io,plan['before'])\n    overview_import(io,plan,documents)\n    need(equal(documents['CURRENT']['F004_q11_latest_ledger'],documents['STATUS']['F004_q11_latest_ledger']),\n         'coherent actual registered q11 before ledger')\n    q11 = documents['CURRENT']['F004_q11_latest_ledger']\n    need(type(q11.get('closed')) is int and q11['closed'] == 75\n         and type(q11.get('pending')) is int and q11['pending'] == 197\n         and q11.get('required') == 272 and equal(q11.get('pending_file'),plan['old_pending']),\n         'actual75/197/272 registration and exact old pending')\n    for name in documents:\n        q8 = documents[name]['F004_q8_latest_ledger']\n        need(equal(q8.get('closed'),686) and equal(q8.get('required'),686)\n             and equal(q8.get('pending'),0),\n             'actual already complete q8 preserved, no old fixed q8 boundary')\n    for name in documents:\n        archived = io.read(plan['whole_before_archives'][name])\n        need(archived == raws[name], 'exact fresh whole before archive matches live observation')\n    out,blobs,refs,banks,state_raws,state_refs,output_bytes = publication(\n        io,plan,plan_ref,method,index,documents,raws,remaining)\n    if args.mode == 'forecast':\n        observed,_ = state_pair(io,plan['before'])\n        need(equal(observed,documents), 'both unchanged complete forecast states')\n        protected(io,plan)\n        io.budget()\n        print(can(dict(status='VERIFIED_F004_CLOSED40_METADATA_FORECAST_ONLY',\n              actual_registration=False,read_bytes=io.read_bytes,unique_paths=len(io.paths),\n              complete_new_byte_bound=output_bytes+65536+plan['guard_and_recorder_return_reserve']['bytes'],\n              closed_after_IF_Root_adopts=115,pending_after_IF_Root_adopts=157,\n              scientific_replays=0,whole_Original_credit=0)).decode(),end='')\n        return\n    stages = [(path,path.with_name(path.name+STAGE_SUFFIX)) for path in (CURRENT,STATUS)]\n    orphan_paths = [p.with_name(p.name+s) for p in (CURRENT,STATUS)\n                    for s in OLD_STAGE_SUFFIXES+(STAGE_SUFFIX,)]\n    for path in orphan_paths:\n        io.charge_path(path)\n    need(all(not os.path.lexists(p) for p in orphan_paths), 'no own or known predecessor orphan stage; no cleanup')\n    lock_before = LOCK.lstat()\n    need(LOCK.resolve(strict=True) == LOCK and stat.S_ISREG(lock_before.st_mode)\n         and lock_before.st_nlink == 1, 'existing stable ordinary Root lock')\n    io.charge_path(LOCK)\n    with LOCK.open('r+') as lock:\n        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)\n        opened = os.fstat(lock.fileno())\n        need((opened.st_dev,opened.st_ino) == (lock_before.st_dev,lock_before.st_ino)\n             == (LOCK.lstat().st_dev,LOCK.lstat().st_ino), 'same opened stable Root lock')\n        locked,_ = state_pair(io,plan['before'])\n        need(equal(locked,documents), 'whole locked states exactly equal authenticated before')\n        protected(io,plan)\n        out.mkdir()\n        for name,body in blobs.items():\n            io.write(out/name,body)\n        sync(out)\n        sync(out.parent)\n        for (path,stage),name in zip(stages,('CURRENT','STATUS')):\n            io.write(stage,state_raws[name])\n        immediate,_ = state_pair(io,plan['before'])\n        need(equal(immediate,documents), 'fresh BOTH CAS immediately before first replace')\n        protected(io,plan)\n        io.budget()\n        need((LOCK.lstat().st_dev,LOCK.lstat().st_ino) == (opened.st_dev,opened.st_ino),\n             'stable Root lock at immediate commit')\n        for path,stage in stages:\n            os.replace(stage,path)\n            sync(path.parent)\n        after,_ = state_pair(io,state_refs)\n        need(equal(after,banks), 'whole actual committed pair equals both plans')\n        protected(io,plan)\n        receipt = dict(schema='ROOT_F004_CLOSED40_COMMITTED_SEQUENTIAL_CAS_V1',root=ROOT,\n            committed=True,method=method,plan=plan_ref,prepared=refs['PREPARED'],\n            registration=refs['registration'],pending=refs['pending'],\n            before=plan['before'],after=state_refs,ordered_removed_jobs=JOBS,\n            required=272,closed=115,pending_count=157,remaining_by_rank={'4':157,'5':0},\n            four_idle_arrays=True,whole_typed_inverse=True,pair_crash_atomic=False,\n            automatic_retry_cleanup_or_rollback=False,all_old_proof_history_retained=True,\n            q8_F009_L026_ownership_and_all_unrelated_values_preserved=True,\n            actual_read_bytes_before_receipt=io.read_bytes,actual_new_bytes_before_receipt=io.new_bytes,\n            scientific_replays=0,whole_Original_manuscript_conjecture_measurement_Lean_credit=0)\n        body = can(receipt)\n        need(len(body) <= 65536, 'complete prepaid commit receipt')\n        committed = io.write(out/'state_transaction_COMMITTED.json',body)\n        sync(out)\n        io.budget()\n    print(can(dict(status='ROOT_REGISTERED_F004_Q11_FORTY_EXISTING_CLOSURES',\n          committed=committed,registration=refs['registration'],pending=refs['pending'],\n          required=272,closed=115,pending_count=157,actual_read_bytes=io.read_bytes,\n          actual_new_bytes=io.new_bytes,unique_paths=len(io.paths),\n          scientific_replays=0,whole_Original_credit=0)).decode(),end='')\n\n\ndef main():\n    ap = argparse.ArgumentParser(allow_abbrev=False)\n    ap.add_argument('--actor',required=True)\n    ap.add_argument('--mode',choices=('forecast','adopt'),required=True)\n    ap.add_argument('--self-sha256',required=True)\n    ap.add_argument('--source-bytes',required=True,type=int)\n    ap.add_argument('--plan',required=True)\n    ap.add_argument('--plan-sha256',required=True)\n    ap.add_argument('--plan-bytes',required=True,type=int)\n    run(ap.parse_args())\n\n\nif __name__ == '__main__':\n    main()\n","only_changed_function":"replacements","represented_activation":0,"schema":"INDEPENDENT_WHOLE_V3_TO_V3B_SOURCE_INVERSE_DATA_V1"}
