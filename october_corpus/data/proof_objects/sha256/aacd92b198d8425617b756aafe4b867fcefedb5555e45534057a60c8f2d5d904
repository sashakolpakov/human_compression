_registration_current')\n    note=('F004 q8 registered686/686; q9 accepted35/35; q11 registered115/272 with157 rank4 pending. '\n          'All33 rank5 jobs are proved; follow F004_q11_latest_ledger and its pending register. '\n          'q8/q11 field assembly, Aut/duality quotient and final tables remain owed; no new Original credit.')\n    change(banks['CURRENT'],['F004_current','navigation_note'],note,changes['CURRENT'])\n    change(banks['STATUS'],['F004','q8_completed'],686,changes['STATUS'])\n    change(banks['STATUS'],['F004','next_status'],note,changes['STATUS'])\n    change(banks['STATUS'],['F004','next_scope'],\n           'Continue only current q11 latest pending register rank4 jobs; preserve accepted model/domain/classification premises. '\n           'Do not rerun any of33 proved rank5 jobs. Complete q8/q11 field assembly and Aut/duality/tables.',changes['STATUS'])\n    change(banks['STATUS'],['root_intake_batch_status'],\n           '102/105 complete; F004,F009,L026 remain. F004: use current q8/q11 ledgers; q8 field assembly and '\n           'q11 pending rank4/field assembly remain. F009: continue CURRENT.F009_checkpoint_current without '\n           'replaying known passes. L026: use current paid coverage selectors. Complete all105, then STOP before measurement/Lean.',changes['STATUS'])\n    actions=copy.deepcopy(at(documents['STATUS'],['root_status_update_current','next_actions']))\n    need(type(actions) is list and all(type(x) is str for x in actions), 'whole current actions list')\n    for label,text in [('F004','F004: follow F004_q11_latest_ledger pending rank4 register and current q8 ledger; finish field assembly/Aut/duality/tables.'),\n                       ('F009','F009: continue CURRENT.F009_checkpoint_current; preserve accepted pending scope and do not replay known passes.')]:\n        matches=[n for n,x in enumerate(actions) if label in x]\n        need(len(matches)==1,'one exact old current action for '+label)\n        actions[matches[0]