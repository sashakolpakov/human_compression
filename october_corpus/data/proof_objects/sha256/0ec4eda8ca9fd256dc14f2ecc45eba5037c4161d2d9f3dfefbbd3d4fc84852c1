def can(value):
    return (json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode()

def ref(path):
    path=Path(path); raw=path.read_bytes()
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def whole(r):
    if r['path'] in READ:
        old,raw=READ[r['path']]; assert old==r; return raw
    p=Path(r['path']); a=p.lstat()
    assert p.is_absolute() and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
    assert a.st_nlink==1 and a.st_size==r['bytes']<=4*2**20
    raw=p.read_bytes(); b=p.lstat()
    signature=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
    assert signature(a)==signature(b) and len(raw)==r['bytes'] and hashlib.sha256(raw).hexdigest()==r['sha256']
    READ[r['path']]=(r,raw)
    assert len(READ)<=512 and sum(len(v[1]) for v in READ.values())<=64*2**20
    return raw

def doc(r): return json.loads(whole(r))

def descriptors(value):
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'}: yield value
        else:
            for v in value.values(): yield from descriptors(v)
    elif type(value) is list:
        for v in value: yield from descriptors(v)

def put(name,value):
    path=OUT/name; raw=can(value)
    with path.open('xb') as stream:
        assert stream.write(raw)==len(raw); stream.flush(); os.fsync(stream.fileno())
    return ref(path)

