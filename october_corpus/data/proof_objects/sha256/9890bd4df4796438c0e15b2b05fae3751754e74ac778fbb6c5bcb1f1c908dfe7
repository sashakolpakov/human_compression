def need(ok,why):
    if not ok:raise ValueError(why)


def canonical(value):
    return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode()


def descriptor(path,raw):
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def signature(s):
    return (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)


class Metadata:
    def __init__(self):
        self.begin=time.monotonic();self.read_bytes=0;self.new_bytes=0;self.paths=set();self.opens=[]
    def path(self,p):
        self.paths.add(str(p));need(len(self.paths)<=512,'complete bootstrap512-path bank')
    def check(self):
        need(time.monotonic()-self.begin<5 and sys.platform=='darwin'
             and resource.getrusage(resource.RUSAGE_SELF).ru_maxrss<=268435456,
             'bootstrap<5s/256MiB inside actual whole125s guard')
    def read(self,row):
        need(type(row)is dict and set(row)=={'path','bytes','sha256'}and type(row['bytes'])is int
             and 0<=row['bytes']<=4194304,'whole bounded metadata descriptor')
        p=Path(row['path']);self.path(p);a=p.lstat()
        need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
             and a.st_nlink==1 and a.st_size==row['bytes'],'canonical stable metadata input')
        with p.open('rb')as f:b=os.fstat(f.fileno());raw=f.read(a.st_size+1);c=os.fstat(f.fileno())
        need(signature(a)==signature(b)==signature(c)==signature(p.lstat())and descriptor(p,raw)==row,
             'entire stable expected metadata bytes')
        self.read_bytes+=len(raw);self.opens.append(row)
        need(self.read_bytes<=67108864,'whole bootstrap64MiB bank');self.check();return raw
    def pin(self,p):
        p=Path(p).resolve(strict=True);a=p.lstat()
        need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and a.st_size<=4194304,'bounded ordinary origin before read')
        with p.open('rb')as f:b=os.fstat(f.fileno());raw=f.read(a.st_size+1);c=os.fstat(f.fileno())
        need(signature(a)==signature(b)==signature(c)==signature(p.lstat())and len(raw)==a.st_size,'stable full origin')
        row=descriptor(p,raw);self.path(p);self.read_bytes+=len(raw);self.opens.append(row)
        need(self.read_bytes<=67108864,'whole origin read bank');self.check();return row
    def put(self,p,raw,base):
        need(type(raw)is bytes and len(raw)<=4194304 and p.parent==base
             and base.resolve(strict=True)==base and not os.path.lexists(p),'fresh private bootstrap metadata output')
        self.path(p);self.new_bytes+=len(raw);need(self.new_bytes<=16777216,'whole16MiB new bank')
        with p.open('xb')as f:
            need(f.write(raw)==len(raw),'whole exclusive metadata write');f.flush();os.fsync(f.fileno())
        row=descriptor(p,raw);need(self.read(row)==raw,'whole generated metadata readback');return row


def prewarm_adapter_parser(mode,plan_path):
    """Exact installed Source.main argument declarations; no Source execution."""
    parser=argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument('--actor',required=True)
    parser.add_argument('--mode',choices=('forecast','adopt'),required=True)
    parser.add_argument('--self-sha256',required=True)
    parser.add_argument('--source-bytes',required=True,type=int)
    parser.add_argument('--plan',required=True)
    parser.add_argument('--plan-sha256',required=True)
    parser.add_argument('--plan-bytes',required=True,type=int)
    old=sys.argv
    try:
        sys.argv=[METHOD['path']]
        parser.parse_args(['--actor',ROOT,'--mode',mode,'--self-sha256',METHOD['sha256'],
            '--source-bytes','39928','--plan',str(plan_path),'--plan-sha256','0'*64,'--plan-bytes','1'])
    finally:sys.argv=old
    shlex.split("'metadata argument' --mode "+mode)
    json.loads(canonical(dict(prewarm=True)))
    copy.deepcopy(dict(prewarm=[1,False,'metadata']))
    Path(METHOD['path']).resolve(strict=True).is_file()


