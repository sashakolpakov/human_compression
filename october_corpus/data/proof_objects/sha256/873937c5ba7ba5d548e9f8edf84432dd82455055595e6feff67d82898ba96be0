        need(q['bytes']<=(65536 if k!='runtime'else 262144),'control source cap');refs[k]=q
    need(refs['self']['path']==str(Path(__file__).resolve()),'actual control Source');whole(refs['self'])
    text=whole(refs['subject'],True).decode();domain=json.loads(whole(refs['runtime'],True));rows=domain['rows']
    need(domain['schema']=='F009_DIAGNOSTIC_RUNTIME_SUBSET_V1'and type(rows)is list and len(rows)<=256,'finite exact runtime')
    runtime={q['path']:q for q in rows};need(len(runtime)==len(rows),'unique runtime')
    package=[q for q in rows if'/site-packages/psutil/'in q['path']]
    need(len(package)==11,'whole declared package including native extension')
    preauth=[q for q in rows if q in package or q['path'].endswith(('.so','.dylib'))]
    for q in preauth:whole(q)
