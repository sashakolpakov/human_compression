        except ValueError:return True
        return False
    with (out/'markers.jsonl').open('x',encoding='utf-8')as f:
        check(m.ROOT_OBSERVER is None);m.root_observe('contract.begin');check(f.tell()==0)
        z=m.RootInitProbe(resource,f)
        for phase in z.PHASES:z.emit(phase)
        end=f.tell()
        for phase in z.PHASES:z.emit(phase)
        check(end==f.tell()and z.n==len(z.PHASES)<=32)
        check(fails(lambda:z.emit('unknown')))
        c=m.RootInitProbe(resource,f);c.n=32;check(fails(lambda:c.emit('contract.begin')))
        c=m.RootInitProbe(resource,f);c.pid+=1;check(fails(lambda:c.emit('contract.begin')))
        r=m.RootInitProbe(resource,f);r.ready();check(r.ps is not None and r.pid==os.getpid())
        r.birth=-1;r.emit('decode.begin');r.ppid=2147483647;r.emit('decode.end')
        m.ROOT_OBSERVER=r;m.root_observe('encode.begin');m.ROOT_OBSERVER=None
        with contextlib.redirect_stdout(f):m.RootInitProbe(resource).emit('contract.begin')
    raw=(out/'markers.jsonl').read_bytes();lines=raw.splitlines(keepends=True);values=[json.loads(v)for v in lines]
    check(all(v.endswith(b'\n')and len(v)<=384 and v.isascii()for v in lines))
    check(all(set(v)=={'schema','seq','phase','pid','ppid','t_ns','rss','maxrss','owner_rss','error'}and v['schema']=='F009_INIT_RSS_V1'for v in values))
    check(all(v['pid']==os.getpid()and type(v['maxrss'])is int and v['maxrss']>=0 for v in values))
    n=len(z.PHASES);check([v['seq']for v in values[:n]]==list(range(1,n+1)))
    check(all(v['rss']is None and v['owner_rss']is None for v in values[:n]))
    check(values[n]['rss']>0 and values[n]['owner_rss']>0 and values[n]['error']is None)
    check(values[n+1]['owner_rss']is None and values[n+1]['error']=='parent')
    check(values[n+2]['rss']is None and values[n+2]['owner_rss']is None and values[n+2]['error']=='process')
    for path in sorted(set(opens)|{q['path']for q in preauth}):whole(runtime[path])
    result=dict(schema='F009_INIT_MARKER_CONTROL_RESULT_V1',status='PASS',checks=checks,read_bytes=READ,import_opens=len(opens),records=len(lines),source=refs['subject'],new_census_credit=0)
