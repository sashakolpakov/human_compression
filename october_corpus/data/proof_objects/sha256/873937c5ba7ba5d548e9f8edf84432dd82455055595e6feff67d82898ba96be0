        if event!='open'or not isinstance(args[0],(str,bytes,Path)):return
        path=str(Path(os.fsdecode(args[0])).absolute());mode=args[1]if len(args)>1 else None;flags=args[2]if len(args)>2 else 0
        writing=(isinstance(mode,str)and any(c in mode for c in'wax+'))or bool(flags&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC|os.O_APPEND))
        if path==IN_HASH:need(not writing,'hash reads only');return
