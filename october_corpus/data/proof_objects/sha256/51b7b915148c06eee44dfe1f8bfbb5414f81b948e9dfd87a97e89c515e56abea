 while not a.exists():a=a.parent
 need(a.resolve(strict=True)==a,'canonical existing ancestry before directory creation')

def mkdirs(path):
 ancestry(path);missing=[];p=path
 while not p.exists():missing.append(p);p=p.parent
 for q in reversed(missing):q.mkdir();fsync_dir(q.parent)
 need(path.resolve(strict=True)==path,'canonical final directory')

def publish(path,raw):
 need(not os.path.lexists(path),'exclusive new metadata output');mkdirs(path.parent)
 with path.open('xb')as f:need(f.write(raw)==len(raw),'whole metadata publication');f.flush();os.fsync(f.fileno())
 fsync_dir(path.parent);return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def source_choice(row):
 original=shape(row['source']);alternatives=[original]+row.get('reuse_sources',[])
 for candidate in alternatives:
  shape(candidate);need(candidate['bytes']==original['bytes']and candidate['sha256']==original['sha256'],
   'reuse is exact whole content, never a guessed object')
  if Path(candidate['path']).exists():whole(candidate);return candidate
 raise FileNotFoundError('No declared complete physical source exists: '+original['path'])

def plan_check(plan,own):
 need(plan['schema']=='CURATED_OCTOBER_PROOF_EXPORT_PLAN_V1'and plan['program']==own
  and plan['execution_authority_granted']is False and plan['scientific_calls']==0,
  'explicit immutable DATA selection, no proof/role authority')
