def chunks(plan):
 out=[];rows=[];size=0
 for row in plan['payloads']:
  extent=row['source']['bytes'];need(extent<=8*MIB,'each selected payload fits one8MiB chunk')
  if rows and size+extent>8*MIB:out.append(rows);rows=[];size=0
  rows.append(row);size+=extent
