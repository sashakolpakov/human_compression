  path=str(rel(row['target']));r=shape(row['source'])
  need(path not in paths,'one exact selected destination');paths[path]=r;total+=r['bytes']
  need(type(row['role'])is str and row['role']in('mathematical_source','mathematical_data','archived_evidence','navigation','integrity_verifier'),
   'explicit portable role; host runtime is not a content artifact')
  for original in row['originals']:shape(original);need(original['bytes']==r['bytes']and original['sha256']==r['sha256'],
   'every original mapping retains exact full content')
