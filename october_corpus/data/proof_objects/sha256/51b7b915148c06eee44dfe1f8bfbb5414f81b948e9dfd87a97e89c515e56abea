   files=[dict(path=r['target'],bytes=r['source']['bytes'],sha256=r['source']['sha256'],role=r['role'])for r in members],
   original_to_relative=[dict(original=o,relative=r['target'])for r in members for o in r['originals']],
   packed_members=packet['packed_members'],proof_banks=packet['proof_banks'],scope=packet['scope'],premises=packet['premises'],
   scientific_replay_status=packet['scientific_replay_status'],whole_original_credit=0,conjecture_credit=0,Lean_credit=0,compression_credit=0,
   qualifications=['Only declared relative files may be read; original machine paths are opaque provenance.','Whole file/body integrity does not establish the mathematical predicates or named-model premises.','No compiled host runtime, prior Source verdict or future computation is silently substituted.'])
  raw=can(value);need(len(raw)<=8*MIB,'bounded complete portable manifest');out[str(path)]=raw
