def proposals(contract,job,result):
    """Only proposed Reader equations; its independent state proves them.

    This is the same scalar/tail accounting used by the retained metadata
    return-plan constructor. No proposal itself pays a census obligation.
    """
    cp=contract.document(job['checkpoint_acceptance'])['checkpoint']
    expected=dict(sequence=result['sequence'],nodes=result['nodes'],pending=result['pending'],
      selected_raw_leaf_records=result['selected_leaf_occurrences'],reserved_debts=result['reserved_debts'])
    # These freshly produced metadata artifacts are bounded by the unchanged
    # producer reservation; the Reader will independently replay every one.
    def produced(ref):
        need(contract.acquire(ref['path'])==ref,'exact actual produced metadata reference')
        need(ref['bytes']<=2**20,'bounded produced transaction metadata')
        return strict(Path(ref['path']).read_bytes())
    head=produced(result['checkpoint']);tail=head['tail'];rows=[];seen=set()
    while tail is not None:
        need(tail['sha256']not in seen and len(rows)<512,'bounded acyclic complete new tail')
        seen.add(tail['sha256']);tx=produced(tail);rows.append(tx);tail=tx['previous']
    rows.reverse()
    need([q['sequence']for q in rows]==list(range(cp['sequence']+1,expected['sequence']+1)),
         'exact proposed new-tail interval from10626')
    allowed={'F009_QUEUE_DISPATCH_V1','F009_QUEUE_REPLACEMENT_V1','F009_QUEUE_COMPLETION_V1'}
    need(all(q['schema']in allowed for q in rows),'literal original transaction schemas')
    completed=sum(q['schema']=='F009_QUEUE_COMPLETION_V1'for q in rows)
    refined=sum(q['schema']=='F009_QUEUE_REPLACEMENT_V1'for q in rows)
    admissions=sum(len(q['admissions'])for q in rows if q['schema']=='F009_QUEUE_REPLACEMENT_V1')
    nodes=expected['nodes']-cp['nodes'];receivers=expected['pending']-cp['pending']+completed+refined
    delta=dict(completed_families=completed,refined_families=refined,exported_descendants=admissions,
      transactions=len(rows),selected_raw_leaf_delta=expected['selected_raw_leaf_records']-cp['selected_raw_leaf_records'],
      new_node_records=nodes,new_pending_receivers=receivers,alias_records=nodes-receivers,
      duplicate_admission_records=admissions-nodes)
    need(all(type(x)is int and x>=0 for x in delta.values()),'nonnegative proposals, not an acquired state assertion')
    return expected,delta

