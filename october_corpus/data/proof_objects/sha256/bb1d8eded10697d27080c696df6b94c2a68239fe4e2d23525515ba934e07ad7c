            need(fact['all64_directly_checked']is True,'actual original cyclic pilot')
            kind='cyclic_nongeneration';positions=fact['nongeneration_positions']
        elif schema=='ROOT_ACCEPTED_Q11_RANK4_RESIDUAL_CYCLIC_CERTIFICATES_V1':
            need(fact['exact_proper_basis_generator_invariance_and_actual_ambient_mover_checked']is True,
                 'actual proper invariant subspace, not full-span generation')
            kind='cyclic_nongeneration';positions=fact['new_nongeneration_positions']
        elif schema=='ROOT_ACCEPTED_Q11_RANK4_SECTION_IP_OBSTRUCTIONS_V1':
            need(fact['independent_direct_word_power_row_minor_checks']is True,'actual old section IP proof')
            kind='section_IP_failure';positions=fact['new_IP_failure_positions']
