def need(ok, why):
    if not ok:
        raise ValueError(why)


def can(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()


def ref(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def whole(path, expected=None):
    path = Path(path)
    before = path.lstat()
    need(path.is_absolute() and path.resolve(strict=True) == path and stat.S_ISREG(before.st_mode)
         and before.st_nlink == 1 and before.st_size <= 4 * MIB, 'ordinary bounded whole metadata file')
    raw = path.read_bytes()
    sig = lambda st: (st.st_dev, st.st_ino, st.st_mode, st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
    need(sig(before) == sig(path.lstat()) and len(raw) == before.st_size, 'stable complete bytes')
    result = ref(path, raw)
    if expected is not None:
        need(result == expected, 'exact selected descriptor')
    READ_ROLES[str(path)] = result
    return raw, result


def write(name, value):
    path = HERE / name
    need(path.is_relative_to(HERE) and not os.path.lexists(path), 'fresh private DATA output')
    path.parent.mkdir(parents=True, exist_ok=True)
    need(path.parent.resolve() == path.parent, 'canonical private output ancestry')
    raw = can(value)
    need(len(raw) <= 4 * MIB, 'bounded private DATA output')
    with path.open('xb') as f:
        need(f.write(raw) == len(raw), 'whole exclusive DATA write')
        f.flush()
        os.fsync(f.fileno())
    result = ref(path, raw)
    CREATED.append(dict(path=str(path), before=dict(exists=False),
                        after=dict(ref=result, whole_body_base64=base64.b64encode(raw).decode())))
    return result, raw


def tree(root):
    root = Path(root)
    need(root.resolve() == root and root.is_dir(), 'canonical finite metadata directory')
    files = sorted(path for path in root.rglob('*') if path.is_file())
    need(len(files) <= 150 and not any(path.is_symlink() for path in root.rglob('*')), 'finite ordinary metadata tree')
    return files


def selected(paths, prefix, root):
