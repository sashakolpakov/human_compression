    plan = dict(schema='F009_CP11262_CLOSED_REGISTRATION_METADATA_RETENTION_DATA_V1',
                author='/root/status_readme_audit', title=title, destination=str(destination),
                Root_authority=False, Root_authority_granted=False, execution_authority_granted=False,
                scientific_calls=0, checkpoint_sequence=11262, files=rows, borrowed_closures=borrowed,
                qualification='Exact closed metadata bytes only. The canonical af39 manifest and generic667 prelaunch map are borrowed whole as data with their distinct scopes; no scientific payload graph is expanded, replayed or claimed freshly hashed. Root alone may activate unchanged667 after source, selection, resource and destination review.')
