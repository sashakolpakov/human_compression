                   dict(original=plan_ref, retained=ref(destination / 'method/plan.json', plan_raw))]
    manifest = dict(schema='ROOT_EXACT_CLOSED_METADATA_RETENTION_V1', root='/root',
                    files=rows + method_rows, borrowed_closures=borrowed, source_plan=plan_ref,
                    scientific_calls=0, Source_or_verdict_transfer=False,
                    acceptance_or_checkpoint_or_operational_register_writes=0,
                    qualification='Complete selected file bodies retained. Borrowed closures authenticate whole existing manifests; their older payloads are not re-executed or claimed freshly opened here. This copy supplies no mathematical or census credit.')
    manifest_raw = can(manifest)
    manifest_ref = ref(destination / 'preservation.json', manifest_raw)
    source_bytes = method_ref['bytes']
    plan_bytes = plan_ref['bytes']
    manifest_bytes = len(manifest_raw)
