def canonical(value):
    return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')


def reference(path,raw):
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def decode(raw):
    def pairs(items):
        out={}
        for key,value in items:
            need(key not in out,'unique metadata keys');out[key]=value
        return out
    def floating(text):
        value=float(text);need(math.isfinite(value),'finite old observations');return value
    return json.loads(raw,object_pairs_hook=pairs,parse_float=floating,
                      parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))


class Evidence:
