import struct

TEMPLATE=(2961,1683,2)
U0=(478,682,984)
V0=(1317,2230,2569)

def transport(L,geo,tri,need,work):
    need(type(tri)in(list,tuple)and len(tri)==3 and len(set(tri))==3,'actual ordered triangle placement')
    x,y,z=tri;need(x in geo['A']['positions'],'same original complete ambient point tree')
    a=geo['A']['paths'][geo['A']['positions'][x]]
    y1=L['image'](geo['ambient'],L['inv'](a),y,need,work)
    z1=L['image'](geo['ambient'],L['inv'](a),z,need,work)
    need(y1 in geo['Q']['positions'],'actual normalized original neighbor')
    i=geo['Q']['positions'][y1];h=L['inv'](geo['Q']['paths'][55])+geo['Q']['paths'][i]
    z2=L['image'](geo['q'],L['inv'](h),z1,need,work)
    need(z2 in geo['S']['positions'],'actual normalized third point in full common180')
    q=geo['S_paths'][geo['S']['positions'][z2]]+h
    work.charge(2*(len(q)+len(a))+96,'whole_literal_three_leg_triangle_word')
    need(len(q)+len(a)<=73,'literal acquired73-letter typed A2/Q0 transporter')
    def apply(p):return L['image'](geo['ambient'],a,L['image'](geo['q'],q,p,need,work),need,work)
    need(tuple(apply(p)for p in TEMPLATE)==tuple(tri),'all three actual template placement images')
    return q,a

def apply(L,geo,g,point,need,work,inverse=False):
    q,a=g
    if inverse:
        return L['image'](geo['q'],L['inv'](q),L['image'](geo['ambient'],L['inv'](a),point,need,work),need,work)
    return L['image'](geo['ambient'],a,L['image'](geo['q'],q,point,need,work),need,work)

def base(L,geo,need,work):
    g0=transport(L,geo,U0,need,work)
    vstar=tuple(apply(L,geo,g0,p,need,work,inverse=True)for p in V0)
    need(len(set(vstar))==3,'three distinct transported canonical partner points')
    return vstar

def witness(L,ctx,vstar,record,need,work):
    need(type(record)is list and len(record)==2 and type(record[0])is type(record[1])is int
         and 0<=record[0]<500178 and record[1]in(3,6),'one actually certified unordered canonical owner and S3 size')
    owner,size=record;tri,mass=L['representative'](ctx,owner,need,work)
    work.charge(64,'whole_unordered_owner_mass_and_partner_record')
    need((mass*size)%6==0,'exact S3 component mass, including nonfree cases')
    unordered_mass=mass*size//6;need(0<unordered_mass<=1024,'actual unordered B orbit mass')
    g=transport(L,ctx['geo'],tri,need,work)
    partner=tuple(apply(L,ctx['geo'],g,p,need,work)for p in vstar)
    need(len(set(partner))==3,'actual three distinct partner images')
    target=L['canonical_owner'](ctx,partner,need,work)
    return owner,target,unordered_mass,*partner

def records_shape(ctx,records,need,work):
    import bisect
    need(type(records)is list and 1<=len(records)<=512,'bounded complete unordered-owner slice')
    work.charge(8*len(records),'whole_unordered_record_order')
    need(all(type(r)is list and len(r)==2 for r in records)
         and[ r[0]for r in records]==sorted(set(r[0]for r in records)),'exact sorted distinct canonical owners')
    first=bisect.bisect_right(ctx['owner_starts'],records[0][0])-1
    last=bisect.bisect_right(ctx['owner_starts'],records[-1][0])-1
    work.charge(32,'whole_partner_representative_edge_extent')
    need(0<=first<=last and last-first+1<=32,'at most32 shared representative edge blocks')

def propose(L,ctx,vstar,records,need,work):
    records_shape(ctx,records,need,work);out=bytearray()
    for record in records:
        work.proposal();out.extend(struct.pack('<IIHHHH',*witness(L,ctx,vstar,record,need,work)))
        work.charge(16,'whole_proposed_unordered_partner_witness')
    return bytes(out)

def verify(L,ctx,vstar,records,raw,need,work):
    records_shape(ctx,records,need,work)
    need(type(raw)is bytes and len(raw)==16*len(records),'entire supplied unordered partner witness slice')
    total=0
    for at,record in enumerate(records):
        supplied=struct.unpack_from('<IIHHHH',raw,16*at);work.charge(16,'whole_supplied_unordered_partner_witness')
        expected=witness(L,ctx,vstar,record,need,work)
        need(supplied==expected,'all actual placements, partner points, mass and raw owner independently checked')
        total+=expected[2]
    return dict(unordered_owners=len(records),unordered_triangle_mass=total,
      partner_target_is_ordered_owner_pending_separate_S3_resolution=True,
      no_commuting_ordered_partner_lift_claim=True,all_nonfree_branches_retained=True,
      product_quotient_or_generation_or_Original_credit=0)
