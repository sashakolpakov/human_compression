seen = {}

def can(x):
    return json.dumps(x, sort_keys=True, separators=(',', ':'), ensure_ascii=True, allow_nan=False).encode()

def sha(b):
    return hashlib.sha256(b).hexdigest()

def dig(x):
    return sha(can(x))

def pin(path):
    p = Path(path)
    b = p.read_bytes()
    return {'path':str(p), 'bytes':len(b), 'sha256':sha(b)}

def whole(r):
    assert set(r) == {'path','bytes','sha256'} and type(r['bytes']) is int
    p = Path(r['path'])
    a = p.lstat()
    assert p.is_absolute() and p.resolve(strict=True) == p and stat.S_ISREG(a.st_mode) and a.st_nlink == 1
    b = p.read_bytes()
    z = p.lstat()
    assert (a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_ctime_ns)==(z.st_dev,z.st_ino,z.st_size,z.st_mtime_ns,z.st_ctime_ns)
    assert len(b)==r['bytes'] and sha(b)==r['sha256']
    assert seen.get(str(p),r)==r
    seen[str(p)] = r
    return b

def doc(r):
    def unique(items):
        d={}
        for k,v in items:
            assert k not in d
            d[k]=v
        return d
    return json.loads(whole(r),object_pairs_hook=unique)

def local(path):
    return doc(pin(path))

def runs(rr):
    values=[]
    for a,b in rr:
        assert type(a) is type(b) is int and 1<=a<=b and (not values or a>values[-1])
        values.extend(range(a,b+1))
    return values

def packed(values):
    rr=[]
    for v in values:
        if rr and rr[-1][1]+1==v: rr[-1][1]=v
        else: rr.append([v,v])
    return rr

def child(x):
    return ['/Users/sasha/.venvs/global/bin/python','-E','-B','-S',x['program']['path'],
        '--self-sha256',x['program']['sha256'],'--plan',x['plan']['path'],x['plan']['sha256'],
        '--Root-gate',x['source_gate']['path'],x['source_gate']['sha256']]

def closure(capture,guard,started,stdout,stderr,rss,wall,command=None):
    c=doc(capture); r=doc(guard); st=doc(started); out=whole(stdout); err=whole(stderr)
    frames=c['all_genuine_api_frames']
    assert c['root']=='/root' and c['child_argv']==c['issued_argv'] and c['actual_tool']['exit_code']==0
    assert frames and frames[-1]['exit_code']==0 and 'session_id' not in frames[-1]
    assert all(type(f['output']) is str for f in frames)
    outer=c['issued_argv']; assert outer.count('--')==1 and outer.count('--output')==1
    actual_child=outer[outer.index('--')+1:]
    if command is not None: assert actual_child==command
    assert outer[outer.index('--output')+1]==str(Path(guard['path']).parent)
    assert json.loads(''.join(f['output'] for f in frames))=={'status':'PASS','stop':'RETURNED','receipt':guard['path']}
    assert r['status']=='PASS' and r['stop']=='RETURNED' and r['returncode']==0
    assert r['command']==st['command']==actual_child and r['limits']==st['limits']
    assert r['limits']['total_rss']==rss and r['limits']['wall_seconds']==wall
    assert r['cleanup']['remaining']==r['cleanup']['errors']==[]
    assert r['logs']['stdout']==len(out) and r['logs']['stderr']==len(err)
    return json.loads(out),r

def fixed_closure(run,rss,wall,command=None):
    return closure(*(run[k] for k in ['capture','guard','started','stdout','stderr']),rss,wall,command)

def directory_closure(root,capture,rss,wall):
    return closure(pin(capture),*(pin(Path(root)/n) for n in ['receipt.json','started.json','stdout.log','stderr.log']),rss,wall)

