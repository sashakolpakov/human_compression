def canonical(value):
 return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False).encode('ascii')


def same(a,b):return canonical(a)==canonical(b)


def shape(ref):
 need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}and type(ref['path'])is str
  and type(ref['bytes'])is int and 0<=ref['bytes']<=2*GIB
  and type(ref['sha256'])is str and len(ref['sha256'])==64
  and all(c in'0123456789abcdef'for c in ref['sha256']),'whole typed canonical pin')
 p=Path(ref['path']);need(p.is_absolute()and str(p)==ref['path']and '..'not in p.parts,'canonical absolute input path')
 return p


def pin(path):
 p=Path(path);a=p.stat();need(stat.S_ISREG(a.st_mode)and a.st_size<=2*GIB,'bounded complete regular input')
 h=hashlib.sha256();n=0
 with p.open('rb')as f:
  try:fcntl.fcntl(f.fileno(),48,1)
  except OSError:pass
  b=os.fstat(f.fileno())
  for raw in iter(lambda:f.read(MIB),b''):h.update(raw);n+=len(raw)
  z=os.fstat(f.fileno())
 now=p.stat();sig=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_size,x.st_mtime_ns,x.st_ctime_ns)
 need(sig(a)==sig(b)==sig(z)==sig(now)and n==a.st_size,'stable entire input')
 return dict(path=str(p),bytes=n,sha256=h.hexdigest())


