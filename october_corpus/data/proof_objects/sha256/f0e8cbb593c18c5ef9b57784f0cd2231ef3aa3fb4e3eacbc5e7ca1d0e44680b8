for row in old['files']:
    p = Path(row['retained']['path'])
    assert pin(p) == row['retained']
    assert (row['original']['bytes'], row['original']['sha256']) == (row['retained']['bytes'], row['retained']['sha256'])
    rows.append(row)
    seen.add((row['original']['path'], row['original']['bytes'], row['original']['sha256']))
