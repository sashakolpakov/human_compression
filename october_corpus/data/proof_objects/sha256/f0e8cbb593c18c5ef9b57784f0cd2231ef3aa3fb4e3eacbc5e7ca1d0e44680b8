from pathlib import Path
import hashlib, json, os

T = Path('/private/tmp/l026_eleven_cycle_proposals')
B = T/'remaining_singleton_data'
O = Path('/Users/sasha/medusa/research/leemans/maintenance/intake/l026_fi22_neighborhood_orbits/operations/triangle_quotients')
S = O/'direct_generation/initial_window/evidence'
old_manifest = O/'direct_generation/first_component/evidence/preservation.json'
rows, seen = [], set()

def pin(p, body=None):
    if body is None:
        body = p.read_bytes()
    return dict(path=str(p), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())

def retain(p):
    body = p.read_bytes()
    ref = pin(p, body)
    key = (ref['path'], ref['bytes'], ref['sha256'])
    if key in seen:
        return ref
    seen.add(key)
    q = S/'objects'/ref['sha256']
    q.parent.mkdir(parents=True, exist_ok=True)
    if q.exists():
        assert q.read_bytes() == body
    else:
        with q.open('xb') as f:
            f.write(body)
            f.flush()
            os.fsync(f.fileno())
    rows.append(dict(original=ref, retained=pin(q, body)))
    return ref

