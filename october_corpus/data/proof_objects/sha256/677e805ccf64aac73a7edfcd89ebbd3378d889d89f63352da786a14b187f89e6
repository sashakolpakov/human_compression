  text=new[q['name']]+'\n';assert len(text.encode())==q['new_bytes'] and hashlib.sha256(text.encode()).hexdigest()==q['new_sha256']
 subjects.append(dict(role=row['role'],program=row['final'],literal_definitions=len(row['literal_definitions']),new_or_changed=[q['name']for q in row['new_or_changed_definitions']]))
