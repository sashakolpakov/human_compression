assert coverage['all_final_bytes_accounted_for'] and not coverage['e366_or6498_assumed_reviewed']
subjects=[]
for row in coverage['roles']:
 if row['role']=='adopter':continue
 old,new=defs(checked(row['Root_reviewed_ancestor'])),defs(checked(row['final']))
 for q in row['literal_definitions']:assert old[q['name']]==new[q['name']]
 assert set(new)=={q['name']for q in row['literal_definitions']+row['new_or_changed_definitions']}
