def formal_class(word):
    # Pure strings in <r>*<t|t^2=1>, with s=r^-1*t; no original action.
    def reduce(seq):
        out=[]
        for x in seq:
            if out and ((out[-1]==0)==(x==0)):
                y=out.pop()
                if x!=0 and x+y:out.append(x+y)
            else:out.append(x)
        return out
    seq=[]
    for x in word:seq.extend([x]if abs(x)==1 else([-1,0]if x==2 else[0,1]))
    q=reduce(seq)
    while len(q)>1 and ((q[0]==0)==(q[-1]==0)):q=reduce(q[1:]+q[:1])
    inverse=[-x for x in reversed(q)]
    return min([tuple(v[i:]+v[:i])for v in(q,inverse)for i in range(len(v))],default=())


