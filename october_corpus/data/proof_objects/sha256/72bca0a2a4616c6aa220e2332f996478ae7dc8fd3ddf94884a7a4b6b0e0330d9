def original_power(matrix,exponent,budget):
    value=tuple(tuple(int(i==j)for j in range(7))for i in range(7))
    for bit in bin(exponent)[2:]:
        value=budget.multiply(value,value)
        if bit=='1':value=budget.multiply(value,matrix)
    return value


def literal_word(marks,section,word,budget):
    value=tuple(tuple(int(i==j)for j in range(7))for i in range(7))
    for letter in word:value=budget.multiply(value,marks[section[int(letter)]])
    return value


