nfiguration['harness']\n# Load the standard-library modules used by the actual argument/AST setup.\n# These operations inspect metadata; no adapter definitions are executed.\npreparser = argparse.ArgumentParser(allow_abbrev=False)\nfor name in ('actor', 'self-sha256', 'self-bytes', 'release', 'release-sha256', 'release-bytes'):\n    preparser.add_argument('--' + name, required=True)\npreparser.parse_args(['--actor', '/root', '--self-sha256', 'pin', '--self-bytes', '1',\n                     '--release', 'metadata', '--release-sha256', 'pin', '--release-bytes', '1'])\ntree = ast.parse(source, filename=configuration['adapter_Source']['path'])\nprefix = copy.deepcopy(next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'run'))\nprefix.name = 'run_admission_prefix_only'\nprefix.body = prefix.body[:2]\nast.unparse(prefix)\nfor node in tree.body:\n    ast.get_source_segment(source.decode(), node)\norigins = {}\nfor module in tuple(sys.modules.values()):\n    for field in ('__file__', '__cached__'):\n        name = getattr(module, field, None)\n        if type(name) is str and Path(name).is_absolute() and Path(name).is_file():\n            p = Path(name).resolve()\n            if p == Path(configuration['harness']['path']):\n                continue\n            b = p.read_bytes()\n            assert len(b) <= 4194304\n            origins[str(p)] = dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())\np = Path(sys.executable).resolve()\nb = p.read_bytes()\nassert len(b) <= 4194304\norigins[str(p)] = dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())\nassert len(origins) <= 200\nassert sum(r['bytes'] for r in origins.values()) <= 8 * 1048576\nruntime = exclusive(BASE / 'actual_control_runtime_admission.json', dict(\n    root='/root', admitted=True, pid=os.getpid(), rss_cap_bytes=256 * 1048576,\n    timeout_seconds=125, harness=configuration['harness'], guard_active=True,\n    qualification='Root issued this exact laun