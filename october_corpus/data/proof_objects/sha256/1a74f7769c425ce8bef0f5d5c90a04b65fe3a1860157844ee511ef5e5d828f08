class _AuthenticatedLocations:
    """Invocation-local storage, never an independent acquisition authority.

    capture is installed ONLY immediately after the unchanged full compact
    authentication. Its matching inverse reauthenticates all the same whole
    files and exact selected LF lines against that table before returning it.
    No caller-provided state/map or global cache enters the export API.
    """
    __slots__ = ('_authenticate', '_captured', 'reauthentications', '_released')

    def __init__(self):
        self._authenticate = None
        self._captured = None
        self.reauthentications = 0
        self._released = False

    def capture(self, pins, groups, expected):
        if self._captured is None:
            need(type(self.reauthentications) is int and self.reauthentications == 0
                 and self._released is False and expected is not None,
                 'one first compact capture of a live expected table')
            self._captured = (pins, groups, expected)
        else:
            need(type(self._captured) is tuple and len(self._captured) == 3
                 and self._released is True and self.reauthentications == 1
                 and self._captured[2] is None,
                 'final compact follows completed inverse scratch retirement')
            prior_pins, prior_groups, unused = self._captured
            need(pins == prior_pins and groups == prior_groups,
                 'same full canonical file/group values on later compact checks')

    def authenticate(self, pins, groups):
        need(self._captured is not None and self._authenticate is not None,
             'reuse only after this complete compact authentication')
        need(type(self._captured) is tuple and len(self._captured) == 3
             and type(self.reauthentications) is int and self.reauthentications == 0
             and self._released is False and self._captured[2] is not None,
             'one complete inverse authentication while the captured table is live')
        prior_pins, prior_groups, expected = self._captured
        need(pins == prior_pins and groups == prior_groups,
             'entire same file identities and ordered multiplicities before reuse')
        # Equality above has discharged the only use of the first compact's
        # containers. Keep the equal inverse wire; retain the SAME digest map.
        self._captured = (pins, groups, expected)
        del prior_pins, prior_groups
        # This is the SAME private original function, now its expected branch.
        # It streams every raw file, recomputes each selected SHA and compares
        # it to this complete map. Returning the map changes identity only.
        need(self._authenticate(pins, groups, expected=expected) is None,
             'complete fresh whole-file and exact LF digest authentication')
        self.reauthentications += 1
        return expected

    def release_expected(self):
        need(type(self._captured) is tuple and len(self._captured) == 3
             and type(self.reauthentications) is int and self.reauthentications == 1
             and self._released is False and self._captured[2] is not None,
             'retire scratch once, after one successful full inverse authentication')
        pins, groups, expected = self._captured
        self._captured = (pins, groups, None)
        self._released = True
        need(self._captured[0] is pins and self._captured[1] is groups
             and self._captured[2] is None,
             'retirement preserves the exact pins/groups and drops only expected')
        # expected is a local reference only; it dies at this callback return.

    def clear(self):
        self._captured = None
        self._authenticate = None
        self._released = True


