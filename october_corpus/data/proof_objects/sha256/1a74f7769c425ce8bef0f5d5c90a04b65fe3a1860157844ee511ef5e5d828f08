def load_callbacks(contract):
    # The slot is private to one derived accessor. No wire, raw bytes, leaf
    # digest map or old verdict is retained. The immediate call site can only
    # delete dead wire bindings between expansion and consumption.
    slot=[None]
    def expand(codec,value,*,envelope):
        need(slot[0]is None,'no outstanding local logical-size fact')
        fact=RootLogicalSizeFact(codec)
        try:
            state=expand_current(contract,codec,value,envelope=envelope,size_fact=fact)
            fact.publish(state,envelope);slot[0]=fact;return state
        except BaseException:
            fact.discard();slot[0]=None;raise
    def consume(codec,envelope,state):
        fact=slot[0];slot[0]=None
        need(type(fact)is RootLogicalSizeFact,'only the completed local expansion publishes a size fact')
        return fact.consume(codec,envelope,state)
    return expand,consume

