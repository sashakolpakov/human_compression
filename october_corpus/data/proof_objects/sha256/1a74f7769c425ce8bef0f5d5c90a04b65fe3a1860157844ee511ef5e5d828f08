def root_current_wire_size(codec,envelope,value,hashes=None):
    """Exact CURRENT reference-envelope JSON bytes, including its final LF.

    Streaming visits every locator occurrence; it does not build the legacy
    SHA/triple representation or deduplicate ordered selected occurrences.
    All rich inverse, shape, LF authentication and canonicality checks remain
    obligations of the original compact/expand functions around this count.
    """
    codec.legacy()
    codec.need((codec.MAX_RAW,codec.MAX_PACKED)==(64*2**20,8*2**20),
        'current-wire method retains64MiB raw and8MiB packed')
    codec.need(type(envelope)is dict and set(envelope)=={'schema','head','producer_case','upstream_acceptance','source_profile'}
        and envelope['schema']==codec.SCHEMA and type(value)is dict and value.get('schema')==codec.WIRE,
        'current literal envelope and locator grammar')
    total=1
    for i,chunk in enumerate(codec.json.JSONEncoder(separators=(',',':'),ensure_ascii=True).iterencode(dict(envelope,state=value))):
        total+=len(chunk.encode('ascii'))
        codec.need(total<=codec.MAX_RAW,'exact CURRENT reference envelope64MiB including LF')
    return total

class RootLogicalSizeFact:
    """One immediate same-process proof, published only after full expansion."""
    __slots__=('codec','owner','token','phase','pending','fact','providers','wire_providers','constants','metric','counter')
    def __init__(self,codec):
        self.codec=codec;self.owner=os.getpid();self.token=object()
        self.metric=ROOT_WIRE_QUOTA;self.counter=root_current_wire_size
        self.phase='EXPANDING';self.pending=None;self.fact=None
        names=('need','legacy','logical_reference_size','logical_size','expand','compact','authenticate_lines')
        self.providers=tuple((name,getattr(codec,name))for name in names)
        legacy=codec._OLD;codec.need(legacy is not None,'already acquired actual legacy provider')
        self.wire_providers=(legacy,legacy.W,tuple((name,getattr(legacy.W,name))for name in
            ('need','digest','pin_shape','reference','unwire','wire')))
        self.constants=(codec.MAX_RAW,codec.SCHEMA,codec.WIRE,legacy.SCHEMA,legacy.O,legacy.O.WIRE,codec.MAX_PACKED)
    def guard(self):
        c=self.codec;c.need(self.owner==os.getpid() and self.metric==ROOT_WIRE_QUOTA
            and self.counter is root_current_wire_size,'same actor and versioned current-wire counter')
        c.need(all(getattr(c,name)is provider for name,provider in self.providers),
            'every acquired original codec provider remains identical')
        legacy,w,providers=self.wire_providers
        c.need(c._OLD is legacy and legacy.W is w and all(getattr(w,name)is provider for name,provider in providers),
            'every actual original typed wire provider remains identical')
        c.need(legacy.O is self.constants[4]and self.constants==(c.MAX_RAW,c.SCHEMA,c.WIRE,legacy.SCHEMA,legacy.O,legacy.O.WIRE,c.MAX_PACKED),
            'same complete legacy format and physical bound')
    def discard(self):
        self.pending=None;self.fact=None;self.phase='DISCARDED'
    def count(self,envelope,value,hashes):
        try:
            self.guard();self.codec.need(self.phase=='EXPANDING'and self.pending is None and self.fact is None,
                'one current-wire size calculation in this expansion')
            self.phase='COUNTING'
            root_observe('count.begin');length=self.counter(self.codec,envelope,value,hashes);root_observe('count.end')
            self.codec.need(type(length)is int and 0<=length<=self.codec.MAX_RAW,'exact bounded integer counter result')
            self.pending=(length,envelope);self.phase='COUNTED';return length
        except BaseException:
            self.discard();raise
    def publish(self,state,envelope):
        try:
            self.guard();self.codec.need(self.phase=='COUNTED'and type(self.pending)is tuple
                and len(self.pending)==2 and self.pending[1]is envelope and self.fact is None,
                'count belongs to this exact immediately expanded envelope')
            self.codec.need(type(state)is dict,'same full typed result after the unchanged inverse')
            length=self.pending[0];self.pending=None
            self.fact=(self.token,length,state,envelope);self.phase='PUBLISHED';root_observe('publish')
        except BaseException:
            self.discard();raise
    def consume(self,codec,envelope,state):
        try:
            root_observe('consume.begin');self.guard();codec.need(codec is self.codec and self.phase=='PUBLISHED'
                and type(self.fact)is tuple and len(self.fact)==4 and self.fact[0]is self.token
                and type(self.fact[1])is int and self.fact[2]is state and self.fact[3]is envelope,
                'one immediate exact codec/state/envelope/token size obligation')
            length=self.fact[1];self.fact=None;self.phase='CONSUMING'
            # These retain the immediate logical_size entry's legacy Source
            # authentications. Their two acquire calls remain actual calls.
            legacy=codec.legacy();self.guard()
            codec.need(legacy is self.wire_providers[0]and 0<=length<=codec.MAX_RAW,
                'same exact current-wire length and unchanged physical guard')
            self.phase='CONSUMED';root_observe('consume.end');return length
        except BaseException:
            self.discard();raise

