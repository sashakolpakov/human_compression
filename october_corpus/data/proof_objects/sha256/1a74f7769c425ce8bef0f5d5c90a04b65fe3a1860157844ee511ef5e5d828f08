def _text(contract,ref,name):
    raw=contract.source_text(ref)
    rows=[n for n in ast.parse(raw,filename=ref['path']).body if isinstance(n,ast.FunctionDef)and n.name==name]
    need(len(rows)==1,'one exact retained provider body')
    return ast.get_source_segment(raw,rows[0])

def _edit(before,old,new):
    need(before.count(old)==1 and new not in before,'one explicit private provider site')
    after=before.replace(old,new,1)
    need(after.replace(new,old,1)==before,'whole literal private provider inverse')
    return after

