Author /root/middle_dictionary_author. A separately adopted detail is mandatory.
"""
import copy

def need(ok,why):
    if not ok:raise ValueError(why)

def project(before,base_ref,acceptance,acceptance_ref,detail):
    """Compact semantic refactor, preserving the whole old object in detail."""
    need(acceptance['schema']=='ROOT_ACCEPTED_L026_ROTATION_INVARIANT_SUBSET_NONGENERATION_V1'
         and acceptance['root']=='/root'and acceptance['adopted']is True
         and acceptance['scope_digest']==detail['scope_digest']
         and acceptance['validator']==detail['validator']and acceptance['validation_plan']==detail['plan']
         and acceptance['new_subset_count']==12 and acceptance['prior_nonfree_count']==17688
         and acceptance['remaining_free_count']==28896 and acceptance['new_subset_mass']==12288,
         'separate actual Root typed acceptance, never an unadopted candidate')
    need(detail['schema']=='L026_VALIDATED_PARTIAL_SUBSET_NONGENERATION_DETAIL_V1'
         and detail['adopted']is False and detail['Root_adoption_owed']is True
         and detail['whole_previous_journal']==base_ref
         and detail['whole_old_nonfree_journal_object']==before['L026']['nonfree_product_deductions']
         and detail['prior_nonfree_count']==17688 and detail['new_free_subset_count']==12
         and detail['free_components_still_unresolved']==28896
         and acceptance['prior_nonfree_adoption']==detail['prior_nonfree_adoption'],
         'whole exact old journal/nonfree object retained and typed new counts joined')
    need(acceptance['validated_detail']['bytes']>0 and len(acceptance_ref['sha256'])==64,
         'actual entire retained detail/acceptance references, not a future guessed pin')
    out=copy.deepcopy(before)
    del out['L026']['nonfree_product_deductions']
    out['L026']['nongeneration_progress']=dict(
        Root_adoption=acceptance_ref,nonfree_orbits=17688,free_subset_orbits=12,
        total_nongenerating=17700,free_orbits_unresolved=28896,
        qualification='Rotation/three-mark nongeneration only; full old facts and all original premises are retained in the adopted detail. Generation, IP, reversal, other endpoints and manuscript closure remain owed.')
    out['L026']['next']='Resolve generation on28896 remaining free product orbits, then endpoint reversal and remaining endpoints under all retained premises.'
    # This pure function intentionally leaves actor/time/method ancestry/CAS and
    # all unrelated Source facts to the separately reviewed journal constructor.
    need(all(out[k]==before[k]for k in before if k!='L026'),'all unrelated journal fields literal')
    prior=copy.deepcopy(out['L026']);del prior['nongeneration_progress'];prior['nonfree_product_deductions']=detail['whole_old_nonfree_journal_object'];prior['next']=before['L026']['next']
    need(prior==before['L026'],'exact whole old L026 object is recoverable')
    return out
