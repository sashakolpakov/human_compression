{"author":"/root/journal_peer","full_old_and_new":[{"body":"\"\"\"UNRUN bounded cached original Fi22 r/s walk hints; /root/journal_peer.\nWhole c942 ancestry is retained. New seed/cursor/cached-product branches only;\noriginal kernel and independent supplied268d strict ABI remain unchanged.\nNo finite miss proves absence; no supplier output grants proof authority.\n\"\"\"\nimport time\nSTART=time.monotonic()\nimport argparse,hashlib,json,math,os,resource,signal,stat,struct,sys\nfrom pathlib import Path\nENV4=('COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG','OPENSSL_CONF','OPENSSL_MODULES')\nSCOPE='7795d9d9d4bbf392cb5a943053372149950eef15d4bd468a63e0cc41f5fcce3a'\nSELECTOR=dict(first_block_index=2,endpoint_position=18,local_class_position=164,middle_block_index=2,first_ambient_class_position=13,middle_ambient_class_position=13)\ndef need(ok,message):\n    if not ok:raise ValueError(message)\n\n\ndef can(value):return(json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)+'\\n').encode()\n\n\ndef decode(raw):\n    def pairs(items):\n        out={}\n        for key,value in items:need(key not in out,'unique JSON keys');out[key]=value\n        return out\n    return json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))\n\n\nclass Budget:\n    def __init__(self):self.refs={};self.raw={};self.bytes=0;self.peak=0\n    def tick(self):\n        rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin'else 1024);self.peak=max(self.peak,rss)\n        need(rss<128*2**20 and time.monotonic()-START<140,'whole128MiB/140s original caller envelope')\n    def read(self,ref,fresh=False):\n        self.tick();need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}\n            and type(ref['path'])is str and type(ref['bytes'])is int and 0<=ref['bytes']<=2**21\n            and type(ref['sha256'])is str and len(ref['sha256'])==64\n            and set(ref['sha256'])<=set('0123456789abcdef'),'whole bounded physical role')\n        need(self.refs.get(ref['path'],ref)==ref,'one immutable physical version')\n        if ref['path']in self.raw and not fresh:return self.raw[ref['path']]\n        need(self.bytes+ref['bytes']<=8*2**20 and(ref['path']in self.refs or len(self.refs)<32),'whole first/final8MiB/32-path read scope')\n        p=Path(ref['path']);a=p.lstat();need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)\n            and a.st_nlink==1 and a.st_size==ref['bytes'],'canonical single-link physical input')\n        with p.open('rb')as f:b=os.fstat(f.fileno());raw=f.read(ref['bytes']+1);c=os.fstat(f.fileno())\n        sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)\n        need(sig(a)==sig(b)==sig(c)==sig(p.lstat())and len(raw)==ref['bytes']and hashlib.sha256(raw).hexdigest()==ref['sha256'],\n             'stable entire actual physical role')\n        self.refs[ref['path']]=ref;self.raw[ref['path']]=raw;self.bytes+=len(raw);return raw\n    def doc(self,ref):return decode(self.read(ref))\n    def final(self):\n        for ref in list(self.refs.values()):self.read(ref,True)\n\n\nclass Work:\n    def __init__(self,check,cap=10000000,seconds=20):\n        need(type(cap)is int and 0<cap<=10000000 and type(seconds)in(int,float)and 0<seconds<=20,'unchanged finite shared work cap')\n        self.units=0;self.cap=cap;self.seconds=seconds;self.start=time.monotonic();self.check=check;self.labels={}\n    def charge(self,amount,label):\n        need(type(amount)is int and amount>=0,'typed nonnegative complete work charge');self.check()\n        need(amount<=self.cap-self.units and time.monotonic()-self.start<self.seconds,'shared10M/20s point/field/framing budget')\n        self.units+=amount;self.labels[label]=self.labels.get(label,0)+amount\n\n\ndef load_kernel(ref,budget,source_bytes):\n    raw=budget.read(ref);need(len(raw)<=16384 and len(raw)+source_bytes<=50000,'whole compiled mathematical Source namespace50k')\n    ns={'__name__':'l026_actual_supplied_cycle_kernel','__file__':ref['path']}\n    exec(compile(raw,ref['path'],'exec'),ns)\n    for name in('decode_operands','prepare_triangle','rotation_word','check_cycle','verify_pair'):\n        need(ns[name].__globals__ is ns and ns[name].__code__.co_filename==ref['path'],'genuine exact current provider namespace/filename')\n    return ns\n\n\ndef imported_context(plan,budget,work):\n    need(plan['scope_digest']==SCOPE and plan['original_selector']==SELECTOR,'same currently acquired original endpoint/middle subject')\n    R=plan['roles']\n    def document(name):\n        work.charge(2*R[name]['bytes'],'complete_retained_premise_JSON_byte_admission')\n        return budget.doc(R[name])\n    a=document('operand_adoption');f=document('free_adoption')\n    need(a['schema']=='ROOT_ACCEPTED_L026_PRIME_CYCLE_OPERAND_DATA_V1'and a['root']=='/root'and a['adopted']is True\n        and f['schema']=='ROOT_L026_ACCEPTED_FREE_PRODUCT_WITNESS_PROJECTION_V1'and f['root']=='/root'and f['adopted']is True\n        and a['operand_bytes']==52658 and f['free_rows']==28908\n        and a['all28908_generation_questions_unresolved']is f['all28908_generation_questions_unresolved']is True,\n        'actual metadata operand/witness adoptions, not a transferred scientific verdict')\n    need(a['outputs']['operands.bin']==R['operands']and a['outputs']['premises.json']==R['operand_premises']\n        and a['outputs']['byte_inverse.json']==R['operand_inverse']and a['outputs']['projection.json']==R['operand_projection']\n        and f['outputs']['free_witnesses.bin']==R['witnesses']and f['outputs']['projection.json']==R['free_projection'],\n        'exact whole adopted byte/framing/premise outputs')\n    premises=document('operand_premises');inverse=document('operand_inverse');projection=document('operand_projection');free=document('free_projection')\n    need(premises['schema']=='L026_PRIME_CYCLE_OPERAND_RETAINED_PREMISES_V1'\n        and premises['exact_original_scope']==projection['scope_digest']==free['scope_digest']==SCOPE\n        and premises['path_max']==10 and premises['d_image_elementary_map_bound']==21\n        and premises['b_image_elementary_map_bound']==63 and premises['rotation_image_elementary_map_bound']==64\n        and premises['seed_equals_first_Q_vector_proved_by_same_accepted_compact_identity']is True\n        and projection['qualified_original_a_c_d0_A_and_tree']is True\n        and inverse['schema']=='L026_PRIME_CYCLE_OPERAND_EXACT_BYTE_INVERSE_V1'\n        and free['free_projected']==28908 and free['exact_literal_record_bytes']is True,\n        'actual complete operand/witness identity with retained exact inverse, scope and path bounds')\n    imports=premises['inherited_member_and_Reader_imports']\n    need(imports['original_G_normal_in_A']is True and imports['GAP_IsNormal_A_G_means_G_normal_in_A']is True\n        and imports['same_accepted_original_degree3510_action']is True\n        and imports['original_exact_orders_and_full_class_predicates_borrowed']is True\n        and premises['named_group_or_class_or_GAP_classification_reproved']is False\n        and 'GLOBAL block2 class'in premises['qualification']and 'H=B'in premises['qualification'],\n        'explicit imported known-G seed/normality/faithful Reader/class/graph/two-fibre/qualified H=B meanings')\n    theorem=document('maximal_orders');review=document('theorem_review');note=document('theorem_source_note');handoff=document('theorem_handoff')\n    work.charge(2*R['theorem_argument']['bytes'],'whole_written_theorem_byte_admission')\n    budget.read(R['theorem_argument'])\n    need(theorem['schema']=='FI22_COMPLETE_SIMPLE_MAXIMAL_ORDER_PREMISE_V1'and theorem['named_group']=='Fi22'\n        and theorem['classification_is_borrowed']is True and theorem['completeness_independently_reproved_here']is False\n        and theorem['Aut_Fi22_substitution_permitted']is False and theorem['conjugacy_classes']==14,\n        'borrowed complete simple Fi22 classification with1988 correction; not Aut substitution')\n    rows=theorem['rows'];need(type(rows)is list and len(rows)==12,'all twelve types/fourteen conjugacy classes')\n    total=0\n    for row in rows:\n        work.charge(64,'whole_imported_maximal_order_divisibility_row')\n        n,k=row['order'],row['conjugacy_classes']\n        need(type(n)is type(k)is int and n>0 and k>0 and not(n%11==n%13==0)\n            and row['divisible_by_11']==(n%11==0)and row['divisible_by_13']==(n%13==0),\n            'every imported proper maximal omits one prime')\n        total+=k\n    need(total==14 and review['schema']=='DISTINCT_FI22_PRIME_CYCLE_WRITTEN_THEOREM_REVIEW_V1'\n        and review['status']=='PASS_DISTINCT_FI22_PRIME_CYCLE_WRITTEN_THEOREM'and review['reviewer']==review['actor']=='/root'\n        and review['blockers']==[]and review['all14_maximal_classes_accounted_for']is True\n        and review['exact_G_membership_required']is True and review['Aut_G_substitution_forbidden']is True\n        and review['maximal_avoidance_and_point_cycle_proof_accepted']is True\n        and review['source_handoff']==R['theorem_handoff'],'same actual written-theorem review only, not a current checker verdict')\n    need(handoff['artifacts']['ARGUMENT.rst']==R['theorem_argument']and handoff['artifacts']['maximal_orders.json']==R['maximal_orders']\n        and handoff['artifacts']['source_note.json']==R['theorem_source_note']\n        and note['actual_input_gate_and_point_action_premises']['original_input_acceptance']==premises['original_input']\n        and note['actual_input_gate_and_point_action_premises']['point_bridge_acceptance']==premises['whole_old_proof_roles']['bridge_root'],\n        'exact same original G/Reader/bridge membership and classified theorem source lineage')\n    return dict(premises=premises,adopted_operand=a,adopted_witness=f,qualification=premises['qualification'])\n\n\nclass SearchStop(Exception):pass\n\n\nclass SearchWork(Work):\n    def __init__(self,check):\n        super().__init__(check);self.start=START;self.proposing=False;self.proposal_units=0;self.proposal_cap=0\n    def begin(self,cap):\n        need(type(cap)is int and 0<cap<=6000000,'finite new supplier search allowance at most6M')\n        self.proposal_units=self.units;self.proposal_cap=cap;self.proposing=True\n    def charge(self,amount,label):\n        need(type(amount)is int and amount>=0,'typed whole work charge')\n        if self.proposing:\n            rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin'else 1024)\n            if amount>self.proposal_cap-(self.units-self.proposal_units)or time.monotonic()-START>=14 or rss>=112*2**20:\n                raise SearchStop('finite6M/14s/112MiB proposal reserve reached')\n        return super().charge(amount,label)\n\n\nclass AllOperationBudget(Budget):\n    def __init__(self):super().__init__();self.work=None\n    def read(self,ref,fresh=False):\n        need(type(ref)is dict and type(ref.get('bytes'))is int and ref['bytes']>=0,'typed byte admission before all IO')\n        if fresh or ref.get('path')not in self.raw:\n            self.work.charge(ref['bytes'],'every_actual_physical_input_byte_before_IO')\n        return super().read(ref,fresh)\n    def doc(self,ref):\n        raw=self.read(ref);self.work.charge(2*len(raw),'every_current_config_or_metadata_JSON_byte_before_decode')\n        return decode(raw)\n\n\ndef load_support(ref,budget,names,tag):\n    raw=budget.read(ref);need(len(raw)<=16384,'bounded exact walk/provider Source')\n    budget.work.charge(2*len(raw),'whole_support_compile_Source_bytes')\n    ns={'__name__':tag,'__file__':ref['path']};exec(compile(raw,ref['path'],'exec'),ns)\n    for name in names:need(ns[name].__globals__ is ns and ns[name].__code__.co_filename==ref['path'],'exact current support provider namespace')\n    return ns\n\ndef current_unpaid(plan,budget,work,witnesses):\n    a=budget.doc(plan['roles']['current_generation_adoption']);p=budget.doc(plan['roles']['current_partition'])\n    need(a['schema']=='ROOT_ACCEPTED_L026_ADDITIONAL_GENERATION_AND_SEPARATE_RANK3_IP_V1'\n        and a['root']=='/root'and a['adopted']is True and a['scope_digest']==SCOPE\n        and a['validated_partition']==plan['roles']['current_partition']\n        and a['original_free_witness_adoption']==plan['roles']['free_adoption']\n        and a['original_operand_adoption']==plan['roles']['operand_adoption'],'actual same-scope current Root ledger/partition join')\n    need(p['schema']=='L026_APPEND_GEN_AND_SEPARATE_IP_EXACT_TYPED_PARTITION_V1'and p['scope_digest']==SCOPE\n        and p['original_free_space']==28908 and p['unchanged_total_NEG_count']==17712\n        and p['total_GENERATING_count']==7 and p['remaining_without_other_generation_registration']==28877\n        and p['total_separate_rank3_IP_count']==7 and p['strict_results_IPcredit0_unchanged']is True\n        and p['remaining_middle_mass']==29570048,'exact present typed17712NEG/7GEN/separateIP7/28877unpaid ledger')\n    paid=set()\n    for rows in(p['all_prior_subset_owner_rows'],p['all_prior_generation_facts'],p['exact_new_original_owner_rows']):\n        need(type(rows)is list,'whole current typed paid rows')\n        for row in rows:\n            work.charge(128,'current_paid_witness_identity')\n            i=row['free_index'];need(type(i)is int and 0<=i<28908 and i not in paid,'unique typed paid index')\n            raw=witnesses[16*i:16*i+16];need(type(row['owner'])is int and row['owner']==struct.unpack_from('<I',raw)[0]\n                and row.get('witness_row_sha256',row.get('original_witness_row_sha256'))==hashlib.sha256(raw).hexdigest(),'current paid row exact original witness identity');paid.add(i)\n    need(len(paid)==31 and not(set(plan['selected_free_indices'])&paid),'every selected index is currently unpaid, no paid retries')\n\ndef checkpoint_notes(raw,plan,schedule,indices,witnesses,C,work):\n    work.charge(2*len(raw),'whole_untrusted_current_walk_checkpoint_semantics');value=decode(raw)\n    need(value['schema']=='L026_UNTRUSTED_CACHED_ROTATION_WALK_PROGRESS_V1'and value['program']==plan['program']\n        and value['scope_digest']==SCOPE and value['original_selector']==SELECTOR and value['schedule']==plan['schedule']\n        and value['operand_adoption']==plan['roles']['operand_adoption']and value['free_witness_adoption']==plan['roles']['free_adoption']\n        and value['selected_free_indices']==indices,'same exact current walk Source/schedule/window and old original imports')\n    notes=value['notes'];need(type(notes)is list and len(notes)<=len(indices),'finite untrusted checkpoint prefix')\n    out={}\n    for at,note in enumerate(notes):\n        i=note['free_index'];need(type(i)is int and i==indices[at],'same exact selected-prefix cursor identity')\n        raw=witnesses[16*i:16*i+16];owner=struct.unpack_from('<I',raw)[0];row_sha=hashlib.sha256(raw).hexdigest()\n        work.charge(192,'whole_bound_case_SHA_seed');seed=hashlib.sha256(bytes.fromhex(schedule['seed'])+bytes.fromhex(row_sha)).hexdigest()\n        out[i]=C['restore_note'](note,i,owner,row_sha,seed,schedule,3510,work)\n        need(at==len(notes)-1 or out[i]['outcome']!='unfinished','at most final untrusted row is incomplete')\n    return out\n\ndef seed_hints(raw,plan,witnesses,C,work):\n    work.charge(2*len(raw),'whole_old_hint_seed_semantics');value=decode(raw)\n    need(value['schema']=='L026_UNTRUSTED_PRIME_CYCLE_SEARCH_PROGRESS_V1'and value['scope_digest']==SCOPE\n        and value['original_selector']==SELECTOR and value['operand_adoption']==plan['roles']['operand_adoption']\n        and value['free_witness_adoption']==plan['roles']['free_adoption'],'same original imports for untrusted old hints only')\n    out={};need(type(value['notes'])is list and len(value['notes'])<=16,'finite legacy hint roster')\n    for note in value['notes']:\n        work.charge(128,'whole_legacy_hint_row_digest_and_identity')\n        i=note['free_index'];need(type(i)is int and 0<=i<28908 and i not in out,'unique typed old hint index')\n        row=witnesses[16*i:16*i+16];need(note['owner']==struct.unpack_from('<I',row)[0]and note['witness_row_sha256']==hashlib.sha256(row).hexdigest(),'whole legacy hint actual row')\n        hints=note['hints'];need(type(hints)is dict and set(hints)=={'prime11','prime13'},'exact untrusted old hint slots')\n        for p in(11,13):C['validate_part'](hints['prime'+str(p)],p,3510,work)\n        out[i]=dict(hints)\n    return out\n\ndef search_window(K,P,C,ctx,schedule,indices,witnesses,work,prior=None,seeds=None):\n    notes=[];records=[];visited=[];misses=[];existing=prior or{};status='finite_selected_walk_queue_completed';precomputed=False\n    try:\n        for i in indices:\n            work.charge(288,'whole_original_free_row_digest_and_seed')\n            raw=witnesses[16*i:16*i+16];owner,partner,mass,x,y,z=struct.unpack('<IIHHHH',raw)\n            need(owner<500178 and partner<500178 and mass==1024,'same exact adopted original free16B row')\n            row_sha=hashlib.sha256(raw).hexdigest();seed=hashlib.sha256(bytes.fromhex(schedule['seed'])+bytes.fromhex(row_sha)).hexdigest()\n            note=existing.get(i,C['empty_note'](i,owner,row_sha,seed,(seeds or{}).get(i)));notes.append(note)\n            if note['outcome']=='unfinished':\n                paths=K['prepare_triangle'](ctx,(x,y,z),work);note['active_step']=dict(phase='rotation_precompute')\n                maps=C['precompute_rotations'](K,ctx,paths,work,note['active_step']);precomputed=True\n                C['walk_row'](P,maps,note,schedule,work)\n            if note['outcome']=='pair_hint':records.append(dict(free_index=i,owner=owner,witness_row_sha256=row_sha,**note['hints']))\n            else:misses.append(i)\n            visited.append(i)\n    except SearchStop as error:status='soft_stop_with_exact_unvisited:'+str(error)\n    need(visited==indices[:len(visited)],'whole completed selected prefix only')\n    unvisited=indices[len(visited):]\n    need(sorted([r['free_index']for r in records]+misses+unvisited)==indices,'hints/unpaid finite misses/unvisited exact partition')\n    return dict(records=records,visited=visited,finite_misses=misses,unvisited=unvisited,notes=notes,status=status,precomputed=precomputed)\n\ndef main():\n    need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode\n        and not sys.flags.optimize and all(k not in os.environ for k in ENV4),'minimal EBS/ENV4 supplier')\n    signal.signal(signal.SIGALRM,lambda *_:(_ for _ in()).throw(TimeoutError('140s bounded Fi22 cycle hints')))\n    signal.setitimer(signal.ITIMER_REAL,max(.001,140-(time.monotonic()-START)))\n    ap=argparse.ArgumentParser(allow_abbrev=False);ap.add_argument('--self-sha256',required=True)\n    ap.add_argument('--plan',nargs=2,required=True);ap.add_argument('--Root-gate',nargs=2,required=True);a=ap.parse_args()\n    budget=AllOperationBudget();work=SearchWork(budget.tick);budget.work=work;work.charge(0,'whole_supplier_scope_from_START')\n    own=dict(path=str(Path(__file__).resolve(strict=True)),bytes=Path(__file__).stat().st_size,sha256=a.self_sha256)\n    need(own['bytes']<=32768,'bounded untrusted supplier Source');budget.bytes+=own['bytes'];work.charge(own['bytes'],'current_supplier_Source_bootstrap');budget.read(own)\n    p=Path(a.plan[0]);pref=dict(path=str(p),bytes=p.stat().st_size,sha256=a.plan[1]);need(pref['bytes']<=65536,'bounded actual supplier plan');plan=budget.doc(pref)\n    g=Path(a.Root_gate[0]);gref=dict(path=str(g),bytes=g.stat().st_size,sha256=a.Root_gate[1]);need(gref['bytes']<=8192,'bounded exact Root proposal release');gate=budget.doc(gref)\n    need(plan['schema']=='L026_UNTRUSTED_CACHED_ROTATION_WALK_PLAN_V1'and plan['program']==own\n        and gate['schema']=='ROOT_AUTHORIZED_L026_CACHED_ROTATION_WALK_SUPPLIER_V1'and gate['root']=='/root'and gate['adopted']is True\n        and gate['candidate_generation_only_aut