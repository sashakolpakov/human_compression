{"Root_authority":false,"Source_or_controls_activated":false,"all_old_Source_files_unchanged":true,"author":"/root/f004_register","complete_prior_SourceTEXT":[{"complete_UTF8":"\"\"\"Unselected Source: metadata registration of forty already accepted F004 jobs.\n\nAuthor /root/f004_register. No represented scientific imports or evaluation.\nOld 1f77/099c/46c1 Sources supply attributed stable-lock, complete inverse,\nbefore/planned preservation, PREPARED journal and sequential CAS conventions.\nThis distinct edition needs its own Source review, actual metadata controls,\nRoot closure import and release, runtime guard, and post-CP11262 fresh plan.\nThe file in /private/tmp is never an installed or released entry point.\n\"\"\"\nfrom pathlib import Path\nimport argparse\nimport copy\nimport fcntl\nimport hashlib\nimport json\nimport os\nimport resource\nimport shlex\nimport stat\nimport sys\nimport time\n\nAUTHOR = '/root/f004_register'\nROOT = '/root'\nS = Path('/Users/sasha/medusa/research/leemans')\nM = S / 'maintenance/intake'\nR = M / 'f004_closed40_batch_registration'\nCURRENT = S / 'reboot_20261013/CURRENT.json'\nSTATUS = M / 'current_status.json'\nLOCK = M / 'root_state.lock'\nKIND = 'IMPORT_FORTY_PREVIOUSLY_ROOT_ACCEPTED_F004_Q11_COMPLETE_JOBS'\nMIB = 2**20\nLIMITS = dict(source_bytes=65535, file_bytes=4*MIB, read_bytes=64*MIB,\n              new_bytes=16*MIB, paths=512, rss_bytes=256*MIB,\n              child_timeout_seconds=125, internal_seconds=115)\nJOBS = [[10,5],[11,4],[12,4],[15,5],[15,4],[16,4],[17,4],[18,5],\n        [19,4],[20,5],[23,4],[37,5],[47,5],[50,5],[56,5],[61,5],\n        [66,5],[72,5],[75,5],[77,5],[82,5],[94,5],[99,5],[107,5],\n        [110,5],[115,5],[117,5],[127,5],[151,5],[153,5],[154,5],\n        [157,5],[162,5],[163,5],[171,5],[173,5],[184,5],[189,5],\n        [190,5],[193,5]]\nALIASES = dict(\n    CURRENT=[['root_f004_q11_ledger_current'], ['F004_q11_latest_ledger'],\n             ['F004_q11_current'], ['F004_status']],\n    STATUS=[['root_f004_q11_ledger_current'], ['F004','latest_ledger'],\n            ['F004','q11_completed'], ['F004','q11_pending'],\n            ['F004_q11_current'], ['F004_q11_latest_ledger']])\nLEGACY_KEYS = ['q11_actual_lower_closed', 'q11_closed', 'q11_actual_pending',\n               'q11_pending', 'q11_remaining', 'q11_current_pending_plan',\n               'q11_pending_registration', 'q11_latest_adoption',\n               'q11_authoritative_latest', 'q11_batch_registration_current']\nCHECKS = ['whole_new_Source', 'exact40_existing_Root_closures_and_API_joins',\n          'ordered197_to157_inverse', 'ten_aliases_and_explicit_legacy_leaves',\n          'unknown_fields_and_single_job_histories_retained',\n          'four_idle_arrays_stable_lock_BOTH_CAS',\n          'whole_before_planned_PREPARED_sequential_recovery',\n          'complete64MiB_read_16MiB_return_runtime_invoice',\n          'no_new_science_or_Original_credit']\nCONTROL_CASES = ['valid_exact40', 'bool_as_count', 'missing_or_extra_job',\n                 'job115_API_omitted', 'wrong_job23_selector',\n                 'pending_order_changed', 'unknown_alias_key_changed',\n                 'legacy_active_counter_omitted', 'stale_CURRENT',\n                 'stale_STATUS', 'nonempty_ownership', 'orphan_stage',\n                 'lock_inode_changed', 'guard_or_release_unbound',\n                 'output_or_read_bank_over_cap', 'interrupted_second_rename']\nSTAGE_SUFFIX = '.f004_closed40.pending'\nOLD_STAGE_SUFFIXES = ('.pending', '.f004_rank5_pending', '.f004_endpoint_pending',\n                     '.f004_projective_pending', '.q11_mixed_job.pending',\n                     '.q11_complete_job.pending')\n\n\ndef need(ok, why):\n    if not ok:\n        raise ValueError(why)\n\n\ndef can(value):\n    return (json.dumps(value, sort_keys=True, separators=(',', ':'),\n                       ensure_ascii=True, allow_nan=False) + '\\n').encode()\n\n\ndef equal(a, b):\n    if type(a) is not type(b):\n        return False\n    if type(a) is dict:\n        return a.keys() == b.keys() and all(equal(a[k], b[k]) for k in a)\n    if type(a) is list:\n        return len(a) == len(b) and all(equal(x,y) for x,y in zip(a,b))\n    return a == b\n\n\ndef strict(raw):\n    def pairs(rows):\n        out = {}\n        for key, value in rows:\n            need(key not in out, 'duplicate JSON key')\n            out[key] = value\n        return out\n    def bad(value):\n        raise ValueError('nonfinite JSON token: ' + value)\n    return json.loads(raw.decode('utf-8'), object_pairs_hook=pairs,\n                      parse_constant=bad)\n\n\ndef ref(path, raw):\n    return dict(path=str(path), bytes=len(raw),\n                sha256=hashlib.sha256(raw).hexdigest())\n\n\ndef valid_ref(row):\n    need(type(row) is dict and set(row) == {'path','bytes','sha256'}\n         and type(row['path']) is str and Path(row['path']).is_absolute()\n         and type(row['bytes']) is int and 0 <= row['bytes'] <= LIMITS['file_bytes']\n         and type(row['sha256']) is str and len(row['sha256']) == 64\n         and all(c in '0123456789abcdef' for c in row['sha256']),\n         'complete bounded path/bytes/sha256 descriptor')\n    return row\n\n\ndef signature(s):\n    return (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,\n            s.st_mtime_ns,s.st_ctime_ns)\n\n\nclass IO:\n    \"\"\"Count every explicit read/open and new byte; no hidden recheck bank.\"\"\"\n    def __init__(self):\n        self.start = time.monotonic()\n        self.read_bytes = 0\n        self.new_bytes = 0\n        self.paths = set()\n        self.opens = 0\n        self.writes = 0\n        self.read_versions = {}\n\n    def budget(self):\n        need(sys.platform == 'darwin'\n             and time.monotonic()-self.start <= LIMITS['internal_seconds']\n             and resource.getrusage(resource.RUSAGE_SELF).ru_maxrss <= LIMITS['rss_bytes'],\n             'Darwin metadata caller <=256MiB/115s; actual guard125s separately required')\n\n    def charge_path(self, path):\n        self.paths.add(str(path))\n        need(len(self.paths) <= LIMITS['paths'], 'single complete512-path bank')\n\n    def read(self, row, live=False):\n        valid_ref(row)\n        path = Path(row['path'])\n        need(path.resolve(strict=True) == path, 'no symlink or noncanonical input')\n        a = path.lstat()\n        need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1\n             and a.st_size == row['bytes'], 'ordinary single-link bounded whole input')\n        self.charge_path(path)\n        need(self.read_bytes + a.st_size <= LIMITS['read_bytes'], 'single64MiB actual read bank')\n        self.read_bytes += a.st_size\n        self.opens += 1\n        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n        try:\n            b = os.fstat(fd)\n            chunks = []\n            left = a.st_size\n            while left:\n                block = os.read(fd, min(left, 65536))\n                need(bool(block), 'no short whole input')\n                chunks.append(block)\n                left -= len(block)\n            need(os.read(fd, 1) == b'', 'no growing whole input')\n            c = os.fstat(fd)\n        finally:\n            os.close(fd)\n        raw = b''.join(chunks)\n        need(signature(a) == signature(b) == signature(c) == signature(path.lstat())\n             and equal(ref(path,raw),row), 'whole stable expected input bytes')\n        if not live:\n            prior = self.read_versions.setdefault(str(path), row)\n            need(equal(prior,row), 'one immutable version per path')\n        self.budget()\n        return raw\n\n    def doc(self, row, live=False):\n        return strict(self.read(row, live=live))\n\n    def write(self, path, raw):\n        need(type(raw) is bytes and len(raw) <= LIMITS['file_bytes']\n             and self.new_bytes + len(raw) <= LIMITS['new_bytes'],\n             'whole <=4MiB output in same complete16MiB new bank')\n        need(path.parent.resolve(strict=True) == path.parent\n             and not os.path.lexists(path), 'fresh ordinary-parent output')\n        self.charge_path(path)\n        self.new_bytes += len(raw)\n        self.writes += 1\n        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n        try:\n            done = 0\n            while done < len(raw):\n                n = os.write(fd, raw[done:])\n                need(n > 0, 'whole output write')\n                done += n\n            os.fsync(fd)\n        finally:\n            os.close(fd)\n        row = ref(path,raw)\n        self.read(row)\n        return row\n\n\ndef sync(path):\n    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\ndef at(value, path):\n    for key in path:\n        need(type(value) is dict and key in value, 'exact existing nested alias parent/key')\n        value = value[key]\n    return value\n\n\ndef parent(value, path):\n    return at(value,path[:-1]) if len(path)>1 else value\n\n\ndef idle(current, status):\n    for key in ('root_execution_ownership_latest','root_current_ownership',\n                'current_execution_ownership'):\n        need(type(current.get(key)) is dict\n             and equal(current[key].get('active_handles'),[]), 'actual CURRENT idle array: '+key)\n    need(equal(status.get('active_scientific_handles'),[]), 'actual STATUS idle array')\n\n\ndef capture(io, row, actor):\n    value = io.doc(row)\n    tool = value.get('actual_tool',{})\n    need(value.get('actor') == actor and type(tool.get('exit_code')) is int\n         and tool['exit_code'] == 0\n         and type(value.get('issued_command')) is str\n         and equal(shlex.split(value['issued_command']),value.get('issued_argv'))\n         and value.get('issued_tool_arguments',{}).get('cmd') == value['issued_command']\n         and value.get('terminal_observed') is True,\n         'whole genuine terminal API record, command and actor')\n    return value\n\n\ndef source_admission(io, plan, method, release_ref):\n    release = io.doc(release_ref)\n    need(release.get('schema') == 'ROOT_F004_CLOSED40_METADATA_SOURCE_RELEASE_V1'\n         and release.get('root') == ROOT and release.get('released') is True\n         and equal(release.get('method'),method) and equal(release.get('limits'),LIMITS)\n         and equal(release.get('required_checks'),CHECKS), 'own exact Root Source release')\n    peer = io.doc(release['independent_Source_review'])\n    reviewer = peer.get('reviewer')\n    need(type(reviewer) is str and reviewer not in (AUTHOR,ROOT)\n         and peer.get('schema') == 'INDEPENDENT_F004_CLOSED40_METADATA_SOURCE_REVIEW_V1'\n         and equal(peer.get('method'),method) and peer.get('verdict') == 'PASS'\n         and equal(peer.get('checks'),CHECKS) and equal(peer.get('blockers'),[]),\n         'actual distinct Source peer for this whole edition')\n    record = capture(io,release['independent_Source_execution'],reviewer)\n    need(equal(record.get('review_emission'),release['independent_Source_review']),\n         'peer execution emits the exact reviewed Source result')\n    controls = io.doc(release['actual_controls'])\n    need(controls.get('schema') == 'ROOT_F004_CLOSED40_ACTUAL_METADATA_CONTROLS_V1'\n         and controls.get('root') == ROOT and controls.get('accepted') is True\n         and equal(controls.get('method'),method)\n         and equal(controls.get('control_case_names'),CONTROL_CASES)\n         and controls.get('live_S_W_or_selector_writes') == 0\n         and controls.get('all_expected_outcomes_observed') is True,\n         'own actual finite metadata controls, no invented execution')\n    control_record = capture(io,release['actual_controls_execution'],ROOT)\n    need(equal(control_record.get('review_emission'),release['actual_controls']),\n         'actual metadata controls capture emits exact Root-accepted controls')\n    need(equal(release.get('plan_schema'),'ROOT_F004_CLOSED40_LIVE_METADATA_CAS_PLAN_V1')\n         and equal(plan.get('Source_release'),release_ref), 'this planned source ABI')\n\n\ndef runtime(io, plan, method):\n    gate = io.doc(plan['runtime_admission'])\n    started = io.doc(plan['runtime_started'])\n    need(gate.get('schema') == 'ROOT_F004_CLOSED40_METADATA_RUNTIME_ADMISSION_V1'\n         and gate.get('root') == ROOT and gate.get('admitted') is True\n         and equal(gate.get('method'),method) and equal(gate.get('limits'),LIMITS)\n         and gate.get('rss_cap_bytes') == LIMITS['rss_bytes']\n         and gate.get('timeout_seconds') == LIMITS['child_timeout_seconds']\n         and equal(gate.get('guard_and_recorder_return_reserve'),plan['guard_and_recorder_return_reserve'])\n         and gate.get('wrapper_reserve_bound_to_actual_guard') is True\n         and equal(gate.get('runtime_started'),plan['runtime_started'])\n         and started.get('pid') == os.getpid()\n         and started.get('actor') == ROOT and started.get('owned_processes_active') == 1\n         and started.get('guard_active') is True,\n         'actual process-bound256MiB/125s metadata runtime admission')\n    origin_rows = plan['runtime_inputs']\n    need(type(origin_rows) is list and len(origin_rows) <= 200, 'bounded complete runtime origins')\n    origins = {r['path']:valid_ref(r) for r in origin_rows}\n    need(len(origins) == len(origin_rows), 'unique runtime file paths')\n    for module in tuple(sys.modules.values()):\n        for field in ('__file__','__cached__'):\n            name = getattr(module,field,None)\n            if type(name) is str and Path(name).is_absolute() and Path(name).is_file():\n                need(str(Path(name).resolve()) in origins or str(Path(name).resolve()) == method['path'],\n                     'every actual loaded Source/cache origin in bounded runtime invoice')\n    need(str(Path(sys.executable).resolve()) in origins, 'actual interpreter origin prepaid')\n    for row in origin_rows:\n        io.read(row)\n    return gate\n\n\ndef accepted(io, plan):\n    index = io.doc(plan['closure_index'])\n    need(index.get('schema') == 'F004_CLOSED40_RESOLVED_PROOF_API_INDEX_V1'\n         and index.get('Root_authority') is False\n         and equal([r['original_job'] for r in index['rows']],JOBS)\n         and index.get('unresolved_genuine_API_links') == [], 'exact40 DATA index with resolved API metadata')\n    for row in index['rows']:\n        need(row.get('accepted_complete') is True and type(row.get('unpaid')) is int\n             and row['unpaid'] == 0 and row.get('genuine_checker_APIs'), 'all40 imported closures have genuine API joins')\n    proof_review = io.doc(plan['Root_closure_import'])\n    need(proof_review.get('schema') == 'ROOT_ACCEPTED_F004_CLOSED40_HISTORICAL_CLOSURE_IMPORT_V1'\n         and proof_review.get('root') == ROOT and proof_review.get('accepted') is True\n         and equal(proof_review.get('closure_index'),plan['closure_index'])\n         and equal(proof_review.get('ordered_jobs'),JOBS)\n         and proof_review.get('scientific_replays') == 0\n         and proof_review.get('whole_Original_credit') == 0\n         and equal(proof_review.get('metadata_packet_refs'),index['metadata_packet_refs']),\n         'actual Root import of old complete proofs, no new mathematical verdict')\n    components = proof_review['actual_metadata_components']\n    need(len(components) == len(index['metadata_packet_refs']), 'complete bounded old metadata component reviews')\n    for component, packet_ref in zip(components,index['metadata_packet_refs']):\n        packet = io.doc(packet_ref)\n        reviewed = io.doc(component['review'])\n        need(equal(component['packet'],packet_ref)\n             and reviewed.get('root') == ROOT and reviewed.get('accepted') is True\n             and equal(reviewed.get('packet'),packet_ref)\n             and reviewed.get('whole_input_paths') == packet['unique_paths']\n             and reviewed.get('whole_input_bytes') == packet['whole_bytes']\n             and reviewed.get('old_proof_mathematics_imported') is True,\n             'exact prior bounded metadata review receipt, not a new full sweep')\n        c = capture(io,component['actual_execution'],ROOT)\n        need(equal(c.get('review_emission'),component['review']), 'genuine component metadata return')\n    authorities = index['Root_authorities']\n    for row in authorities.values():\n        io.read(row)\n    # Only job23 has an explicitly adopted per-job selector in this imported index.\n    row = next(r for r in index['rows'] if r['original_job'] == [23,4])\n    selector = io.doc(row['current_per_job_selector'])\n    need(row['current_per_job_selector']['sha256'] == '2c79a9551b40789c187f1f48155f9aebb3fb1d47649b8c275ba9f3a5d27a8c03'\n         and row['Root_complete_authority']['sha256'] == '45a4cc2b8ff6058f263d36a47ffc40119bb6b4c8d54a61416bbb2fb81287ba09'\n         and selector.get('unresolved_positions') == 0\n         and selector.get('original_paid_count') == 217,\n         'job23 exact current closure selector;38IP distinct from43NG')\n    return index\n\n\ndef pending(io, plan):\n    old = io.doc(plan['old_pending'])\n    new = io.doc(plan['proposed_pending_DATA'])\n    if type(old) is dict:\n        old = old['pending_jobs']\n    need(type(old) is list and type(new) is list\n         and len(old) == 197 and len(new) == 157\n         and all(type(j) is list and len(j)==2 and all(type(n) is int for n in j) for j in old+new)\n         and len(set(map(tuple,old))) == 197 and len(set(map(tuple,new))) == 157,\n         'typed unique197/157 pending lists')\n    removed = [j for j in old if j not in new]\n    need(equal(removed,JOBS) and equal([j for j in old if j not in JOBS],new)\n         and all(j[1] == 4 for j in new), 'exact ordered40 removal and157 rank4 survivor inverse')\n    need(plan['old_pending']['sha256'] == 'aec6d95b246f34da1bd5485c0b1760749dcbaaf6939c1c7f82257d29a246c09b'\n         and plan['proposed_pending_DATA']['sha256'] == 'fc837748a687852e4bd9882ac469b9b964a5015846e5f1e23680c90fb8845b44',\n         'old actual pending bytes and exact proposed1196-byte output')\n    return old,new\n\n\ndef state_pair(io, before):\n    need(set(before) == {'CURRENT','STATUS'}\n         and before['CURRENT']['path'] == str(CURRENT)\n         and before['STATUS']['path'] == str(STATUS), 'exact two mutable observation roles')\n    raw = {k:io.read(r,live=True) for k,r in before.items()}\n    documents = {k:strict(v) for k,v in raw.items()}\n    idle(documents['CURRENT'],documents['STATUS'])\n    return documents,raw\n\n\ndef protected(io, plan):\n    for row in plan['protected_progress']:\n        need(row['path'] not in (str(CURRENT),str(STATUS)), 'mutable states excluded from immutable progress')\n        io.read(row)\n\n\ndef change(bank, path, after, patches, allow_absent=False):\n    target = parent(bank,path)\n    key = path[-1]\n    need(type(target) is dict and (key in target or allow_absent), 'existing exact alias or declared new batch leaf')\n    patch = dict(path=path,before_present=key in target,after_present=True,\n                 before=copy.deepcopy(target.get(key)),after=copy.deepcopy(after))\n    patches.append(patch)\n    target[key] = copy.deepcopy(after)\n\n\ndef inverse(before, after, patches):\n    restored = copy.deepcopy(after)\n    paths = [tuple(p['path']) for p in patches]\n    need(len(set(paths)) == len(paths), 'unique exact allowed change paths')\n    for a in paths:\n        for b in paths:\n            need(a == b or not (len(a)<len(b) and b[:len(a)] == a), 'no overlapping alias paths')\n    for patch in reversed(patches):\n        target = parent(restored,patch['path'])\n        key = patch['path'][-1]\n        need(equal(target[key],patch['after']), 'exact full planned typed patch')\n        if patch['before_present']:\n            target[key] = copy.deepcopy(patch['before'])\n        else:\n            del target[key]\n    need(equal(restored,before), 'whole exact typed inverse preserves EVERY un