nding bytes and exact proposed1196-byte output')\n    return old,new\n\n\ndef state_pair(io, before):\n    need(set(before) == {'CURRENT','STATUS'}\n         and before['CURRENT']['path'] == str(CURRENT)\n         and before['STATUS']['path'] == str(STATUS), 'exact two mutable observation roles')\n    raw = {k:io.read(r,live=True) for k,r in before.items()}\n    documents = {k:strict(v) for k,v in raw.items()}\n    idle(documents['CURRENT'],documents['STATUS'])\n    return documents,raw\n\n\ndef protected(io, plan):\n    for row in plan['protected_progress']:\n        need(row['path'] not in (str(CURRENT),str(STATUS)), 'mutable states excluded from immutable progress')\n        io.read(row)\n\n\ndef overview_import(io, plan, documents):\n    \"\"\"Import existing registered q8 context; never recompute a q8 proof.\"\"\"\n    q8=documents['CURRENT']['F004_q8_latest_ledger']\n    need(equal(q8,documents['STATUS']['F004_q8_latest_ledger']), 'whole current q8 ledger agrees')\n    imported=io.doc(plan['Root_q8_summary_import'])\n    need(imported.get('root')==ROOT and imported.get('accepted') is True\n         and imported.get('schema')=='ROOT_F004_Q8_COMPLETE_LEDGER_SUMMARY_IMPORT_V1'\n         and equal(imported.get('whole_registered_ledger'),q8), 'explicit Root q8 current summary context')\n    committed=io.doc(imported['matching_old_commit'])\n    need(committed.get('root')==ROOT and committed.get('committed') is True\n         and equal(committed.get('closed'),686) and equal(committed.get('pending_count'),0)\n         and equal(committed.get('job_registration'),q8['registration'])\n         and equal(committed.get('pending'),q8['pending_file']), 'old actual686/0 q8 commit, proof scope unchanged')\n    io.read(q8['registration'])\n    for key in ('accepted_application','actual_registration_capture','matching_guard'):\n        io.read(imported[key])\n    need(equal(io.doc(q8['pending_file']),[]), 'old exact empty q8 pending bytes')\n    context=io.doc(plan['Root_postch