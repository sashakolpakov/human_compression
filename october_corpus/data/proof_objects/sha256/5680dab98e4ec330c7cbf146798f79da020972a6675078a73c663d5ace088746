def whole(ref, cap):
    p=Path(ref['path']);a=p.lstat()
    need(str(p)==str(p.resolve(strict=True)) and stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size==ref['bytes']<=cap,
         'bounded ordinary Root metadata subject')
    with p.open('rb') as f:
        b=os.fstat(f.fileno());raw=f.read(cap+1);c=os.fstat(f.fileno())
    signature=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns,x.st_ctime_ns)
    need(signature(a)==signature(b)==signature(c)==signature(p.lstat()) and len(raw)==ref['bytes'] and hashlib.sha256(raw).hexdigest()==ref['sha256'],
         'fresh whole Root metadata subject')
    return raw

def strict(raw):
    def pairs(items):
        out={}
        for k,v in items:
            need(k not in out,'unique Root metadata fields');out[k]=v
        return out
    return json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in()).throw(ValueError('finite JSON')))

