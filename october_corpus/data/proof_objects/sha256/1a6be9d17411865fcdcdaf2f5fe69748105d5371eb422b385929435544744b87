    assert READ < 64 * 1048576 and NEW < 16 * 1048576 and len(PATHS) < 512


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True, allow_nan=False) + '\n').encode()


def ref(path, body):
    return dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())


def read(path, expected=None):
    global READ
    path = Path(path)
    a = path.lstat()
    assert path.resolve() == path and a.st_nlink == 1 and a.st_size <= 4194304
    PATHS.add(str(path))
    READ += a.st_size
    budget()
    body = path.read_bytes()
    z = path.lstat()
    assert (a.st_dev, a.st_ino, a.st_mode, a.st_nlink, a.st_size, a.st_mtime_ns, a.st_ctime_ns) == (
        z.st_dev, z.st_ino, z.st_mode, z.st_nlink, z.st_size, z.st_mtime_ns, z.st_ctime_ns)
    if expected is not None:
        assert ref(path, body) == expected
    return body


def doc(path, expected=None):
    return json.loads(read(path, expected))


def put(path, value):
    global NEW
    assert (path.is_relative_to(BASE) or path.is_relative_to(R)) and not os.path.lexists(path)
    assert path.parent.resolve() == path.parent
    body = canonical(value)
    assert len(body) <= 4194304
    NEW += len(body)
    PATHS.add(str(path))
    budget()
    with path.open('xb') as f:
        assert f.write(body) == len(body)
        f.flush()
        os.fsync(f.fileno())
    row = ref(path, body)
    read(path, row)
    return row


def same(a, b):
    if type(a) is not type(b):
        return False
    if type(a) is dict:
        return a.keys() == b.keys() and all(same(a[k], b[k]) for k in a)
    if type(a) is list:
        return len(a) == len(b) and all(same(x, y) for x, y in zip(a, b))
    return a == b


