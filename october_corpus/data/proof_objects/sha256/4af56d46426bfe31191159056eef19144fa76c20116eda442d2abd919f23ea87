def need(ok,why):
    if not ok:raise ValueError(why)

def can(v):return(json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode()

def pin(p):
    p=Path(p);a=p.lstat()
    need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
         and a.st_nlink==1 and a.st_size<=16*MIB,'bounded ordinary immutable metadata artifact')
    h=hashlib.sha256()
    with p.open('rb')as f:
        for block in iter(lambda:f.read(MIB),b''):h.update(block)
    z=p.lstat()
    need((a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_ctime_ns)==
         (z.st_dev,z.st_ino,z.st_size,z.st_mtime_ns,z.st_ctime_ns),'stable entire artifact')
    return dict(path=str(p),bytes=a.st_size,sha256=h.hexdigest())

def doc(r):
    need(r['bytes']<=2*MIB and pin(r['path'])==r,'whole bounded exact metadata')
    def pairs(items):
        d={}
        for k,v in items:need(k not in d,'unique metadata keys');d[k]=v
        return d
    return json.loads(Path(r['path']).read_bytes(),object_pairs_hook=pairs,
      parse_constant=lambda _:(_ for _ in()).throw(ValueError('finite JSON')))

def inventory(root):
    root=Path(root);need(root.resolve(strict=True)==root and root.is_dir(),'closed canonical evidence tree')
    rows=[]
    for current,dirs,files in os.walk(root,followlinks=False):
        current=Path(current);need(current.resolve(strict=True)==current,'ordinary evidence directories')
        for name in dirs:need(not(current/name).is_symlink(),'no evidence child alias')
        rows.extend(pin(current/name)for name in files)
    return sorted(rows,key=lambda r:r['path'])

def retain_exact_copy(mapping,row,authenticate):
    need(type(row)is dict and set(row)=={'original','retained'}
         and all(type(row[k])is dict and set(row[k])=={'path','bytes','sha256'}for k in('original','retained')),
         'whole original and retained artifact descriptors')
    original,retained=row['original'],row['retained'];key=original['path']
    prior=mapping.get(key)
    need(prior is None or prior['original']==original,'one exact original version; no conflicting history')
    need(retained['bytes']==original['bytes']and retained['sha256']==original['sha256'],
         'retained copy has exactly the original full bytes and SHA')
    authenticate(retained)
    if prior is None or retained['path']<prior['retained']['path']:mapping[key]=row

