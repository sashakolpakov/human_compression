+def large_end_positions(fact,source,baseline,maximum,document,whole):
+    need(fact['schema']=='ROOT_ACCEPTED_Q11_RANK4_LARGE_END_SPECTRUM_IP_FACTS_V1'
+         and fact['projection']==source['projection']and fact['Root_projection_acceptance']==source['Root_projection_acceptance']
+         and fact['proof_mode']==SPECTRUM_MODE and fact['classification']=='FOUR_MARK_INTERSECTION_PROPERTY_FAILURE'
+         and fact['four_mark_generation_or_nongeneration_claim']is False
+         and fact['spectrum_theorem']['sha256']==SPECTRUM_THEOREM_SHA
+         and fact['spectrum_review']['sha256']==SPECTRUM_REVIEW_SHA,'separate adopted spectrum proof type')
+    result=document(fact['independent_direct_result']);positions=fact['verified_IP_failure_positions']
+    need(result['schema']=='Q11_LARGE_END_SPECTRUM_DIRECT_RESULT_V1'
+         and result['status']=='VERIFIED_LARGE_END_SPECTRUM_ORIGINAL_RECORDS'
+         and result['proof_mode']==SPECTRUM_MODE and result['original_job']==source['original_job']
+         and result['projection']==source['projection']and result['verified_IP_failure_positions']==positions
+         and result['word_search_or_row_reduction_calls']==0
+         and type(positions)is list and positions==sorted(set(positions))
+         and all(type(i)is int and 1<=i<=maximum for i in positions)and not set(positions)&set(baseline),
+         'same original independent spectrum result; no old two37 verdict retag')
+    retained_spectrum_imports(fact,result,document,whole)
+    document(fact['spectrum_review']);return positions

# shared_05_literal_value — exact old/new pair used at consumer.literal_value, supplier.literal_value
--- shared_05_literal_value/reviewed_ancestor
+++ shared_05_literal_value/final
@@ -0,0 +1,5 @@
+def literal_value(marks,section,text,budget):
+    need(section in((0,1,2),(1,2,3)),'same original left or right end')
+    value=I7
+    for letter in literal_word(text):value=budget.multiply(value,marks[section[int(letter)]])
+    return value

# shared_06_retained_spectrum_imports — exact old/new pair used at consumer.retained_spectrum_imports, supplier.retained_spectrum_imports, adopter.retained_spectrum_imports
--- shared_06_retained_spectrum_imports/reviewed_ancestor
+++ shared_06_retained_spectrum_imports/final
@@ -0,0 +1,24 @@
+def retained_spectrum_imports(fact,result,document,whole):
+    need(callable(whole),'explicit bounded physical proof reader')
+    preservation=document(fact['preservation'])
+    need(preservation['schema']=='ROOT_PRESERVED_Q11_SPECTRUM_CHECK_V1'and preservation['root']=='/root'
+         and preservation['scientific_calls']==0 and type(preservation['files'])is list and len(preservation['files'])<=512,
+         'actual Root spectrum preservation map, never a bare path alias')
+    mappings=fact['proof_import_retentions']
+    need(type(mappings)is dict and set(mappings)=={'spectrum_theorem','spectrum_review','spectrum_premises'},
+         'explicit original-to-retained map for all three proof imports')
+    for key in('spectrum_theorem','spectrum_review','spectrum_premises'):
+        original=result[key];retained=fact[key]
+        for ref in(original,retained):
+            need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}and type(ref['path'])is str
+                 and type(ref['bytes'])is int and 0<=ref['bytes']<=2**21 and type(ref['sha256'])is str
+                 and len(ref['sha256'])==64 and set(ref['sha256'])<=set('0123456789abcdef'),'complete immutable proof descriptor')
+        need((original['bytes'],original['sha256'])==(retained['bytes'],retained['sha256'])
+             and mappings[key]==dict(original=original,retained=retained),'same whole proof body and explicit two identities')
+        rows=[row for row in preservation['files']if row['original']==original]
+        need(len(rows)==1 and rows[0]['retained']==retained
+             and rows[0]['action']==('REUSE_EXACT_S_INPUT'if original==retained else'COPY_COMPLETE_BYTES'),
+             'exact original-to-retained row in the actual immutable preservation')
+        raw=whole(retained,True)
+        need(len(raw)==original['bytes']and hashlib.sha256(raw).hexdigest()==original['sha256'],
+             'fresh entire retained proof body, not an ignored source path')

