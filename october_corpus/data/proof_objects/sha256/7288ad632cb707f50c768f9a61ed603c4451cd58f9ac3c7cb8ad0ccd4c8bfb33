# shared_02_check_end — exact old/new pair used at consumer.check_end, supplier.check_end
--- shared_02_check_end/reviewed_ancestor
+++ shared_02_check_end/final
@@ -0,0 +1,11 @@
+def check_end(marks,section,end,budget):
+    end_header(end)
+    if end['kind']=='PRIME37':
+        Y=supplied_value(marks,section,end['prime37'],budget)
+        need(Y!=I7 and power(Y,37,budget)==I7,'same-end exact37 witness')
+    else:
+        Y=supplied_value(marks,section,end['prime19'],budget)
+        need(Y!=I7 and power(Y,19,budget)==I7,'same-end exact19 witness')
+        Z=supplied_value(marks,section,end['order4'],budget)
+        need(power(Z,4,budget)==I7 and power(Z,2,budget)!=I7,'same-end exact4 witness, not a Klein-four order')
+    return end['kind']

