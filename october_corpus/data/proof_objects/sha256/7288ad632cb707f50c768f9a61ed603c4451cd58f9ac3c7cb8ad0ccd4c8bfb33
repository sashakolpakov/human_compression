+         and peer['status']=='SUPPORTED_CONDITIONAL_WRITTEN_THEOREM'and peer['blockers']==[]
+         and peer['argument']==plan['spectrum_theorem']and peer['premises']==plan['spectrum_premises']
+         and peer['full_natural_embedding_premises_retained']is True
+         and peer['Klein_four_kernel_argument_and_both_three_halfturn_fullness_steps_checked']is True
+         and peer['unitary_centre_lift_restored']is True
+         and peer['middle_order_and_product_set_inequalities_checked']is True
+         and prem['schema']=='Q11_LARGE_END_CONDITIONAL_REUSE_PREMISES_V1',
+         'complete classified natural overgroups, V4 kernel, centre, three-halfturn and intersection proof imports')
+    for ref in prem['local_sources'].values():budget.read(ref)
+    need(plan['theorem']['sha256']==THEOREM_SHA and plan['theorem_review']['sha256']==THEOREM_REVIEW_SHA,
+         'old paid two37 theorem attribution remains separate')
+    budget.read(plan['theorem']);old=budget.doc(plan['theorem_review'])
+    need(old['root']=='/root'and old['blockers']==[]and old['status']=='SUPPORTED_WRITTEN_THEOREM_AND_EXACT27_APPLICATIONS',
+         'retained old theorem review is not a spectrum result')

