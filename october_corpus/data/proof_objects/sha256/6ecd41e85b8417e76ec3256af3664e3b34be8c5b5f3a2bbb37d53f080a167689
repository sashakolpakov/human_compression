pand_declared(value):\n    return f9_expand_table(value, 'declared_inputs', _F9_DECLARED_TAG,\n                           'F009_DECLARED_ROW_TABLE_V1')\n\n\ndef f9_request_limit(value):\n    f9_need(type(value) is dict and value.get('schema') == 'LOCAL_SMALL_PYTHON_CHECK_V1'\n            and type(value.get('provenance')) is dict\n            and value['provenance'].get('role') in ('native', 'reader'),\n            'explicit ordinary Owner request and retained role')\n    return (8 if value['provenance']['role'] == 'native' else 16) * 2**20\n\n\ndef f9_encode_request(value):\n    cap = f9_request_limit(value)\n    f9_need(_F9_REQUEST_TAG not in value, 'encode one complete request once')\n    rows = f9_rows(value['inputs'], 40000)\n    prefixes = sorted({r['path'][:r['path'].rfind('/')+1] for r in rows})\n    lookup = {p: i for i, p in enumerate(prefixes)}\n    packed = []\n    for row in rows:\n        cut = row['path'].rfind('/')+1\n        packed.append([lookup[row['path'][:cut]], row['path'][cut:],\n                       row['bytes'], row['sha256']])\n    raw = f9_canonical(value)\n    f9_need(len(raw) <= cap, 'unchanged logical Native8MiB/Reader16MiB request')\n    wire = dict(value); wire.pop('inputs')\n    wire[_F9_REQUEST_TAG] = dict(schema='F009_OWNER_REQUEST_ROW_TABLE_V1',\n        prefixes=prefixes, rows=packed, logical_bytes=len(raw),\n        logical_sha256=hashlib.sha256(raw).hexdigest())\n    f9_need(f9_expand_request(wire) == value, 'entire complete Owner request inverse')\n    return wire\n\n\ndef f9_expand_request(wire):\n    if type(wire) is not dict or _F9_REQUEST_TAG not in wire:\n        return wire\n    cap = f9_request_limit(wire)\n    f9_need('inputs' not in wire, 'one explicit Owner request representation')\n    tag = wire[_F9_REQUEST_TAG]\n    f9_need(type(tag) is dict and set(tag) == {'schema', 'prefixes', 'rows',\n            'logical_bytes', 'logical_sha256'}\n            and tag['schema'] == 'F009_OWNER_REQUEST_ROW_TABLE_V1',\n            'exact request table encoding')\n    prefixes, packed = tag['prefixes'], tag['rows']\n    f9_need(type(prefixes) is list and len(prefixes) <= 40000\n            and prefixes == sorted(set(prefixes))\n            and all(type(p) is str and p.startswith('/') and p.endswith('/')\n                and '\\x00' not in p and all(x not in ('.', '..') for x in p.split('/'))\n                for p in prefixes), 'ordered exact absolute request parent prefixes')\n    f9_need(type(packed) is list and len(packed) <= 40000,\n            'bounded complete request rows')\n    rows = []\n    for entry in packed:\n        f9_need(type(entry) is list and len(entry) == 4, 'complete four-column request row')\n        index, name, size, digest = entry\n        f9_need(type(index) is int and 0 <= index < len(prefixes)\n                and type(name) is str and name not in ('', '.', '..') and '/' not in name,\n                'nonboolean request parent index and exact filename')\n        rows.append(dict(path=prefixes[index]+name, bytes=size, sha256=digest))\n    f9_rows(rows, 40000)\n    logical = dict(wire); logical.pop(_F9_REQUEST_TAG); logical['inputs'] = rows\n    raw = f9_canonical(logical)\n    f9_need(len(raw) <= cap and type(tag['logical_bytes']) is int\n            and tag['logical_bytes'] == len(raw)\n            and tag['logical_sha256'] == hashlib.sha256(raw).hexdigest(),\n            'entire same canonical request; unchanged role-specific logical cap')\n    return logical\n\n\ndef f9_output_bank(rows, directories):\n    f9_rows(rows, 2048)\n    f9_need(type(directories) is list and len(rows)+len(directories) <= 2049\n            and all(type(d) is str and d.isascii() and len(d.encode('ascii')) <= 384\n                and (d == '.' or (not d.startswith('/') and all(p not in ('', '.', '..')\n                    for p in d.split('/')))) for d in directories)\n            and directories == sorted(set(directories)) and '.' in directories,\n            'complete bounded relative directories and root; same producer object allowance')\n    f9_need(sum(r['bytes'] for r in rows) <= 16*2**20\n            and all(len(f9_canonical(r)) <= 512 and r['path'].isascii()\n                and len(r['path'].encode('ascii')) <= 384 for r in rows),\n            'same complete Native output descriptor and byte bounds')\n    return dict(schema='F009_COMPLETE_NATIVE_OUTPUT_ROWS_V1', files=rows, directories=directories)\n\n\ndef f9_encode_manifest(value, bank):\n    f9_need(type(value) is dict and value.get('schema') ==\n            'ROOT_F009_STANDALONE_CLOSED_OUTPUT_MANIFEST_V1'\n            and _F9_MANIFEST_TAG not in value,\n            'one complete logical output manifest')\n    f9_rows([bank], 1)\n    f9_need(bank['bytes'] <= 2*2**20, 'separately bounded complete output bank')\n    f9_output_bank(value['files'], value['directories'])\n    raw = f9_canonical(value); files = f9_canonical(value['files'])\n    f9_need(len(raw) <= 2*2**20, 'finite whole logical output manifest')\n    wire = dict(value); wire.pop('files'); wire.pop('directories')\n    wire[_F9_MANIFEST_TAG] = dict(schema='F009_COMPLETE_OUTPUT_MANIFEST_BANK_V1',\n        bank=bank, files_bytes=len(files), files_sha256=hashlib.sha256(files).hexdigest(),\n        logical_bytes=len(raw), logical_sha256=hashlib.sha256(raw).hexdigest())\n    return wire\n\n\ndef f9_expand_manifest(wire, read_bank):\n    if type(wire) is not dict or _F9_MANIFEST_TAG not in wire:\n        return wire\n    f9_need(wire.get('schema') == 'ROOT_F009_STANDALONE_CLOSED_OUTPUT_MANIFEST_V1'\n            and 'files' not in wire and 'directories' not in wire, 'one explicit output manifest representation')\n    tag = wire[_F9_MANIFEST_TAG]\n    f9_need(type(tag) is dict and set(tag) == {'schema', 'bank', 'files_bytes',\n            'files_sha256', 'logical_bytes', 'logical_sha256'}\n            and tag['schema'] == 'F009_COMPLETE_OUTPUT_MANIFEST_BANK_V1',\n            'exact full output bank import')\n    f9_rows([tag['bank']], 