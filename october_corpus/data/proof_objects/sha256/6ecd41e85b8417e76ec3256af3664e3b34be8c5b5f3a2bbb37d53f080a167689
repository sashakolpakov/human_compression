st(),\n        declared_rows_sha256=hashlib.sha256(f9_canonical(rows)).hexdigest(),\n        logical_bytes=size, logical_sha256=digest)\n    f9_need(f9_expand_job(wire) == job, 'entire exact Source-reference inverse')\n    return f9_encode_declared(wire)\n\n\ndef f9_expand_job(wire):\n    wire = f9_expand_declared(wire)\n    if type(wire) is not dict or _F9_SOURCE_TAG not in wire:\n        return wire\n    f9_need(wire.get('schema') == 'ROOT_F009_STANDALONE_JOB_V1'\n            and wire.get('role') in ('native', 'reader') and 'source_inputs' not in wire,\n            'explicit Source-reference wire, never a mixed representation')\n    tag = wire[_F9_SOURCE_TAG]\n    f9_need(type(tag) is dict and set(tag) == {'schema', 'indices', 'Source_rows_sha256',\n            'declared_rows_sha256', 'logical_bytes', 'logical_sha256'}\n            and tag['schema'] == 'F009_SOURCE_ROW_INDICES_V1', 'exact reference encoding')\n    rows = f9_rows(wire['declared_inputs'], 40000); indices = tag['indices']\n    f9_need(type(indices) is list and len(indices) <= 1024,\n            'bounded Source-index list')\n    last = -1\n    for index in indices:\n        f9_need(type(index) is int and last < index < len(rows),\n                'strictly increasing nonboolean unique in-range indices')\n        last = index\n    sources = [rows[index] for index in indices]\n    f9_need(sum(row['bytes'] for row in sources) <= 128*2**20,\n            'unchanged128MiB functional Source extent')\n    f9_need(hashlib.sha256(f9_canonical(rows)).hexdigest() == tag['declared_rows_sha256']\n            and hashlib.sha256(f9_canonical(sources)).hexdigest() == tag['Source_rows_sha256'],\n            'complete exact declared and Source table identities')\n    logical = dict(wire); logical.pop(_F9_SOURCE_TAG); logical['source_inputs'] = sources\n    size, digest = f9_image(logical)\n    f9_need(type(tag['logical_bytes']) is int and tag['logical_bytes'] == size\n            and tag['logical_sha256'] == digest, 'entire canonical semantic image')\n    return logical\n\n\ndef f9_encode_table(domain, field, tag_name, version):\n    f9_need(type(domain) is dict and tag_name not in domain,\n            'ordinary complete Root domain')\n    rows = f9_rows(domain[field], 40000)\n    prefixes = sorted({row['path'][:row['path'].rfind('/')+1] for row in rows})\n    lookup = {prefix: i for i, prefix in enumerate(prefixes)}\n    packed = []\n    for row in rows:\n        cut = row['path'].rfind('/')+1; prefix = row['path'][:cut]\n        packed.append([lookup[prefix], row['path'][cut:], row['bytes'], row['sha256']])\n    size, digest = f9_image(domain)\n    wire = dict(domain); wire.pop(field)\n    wire[tag_name] = dict(schema=version,\n        prefixes=prefixes, rows=packed, logical_bytes=size, logical_sha256=digest)\n    f9_need(f9_expand_table(wire, field, tag_name, version) == domain, 'entire exact row-table inverse')\n    return wire\n\n\ndef f9_expand_table(wire, field, tag_name, version):\n    if type(wire) is not dict or tag_name not in wire:\n        return wire\n    f9_need(field not in wire, 'one explicit row-table representation')\n    tag = wire[tag_name]\n    f9_need(type(tag) is dict and set(tag) == {'schema', 'prefixes', 'rows',\n            'logical_bytes', 'logical_sha256'} and tag['schema'] == version,\n            'exact parent-path table encoding')\n    prefixes, packed = tag['prefixes'], tag['rows']\n    f9_need(type(prefixes) is list and len(prefixes) <= 40000\n            and all(type(p) is str and p.startswith('/') and p.endswith('/')\n                and '\\x00' not in p and all(x not in ('.', '..') for x in p.split('/'))\n                for p in prefixes)\n            and prefixes == sorted(set(prefixes)), 'exact unique absolute parent prefixes')\n    f9_need(type(packed) is list and len(packed) <= 40000, 'bounded complete packed table')\n    rows = []\n    for entry in packed:\n        f9_need(type(entry) is list and len(entry) == 4, 'complete four-column row