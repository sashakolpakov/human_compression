    assert guard['status'] == 'PASS' and guard['stop'] == 'RETURNED' and guard['returncode'] == 0
    assert guard['cleanup']['remaining'] == [] and guard['cleanup']['errors'] == [] and err == b''
    assert guard['limits']['total_rss'] == 128 * MIB and guard['limits']['wall_seconds'] == 150
    child = guard['command']
    assert child[:7] == ['/Users/sasha/.venvs/global/bin/python', '-E', '-B', '-S', entry['program']['path'], '--self-sha256', entry['program']['sha256']]
    assert child[7:10] == ['--plan', entry['plan']['path'], entry['plan']['sha256']]
    assert child[10] == '--Root-gate' and len(child) == 13
    gate, gate_ref = doc(child[11])
    assert gate_ref['sha256'] == child[12]
    assert gate['program'] == entry['program'] and gate['plan'] == entry['plan']
    assert gate['root'] == '/root' and gate['adopted'] is True and gate['mode'] == 'propose'
    review, review_ref = refdoc(gate['Root_code_math_review'])
    assert review['status'] == 'SUPPORTED' and review['blockers'] == [] and review['root'] == '/root'
    assert review['program'] == entry['program'] and review['plan'] == entry['plan']
    assert review['current_paid_ledger'][0] == current_ref
    invoice, invoice_ref = doc(Path(gate_ref['path']).parent / 'actual_case_resource_invoice_DATA.json')
    assert invoice['program'] == entry['program'] and invoice['plan'] == entry['plan']
    assert invoice['gate'] == gate_ref and invoice['review'] == review_ref
    assert invoice['schema'] == 'L026_ACTUAL_CASE_METADATA_RESOURCE_INVOICE_V1'
    assert invoice['physical_paths'] <= 32 and invoice['physical_first_final_plus_bootstrap_bytes'] <= 8 * MIB
    assert invoice['active_Source_namespace_bytes'] <= 50000
    assert invoice['outer'] == dict(rss=128*MIB, seconds=150, admit_RAM=4*GIB, admit_disk=10*GIB, RAM_floor=3*GIB, disk_floor=8*GIB)
    assert capture['root'] == '/root' and capture['actor'] == '/root'
    issued = capture['issued_argv']
    sep = issued.index('--')
    assert issued[sep+1:] == child and capture['child_argv'] == issued
    assert capture['actual_tool']['exit_code'] == 0 and capture['all_genuine_api_frames']
