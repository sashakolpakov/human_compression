    for ref in outputs.values():
        raw(ref['path'], ref)
    records.append(dict(capture=capture_ref, outer=guard_ref, stdout=stdout_ref, stderr=err_ref,
                        terminal=stdout, kind='NEG', program=entry['program'], plan=entry['plan'],
                        gate=gate_ref, review=review_ref, resource_invoice=invoice_ref,
                        result=outputs['result.json'], carrier=outputs['records.json'], checkpoint=outputs['checkpoint.json']))
assert not (BASE / 'subset_runs.json').exists()
prior, prior_ref = doc('/private/tmp/l026_free_0096_0111_actual_workflow_record.json')
