"""Reconstruct six genuine completed proposal records; never run mathematics."""
import hashlib
import json
import os
from pathlib import Path
import stat

BASE = Path('/private/tmp/l026_free_0096_0111_execution')
DEST = Path('/private/tmp/l026_free_0096_0111_resume')
GIB = 1073741824
MIB = 1048576
seen = {}
physical = 0


def raw(path, expected=None):
    global physical
    p = Path(path)
    a = p.lstat()
    assert p.is_absolute() and p.resolve() == p
    assert stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and a.st_size <= 4194304
    with p.open('rb') as f:
        b0 = os.fstat(f.fileno())
        body = f.read(a.st_size + 1)
        b1 = os.fstat(f.fileno())
    z = p.lstat()
    sig = lambda t: (t.st_dev, t.st_ino, t.st_mode, t.st_nlink, t.st_size, t.st_mtime_ns, t.st_ctime_ns)
    assert sig(a) == sig(b0) == sig(b1) == sig(z) and len(body) == a.st_size
    ref = dict(path=str(p), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())
    if expected is not None:
        assert ref == expected
    physical += len(body)
    assert physical <= 8388608
    seen[str(p)] = ref
    assert len(seen) <= 128
    return body, ref


def doc(path, expected=None):
    body, ref = raw(path, expected)
    return json.loads(body), ref


def refdoc(ref):
    return doc(ref['path'], ref)


def write(name, obj):
    p = DEST / name
    assert p.parent.resolve() == p.parent and not os.path.lexists(p)
    body = json.dumps(obj, sort_keys=True, separators=(',', ':'), allow_nan=False).encode() + b'\n'
    assert len(body) <= 4194304
    with p.open('xb') as f:
        assert f.write(body) == len(body)
        f.flush()
        os.fsync(f.fileno())
    return dict(path=str(p), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())


assert DEST.resolve() == DEST and DEST.is_dir()
batch, batch_ref = doc(BASE / 'prepared/batch.json')
assert batch['selected_indices'] == list(range(96, 112)) and len(batch['subset_calls']) == 6
