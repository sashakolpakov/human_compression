        if hit:prime=dict(word=row['word'],power=7);note['prime19_hit'][side]=i+1;break
    if prime is None:return None
    if middle_power is not None:
        four=dict(word='12'if side==0 else'01',power=middle_power)
        return dict(kind='PRIME19_AND_ORDER4',prime19=prime,order4=four)
    for i,(row,value)in enumerate(zip(rows,values)):
        for j,k in enumerate(profile['end_four_powers']):
