def power(matrix, exponent, budget):
    need=budget.need
    need(type(exponent)is int and exponent>=0,'exact nonnegative exponent')
    if exponent==6:
        square=budget.multiply(matrix,matrix)
        cube=budget.multiply(square,matrix)
        return budget.multiply(cube,cube)
    if exponent==37:
        square=budget.multiply(matrix,matrix)
        fourth=budget.multiply(square,square)
        eighth=budget.multiply(fourth,fourth)
        sixteenth=budget.multiply(eighth,eighth)
        thirty_second=budget.multiply(sixteenth,sixteenth)
        return budget.multiply(budget.multiply(thirty_second,fourth),matrix)
    value=I7
    for bit in bin(exponent)[2:]:
        value=budget.multiply(value,value)
        if bit=='1':value=budget.multiply(value,matrix)
    return value

