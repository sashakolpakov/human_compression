            note['four_completed'][side]=i*len(profile['end_four_powers'])+j+1
            if hit:
                note['four_hit'][side]=[i+1,k]
                return dict(kind='PRIME19_AND_ORDER4',prime19=prime,order4=dict(word=row['word'],power=k))
    return None

