                 'one capture AFTER unchanged complete first authentication')
            successor = successor.replace(CAPTURE_BEFORE, CAPTURE_AFTER, 1)
        recovered = successor
        if name == 'compact':
            recovered = recovered.replace(CAPTURE_AFTER, CAPTURE_BEFORE, 1)
        need(recovered.replace(new_allocation, old_allocation, 1) == previous,
             'entire original scratch-map function inverse')
        exec(compile(successor, str(Path(__file__).resolve()), 'exec', dont_inherit=True), private)
    exec(compile(after, str(Path(__file__).resolve()), 'exec', dont_inherit=True), private)
    shared = private['expand']
