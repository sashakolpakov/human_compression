         'same private full original authentication provider')
    need(shared.__globals__ is private
         and private['ROOT_EXPORT_LEAVES'] is state['leaves']
         and all(private[key] is value for key, value in original_globals.items()
                 if key not in {'expand', 'compact', 'authenticate_lines'}),
         'same original providers/guard lifetime plus exact source leaves and scratch-map storage')
    ordinary = codec.export
