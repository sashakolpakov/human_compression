        provider = getattr(codec, name)
        need(provider.__globals__ is original_globals
             and provider.__code__.co_filename == CODEC['path'],
             'same original mathematical scratch-map provider')
        previous = ast.get_source_segment(raw, matches[0])
        need(previous.count(old_allocation) == 1 and new_allocation not in previous,
             'one exact empty scratch-dictionary allocation')
        successor = previous.replace(old_allocation, new_allocation, 1)
        if name == 'compact':
