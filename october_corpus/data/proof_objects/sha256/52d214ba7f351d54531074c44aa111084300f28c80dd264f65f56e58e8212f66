         and codec.expand.__code__.co_filename == CODEC['path'],
         'same acquired concrete original codec providers')
    need(type(state) is dict and type(state.get('leaves')) is list,
         'same actual ordered acquired leaf-occurrence list')
    nodes = [n for n in ast.parse(raw, filename=CODEC['path']).body
             if isinstance(n, ast.FunctionDef) and n.name == 'expand']
    need(len(nodes) == 1, 'one exact retained complete inverse body')
    before = ast.get_source_segment(raw, nodes[0])
    after = before
    for old, new in ((PIN_BEFORE, PIN_AFTER), (LEAF_BEFORE, LEAF_AFTER),
                     (HASHES_BEFORE, HASHES_AFTER)):
        need(after.count(old) == 1 and new not in after,
             'one exact storage-allocation successor site')
        after = after.replace(old, new, 1)
    inverse = after
    for old, new in reversed(((PIN_BEFORE, PIN_AFTER), (LEAF_BEFORE, LEAF_AFTER),
                              (HASHES_BEFORE, HASHES_AFTER))):
        need(inverse.count(new) == 1, 'one complete reverse allocation site')
        inverse = inverse.replace(new, old, 1)
    need(inverse == before, 'entire literal old inverse recovered')
    need('ROOT_EXPORT_LEAVES' not in vars(codec),
         'fresh invocation-local source-leaf binding')
    original_globals = vars(codec)
    private = dict(original_globals)
    private['ROOT_EXPORT_LEAVES'] = state['leaves']
    need('ROOT_LOCATION_MAP' not in private, 'fresh private scratch-map binding')
    private['ROOT_LOCATION_MAP'] = map_module.LocationDigestMap
    retained = _AuthenticatedLocations()
    need('ROOT_CAPTURE_EXPECTED' not in private and 'ROOT_AUTHENTICATE_EXPECTED' not in private,
         'fresh invocation-local authenticated-location bindings')
    private['ROOT_CAPTURE_EXPECTED'] = retained.capture
    private['ROOT_AUTHENTICATE_EXPECTED'] = retained.authenticate
    for name, old_allocation, new_allocation in (
            ('compact', 'groups=[];expected={}', 'groups=[];expected=ROOT_LOCATION_MAP()'),
            ('authenticate_lines', 'found={}if expected is None else None',
             'found=ROOT_LOCATION_MAP()if expected is None else None')):
        matches = [n for n in ast.parse(raw, filename=CODEC['path']).body
