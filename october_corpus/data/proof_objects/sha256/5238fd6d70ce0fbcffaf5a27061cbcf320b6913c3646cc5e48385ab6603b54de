      "whole_body": "\"\"\"UNRUN original-operand SAME-END37 fixed-line certificate.\nCanonical nested-header successor by /root/journal_peer/large_end_route_audit. No project imports or old\ncontext-code loads. Root acceptance, fresh review/control/gate and whole\nfrozen Original operand/proof pins are required before case arithmetic.\n\"\"\"\nimport argparse,hashlib,json,math,os,resource,signal,stat,sys,time\nfrom pathlib import Path\nSTART=time.monotonic()\nI7=bytes(int(i==j)for i in range(7)for j in range(7))\nPRIME_THEORY_SHA='f1b6c8a69780c7b8ac88f239627a7ce6889c24203f72ddc35c86fe93e661e76b'\nEND_IP_THEORY_SHA='9f52e0d341e68ff2649b2d419635e9b6fc4d1c320a3a3469dc56af97775447bc'\nMODE='ORIGINAL_SAME_END37_UNIQUE_FIXED_LINE_ESCAPE_V1'\nGRAMMAR='SAME_END_LITERAL_012_LENGTH1_TO64_V1'\nENV4=('COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG','OPENSSL_CONF','OPENSSL_MODULES')\ndef need(ok,why):\n    if not ok:raise ValueError(why)\ndef canonical(value):\n    return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False,ensure_ascii=True).encode('ascii')\ndef decode(raw):\n    def pairs(items):\n        result={}\n        for key,value in items:\n            need(key not in result,'duplicate JSON key');result[key]=value\n        return result\n    def finite(text):\n        value=float(text);need(math.isfinite(value),'finite JSON number');return value\n    return json.loads(raw,object_pairs_hook=pairs,parse_float=finite,\n        parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))\ndef refcheck(ref):\n    need(type(ref)is dict and set(ref)=={'path','bytes','sha256'} and type(ref['path'])is str\n         and type(ref['bytes'])is int and 0<=ref['bytes']<=2**21\n         and type(ref['sha256'])is str and len(ref['sha256'])==64\n         and set(ref['sha256'])<=set('0123456789abcdef'),'complete bounded whole-file descriptor')\n    return ref\nclass SoftStop(Exception):pass\nclass Budget:\n    def __init__(self):\n        self.refs={};self.raw={};self.read_bytes=0;self.products=0;self.images=0;self.scalar_units=0;self.peak=0\n    def tick(self,soft=False):\n        self.peak=max(self.peak,resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024))\n        elapsed=time.monotonic()-START\n        need(self.peak<128*2**20 and elapsed<125,'128MiB/125s hard inner envelope')\n        if soft and (self.scalar_units>=900000 or elapsed>=110):raise SoftStop('900000scalar/110s soft stop')\n    def scalar(self,units,soft=False):\n        need(type(units)is int and units>=0,'integer nonnegative work debit')\n        self.scalar_units+=units;need(self.scalar_units<=1000000,'1000000 additional scalar hard cap');self.tick(soft)\n    def read(self,ref,again=False):\n        refcheck(ref);self.tick();need(self.refs.get(ref['path'],ref)==ref,'one whole version per path')\n        if ref['path']in self.raw and not again:return self.raw[ref['path']]\n        need(self.read_bytes+ref['bytes']<=8*2**20 and (ref['path']in self.refs or len(self.refs)<96),\n             'all initial and repeated reads within8MiB/96paths')\n        p=Path(ref['path']);a=p.lstat()\n        need(p.is_absolute() and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)\n             and a.st_nlink==1 and a.st_size==ref['bytes'],'canonical single-link bounded regular input')\n        with p.open('rb')as handle:\n            b=os.fstat(handle.fileno());raw=handle.read(ref['bytes']+1);c=os.fstat(handle.fileno())\n        signature=lambda z:(z.st_dev,z.st_ino,z.st_mode,z.st_nlink,z.st_size,z.st_mtime_ns,z.st_ctime_ns)\n        need(signature(a)==signature(b)==signature(c)==signature(p.lstat()) and len(raw)==ref['bytes']\n             and hashlib.sha256(raw).hexdigest()==ref['sha256'],'stable whole input bytes and SHA')\n        self.refs[ref['path']]=ref;self.raw[ref['path']]=raw;self.read_bytes+=len(raw);return raw\n    def doc(self,ref):return decode(self.read(ref))\n    def recheck(self):\n        for ref in list(self.refs.values()):self.read(ref,True)\n    def multiply(self,A,B,soft=False):\n        need(type(A)is bytes and type(B)is bytes and len(A)==len(B)==49,'whole packed7x7 operands')\n        self.products+=1;need(self.products<=400000,'400000 matrix products');self.scalar(64,soft)\n        return bytes(sum(A[7*i+k]*B[7*k+j]for k in range(7))%11 for i in range(7)for j in range(7))\n    def image(self,row,A,soft=False):\n        need(type(row)is tuple and len(row)==7 and type(A)is bytes and len(A)==49,'whole row/right action')\n        self.images+=1;need(self.images<=200000,'200000 row images');self.scalar(49,soft)\n        return tuple(sum(row[k]*A[7*k+j]for k in range(7))%11 for j in range(7))\n    def snapshot(self):\n        self.tick();return dict(physical_read_bytes=self.read_bytes,paths=len(self.refs),matrix_products=self.products,\n            row_images=self.images,additional_scalar_units=self.scalar_units,peak_RSS=self.peak,\n            seconds=time.monotonic()-START,before_output_IO=True)\ndef word_header(word,power):\n    need(type(word)is str and 1<=len(word)<=64 and set(word)<=set('012'),'bounded same-end literal012 word')\n    need(type(power)is int and 1<=power<=256,'bounded positive exact-integer word power')\ndef end_indices(mask):\n    need(type(mask)is int and mask in(7,14),'original rank3 end mask7or14')\n    return (0,1,2)if mask==7 else(1,2,3)\ndef unpack_operand(raw):\n    need(type(raw)is bytes and len(raw)==294 and all(x<11 for x in raw),'all294 canonical GF11 operand bytes')\n    return tuple(raw[49*i:49*(i+1)]for i in range(6))\ndef power(A,n,budget,soft=False):\n    need(type(n)is int and n>=0,'nonnegative exact integer exponent')\n    result=I7\n    while n:\n        if n&1:result=budget.multiply(result,A,soft)\n        n>>=1\n        if n:A=budget.multiply(A,A,soft)\n    return result\ndef word_value(parts,mask,word,exponent,budget,soft=False):\n    word_header(word,exponent);indices=end_indices(mask);value=I7\n    for letter in word:value=budget.multiply(value,parts[indices[int(letter)]],soft)\n    return power(value,exponent,budget,soft)\ndef fixed_vector(value):\n    need(type(value)is list and len(value)==7 and all(type(x)is int and 0<=x<11 for x in value)\n         and any(value),'canonical nonzero full seven-coordinate fixed row')\n    return tuple(value)\ndef escaped_minor(row,image,minor,budget):\n    need(type(minor)is list and len(minor)==2 and all(type(x)is int for x in minor)\n         and 0<=minor[0]<minor[1]<7,'strict ordered two-coordinate minor')\n    i,j=minor;budget.scalar(4);need((row[i]*image[j]-row[j]*image[i])%11!=0,'actual nonzero line-escape minor')\ndef accepted_metadata(plan,accepted,selector):\n    need(accepted['schema']=='ROOT_ACCEPTED_Q11_ORIGINAL_QUARTET_OPERAND_V1'\n         and accepted['root']==accepted['reviewer']=='/root' and accepted.get('Root_authority_granted')is True\n         and accepted['operand']==plan['operand']\n         and accepted['original_job']==plan['original_job']==[23,4]\n         and type(accepted['position'])is type(plan['position'])is int and accepted['position']==plan['position']\n         and type(accepted['representative'])is type(plan['representative'])is int and accepted['representative']==plan['representative']\n         and accepted['whole_orbit_sha256']==plan['whole_orbit_sha256']\n         and accepted['selector']==plan['selector']\n         and accepted['checks']['original_member_frame_faithful_orbit_G_A_equals_G']is True,\n         'exact Root-adopted Original quartet/member/frame/faithful/orbit/G/A=G operand premise')\n    need(type(accepted['old_proof_DAG_qualification'])is str and accepted['old_proof_DAG_qualification'],\n         'explicit opaque retained Original proof-DAG qualification')\n    for key in('export_program','export_result','export_actual_capture'):refcheck(accepted[key])\n    need(type(plan['whole_orbit_sha256'])is str and len(plan['whole_orbit_sha256'])==64\n         and set(plan['whole_orbit_sha256'])<=set('0123456789abcdef'),'complete exact original orbit digest')\n    need(selector['schema']=='ROOT_ACCEPTED_Q11_RANK4_UNRESOLVED_SELECTOR_V1'\n         and selector['root']=='/root' and selector['adopted']is True and selector['original_job']==[23,4],\n         'same actual Root-selected original job23 selector')\n    runs=selector['unresolved_position_runs'];previous=0;unpaid=[]\n    need(type(runs)is list,'whole unpaid run array')\n    for pair in runs:\n        need(type(pair)is list and len(pair)==2 and all(type(v)is int for v in pair)\n             and previous<pair[0]<=pair[1]<=selector['original_orbit_positions'],'ordered disjoint exact unpaid runs')\n        unpaid.extend(range(pair[0],pair[1]+1));previous=pair[1]\n    need(len(unpaid)==selector['unresolved_positions']\n         and hashlib.sha256(canonical(unpaid)).hexdigest()==selector['expanded_unresolved_sha256']\n         and plan['position']in unpaid,'current exact unpaid position, never historical paid replay')\n    return accepted\ndef gate_header(plan,pref,own,gate,role):\n    need(gate['schema']=='ROOT_AUTHORIZED_Q11_OPERAND37_LINE_'+role+'_V1'\n         and gate['root']=='/root' and gate['adopted']is True and gate['new_case_calls_authorized']is True\n         and gate['program']==own and gate['plan']==pref and gate['operand_acceptance']==plan['operand_acceptance']\n         and gate['selector']==plan['selector'],'fresh exact Root case gate before operand arithmetic')\ndef authority_metadata(plan,pref,own,gate,review,controls):\n    need(review['schema']=='ROOT_REVIEWED_Q11_OPERAND37_LINE_SOURCE_V1'\n         and review['root']==review['reviewer']=='/root' and review['status']=='SUPPORTED' and review['blockers']==[]\n         and review['program']==own and review['plan']==pref and review['operand_acceptance']==plan['operand_acceptance']\n         and review['selector']==plan['selector']\n         and review['natural_Cayley_classification_unique37_line_and_one_full_end_IP_checked']is True,\n         'fresh whole Root Source/math/Original-import review')\n    need(controls['schema']=='Q11_OPERAND37_LINE_GENERIC_CONTROLS_V1' and controls['status']=='PASS'\n         and controls['program']==plan['control_program'] and controls['proposer']==plan['proposer_program']\n         and controls['strict']==plan['strict_program'] and type(controls['original_case_calls'])is int and controls['original_case_calls']==0,\n         'actual controls of these distinct exact Sources')\ndef plan_header(plan,own,role):\n    need(plan['schema']=='Q11_OPERAND37_LINE_'+role+'_PLAN_V1' and plan['program']==own\n         and plan['proof_mode']==MODE and plan['grammar']==GRAMMAR,'exact Source/role/mode/grammar plan')\n    need(own==plan['proposer_program'if role=='PROPOSER'else'strict_program'],'exact role-specific Source subject')\n    for key in('operand','operand_acceptance','selector','control_program','proposer_program','strict_program','prime_theory','end_IP_theory'):refcheck(plan[key])\n    need(plan['operand']['bytes']==294 and plan['operand_acceptance']['bytes']<=32768,'whole294-byte operand and32KiB Root receipt')\n    if role=='STRICT':\n        refcheck(plan['hint']);need(plan['hint']['bytes']<=16384 and plan['hint']in plan['inputs'],'actual whole hint in closed plan roster')\n    end_indices(plan['mask']);word_header(plan['word'],plan['power'])\n    need(plan['prime_theory']['sha256']==PRIME_THEORY_SHA and plan['end_IP_theory']['sha256']==END_IP_THEORY_SHA,\n         'fixed whole natural-module37 and one-full-end IP theorem bodies')\n    need(type(plan['inputs'])is list and len(plan['inputs'])<=96,'bounded whole physical roster')\n    for ref in plan['inputs']:refcheck(ref)\n    need(len({r['path']for r in plan['inputs']})==len(plan['inputs']),'one immutable full pin per declared input')\ndef descriptor(pair):\n    p=Path(pair[0]);return dict(path=str(p),bytes=p.lstat().st_size,sha256=pair[1])\ndef load_case(role):\n    need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode and not sys.flags.optimize\n         and all(key not in os.environ for key in ENV4),'assert-enabled minimal E/S/B and ENV4')\n    signal.signal(signal.SIGALRM,lambda *_:(_ for _ in()).throw(TimeoutError('125s operand route')))\n    signal.setitimer(signal.ITIMER_REAL,max(.001,125-(time.monotonic()-START)))\n    parser=argparse.ArgumentParser(allow_abbrev=False)\n    parser.add_argument('--self-sha256',required=True);parser.add_argument('--plan',nargs=2,required=True)\n    parser.add_argument('--Root-gate',nargs=2,required=True);args=parser.parse_args();budget=Budget()\n    p=Path(__file__).resolve(strict=True);own=dict(path=str(p),bytes=p.lstat().st_size,sha256=args.self_sha256)\n    need(own['bytes']<=65536,'whole executed Source namespace<=65536');budget.read(own)\n    pref=descriptor(args.plan);need(pref['bytes']<=131072,'whole bounded plan');plan=budget.doc(pref);plan_header(plan,own,role)\n    gref=descriptor(args.Root_gate);need(gref['bytes']<=8192,'whole bounded Root gate');gate=budget.doc(gref)\n    gate_header(plan,pref,own,gate,role)\n    need(gate['Root_code_math_review']['bytes']<=32768 and gate['control_report']['bytes']<=16384,'whole review/control bounds')\n    review=budget.doc(gate['Root_code_math_review']);controls=budget.doc(gate['control_report'])\n    authority_metadata(plan,pref,own,gate,review,controls)\n    for ref in plan['inputs']:budget.read(ref)\n    # This is metadata/proof import. No original word/matrix action has run.\n    accepted=accepted_metadata(plan,budget.doc(plan['operand_acceptance']),budget.doc(plan['selector']))\n    budget.read(plan['prime_theory']);budget.read(plan['end_IP_theory'])\n    raw=budget.read(plan['operand']);parts=unpack_operand(raw)\n    expected={r['path']:r for r in plan['inputs']}\n    for ref in(own,pref,gref,gate['Root_code_math_review'],gate['control_report']):\n        need(expected.get(ref['path'],ref)==ref,'one closed whole input version');expected[ref['path']]=ref\n    need(budget.refs==expected,'exact entire actual input roster before case arithmetic');budget.expected_refs=expected\n    budget.scalar(1024)\n    return plan,pref,own,gref,accepted,parts,budget\ndef hint_header(plan):\n    return dict(schema='Q11_ORIGINAL_END37_LINE_ESCAPE_HINT_V1',proof_mode=MODE,grammar=GRAMMAR,\n        operand=plan['operand'],operand_acceptance=plan['operand_acceptance'],selector=plan['selector'],\n        original_job=[23,4],position=plan['position'],representative=plan['representative'],\n        whole_orbit_sha256=plan['whole_orbit_sha256'],mask=plan['mask'],word=plan['word'],power=plan['power'],\n        proposer_program=plan['proposer_program'])\ndef verify_hint(hint,plan,parts,budget):\n    header=hint_header(plan)\n    need(type(hint)is dict and set(hint)==set(header)|{'vector','escape_generator','minor'}\n         and canonical({key:hint[key]for key in header})==canonical(header),\n         'whole exact current Original/operand/word/mask hint header')\n    row=fixed_vector(hint['vector']);indices=end_indices(plan['mask']);label=hint['escape_generator']\n    need(type(label)is int and label in indices,'escape generator is INSIDE the SAME original end')\n    Y=word_value(parts,plan['mask'],plan['word'],plan['power'],budget)\n    need(Y!=I7 and power(Y,37,budget)==I7,'actual nonidentity exact37 same-end word')\n    need(budget.image(row,Y)==row,'all seven actual fixed-row equations')\n    escaped_minor(row,budget.image(row,parts[label]),hint['minor'],budget)\n    return dict(end_mask=plan['mask'],all_saved_fixed_equations_checked=True,same_end_escape_generator=label,\n        nonzero_minor=hint['minor'],exact37_word_checked=True,strict_RREF_or_search_calls=0)\ndef emit(plan,result,budget,hint=None):\n    need(budget.refs==budget.expected_refs,'exact whole final actual input roster');budget.recheck();result['resources']=budget.snapshot()\n    output=Path(plan['output_directory'])\n    need(output.is_absolute() and '..'not in output.parts and output.parent.resolve(strict=True)==output.parent\n         and not os.path.lexists(output),'fresh canonical output directory')\n    hraw=None if hint is None else canonical(hint)+b'\\n'\n    if hraw is not None:\n        need(len(hraw)<=16384,'whole small literal hint');result['hint']=dict(path=str(output/'hint.json'),bytes=len(hraw),sha256=hashlib.sha256(hraw).hexdigest())\n    else:result['hint']=None\n    raw=canonical(result)+b'\\n';need(len(raw)<=32768,'whole result<=32768')\n    output.mkdir()\n    for p,body in([(output/'hint.json',hraw)]if hraw is not None else[])+[(output/'result.json',raw)]:\n        with p.open('xb')as handle:need(handle.write(body)==len(body),'complete fresh output');handle.flush();os.fsync(handle.fileno())\n    print(canonical(dict(result=dict(path=str(output/'result.json'),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),status=result['status'])).decode('ascii'))\n\ndef derive_fixed_row(Y,budget):\n    # Row vY=v means transpose(Y-I)*transpose(v)=0. Seven variables only.\n    rows=[[(Y[7*i+j]-int(i==j))%11 for i in range(7)]for j in range(7)]\n    pivots=[];rank=0\n    for column in range(7):\n        budget.tick(True);pivot=next((k for k in range(rank,7)if rows[k][column]),None)\n        if pivot is None:continue\n        rows[rank],rows[pivot]=rows[pivot],rows[rank];inverse=pow(rows[rank][column],9,11)\n        budget.scalar(7,True);rows[rank]=[(x*inverse)%11 for x in rows[rank]]\n        for k in range(7):\n            if k!=rank and rows[k][column]:\n                factor=rows[k][column];budget.scalar(14,True)\n                rows[k]=[(x-factor*y)%11 for x,y in zip(rows[k],rows[rank])]\n        pivots.append(column);rank+=1\n    free=[i for i in range(7)if i not in pivots]\n    if len(free)!=1:return None\n    row=[0]*7;row[free[0]]=1\n    for k,column in enumerate(pivots):row[column]=(-rows[k][free[0]])%11\n    vector=tuple(row)\n    need(budget.image(vector,Y,True)==vector,'proposed full fixed row rechecked')\n    return vector\ndef propose_hint(plan,parts,budget):\n    Y=word_value(parts,plan['mask'],plan['word'],plan['power'],budget,True)\n    if Y==I7 or power(Y,37,budget,True)!=I7:return None,'FINITE_MISS_SUPPLIED_WORD_NOT_EXACT37'\n    row=derive_fixed_row(Y,budget)\n    if row is None:return None,'FINITE_MISS_NO_UNIQUE_FIXED_ROW_PROPOSED'\n    for label in end_indices(plan['mask']):\n        image=budget.image(row,parts[label],True)\n        for i in range(7):\n            for j in range(i+1,7):\n                budget.scalar(4,True)\n                if (row[i]*image[j]-row[j]*image[i])%11:\n                    hint=dict(hint_header(plan),vector=list(row),escape_generator=label,minor=[i,j])\n                    verify_hint(hint,plan,parts,budget)\n                    return hint,'UNTRUSTED_SAME_END37_LINE_ESCAPE_HINT'\n    return None,'FINITE_MISS_SAME_END_LINE_ESCAPE_NOT_FOUND'\ndef main():\n    plan,pref,own,gref,accepted,parts,budget=load_case('PROPOSER')\n    try:hint,status=propose_hint(plan,parts,budget)\n    except SoftStop as error:hint=None;status='UNPAID_SOFT_INTERRUPTION';stop=str(error)\n    result=dict(schema='Q11_OPERAND37_LINE_PROPOSER_RESULT_V1',status=status,program=own,plan=pref,source_gate=gref,\n        operand=plan['operand'],operand_acceptance=plan['operand_acceptance'],selector=plan['selector'],\n        original_job=[23,4],position=plan['position'],mask=plan['mask'],proof_mode=MODE,\n        prime_theory=plan['prime_theory'],end_IP_theory=plan['end_IP_theory'],independent_strict_verification_owed=True,\n        verification_authority=False,new_paid_credit=0,whole_original_credit=0,\n        qualification='Supplier hint only. No full-end/IP/NG or absence claim. Every miss/interruption remains unpaid.')\n    if status=='UNPAID_SOFT_INTERRUPTION':result['stop']=stop\n    emit(plan,result,budget,hint)\nif __name__=='__main__':main()\n"
