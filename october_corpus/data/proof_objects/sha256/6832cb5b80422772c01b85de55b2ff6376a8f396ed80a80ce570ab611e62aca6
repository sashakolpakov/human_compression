def need(ok,message):
    if not ok:raise ValueError(message)


def canonical(value):
    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')


def digest(value):return hashlib.sha256(canonical(value)).hexdigest()


def decode(raw):
    def pairs(items):
        result={}
        for key,value in items:need(key not in result,'unique JSON keys');result[key]=value
        return result
    def floating(text):
        value=float(text);need(math.isfinite(value),'finite old observations');return value
    return json.loads(raw,object_pairs_hook=pairs,parse_float=floating,
        parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))


def reference(path,raw):
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


class Metadata:
    def __init__(self):self.refs={};self.raw={};self.bytes=0
    def whole(self,ref,fresh=False):
        need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}and type(ref['bytes'])is int
             and 0<=ref['bytes']<=2**21 and type(ref['sha256'])is str and len(ref['sha256'])==64
             and set(ref['sha256'])<=set('0123456789abcdef'),'complete bounded metadata reference')
        need(self.refs.get(ref['path'],ref)==ref,'one complete version per physical path')
        if not fresh and ref['path']in self.raw:return self.raw[ref['path']]
        rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024)
        need(rss<256*2**20 and time.monotonic()-START<125,'256MiB/125s metadata envelope')
        need(self.bytes+ref['bytes']<=64*2**20 and(len(self.refs)<512 or ref['path']in self.refs),
             '64MiB/512-path actual metadata read bound')
        path=Path(ref['path']);a=path.lstat()
        need(path.is_absolute()and path.resolve(strict=True)==path and stat.S_ISREG(a.st_mode)
             and a.st_nlink==1 and a.st_size==ref['bytes'],'canonical ordinary exact input')
        with path.open('rb')as f:b=os.fstat(f.fileno());raw=f.read(ref['bytes']+1);c=os.fstat(f.fileno())
        sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
        need(sig(a)==sig(b)==sig(c)==sig(path.lstat())and reference(path,raw)==ref,'stable whole input bytes')
        self.refs[ref['path']]=ref;self.raw[ref['path']]=raw;self.bytes+=len(raw);return raw
    def document(self,ref):return decode(self.whole(ref))
    def pin(self,path,sha=None):
        path=Path(path);size=path.stat().st_size;need(size<=2**21,'bounded actual file')
        if sha is None:
            if str(path)in self.refs:
                self.whole(self.refs[str(path)]);return self.refs[str(path)]
            a=path.lstat();need(path.is_absolute()and path.resolve(strict=True)==path
                and stat.S_ISREG(a.st_mode)and a.st_nlink==1,'ordinary actual file before hashing')
            need(self.bytes+size+1<=64*2**20 and len(self.refs)<512,'prepaid bounded actual file hash')
            rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024)
            need(rss<256*2**20 and time.monotonic()-START<125,'metadata resource guard before unknown hash')
            with path.open('rb')as f:
                opened=os.fstat(f.fileno());raw=f.read(size+1);closed=os.fstat(f.fileno())
            sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
            need(sig(a)==sig(opened)==sig(closed)==sig(path.lstat())and len(raw)==size,'whole stable bounded actual file')
            ref=reference(path,raw);self.refs[ref['path']]=ref;self.raw[ref['path']]=raw;self.bytes+=len(raw)
            return ref
        ref=dict(path=str(path),bytes=size,sha256=sha);self.whole(ref);return ref
    def final(self):
        for ref in list(self.refs.values()):self.whole(ref,True)


def expand(runs,maximum):
    out=[];last=0
    need(type(runs)is list,'complete original position runs')
    for row in runs:
        need(type(row)is list and len(row)==2,'run pair');lo,hi=row
        need(type(lo)is type(hi)is int and last<lo<=hi<=maximum,'ordered disjoint bounded runs')
        out.extend(range(lo,hi+1));last=hi
    return out


def pack(values):
    result=[]
    for value in values:
        if result and result[-1][1]+1==value:result[-1][1]=value
        else:result.append([value,value])
    return result


def destination(path,temporary=False):
    text=str(path);p=Path(text)
    need(p.is_absolute()and str(p)==text and '..'not in p.parts and not os.path.lexists(p),
         'fresh normalized immutable publication path')
    need(p.is_relative_to('/private/tmp')if temporary else p.is_relative_to(ROOT),
         'temporary preparation or explicit immutable section-generation publication')
    ancestor=p.parent
    while not ancestor.exists():ancestor=ancestor.parent
    need(ancestor.resolve(strict=True)==ancestor,'canonical existing ancestry before mkdir')
    return p


def publish_raw(path,raw,temporary=False):
    p=destination(path,temporary);p.parent.mkdir(parents=True,exist_ok=True)
    need(p.parent.resolve(strict=True)==p.parent,'canonical final publication parent')
    with p.open('xb')as f:need(f.write(raw)==len(raw),'whole exclusive metadata publication');f.flush();os.fsync(f.fileno())
    for directory in(p.parent,p.parent.parent):
        fd=os.open(directory,os.O_RDONLY)
        try:os.fsync(fd)
        finally:os.close(fd)
    return reference(p,raw)


