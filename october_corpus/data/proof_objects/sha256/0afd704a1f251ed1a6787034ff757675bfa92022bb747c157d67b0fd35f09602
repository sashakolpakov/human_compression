"""UNRUN controls for criterion-specific combined19/37 continuation.

Root alone may activate this Source under a fresh control gate. It invokes
the actual subject scope on the real accepted context, never a candidate
mark reconstruction or scientific main. Negative tests alter only private
in-memory plan fields. No mocked API or fabricated execution result is used.
Historical positive matrices are functional fixtures, with no new case credit.
"""
import argparse
import ast
import copy
import hashlib
import json
import math
import os
from pathlib import Path
import resource
import signal
import stat
import sys
import time
import types

START = time.monotonic()
ENV4 = ('COVERAGE_PROCESS_START', 'COVERAGE_PROCESS_CONFIG', 'OPENSSL_CONF', 'OPENSSL_MODULES')


def need(ok, message):
    if not ok:
        raise ValueError(message)


def decode(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            need(key not in out, 'unique JSON keys')
            out[key] = value
        return out
    def floating(text):
        value = float(text)
        need(math.isfinite(value), 'finite float')
        return value
    return json.loads(raw, object_pairs_hook=pairs, parse_float=floating,
                      parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


def main():
    need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode
         and not sys.flags.optimize and all(k not in os.environ for k in ENV4), 'fresh EBS controls')
    signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError('100s controls')))
    signal.setitimer(signal.ITIMER_REAL, max(.001, 100 - (time.monotonic() - START)))
    ap = argparse.ArgumentParser(allow_abbrev=False)
    ap.add_argument('--self-sha256', required=True)
    ap.add_argument('--program', nargs=2, required=True)
    ap.add_argument('--parent-program', nargs=2, required=True)
    ap.add_argument('--logical-plan', nargs=2, required=True)
    ap.add_argument('--source-gate', nargs=2, required=True)
    args = ap.parse_args()
    refs = {}
    explicit_bytes = 0

    def read(path, sha, cap):
        nonlocal explicit_bytes
        p = Path(path)
        a = p.lstat()
        need(p.is_absolute() and p.resolve(strict=True) == p and stat.S_ISREG(a.st_mode)
             and a.st_nlink == 1 and 0 <= a.st_size <= cap, 'canonical bounded input')
        need(explicit_bytes + a.st_size <= 8 * 2**20
             and (str(p) in refs or len(refs) < 96), 'admit cumulative read/path budget before open')
        with p.open('rb') as f:
            b = os.fstat(f.fileno())
            raw = f.read(cap + 1)
            c = os.fstat(f.fileno())
        sig = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns, x.st_ctime_ns)
        need(sig(a) == sig(b) == sig(c) == sig(p.lstat()) and len(raw) == a.st_size
             and hashlib.sha256(raw).hexdigest() == sha, 'whole stable control input')
        ref = dict(path=str(p), bytes=len(raw), sha256=sha)
        need(refs.get(str(p), ref) == ref, 'one immutable version')
        refs[str(p)] = ref
        explicit_bytes += len(raw)
        need(explicit_bytes <= 8 * 2**20 and len(refs) <= 96, 'unchanged read/path bounds')
        return raw, ref

    own_raw, own = read(str(Path(__file__).resolve()), args.self_sha256, 65536)
    # Charge the Python Source bootstrap separately from its explicit first read.
    explicit_bytes += own['bytes']
    raw, program = read(*args.program, 65536)
    parent_raw, parent = read(*args.parent_program, 65536)
    plan_raw, plan_ref = read(*args.logical_plan, 524288)
    gate_raw, gate_ref = read(*args.source_gate, 8192)
    plan = decode(plan_raw)
    gate = decode(gate_raw)
    need(gate.get('schema') == 'ROOT_AUTHORIZED_CRITERION_SPECIFIC_19OR37_CONTINUATION_CONTROLS_V1'
         and gate.get('root') == '/root' and gate.get('adopted') is True
         and gate.get('program') == own and gate.get('target_program') == program
         and gate.get('parent_program') == parent and gate.get('logical_plan') == plan_ref
         and gate.get('context_scope_and_functional_arithmetic_authorized') is True
         and gate.get('actual_candidate_case_calls_authorized') is False,
         'fresh Root control authority, no science gate or old PASS transfer')
    need(plan['program'] == program and plan['source_parent_qualified_only'] == parent,
         'exact current subject and parent')
    olddefs = {n.name: n for n in ast.parse(parent_raw).body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    newdefs = {n.name: n for n in ast.parse(raw).body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    unchanged = [name for name in olddefs
                 if ast.dump(olddefs[name], include_attributes=False) == ast.dump(newdefs[name], include_attributes=False)]
    need(len(unchanged) == 23 and [name for name in olddefs if name not in unchanged] == ['scope', 'startup', 'main'],
         'all23 inherited arithmetic/context definitions unchanged')
    subject = types.ModuleType('criterion_specific19or37_continuation_control_subject')
    subject.__file__ = program['path']
    # Root activation only; the private author has never loaded this module.
    exec(compile(raw, program['path'], 'exec'), subject.__dict__)
    budget = subject.Budget()
    for ref in plan['inputs']:
        budget.read(ref)
    checks = []

    def passed(name, value):
        need(value, name)
        checks.append(name)

    def refused(name, fixture):
        try:
            subject.scope(fixture, budget)
        except ValueError:
            checks.append(name)
            return
        raise ValueError('expected actual scope refusal: ' + name)

    ctx, positions = subject.scope(plan, budget)
    passed('real current scope retains1250 combined-criterion eligible positions',
           positions == plan['selected_orbit_positions'] and len(positions) == 1250)
    passed('only1476 actual BOTH-predicate current misses are excluded',
           len(plan['same_combined_criterion_miss_current_positions']) == 1476
           and not set(positions) & set(plan['same_combined_criterion_miss_current_positions']))
    selector = budget.doc(plan['selector'])
    literal7 = [t for t in selector['previous_method_attempts']
                if t['criterion'] == 'DIRECT_LITERAL_MIDDLE_EXACT_ORDER7']
    passed('one separate literal7 history accounts for its full2967 visits',
           len(literal7) == 1 and len(literal7[0]['visited_positions']) == 2967
           and literal7[0]['unvisited_positions'] == [])
    passed('literal7 misses are still eligible for old19or37',
           set(positions) <= set(literal7[0]['finite_criterion_miss_positions']))
    passed('baseline173 and accepted880 cannot enter the selected domain',
           selector['original_paid_count'] == 173 and len(selector['accepted_new_paid_positions']) == 880
           and not set(positions) & set(selector['original_paid_positions'] + selector['accepted_new_paid_positions']))
    passed('all8 Root-adopted components are preserved', len(selector['source_adoptions']) == 8)
    adopted = [budget.doc(r) for r in plan['current_source_adoptions']]
    single19 = next(v for v in adopted if v['schema'] == 'ROOT_ACCEPTED_Q11_RANK4_MIDDLE19_DIVISIBLE_DIRECT_IP_FAILURES_V1')
    single19_misses = set(single19['finite_criterion_miss_positions_without_IP_credit']) & set(ctx['current_unresolved_positions'])
    passed('107 old19-only misses stay eligible for the37 branch',
           len(single19_misses) == 107 and single19_misses <= set(positions))
    passed('15 fixed-dictionary section misses stay eligible for the combined criterion',
           len(plan['remaining_historical_finite37_misses']) == 15
           and set(plan['remaining_historical_finite37_misses']) <= set(positions))
    new7 = next(v for v in adopted if v['schema'] == 'ROOT_ACCEPTED_Q11_RANK4_MIDDLE7_DIVISIBLE_DIRECT_IP_FAILURES_V1')
    new7_false = set(new7['finite_criterion_miss_positions_without_IP_credit'] + new7['logical_predicate_false_positions'])
    passed('new7 negatives cover2726 but are not a combined-criterion exclusion',
           set(ctx['current_unresolved_positions']) <= new7_false and len(ctx['current_unresolved_positions']) == 2726
           and new7['cofactor'] == 19 and new7['prime'] == 7
           and new7['actual_middle_nineteenth_then_seventh_power_checks_under_root_owned_source'] is True
           and new7['actual_branch_specific_middle_power_checks_under_root_owned_source'] is False)

    bad = copy.deepcopy(plan)
    bad['selected_orbit_positions'] = sorted(positions[:-1] + [plan['same_combined_criterion_miss_current_positions'][0]])
    refused('an actual BOTH-predicate miss cannot be replayed', bad)
    bad = copy.deepcopy(plan)
    bad['same_combined_criterion_miss_current_positions'] = ctx['current_unresolved_positions']
    refused('different-criterion history cannot become a combined negative set', bad)
    bad = copy.deepcopy(plan)
    bad['current_source_adoptions'] = bad['current_source_adoptions'][:-1]
    refused('dropping the new cofactor19-prime7 adopted component is refused', bad)
    # Known positive carriers from an actual prior accepted old19/37 component.
    legacy = next(budget.doc(ref) for ref in plan['current_source_adoptions']
                  if budget.doc(ref)['schema'] == 'ROOT_ACCEPTED_Q11_RANK4_MIDDLE19_OR37_DIRECT_IP_FAILURES_V1')
    for prime, cofactor in [(19, 7), (37, 3)]:
        row = next(v for v in legacy['actual_positive_certificate_records'] if v[3] == prime)
        Y = subject.matrix(row[4], 7)
        Z = subject.power(Y, cofactor, budget)
        Zp = subject.power(Z, prime, budget)
        passed('unchanged exact functional prime fixture ' + str(prime),
               Z == subject.matrix(row[5], 7) and Zp == subject.matrix(row[6], 7) == subject.I7 and Z != subject.I7)
        if prime == 37:
            Y7 = subject.power(Y, 7, budget)
            passed('prime37 fixture really follows a19 miss',
                   not (Y7 != subject.I7 and subject.power(Y7, 19, budget) == subject.I7))
    # Identity fails both sufficient predicates; no positive marking follows.
    passed('identity is a miss for both old sufficient predicates',
           subject.power(subject.I7, 7, budget) == subject.I7
           and subject.power(subject.I7, 3, budget) == subject.I7)
    budget.recheck()
    for ref in list(refs.values()):
        read(ref['path'], ref['sha256'], 524288 if ref == plan_ref else (8192 if ref == gate_ref else 65536))
    total_read = explicit_bytes + budget.bytes
    total_paths = len(set(refs) | set(budget.refs))
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == 'darwin' else 1024)
    need(total_read <= 8 * 2**20 and total_paths <= 96 and budget.products <= 400000
         and rss < 128 * 2**20 and time.monotonic() - START < 100, 'unchanged aggregate control limits')
    result = dict(schema='CRITERION_SPECIFIC_19OR37_CONTINUATION_CONTROLS_RESULT_V1',
                  status='PASS_CRITERION_SPECIFIC_19OR37_CONTINUATION_CONTROLS', program=own,
                  target_program=program, parent_program=parent, logical_plan=plan_ref,
                  source_gate=gate_ref, checks=checks, inherited_AST_components=unchanged,
                  actual_context_scope_helper_calls=4, actual_candidate_case_calls=0,
                  historical_positive_matrices_used_only_as_functional_fixtures=True,
                  natural_context_from_actual_Root_accepted_inputs=True, new_paid_credit=0,
                  whole_original_credit=0,
                  resources=dict(physical_read_bytes_including_Source_bootstrap=total_read,
                                 unique_files=total_paths, matrix_products=budget.products,
                                 peak_self_rss_bytes=rss, seconds=time.monotonic() - START))
    encoded = json.dumps(result, sort_keys=True, separators=(',', ':'), allow_nan=False).encode() + b'\n'
    need(len(encoded) <= 131072, 'bounded complete control result')
    sys.stdout.buffer.write(encoded)


if __name__ == '__main__':
    main()
