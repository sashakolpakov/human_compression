def _one(text,before,after):
    need(text.count(before)==1 and after not in text,'one exact initial-storage Source site')
    result=text.replace(before,after,1)
    need(result.replace(after,before,1)==text,'entire Source site inverse')
    return result


def _body(text,name,kind=None):
    import ast
    kind=ast.FunctionDef if kind is None else kind
    rows=[n for n in ast.parse(text).body if isinstance(n,kind)and n.name==name]
    need(len(rows)==1,'one complete actual Source definition: '+name)
    return ast.get_source_segment(text,rows[0])


def _code(text,filename,name,parent=None):
    code=compile(text,filename,'exec',dont_inherit=True)
    if parent is not None:
        found=[c for c in code.co_consts if isinstance(c,types.CodeType)and c.co_name==parent]
        need(len(found)==1,'one exact parent code');code=found[0]
    found=[c for c in code.co_consts if isinstance(c,types.CodeType)and c.co_name==name]
    need(len(found)==1,'one exact function code: '+name)
    return found[0]


