def need(ok,why):
    if not ok:raise ValueError(why)
    peak=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024)
    if peak>=128*2**20 or time.monotonic()-START>=100:raise RuntimeError('128MiB100s control bound')

def signature(s):return(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)

def source(path,sha):
    global READ
    p=Path(path);a=p.lstat()
    need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
         and a.st_nlink==1 and 0<a.st_size<=65536 and READ+a.st_size<=262144,'preadmitted bounded ordinary Source')
    with p.open('rb')as f:
        b=os.fstat(f.fileno());raw=f.read(a.st_size+1);z=os.fstat(f.fileno())
    need(signature(a)==signature(b)==signature(z)==signature(p.lstat())
         and len(raw)==a.st_size and hashlib.sha256(raw).hexdigest()==sha,'stable complete Source')
    READ+=len(raw);PINS.append(dict(path=str(p),bytes=len(raw),sha256=sha))
    return raw

def module(path,raw,label):
    namespace=dict(__file__=path,__name__='F009_synthetic_'+label,__package__=None)
    text=raw.decode();tree=ast.parse(text)
    for name in ('_LocationBlock','LocationDigestMap'):
        nodes=[n for n in tree.body if isinstance(n,ast.ClassDef)and n.name==name]
        need(len(nodes)==(1 if name=='LocationDigestMap' or label!='old' else 0),'complete exact class-only subject')
        for n in nodes:exec(compile(ast.get_source_segment(text,n),path+'::synthetic_class_only','exec',dont_inherit=True),namespace)
    return namespace['LocationDigestMap']

def outcome(fn):
    try:return('returned',fn())
    except (KeyError,TypeError)as e:return(type(e).__name__,e.args)

