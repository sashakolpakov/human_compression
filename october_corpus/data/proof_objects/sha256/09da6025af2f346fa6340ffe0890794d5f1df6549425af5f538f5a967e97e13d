START = time.monotonic()
ENV4 = ('COVERAGE_PROCESS_START', 'COVERAGE_PROCESS_CONFIG', 'OPENSSL_CONF', 'OPENSSL_MODULES')


def need(ok, message):
    if not ok:
        raise ValueError(message)


def decode(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            need(key not in out, 'unique JSON keys')
            out[key] = value
        return out
    def floating(text):
        value = float(text)
        need(math.isfinite(value), 'finite float')
        return value
    return json.loads(raw, object_pairs_hook=pairs, parse_float=floating,
                      parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


def main():
    need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode
         and not sys.flags.optimize and all(k not in os.environ for k in ENV4), 'fresh EBS controls')
    signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError('100s controls')))
    signal.setitimer(signal.ITIMER_REAL, max(.001, 100 - (time.monotonic() - START)))
    ap = argparse.ArgumentParser(allow_abbrev=False)
    ap.add_argument('--self-sha256', required=True)
    ap.add_argument('--program', nargs=2, required=True)
    ap.add_argument('--parent-program', nargs=2, required=True)
    ap.add_argument('--logical-plan', nargs=2, required=True)
    ap.add_argument('--source-gate', nargs=2, required=True)
    args = ap.parse_args()
    refs = {}
    explicit_bytes = 0

    def read(path, sha, cap):
        nonlocal explicit_bytes
        p = Path(path)
        a = p.lstat()
        need(p.is_absolute() and p.resolve(strict=True) == p and stat.S_ISREG(a.st_mode)
             and a.st_nlink == 1 and 0 <= a.st_size <= cap, 'canonical bounded input')
        with p.open('rb') as f:
            b = os.fstat(f.fileno())
            raw = f.read(cap + 1)
            c = os.fstat(f.fileno())
        sig = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns, x.st_ctime_ns)
        need(sig(a) == sig(b) == sig(c) == sig(p.lstat()) and len(raw) == a.st_size
             and hashlib.sha256(raw).hexdigest() == sha, 'whole stable control input')
        ref = dict(path=str(p), bytes=len(raw), sha256=sha)
        need(refs.get(str(p), ref) == ref, 'one immutable version')
        refs[str(p)] = ref
        explicit_bytes += len(raw)
        need(explicit_bytes <= 8 * 2**20 and len(refs) <= 96, 'unchanged read/path bounds')
        return raw, ref

    own_raw, own = read(str(Path(__file__).resolve()), args.self_sha256, 65536)
    # Charge the Python Source bootstrap separately from its explicit first read.
    explicit_bytes += own['bytes']
    raw, program = read(*args.program, 65536)
    parent_raw, parent = read(*args.parent_program, 65536)
    plan_raw, plan_ref = read(*args.logical_plan, 524288)
    gate_raw, gate_ref = read(*args.source_gate, 8192)
    plan = decode(plan_raw)
    gate = decode(gate_raw)
    need(gate.get('schema') == 'ROOT_AUTHORIZED_MIDDLE7_DIVISIBLE_CONTROLS_V1'
         and gate.get('root') == '/root' and gate.get('adopted') is True
         and gate.get('program') == own and gate.get('target_program') == program
         and gate.get('parent_program') == parent and gate.get('logical_plan') == plan_ref
         and gate.get('context_scope_and_functional_arithmetic_authorized') is True
         and gate.get('actual_candidate_case_calls_authorized') is False,
         'fresh Root control authority, no science gate or old PASS transfer')
    need(plan['program'] == program and plan['source_parent_qualified_only'] == parent,
         'exact current subject and parent')
    olddefs = {n.name: n for n in ast.parse(parent_raw).body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    newdefs = {n.name: n for n in ast.parse(raw).body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    unchanged = [name for name in olddefs
                 if name in newdefs and ast.dump(olddefs[name], include_attributes=False) == ast.dump(newdefs[name], include_attributes=False)]
    need(len(unchanged) == 23 and set(olddefs) - set(unchanged) == {'scope', 'startup', 'main', 'literal_middle7'}
         and set(newdefs) - set(olddefs) == {'middle7_divisible'},
         'all23 inherited arithmetic/context definitions unchanged')
    subject = types.ModuleType('middle7_divisible_control_subject')
    subject.__file__ = program['path']
    # Root activation only; the private author has never loaded this module.
    exec(compile(raw, program['path'], 'exec'), subject.__dict__)
    budget = subject.Budget()
    for ref in plan['inputs']:
        budget.read(ref)
    checks = []

    def passed(name, value):
        need(value, name)
        checks.append(name)

    def refused(name, fixture):
        try:
            subject.scope(fixture, budget)
        except ValueError:
            checks.append(name)
            return
        raise ValueError('expected actual scope refusal: ' + name)

    ctx, positions = subject.scope(plan, budget)
    reused = ctx['logical_predicate_false_positions']
    passed('real new scope selects1348 and reuses1583 actual paired negatives',
           positions == plan['selected_orbit_positions'] and len(positions) == 1348
           and reused == plan['logical_predicate_false_positions'] and len(reused) == 1583)
    passed('new arithmetic and logical coverage exactly partition current2931',
           not set(positions) & set(reused)
           and sorted(positions + reused) == ctx['current_unresolved_positions'])
    selector = budget.doc(plan['selector'])
    literal7 = [t for t in selector['previous_method_attempts']
                if t['criterion'] == 'DIRECT_LITERAL_MIDDLE_EXACT_ORDER7']
    passed('actual exact7 negative evidence covers every current unpaid position',
           len(literal7) == 1
           and set(ctx['current_unresolved_positions']) <= set(literal7[0]['finite_criterion_miss_positions']))
    older = [3,5,6,10,12,14,18,19,20,22,24,25,27,36,43]
    passed('all15 differently tested section or literal19 misses remain arithmetic targets',
           set(older) <= set(positions))
    passed('exact typed current negative support counts are107+730+746 with2931 exact7 negatives',
           [s['current_miss_count'] for s in ctx['negative_fact_support']] == [107,730,746,2931])
    passed('all7 adopted components and paid675 remain intact',
           len(selector['source_adoptions']) == 7 and len(selector['accepted_new_paid_positions']) == 675
           and not set(positions + reused) & set(selector['accepted_new_paid_positions'] + selector['original_paid_positions']))
    bad = copy.deepcopy(plan)
    bad['selected_orbit_positions'] = sorted(positions[:-1] + [reused[0]])
    refused('a logically covered predicate-negative cannot be rerun as fresh', bad)
    bad = copy.deepcopy(plan)
    bad['logical_predicate_false_positions'] = sorted(set(reused + older))
    refused('generic earlier search misses cannot be relabelled cofactor7 negatives', bad)
    bad = copy.deepcopy(plan)
    bad['negative_fact_support'] = bad['negative_fact_support'][:-1]
    refused('dropping actual exact7 negative support is refused', bad)
    bad = copy.deepcopy(plan)
    bad['current_source_adoptions'] = bad['current_source_adoptions'][:-1]
    refused('dropping actual exact7 adopted component is refused', bad)
    def permutation(values):
        return tuple(tuple(int(values[i] == j) for j in range(7)) for i in range(7))
    cycle7 = permutation([1,2,3,4,5,6,0])
    Z, Z7, enough = subject.middle7_divisible(cycle7, budget)
    passed('known order7 functional positive', enough is True and Z != subject.I7 and Z7 == subject.I7)
    _, _, identity = subject.middle7_divisible(subject.I7, budget)
    passed('identity is negative', identity is False)
    order2 = permutation([1,0,2,3,4,5,6])
    _, _, two = subject.middle7_divisible(order2, budget)
    passed('order2 functional negative', two is False)
    # Select a known order133 fixture from actual already-paid old19 carriers.
    # That old certificate bounds order by19or133; the new nonidentity19th
    # power distinguishes133. This is not a new original candidate decision.
    known133 = None
    tested_fixtures = 0
    for ref in plan['current_source_adoptions']:
        legacy = budget.doc(ref)
        if legacy['schema'] != 'ROOT_ACCEPTED_Q11_RANK4_MIDDLE19_OR37_DIRECT_IP_FAILURES_V1':
            continue
        need(len(legacy['actual_positive_certificate_records']) <= 3000, 'bounded historical fixture set')
        for row in legacy['actual_positive_certificate_records']:
            if row[3] != 19:
                continue
            tested_fixtures += 1
