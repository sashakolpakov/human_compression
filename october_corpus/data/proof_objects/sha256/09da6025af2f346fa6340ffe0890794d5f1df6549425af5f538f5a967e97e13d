    for ref in list(refs.values()):
        read(ref['path'], ref['sha256'], 524288 if ref == plan_ref else (8192 if ref == gate_ref else 65536))
    total_read = explicit_bytes + budget.bytes
    total_paths = len(set(refs) | set(budget.refs))
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == 'darwin' else 1024)
