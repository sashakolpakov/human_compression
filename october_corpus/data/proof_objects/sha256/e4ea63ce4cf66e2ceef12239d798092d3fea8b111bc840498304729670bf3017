"""Root metadata release for the prepared independent Reader; no scientific calls."""
from pathlib import Path
import argparse, hashlib, json, os

N = Path('/private/tmp/f009_continuation/from_10997/shared_pin_transport')

def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()

def reference(path):
    path = Path(path)
    raw = path.read_bytes()
    assert len(raw) <= 4 * 2**20 and path.resolve(strict=True) == path
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def document(path, digest):
    row = reference(path)
    assert row['sha256'] == digest
    return json.loads(Path(path).read_bytes()), row

ap = argparse.ArgumentParser(allow_abbrev=False)
ap.add_argument('--peer', nargs=2, required=True)
ap.add_argument('--peer-status', required=True)
args = ap.parse_args()
peer, peer_ref = document(*args.peer)
assert peer['status'] == args.peer_status and peer.get('blockers', []) == []
