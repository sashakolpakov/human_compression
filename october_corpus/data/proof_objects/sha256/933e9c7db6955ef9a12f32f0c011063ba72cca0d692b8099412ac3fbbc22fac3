def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True,
                       allow_nan=False) + '\n').encode()

def digest(data):
    return hashlib.sha256(data).hexdigest()

def no_duplicates(pairs):
    value = {}
    for key, item in pairs:
        assert key not in value, ('duplicate JSON key', key)
        value[key] = item
    return value

def parse(data):
    return json.loads(data, object_pairs_hook=no_duplicates,
                      parse_constant=lambda text: (_ for _ in ()).throw(ValueError(text)))

def sig(value):
    return (value.st_dev, value.st_ino, value.st_mode, value.st_nlink,
            value.st_size, value.st_mtime_ns, value.st_ctime_ns)

def whole(path, expected=None):
    path = Path(path)
    before = path.lstat()
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and path.resolve() == path
    with path.open('rb') as stream:
        opened = os.fstat(stream.fileno())
        data = stream.read()
        closed = os.fstat(stream.fileno())
    assert sig(before) == sig(opened) == sig(closed) == sig(path.lstat())
    pin = dict(path=str(path), bytes=len(data), sha256=digest(data))
    if expected is not None:
        assert pin == expected, (pin, expected)
    assert checked.get(str(path), pin) == pin
    checked[str(path)] = pin
    return data, pin

def document(path, expected=None):
    data, pin = whole(path, expected)
    return parse(data), pin

def reference_document(ref):
    return document(ref['path'], ref)[0]

def scan_refs(value):
    if isinstance(value, dict):
        if set(value) == {'path', 'bytes', 'sha256'}:
            whole(value['path'], value)
        else:
            for item in value.values():
                scan_refs(item)
    elif isinstance(value, list):
        for item in value:
            scan_refs(item)

def expand_table(value, field, tag):
    if tag not in value:
        return value
    table = value[tag]
    result = {key: item for key, item in value.items() if key != tag}
    result[field] = [dict(path=table['prefixes'][i] + suffix, bytes=size, sha256=sha)
                     for i, suffix, size, sha in table['rows']]
    assert result[field] == sorted(result[field], key=lambda row: row['path'])
    assert len({row['path'] for row in result[field]}) == len(result[field])
    assert len(canonical(result)) == table['logical_bytes']
    assert digest(canonical(result)) == table['logical_sha256']
    return result

def sdk(ref):
