    frames = value['all_genuine_api_frames']
    first, last, actual = frames[0], frames[-1], value['actual_tool']
    assert value['actor'] == value.get('root', value['actor']) == '/root'
    assert first == value['full_initial_tool_return'] and last == value['full_tool_return']
    assert actual['exit_code'] == last['exit_code'] == 0 and 'session_id' not in last
    assert actual['initial_chunk'] == first['chunk_id'] and actual['terminal_chunk'] == last['chunk_id']
    if actual['synchronous']:
        assert first == last and actual['handle'] is None and len(frames) == 1
    else:
        assert first['session_id'] == actual['handle']
        assert all(frame.get('session_id') == actual['handle'] for frame in frames[:-1])
    assert value['issued_argv'] == value['child_argv']
    assert value['issued_argv'] == shlex.split(value['issued_command'])
    assert value['issued_argv'] == shlex.split(value['canonical_argv_command'])
    assert value['issued_tool_arguments']['cmd'] == value['issued_command']
    return value, parse(''.join(frame.get('output', '') for frame in frames))

