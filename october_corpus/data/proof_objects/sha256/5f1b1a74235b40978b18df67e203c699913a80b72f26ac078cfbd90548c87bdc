    attempts=denial()
    jobref=initial_ref(*a.job,8*2**20);job=strict(bootstrap(jobref,8*2**20))
    gateref=initial_ref(*a.root_review,65536);gate=strict(bootstrap(gateref,65536))
    need(job['role']=='native'and job['operation']=='SOURCE_PROFILE_PREFLIGHT_ONLY'
         and job['output']==str(a.out),'one explicit non-scientific source-preflight job')
    own=gate['program'];need(own['path']==str(Path(__file__).resolve()),'actual new preflight program');bootstrap(own,65536)
    need(gate['schema']=='ROOT_REVIEWED_F009_STANDALONE_JOB_V1'and gate['root']=='/root'
         and gate['status']=='SUPPORTED'and gate['blockers']==[]and gate['job']==jobref,
         'fresh Root review of this source-only subject')
    cref=job['contract'];craw=bootstrap(cref,65536);need(cref in gate['method_sources'],'complete authenticated contract')
    C=types.ModuleType('Root_F009_preflight_current_contract');C.__file__=cref['path']
    exec(compile(craw,cref['path'],'exec',dont_inherit=True),C.__dict__)
    contract=C.Contract(job,jobref,gate,gateref,own)
    contract.require_scientific_release(job,'native') # authenticates the same metadata premises; launches nothing.
    route=contract.module(job['library_adapter'],'Root_F009_preflight_retained_library_route')
    budget=route.io_budget(contract,job['IO_budget_source'],job['producer_reservation']);sys.addaudithook(budget.event)
    need(job['producer_reservation']['native_writers']==[],'preflight IO cannot authorize any native writer')
    module=contract.module(job['mathematical_native_library'],'Root_F009_preflight_retained_native_library')
    def metadata_subject(ref,K):
