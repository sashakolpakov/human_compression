        module.K.need(module.K.same(module.K.pin(ref['path']),ref),'whole original case-check Source identity')
    current_case=module.K.document(case)
    backend.check_case(current_case) # includes literal terminal_reader.check_case and full direct-role acquisitions.
    need(callable(run)and not attempts,'all retained Source/profile/direct-case prerequisites closed without Native')
    # Deliberately never invoke run, old.priority_run, Segment or state codecs.
