        value=contract.document(ref)
        need(value['schema']=='ROOT_F009_STANDALONE_METADATA_CREATOR_V1'and value['root']=='/root'
             and value['writer']==job['metadata_constructor']and value['old_metadata_Source_executed']is False,
             'new metadata creator attribution')
