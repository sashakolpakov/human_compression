   value.update(remaining=157,pending_ledger=pending_ref,root_adoption=import_ref,\n                                 status='ROOT_REGISTERED_F004_Q11_EXISTING_CLOSED40_BATCH')\n                else:\n                    value.update(pending=157,pending_file=pending_ref,adoption=import_ref,\n                                 rank_four_pending=157,rank_five_pending=0)\n            change(banks[name],path,value,changes[name])\n    legacy = dict(q11_actual_lower_closed=115,q11_closed=115,q11_actual_pending=157,\n                  q11_pending=157,q11_remaining=pending_ref,q11_current_pending_plan=pending_ref,\n                  q11_pending_registration=registration_ref,\n                  q11_latest_adoption=str(Path(import_ref['path']).relative_to(S)),\n                  q11_authoritative_latest=('F004_q11_latest_ledger and q11_batch_registration_current; '\n                      'q11_latest, q11_latest_completed and q11_latest_import retain historical single-job provenance.'),\n                  q11_batch_registration_current=registration_ref)\n    need(list(legacy) == LEGACY_KEYS, 'exact legacy active-leaf roster')\n    for key,value in legacy.items():\n        change(banks['CURRENT'],['F004_current',key],value,changes['CURRENT'],\n               allow_absent=key=='q11_batch_registration_current')\n    note=('F004 q8 registered686/686; q9 accepted35/35; q11 registered115/272 with157 rank4 pending. '\n          'All33 rank5 jobs are proved; follow F004_q11_latest_ledger and its pending register. '\n          'q8/q11 field assembly, Aut/duality quotient and final tables remain owed; no new Original credit.')\n    change(banks['CURRENT'],['F004_current','navigation_note'],note,changes['CURRENT'])\n    change(banks['STATUS'],['F004','q8_completed'],686,changes['STATUS'])\n    change(banks['STATUS'],['F004','next_status'],note,changes['STATUS'])\n    change(banks['STATUS'],['F004','next_scope'],\n           'Continue only current q11 latest pending register rank4 jobs; preserve accepted model/domain/classification premises. '\n           'Do not rerun any of33 proved rank5 jobs. Complete q8/q11 field assembly and Aut/duality/tables.',changes['STATUS'])\n    change(banks['STATUS'],['root_intake_batch_status'],\n           '102/105 complete; F004,F009,L026 remain. F004: use current q8/q11 ledgers; q8 field assembly and '\n           'q11 pending rank4/field assembly remain. F009: continue CURRENT.F009_checkpoint_current without '\n           'replaying known passes. L026: use current paid coverage selectors. Complete all105, then STOP before measurement/Lean.',changes['STATUS'])\n    old_actions=at(documents['STATUS'],['root_status_update_current','next_actions'])\n    need(type(old_actions) is list and all(type(x) is str for x in old_actions), 'whole prior actions list')\n    change(banks['STATUS'],['root_status_update_current','prior_next_actions_closed40_history'],\n           dict(utc=documents['STATUS']['root_status_update_current']['utc'],next_actions=old_actions),\n           changes['STATUS'],allow_absent=True)\n    actions=['F004: follow F004_q11_latest_ledger pending rank4 register and current q8 ledger; finish field assembly/Aut/duality/tables.',\n             'F009: continue CURRENT.F009_checkpoint_current; preserve accepted pending scope and do not replay known passes.',\n             'L026: continue only unpaid current paid-ledger/coverage selector scopes.',\n             'Complete all105 reviewed Originals, then STOP before measurement or Lean.']\n    change(banks['STATUS'],['root_status_update_current','next_actions'],actions,changes['STATUS'])\n    audit=at(documents['STATUS'],['root_goal_turn_audit_current'])\n    change(banks['STATUS'],['root_goal_turn_audit_current','prior_qualification_closed40_history'],\n           dict(utc=audit['utc'],qualification=audit['qualification']),changes['STATUS'],allow_absent=True)\n    change(banks['STATUS'],['root_goal_turn_audit_current','qualification'],\n           'The preceding dated proof context is retained in prior_qualification_closed40_history. Active F004/F009/L026 '\n           'work follows current accepted ledgers and checkpoint;102/105 complete. Complete all105, then STOP before measurement/Lean.',changes['STATUS'])\n    for name in banks:\n        inverse(documents[name],banks[name],changes[name])\n    idle(banks['CURRENT'],banks['STATUS'])\n    need(equal(banks['CURRENT']['F004_q11_latest_ledger'],banks['STATUS']['F004_q11_latest_ledger']),\n         'both complete new q11 ledger aliases agree')\n    return banks,changes"},{"AST":"FunctionDef(name='publication', args=arguments(args=[arg(arg='io', lineno=525, col_offset=16, end_lineno=525, end_col_offset=18), arg(arg='plan', lineno=525, col_offset=20, end_lineno=525, end_col_offset=24), arg(arg='plan_ref', lineno=525, col_offset=26, end_lineno=525, end_col_offset=34), arg(arg='method', lineno=525, col_offset=36, end_lineno=525, end_col_offset=42), arg(arg='index', lineno=525, col_offset=44, end_lineno=525, end_col_offset=49), arg(arg='documents', lineno=525, col_offset=51, end_lineno=525, end_col_offset=60), arg(arg='raws', lineno=525, col_offset=62, end_lineno=525, end_col_offset=66), arg(arg='remaining', lineno=525, col_offset=68, end_lineno=525, end_col_offset=77)]), body=[Assign(targets=[Name(id='out', ctx=Store(), lineno=526, col_offset=4, end_lineno=526, end_col_offset=7)], value=Call(func=Name(id='Path', ctx=Load(), lineno=526, col_offset=10, end_lineno=526, end_col_offset=14), args=[Subscript(value=Name(id='plan', ctx=Load(), lineno=526, col_offset=15, end_lineno=526, end_col_offset=19), slice=Constant(value='output_directory', lineno=526, col_offset=20, end_lineno=526, end_col_offset=38), ctx=Load(), lineno=526, col_offset=15, end_lineno=526, end_col_offset=39)], lineno=526, col_offset=10, end_lineno=526, end_col_offset=40), lineno=526, col_offset=4, end_lineno=526, end_col_offset=40), Expr(value=Call(func=Name(id='need', ctx=Load(), lineno=527, col_offset=4, end_lineno