ef = add('pending','proposed_pending.json',remaining)\n    need(pending_ref['bytes'] == 1196 and pending_ref['sha256'] == plan['proposed_pending_DATA']['sha256'],\n         'exact installed pending1196/fc8377 bytes')\n    registration = dict(schema='ROOT_F004_Q11_EXISTING_CLOSED40_TYPED_REGISTRATION_V1',\n        root=ROOT,registrar=ROOT,method=method,proof_kind=KIND,\n        Root_closure_import=plan['Root_closure_import'],closure_index=plan['closure_index'],\n        complete_job_records=index['rows'],old_pending=plan['old_pending'],new_pending=pending_ref,\n        ordered_removed_jobs=JOBS,added_jobs=[],required=272,closed_before=75,closed_after=115,\n        pending_before=197,pending_after=157,remaining_by_rank={'4':157,'5':0},\n        source_author=AUTHOR,Source_release=plan['Source_release'],before_live_roles=plan['before'],\n        operational_commit_requires_separate_CAS_receipt=True,\n        all_old_proof_actors_methods_scopes_preserved=True,scientific_replays=0,\n        whole_Original_manuscript_conjecture_measurement_Lean_credit=0)\n    record_ref = add('registration','root_closed40_registration.json',registration)\n    banks,patches = replacements(documents,pending_ref,record_ref,plan['Root_closure_import'])\n    add('inverse','whole_alias_inverse.json',dict(schema='F004_CLOSED40_WHOLE_TYPED_ALIAS_INVERSE_V1',\n         before=plan['before'],patches=patches,complete_unrelated_values_preserved=True,\n         old_single_job_proof_methods_and_unknown_alias_keys_preserved=True))\n    add('planned_pair','complete_planned_state_pair.json',dict(\n        schema='F004_CLOSED40_COMPLETE_PLANNED_STATE_PAIR_V1',CURRENT=banks['CURRENT'],STATUS=banks['STATUS']))\n    state_raws = {k:can(v) for k,v in banks.items()}\n    state_refs = {k:ref(CURRENT if k=='CURRENT' else STATUS,v) for k,v in state_raws.items()}\n    need(equal(state_refs,plan['planned_states']), 'exact whole reviewed planned pair, still uncommitted')\n    add('PREPARED','state_transaction_PREPARED.json',dict(\n        schema='ROOT_F004_CLOSED40_PREPARED_SEQUENTIAL_CAS_V1',root=ROOT,phase='PREPARED',\n        method=method,plan=plan_ref,Source_release=plan['Source_release'],\n        before_live_roles=plan['before'],before_archives={k:refs['before_'+k] for k in banks},\n        complete_planned_state_pair=refs['planned_pair'],planned_states=state_refs,\n        inverse=refs['inverse'],registration=record_ref,pending=pending_ref,\n        stage_paths=[str(p.with_name(p.name+STAGE_SUFFIX)) for p in (CURRENT,STATUS)],\n        pair_crash_atomic=False,automatic_retry_cleanup_or_rollback=False,\n        interrupted_commit_requires_Root_inspection=True))\n    # Include complete future receipt reserve and wrappers BEFORE any mkdir/write.\n    overhead = plan['guard_and_recorder_return_reserve']\n    need(type(overhead) is dict and type(overhead.get('bytes')) is int\n         and 0 <= overhead['bytes'] <= 2*MIB and type(overhead.get('paths')) is int\n         and 0 <= overhead['paths'] <= 32 and type(overhead.get('read_bytes')) is int\n         and 0 <= overhead['read_bytes'] <= 16*MIB\n         and type(overhead.get('source_bootstrap_bytes')) is int\n         and 0 <= overhead['source_bootstrap_bytes'] <= overhead['read_bytes'],\n         'one actual wrapper output/read/Source-bootstrap reserve')\n    output_bytes = sum(map(len,blobs.values())) + sum(map(len,state_raws.values()))\n    # Receipt/read budget is a bound; every actual output verification is charged again by IO.\n    need(output_bytes + 65536 + overhead['bytes'] <= LIMITS['new_bytes'],\n         'entire before/planned/registration/inverse/PREPARED/stages/commit/wrappers <=16MiB')\n    need(io.read_bytes + output_bytes + 65536 + overhead['bytes'] + overhead['read_bytes']\n         + 2*sum(len(x) for x in raws.values())\n         + 3*sum(r['bytes'] for r in plan['protected_progress'])\n         + sum(len(x) for x in state_raws.values()) <= LIMITS['read_bytes'],\n         'all actual output reopens, both finalCAS, after reads and final protected checks prepaid')\n    need(len(io.paths)+len(blobs)+2+1+1+2*len(OLD_STAGE_SUFFIXES+(STAGE_SUFFIX,))\n         +overhead['paths'] <= LIMITS['paths'],\n         'single complete input/output/stage/wrapper512-path bank')\n    return out,blobs,refs,banks,state_raws,state_refs,output_bytes"}]}
