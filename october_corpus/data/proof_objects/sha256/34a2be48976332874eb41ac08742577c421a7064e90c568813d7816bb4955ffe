)\n         and index.get('unresolved_genuine_API_links') == [], 'exact40 DATA index with resolved API metadata')\n    for row in index['rows']:\n        need(row.get('accepted_complete') is True and type(row.get('unpaid')) is int\n             and row['unpaid'] == 0 and row.get('genuine_checker_APIs'), 'all40 imported closures have genuine API joins')\n    proof_review = io.doc(plan['Root_closure_import'])\n    need(proof_review.get('schema') == 'ROOT_ACCEPTED_F004_CLOSED40_HISTORICAL_CLOSURE_IMPORT_V1'\n         and proof_review.get('root') == ROOT and proof_review.get('accepted') is True\n         and equal(proof_review.get('closure_index'),plan['closure_index'])\n         and equal(proof_review.get('ordered_jobs'),JOBS)\n         and proof_review.get('scientific_replays') == 0\n         and proof_review.get('whole_Original_credit') == 0\n         and equal(proof_review.get('metadata_packet_refs'),index['metadata_packet_refs']),\n         'actual Root import of old complete proofs, no new mathematical verdict')\n    components = proof_review['actual_metadata_components']\n    need(len(components) == len(index['metadata_packet_refs']), 'complete bounded old metadata component reviews')\n    for component, packet_ref in zip(components,index['metadata_packet_refs']):\n        packet = io.doc(packet_ref)\n        reviewed = io.doc(component['review'])\n        need(equal(component['packet'],packet_ref)\n             and reviewed.get('root') == ROOT and reviewed.get('accepted') is True\n             and equal(reviewed.get('packet'),packet_ref)\n             and reviewed.get('whole_input_paths') == packet['unique_paths']\n             and reviewed.get('whole_input_bytes') == packet['whole_bytes']\n             and reviewed.get('old_proof_mathematics_imported') is True,\n             'exact prior bounded metadata review receipt, not a new full sweep')\n        c = capture(io,component['actual_execution'],ROOT)\n        need(equal(c.get('review_emission'),component['review']), 'genuine component metadata return')\n    authorities = index['Root_authorities']\n    for row in authorities.values():\n        io.read(row)\n    # Only job23 has an explicitly adopted per-job selector in this imported index.\n    row = next(r for r in index['rows'] if r['original_job'] == [23,4])\n    selector = io.doc(row['current_per_job_selector'])\n    need(row['current_per_job_selector']['sha256'] == '2c79a9551b40789c187f1f48155f9aebb3fb1d47649b8c275ba9f3a5d27a8c03'\n         and row['Root_complete_authority']['sha256'] == '45a4cc2b8ff6058f263d36a47ffc40119bb6b4c8d54a61416bbb2fb81287ba09'\n         and selector.get('unresolved_positions') == 0\n         and selector.get('original_paid_count') == 217,\n         'job23 exact current closure selector;38IP distinct from43NG')\n    return index"},{"AST":"FunctionDef(name='pending', args=arguments(args=[arg(arg='io', lineno=360, col_offset=12, end_lineno=360, end_col_offset=14), arg(arg='plan', lineno=360, col_offset=16, end_lineno=360, end_col_offset=20)]), body=[Assign(targets=[Name(id='old', ctx=Store(), lineno=361, col_offset=4, end_lineno=361, end_col_offset=7)], value=Call(func=Attribute(value=Name(id='io', ctx=Load(), lineno=361, col_offset=10, end_lineno=361, end_col_offset=12), attr='doc', ctx=Load(), lineno=361, col_offset=10, end_lineno=361, end_col_offset=16), args=[Subscript(value=Name(id='plan', ctx=Load(), lineno=361, col_offset=17, end_lineno=361, end_col_offset=21), slice=Constant(value='old_pending', lineno=361, col_offset=22, end_lineno=361, end_col_offset=35), ctx=Load(), lineno=361, col_offset=17, end_lineno=361, end_col_offset=36)], lineno=361, col_offset=10, end_lineno=361, end_col_offset=37), lineno=361, col_offset=4, end_lineno=361, end_col_offset=37), Assign(targets=[Name(id='new', ctx=Store(), lineno=362, col_offset=4, end_lineno=362, end_col_offset=7)], value=Call(func=Attribute(value=Name(id='io', ctx=Load(), lineno=362, col_offset=10, end_lineno=362, end_col_offset=12), attr='do