uments):\n    \"\"\"Import existing registered q8 context; never recompute a q8 proof.\"\"\"\n    q8=documents['CURRENT']['F004_q8_latest_ledger']\n    need(equal(q8,documents['STATUS']['F004_q8_latest_ledger']), 'whole current q8 ledger agrees')\n    imported=io.doc(plan['Root_q8_summary_import'])\n    need(imported.get('root')==ROOT and imported.get('accepted') is True\n         and imported.get('schema')=='ROOT_F004_Q8_COMPLETE_LEDGER_SUMMARY_IMPORT_V1'\n         and equal(imported.get('whole_registered_ledger'),q8), 'explicit Root q8 current summary context')\n    committed=io.doc(imported['matching_old_commit'])\n    need(committed.get('root')==ROOT and committed.get('committed') is True\n         and equal(committed.get('closed'),686) and equal(committed.get('pending_count'),0)\n         and equal(committed.get('job_registration'),q8['registration'])\n         and equal(committed.get('pending'),q8['pending_file']), 'old actual686/0 q8 commit, proof scope unchanged')\n    io.read(q8['registration'])\n    for key in ('accepted_application','actual_registration_capture','matching_guard'):\n        io.read(imported[key])\n    need(equal(io.doc(q8['pending_file']),[]), 'old exact empty q8 pending bytes')\n    context=io.doc(plan['Root_postchecked_F009_context']['Root_postreview'])\n    need(context.get('root')==ROOT and context.get('status')=='SUPPORTED'\n         and equal(context.get('blockers'),[])\n         and all(equal(documents[k]['F009_checkpoint_current'],context['checkpoint']) for k in documents),\n         'whole current accepted F009 checkpoint equals its Root postcheck')"},{"AST":"FunctionDef(name='change', args=arguments(args=[arg(arg='bank', lineno=419, col_offset=11, end_lineno=419, end_col_offset=15), arg(arg='path', lineno=419, col_offset=17, end_lineno=419, end_col_offset=21), arg(arg='after', lineno=419, col_offset=23, end_lineno=419, end_col_offset=28), arg(arg='patches', lineno=419, col_offset=30, end_lineno=419, end_col_offset=37), arg(arg='a