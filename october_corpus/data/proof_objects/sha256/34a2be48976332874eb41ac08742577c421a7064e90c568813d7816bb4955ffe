ered q11 before ledger')\n    q11 = documents['CURRENT']['F004_q11_latest_ledger']\n    need(type(q11.get('closed')) is int and q11['closed'] == 75\n         and type(q11.get('pending')) is int and q11['pending'] == 197\n         and q11.get('required') == 272 and equal(q11.get('pending_file'),plan['old_pending']),\n         'actual75/197/272 registration and exact old pending')\n    for name in documents:\n        q8 = documents[name]['F004_q8_latest_ledger']\n        need(equal(q8.get('closed'),686) and equal(q8.get('required'),686)\n             and equal(q8.get('pending'),0),\n             'actual already complete q8 preserved, no old fixed q8 boundary')\n    for name in documents:\n        archived = io.read(plan['whole_before_archives'][name])\n        need(archived == raws[name], 'exact fresh whole before archive matches live observation')\n    out,blobs,refs,banks,state_raws,state_refs,output_bytes = publication(\n        io,plan,plan_ref,method,index,documents,raws,remaining)\n    if args.mode == 'forecast':\n        observed,_ = state_pair(io,plan['before'])\n        need(equal(observed,documents), 'both unchanged complete forecast states')\n        protected(io,plan)\n        io.budget()\n        print(can(dict(status='VERIFIED_F004_CLOSED40_METADATA_FORECAST_ONLY',\n              actual_registration=False,read_bytes=io.read_bytes,unique_paths=len(io.paths),\n              complete_new_byte_bound=output_bytes+65536+plan['guard_and_recorder_return_reserve']['bytes'],\n              closed_after_IF_Root_adopts=115,pending_after_IF_Root_adopts=157,\n              scientific_replays=0,whole_Original_credit=0)).decode(),end='')\n        return\n    stages = [(path,path.with_name(path.name+STAGE_SUFFIX)) for path in (CURRENT,STATUS)]\n    orphan_paths = [p.with_name(p.name+s) for p in (CURRENT,STATUS)\n                    for s in OLD_STAGE_SUFFIXES+(STAGE_SUFFIX,)]\n    for path in orphan_paths:\n        io.charge_path(path)\n    need(all(not os.path.lexists(p