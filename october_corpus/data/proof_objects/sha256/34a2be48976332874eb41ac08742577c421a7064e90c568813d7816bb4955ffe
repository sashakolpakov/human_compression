         sha256=hashlib.sha256(raw).hexdigest())\n\n\ndef valid_ref(row):\n    need(type(row) is dict and set(row) == {'path','bytes','sha256'}\n         and type(row['path']) is str and Path(row['path']).is_absolute()\n         and type(row['bytes']) is int and 0 <= row['bytes'] <= LIMITS['file_bytes']\n         and type(row['sha256']) is str and len(row['sha256']) == 64\n         and all(c in '0123456789abcdef' for c in row['sha256']),\n         'complete bounded path/bytes/sha256 descriptor')\n    return row\n\n\ndef signature(s):\n    return (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,\n            s.st_mtime_ns,s.st_ctime_ns)\n\n\nclass IO:\n    \"\"\"Count every explicit read/open and new byte; no hidden recheck bank.\"\"\"\n    def __init__(self):\n        self.start = time.monotonic()\n        self.read_bytes = 0\n        self.new_bytes = 0\n        self.paths = set()\n        self.opens = 0\n        self.writes = 0\n        self.read_versions = {}\n\n    def budget(self):\n        need(sys.platform == 'darwin'\n             and time.monotonic()-self.start <= LIMITS['internal_seconds']\n             and resource.getrusage(resource.RUSAGE_SELF).ru_maxrss <= LIMITS['rss_bytes'],\n             'Darwin metadata caller <=256MiB/115s; actual guard125s separately required')\n\n    def charge_path(self, path):\n        self.paths.add(str(path))\n        need(len(self.paths) <= LIMITS['paths'], 'single complete512-path bank')\n\n    def read(self, row, live=False):\n        valid_ref(row)\n        path = Path(row['path'])\n        need(path.resolve(strict=True) == path, 'no symlink or noncanonical input')\n        a = path.lstat()\n        need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1\n             and a.st_size == row['bytes'], 'ordinary single-link bounded whole input')\n        self.charge_path(path)\n        need(self.read_bytes + a.st_size <= LIMITS['read_bytes'], 'single64MiB actual read bank')\n        self.read_bytes += a.st_size\n        self.opens += 1\n        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n        try:\n            b = os.fstat(fd)\n            chunks = []\n            left = a.st_size\n            while left:\n                block = os.read(fd, min(left, 65536))\n                need(bool(block), 'no short whole input')\n                chunks.append(block)\n                left -= len(block)\n            need(os.read(fd, 1) == b'', 'no growing whole input')\n            c = os.fstat(fd)\n        finally:\n            os.close(fd)\n        raw = b''.join(chunks)\n        need(signature(a) == signature(b) == signature(c) == signature(path.lstat())\n             and equal(ref(path,raw),row), 'whole stable expected input bytes')\n        if not live:\n            prior = self.read_versions.setdefault(str(path), row)\n            need(equal(prior,row), 'one immutable version per path')\n        self.budget()\n        return raw\n\n    def doc(self, row, live=False):\n        return strict(self.read(row, live=live))\n\n    def write(self, path, raw):\n        need(type(raw) is bytes and len(raw) <= LIMITS['file_bytes']\n             and self.new_bytes + len(raw) <= LIMITS['new_bytes'],\n             'whole <=4MiB output in same complete16MiB new bank')\n        need(path.parent.resolve(strict=True) == path.parent\n             and not os.path.lexists(path), 'fresh ordinary-parent output')\n        self.charge_path(path)\n        self.new_bytes += len(raw)\n        self.writes += 1\n        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n        try:\n            done = 0\n            while done < len(raw):\n                n = os.write(fd, raw[done:])\n                need(n > 0, 'whole output write')\n                done += n\n            os.fsync(fd)\n        finally:\n            os.close(fd)\n        row = ref(path,raw)\n        self.read(row)\n        return row\n\n\ndef sync(path):\n    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\ndef at(value, path):\n    for key in path:\n        need(type(value) is dict and key in value, 'exact existing nested alias parent/key')\n        value = value[key]\n    return value\n\n\ndef parent(value, path):\n    return at(value,path[:-1]) if len(path)>1 else value\n\n\ndef idle(current, status):\n    for key in ('root_execution_ownership_latest','root_current_ownership',\n                'current_execution_ownership'):\n        need(type(current.get(key)) is dict\n             and equal(current[key].get('active_handles'),[]), 'actual CURRENT idle array: '+key)\n    need(equal(status.get('active_scientific_handles'),[]), 'actual STATUS idle array')\n\n\ndef capture(io, row, actor):\n    value = io.doc(row)\n    tool = value.get('actual_tool',{})\n    need(value.get('actor') == actor and type(tool.get('exit_code')) is int\n         and tool['exit_code'] == 0\n         and type(value.get('issued_command')) is str\n         and equal(shlex.split(value['issued_command']),value.get('issued_argv'))\n         and value.get('issued_tool_arguments',{}).get('cmd') == value['issued_command']\n         and value.get('terminal_observed') is True,\n         'whole genuine terminal API record, command and actor')\n    return value\n\n\ndef source_admission(io, plan, method, release_ref):\n    release = io.doc(release_ref)\n    need(release.get('schema') == 'ROOT_F004_CLOSED40_METADATA_SOURCE_RELEASE_V1'\n         and release.get('root') == ROOT and release.get('released') is True\n         and equal(release.get('method'),method) and equal(release.get('limits'),LIMITS)\n         and equal(release.get('required_checks'),CHECKS), 'own exact Root Source release')\n    peer = io.doc(release['independent_Source_review'])\n    reviewer = peer.get('reviewer')\n    need(type(reviewer) is str and reviewer not in (AUTHOR,ROOT)\n         and peer.get('schema') == 'INDEPENDENT_F004_CLOSED40_METADATA_SOURCE_REVIEW_V1'\n         and equa