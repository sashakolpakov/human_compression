def toy37(ns,budget):
    # Bounded generic ring quotients; no polynomial is assumed irreducible.
    one=(1,0,0,0,0,0);x=(0,1,0,0,0,0)
    for a in range(11):
        for b in range(1,11):
            def multiply(u,v):
                budget.scalar(96);out=[0]*11
                for i in range(6):
                    for j in range(6):out[i+j]=(out[i+j]+u[i]*v[j])%11
                for k in range(10,5,-1):
                    c=out[k];out[k-6]=(out[k-6]-b*c)%11;out[k-5]=(out[k-5]-a*c)%11
                return tuple(out[:6])
            def exponent(z,n):
                result=one
                for bit in bin(n)[2:]:
                    result=multiply(result,result)
                    if bit=='1':result=multiply(result,z)
                return result
            z=exponent(x,47880)
            rows=[multiply(tuple(int(i==j)for i in range(6)),z)for j in range(6)]
            Y=matrix([(1,0,0,0,0,0,0)]+[(0,)+row for row in rows])
            if Y!=ns['I7'] and ns['power'](Y,37,budget)==ns['I7']:return Y
    raise ValueError('bounded generic quotient fixture supplied no directly checked37')
