        # ACCESSOR/BACKEND are dict(...) literals; no project code is invoked.
        if isinstance(node.value,ast.Call):value={k.arg:ast.literal_eval(k.value)for k in node.value.keywords}
        else:value=ast.literal_eval(node.value)
