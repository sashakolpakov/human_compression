    saved=A.__file__;A.__file__='/wrong/accessor.py'
    reject('wrong_accessor_module_origin',lambda:root_reader_pin_owned_provider(contract,H,A));A.__file__=saved
    done('original_owned_admission_checks_are_not_removed',
