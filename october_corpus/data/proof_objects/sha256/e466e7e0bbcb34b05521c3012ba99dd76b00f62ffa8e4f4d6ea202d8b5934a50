def need(ok,why):
    if not ok:raise ValueError(why)

def canonical(value):
    return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')

def strict(raw):
    def pairs(items):
        result={}
        for key,value in items:
            need(key not in result,'unique metadata keys');result[key]=value
        return result
    return json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in()).throw(ValueError('finite JSON')))

def signature(s):
    return (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)

def pin(path,alias=None):
    p=Path(path);a=p.lstat()
    need(p.is_absolute()and str(p)==str(Path(os.path.normpath(p))),'literal absolute normalized path')
    if alias is None:
        need(p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)and a.st_nlink==1,'canonical single-link whole input')
    else:
        need(stat.S_ISLNK(a.st_mode)and os.readlink(p)==alias['link']
             and p.resolve(strict=True)==Path(alias['target']['path'])
             and (a.st_dev,a.st_ino,a.st_mode,a.st_mtime_ns)==
                 (alias['device'],alias['inode'],alias['mode'],alias['mtime_ns']),
             'exact retained readonly alias identity')
    need(a.st_size<=2**31,'same finite whole input bound')
    h=hashlib.sha256();size=0
    with p.open('rb')as stream:
        b=os.fstat(stream.fileno())
        while True:
            block=stream.read(MIB)
            if not block:break
            h.update(block);size+=len(block);need(size<=2**31,'streamed whole input cap')
        c=os.fstat(stream.fileno())
    need(signature(a)==signature(p.lstat())and signature(b)==signature(c),'unchanged complete input')
    if alias is None:need(signature(a)==signature(b)and size==a.st_size,'same opened whole ordinary input')
    else:need(size==alias['target']['bytes']and h.hexdigest()==alias['target']['sha256'],'whole exact alias target bytes')
    return dict(path=str(p),bytes=size,sha256=h.hexdigest())

def authenticate(ref,aliases=None):
    need(type(ref)is dict and set(ref)=={'path','bytes','sha256'},'exact descriptor fields')
    need(pin(ref['path'],(aliases or {}).get(ref['path']))==ref,'whole exact physical identity')
    return ref

def document(ref):
    authenticate(ref);need(ref['bytes']<=8*MIB,'bounded metadata only')
    raw=Path(ref['path']).read_bytes()
    need(len(raw)==ref['bytes']and hashlib.sha256(raw).hexdigest()==ref['sha256'],'entire metadata before parse')
    return strict(raw)

def merge(rows):
    by={}
    for ref in rows:
        need(by.get(ref['path'],ref)==ref,'one exact identity per current path');by[ref['path']]=ref
    result=[by[path]for path in sorted(by)]
    need(len(result)<=40000 and sum(r['bytes']for r in result)<=2**31,'unchanged complete read bounds')
    return result

def inventory(root):
    root=Path(root);need(root.resolve(strict=True)==root and root.is_dir(),'canonical closed Native output root')
    rows=[];directories=[]
    for current,names,files in os.walk(root,followlinks=False):
        current=Path(current);need(current.resolve(strict=True)==current,'no output-directory alias')
        directories.append(str(current.relative_to(root)))
        for name in names:
            p=current/name;need(p.is_dir()and not p.is_symlink(),'ordinary complete output directory')
        for name in files:rows.append(pin(current/name))
    rows.sort(key=lambda r:r['path']);directories.sort()
    need(len(rows)<=2048 and sum(r['bytes']for r in rows)<=16*MIB,'same complete finite Native output capacity')
    return rows,directories

def fsync_dir(path):
    fd=os.open(path,os.O_RDONLY)
    try:os.fsync(fd)
    finally:os.close(fd)

