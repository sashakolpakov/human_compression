def can(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()


def ref(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def whole(path, expected=None):
    path = Path(path)
    before = path.lstat()
    assert path.is_absolute() and path.resolve(strict=True) == path
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_size <= 4*MIB
    raw = path.read_bytes()
    sig = lambda st: (st.st_dev, st.st_ino, st.st_mode, st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
    assert sig(before) == sig(path.lstat()) and len(raw) == before.st_size
    pin = ref(path, raw)
    if expected is not None:
        assert pin == expected
    return pin, raw


def put(name, value):
    path = D / name
    assert path.is_relative_to(D) and not os.path.lexists(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    assert path.parent.resolve() == path.parent
    raw = value if isinstance(value, bytes) else can(value)
    assert len(raw) <= 4*MIB
    with path.open('xb') as f:
        assert f.write(raw) == len(raw)
        f.flush(); os.fsync(f.fileno())
    pin = ref(path, raw)
    CREATED.append(dict(path=str(path), before=dict(exists=False), after=pin,
                        whole_after_body_base64=base64.b64encode(raw).decode()))
    return pin


