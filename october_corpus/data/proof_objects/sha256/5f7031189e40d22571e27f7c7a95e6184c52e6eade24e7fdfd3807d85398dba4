            whole(retained['path'], retained)
            reuse_verified[retained['path']] = retained
            reused_bytes += original['bytes']
            action = 'REUSE_EXACT_EXISTING_S_BODY'
        else:
            retained = dict(original, path=str(destination / 'files' / item['relative']))
            new_bytes += original['bytes']; new_count += 1
            action = 'COPY_TO_NEW_APPEND_ONLY_PART'
        rows.append(dict(original=original, retained=retained))
        inventory_rows.append(dict(original=original, retained=retained, action=action, part=number))
    assert len(rows) <= 150 and new_bytes + reused_bytes <= 8*MIB
