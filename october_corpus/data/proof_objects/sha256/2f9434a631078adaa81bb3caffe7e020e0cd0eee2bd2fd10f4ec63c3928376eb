MIB=2**20
START=time.monotonic()

def need(ok,message):
    if not ok:raise ValueError(message)

def canonical(value):
    return(json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode()

def strict(raw):
    def pairs(values):
        out={}
        for k,v in values:need(k not in out,'unique metadata key');out[k]=v
        return out
    return json.loads(raw,object_pairs_hook=pairs,
        parse_constant=lambda _:(_ for _ in()).throw(ValueError('finite metadata')))

def signature(s):
    return(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)

def identity(raw,ref):
    need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}
         and type(ref['bytes'])is int and len(raw)==ref['bytes']
         and hashlib.sha256(raw).hexdigest()==ref['sha256'],'entire original body identity')

class Reads:
    def __init__(self):self.rows={};self.bytes=Path(__file__).stat().st_size
    def whole(self,ref):
        need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}
             and type(ref['bytes'])is int and 0<=ref['bytes']<=8*MIB,'bounded exact physical ref')
        need(self.rows.get(ref['path'],ref)==ref,'one physical version')
        need(self.bytes+ref['bytes']<=64*MIB and(len(self.rows)<512 or ref['path']in self.rows),
             'whole64MiB/512-path metadata budget before IO')
        rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin'else 1024)
        need(rss<256*MIB and time.monotonic()-START<150,'metadata256MiB/150s guard')
        p=Path(ref['path']);a=p.lstat()
        need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
             and a.st_nlink==1 and a.st_size==ref['bytes'],'ordinary immutable physical bank')
        with p.open('rb')as f:
            b=os.fstat(f.fileno());raw=f.read(ref['bytes']+1);c=os.fstat(f.fileno())
        need(signature(a)==signature(b)==signature(c)==signature(p.lstat()),'stable whole physical bytes')
        identity(raw,ref);self.bytes+=len(raw);self.rows[ref['path']]=ref;return raw
    def role(self,mapping):
        a,b=mapping['logical'],mapping['physical']
        need(a['bytes']==b['bytes']and a['sha256']==b['sha256'],'exact retained original mapping')
        return self.whole(b)
    def document(self,mapping):return strict(self.role(mapping))
    def final(self):
        for q in list(self.rows.values()):self.whole(q)

def compressed_document(raw):
    with gzip.GzipFile(fileobj=io.BytesIO(raw),mode='rb')as stream:body=stream.read(8*MIB+1)
    need(len(body)<=8*MIB,'bounded bank expansion before JSON parse')
    return strict(body)

def bodies(*banks):
    out={};total=0
    for bank in banks:
        need(type(bank['documents'])is list and len(bank['documents'])<=1024,'bounded complete body bank')
        for row in bank['documents']:
            ref=row['ref'];need(type(ref['bytes'])is int and 0<=ref['bytes']<=2*MIB,'bounded virtual body')
            raw=base64.b64decode(row['raw_base64'],validate=True);identity(raw,ref)
            key=ref['path'];prior=out.get(key)
            need(prior is None or prior==(ref,raw),'identical repeated logical body')
            if prior is None:out[key]=(ref,raw);total+=len(raw)
            need(total<=8*MIB,'one bounded complete virtual bank at a time')
    return out

def value(table,ref):
    need(ref['path']in table and table[ref['path']][0]==ref,'exact packed logical identity')
    return table[ref['path']][1]

def record6(raw,count):
    need(len(raw)==6*count,'whole <IH original record extent')
    values=list(struct.iter_unpack('<IH',raw))
    need(all(0<=o<500178 and 0<m<=1024 for o,m in values)
         and all(values[i-1][0]<values[i][0]for i in range(1,len(values))),
         'original ordered distinct owner/mass records')
    return values

def actual_mode(table,pair,mode,stage):
