    guard=strict(value(table,refs['receipt']));stdout=strict(value(table,refs['stdout']))
    value(table,refs['stderr'])
    for q in refs['other_guard_bodies']:value(table,q)
    need(cap['actor']==cap['root']=='/root'and cap['actual_tool']['exit_code']==0
         and cap['full_tool_return']['exit_code']==0 and cap['all_genuine_api_frames']
         and cap['issued_argv']==cap['child_argv']and cap['child_argv'].count('--')==1
         and cap['child_argv'][cap['child_argv'].index('--')+1:]==guard['command']
         and guard['status']=='PASS'and guard['stop']=='RETURNED'and guard['returncode']==0
         and guard['error']is None and guard['cleanup']['remaining']==guard['cleanup']['errors']==[],
         'genuine retained successful SDK/guard and known-scope closure')
    result_ref=pair[mode]['result.json'];result=strict(value(table,result_ref))
    certificate=pair[mode]['certificate.bin'];facts=pair[mode]['facts.json']
    expected=[sys.executable,'-E','-B','-S',stage['program']['path'],
        '--mode',mode,'--plan',stage['family_plan']['path'],stage['family_plan']['sha256'],
        '--root-review',stage['scientific_Root_release']['path'],stage['scientific_Root_release']['sha256'],
        '--part',str(pair['part'])]
    if mode=='check':expected+=['--supplied',pair['produce']['certificate.bin']['path'],pair['produce']['certificate.bin']['sha256']]
    expected+=['--out',str(Path(result_ref['path']).parent)]
    need(guard['command']==expected and result['schema']=='ROOT_L026_UNORDERED_PARTNER_WITNESS_RETURN_V1'
         and result['status']=='VERIFIED_WHOLE_SELECTED_ORIGINAL_PARTNER_WITNESSES'
         and result['mode']==mode and result['part']==pair['part']and result['actor']==result['root']=='/root'
         and result['program']==stage['program']and result['plan']==stage['family_plan']
         and result['Root_review']==stage['scientific_Root_release']
         and result['certificate']==certificate and result['facts']==facts
         and result['original_partner_points_checked']is True
         and result['old_Source_verdict_transferred']is False,
         'same original subject and actual checked certificate')
    need(stdout['status']==result['status']and stdout['part']==pair['part']
         and stdout['mode']==mode and stdout['result']==result_ref['path'],
         'actual stdout identifies the same complete result')
    return result

