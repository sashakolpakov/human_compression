    def whole(self,ref,fresh=False):
        need(type(ref)is dict and set(ref)=={'path','bytes','sha256'}and type(ref['bytes'])is int
             and 0<=ref['bytes']<=2**21 and type(ref['sha256'])is str
             and len(ref['sha256'])==64 and set(ref['sha256'])<=set('0123456789abcdef'),'bounded whole metadata ref')
        need(self.refs.get(ref['path'],ref)==ref,'one physical identity')
        if not fresh and ref['path']in self.raw:return self.raw[ref['path']]
        need(self.bytes+ref['bytes']<=32*2**20 and(len(self.refs)<128 or ref['path']in self.refs),'32MiB/128-path metadata read cap')
        rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin' else 1024)
        need(rss<256*2**20 and time.monotonic()-START<90,'256MiB/90s metadata envelope')
        path=Path(ref['path']);before=path.lstat()
        need(path.is_absolute()and path.resolve(strict=True)==path and stat.S_ISREG(before.st_mode)
             and before.st_nlink==1 and before.st_size==ref['bytes'],'ordinary canonical single-link metadata')
        with path.open('rb')as handle:
            opened=os.fstat(handle.fileno());raw=handle.read(ref['bytes']+1);closed=os.fstat(handle.fileno())
        sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
        need(sig(before)==sig(opened)==sig(closed)==sig(path.lstat())and reference(path,raw)==ref,'stable entire metadata body')
        self.refs[ref['path']]=ref;self.raw[ref['path']]=raw;self.bytes+=len(raw);return raw
    def document(self,ref):return decode(self.whole(ref))
    def file(self,path,sha):
        path=Path(path);ref=dict(path=str(path),bytes=path.stat().st_size,sha256=sha)
        return ref,self.whole(ref)
    def final(self):
        for ref in list(self.refs.values()):self.whole(ref,True)


def fsync_directory(path):
    fd=os.open(path,os.O_RDONLY)
    try:os.fsync(fd)
    finally:os.close(fd)


def retain(path,raw,evidence):
    path=Path(path);parent=path.parent
    ancestor=parent
    while not ancestor.exists():ancestor=ancestor.parent
    need(ancestor.resolve(strict=True)==ancestor,'canonical existing ancestry before any directory creation')
    parent.mkdir(parents=True,exist_ok=True)
    need(parent.resolve(strict=True)==parent,'canonical retained directory')
    if os.path.lexists(path):
        need(evidence.whole(reference(path,raw),True)==raw,'existing immutable copy has exact bounded bytes')
    else:
        with path.open('xb')as handle:handle.write(raw);handle.flush();os.fsync(handle.fileno())
        evidence.whole(reference(path,raw),True)
    fsync_directory(parent);fsync_directory(parent.parent)
    return reference(path,raw)


