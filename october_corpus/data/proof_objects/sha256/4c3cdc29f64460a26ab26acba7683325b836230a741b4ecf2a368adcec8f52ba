"""Two-integer-location scratch map with no retained tuple keys.

Only the four methods used by the exact compact/authenticate/inverse pipeline
are supported. This object never enters a mathematical state or serialized wire.
"""


class LocationDigestMap:
    __slots__ = ('_files', '_count')

    def __init__(self):
        self._files = {}
        self._count = 0

    @staticmethod
    def _parts(key):
        if (type(key) is not tuple or len(key) != 2
                or type(key[0]) is not int or type(key[1]) is not int):
            raise TypeError('scratch map key must be the two actual integer location indices')
        return key

    def __getitem__(self, key):
        file_id, line = self._parts(key)
        bucket = self._files.get(file_id)
        if bucket is None or line not in bucket:
            raise KeyError(key)
        return bucket[line]

    def __setitem__(self, key, value):
        file_id, line = self._parts(key)
        bucket = self._files.get(file_id)
        if bucket is None:
            bucket = {}
            self._files[file_id] = bucket
        if line not in bucket:
            self._count += 1
        bucket[line] = value

    def __contains__(self, key):
        file_id, line = self._parts(key)
        bucket = self._files.get(file_id)
        return bucket is not None and line in bucket

    def __len__(self):
        return self._count


if __name__ == '__main__':
    raise SystemExit('UNRUN private scratch-map Source; no state or scientific entrypoint.')
