def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()


def read_exact(row):
    p = Path(row['path'])
    a = p.lstat()
    assert p.resolve() == p and stat.S_ISREG(a.st_mode) and a.st_nlink == 1
    assert a.st_size == row['bytes'] <= 4194304
    raw = p.read_bytes()
    z = p.lstat()
    sig = lambda t: (t.st_dev, t.st_ino, t.st_mode, t.st_nlink, t.st_size, t.st_mtime_ns, t.st_ctime_ns)
    assert sig(a) == sig(z)
    assert len(raw) == row['bytes'] and hashlib.sha256(raw).hexdigest() == row['sha256']
    return raw


def exclusive(path, value):
    raw = canonical(value)
    assert path.is_relative_to(BASE) and path.parent.resolve() == path.parent
    assert not os.path.lexists(path) and len(raw) <= 65536
    with path.open('xb') as f:
        assert f.write(raw) == len(raw)
        f.flush()
        os.fsync(f.fileno())
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


