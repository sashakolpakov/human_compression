def need(ok, message):
    if not ok:
        raise ValueError(message)


def pairs(items):
    result = {}
    for k, v in items:
        need(k not in result, 'duplicate JSON key: ' + k)
        result[k] = v
    return result


def decode(raw):
    return json.loads(raw, object_pairs_hook=pairs)


def sig(st):
    return (st.st_dev, st.st_ino, st.st_mode, st.st_nlink, st.st_size,
            st.st_mtime_ns, st.st_ctime_ns)


def read(role, path, expected=None):
    path = Path(path)
    need(path.is_absolute() and path.resolve(strict=True) == path, 'canonical file path')
    before = path.lstat()
    need(stat.S_ISREG(before.st_mode), 'regular file required: ' + str(path))
    need(before.st_size <= 4 * 2**20, 'metadata-only per-file bound')
    raw = path.read_bytes()
    need(sig(before) == sig(path.lstat()), 'file changed during read: ' + str(path))
    ref = dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
    need(len(raw) == before.st_size, 'whole file read')
    if expected is not None:
        need(ref == expected, 'descriptor mismatch for ' + role)
    ROLES[role] = ref
    RAW[role] = raw
    return raw


def doc(role, path, expected=None):
    return decode(read(role, path, expected))


def check(label, ok, **detail):
    need(ok, label)
    CHECKS.append(dict(check=label, passed=True, **detail))


def patch_diff(a, b, path=()):
    if type(a) is dict and type(b) is dict:
        out = []
        for k in sorted(set(a) | set(b)):
            if k not in a or k not in b:
                out.append(list(path + (k,)))
            else:
                out.extend(patch_diff(a[k], b[k], path + (k,)))
        return out
    return [] if a == b and type(a) is type(b) else [list(path)]


def restore_fields(target, previous, fields):
    for name in fields:
        if name in previous:
            target[name] = copy.deepcopy(previous[name])
        else:
            target.pop(name, None)


