  self.row_images+=1;self.tick(True)
  return tuple(sum(v[k]*G[k][j]for k in range(7))%11 for j in range(7))


def expand_runs(runs,maximum):
 need(type(runs)is list,'complete position runs');out=[];last=0
 for a,b in runs:
  need(type(a)is type(b)is int and last<a<=b<=maximum,'ordered disjoint bounded runs')
  out.extend(range(a,b+1));last=b
 return out

def packed_runs(values):
 out=[]
 for x in values:
  if out and out[-1][1]+1==x:out[-1][1]=x
  else:out.append([x,x])
 return out

