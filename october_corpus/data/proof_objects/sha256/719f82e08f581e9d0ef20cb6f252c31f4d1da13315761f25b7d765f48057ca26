  rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*(1 if sys.platform=='darwin'else 1024);self.peak=max(self.peak,rss)
  need(rss<128*2**20 and time.monotonic()-START<125,'125s/128MiB hard envelope')
  if soft and(rss>=112*2**20 or time.monotonic()-START>=110 or self.products>=390000 or self.row_images>=200000):raise Stop('soft resource frontier')
 def check(self):self.tick(True)
 def read(self,r,again=False):
  self.tick();need(type(r)is dict and set(r)=={'path','bytes','sha256'}and type(r['path'])is str
   and type(r['bytes'])is int and 0<=r['bytes']<=2**21 and type(r['sha256'])is str and len(r['sha256'])==64
   and set(r['sha256'])<=set('0123456789abcdef'),'complete bounded file reference')
  need(self.refs.get(r['path'],r)==r,'one complete version per path')
  if r['path']in self.raw and not again:return self.raw[r['path']]
  need(self.bytes+r['bytes']<=8*2**20 and(r['path']in self.refs or len(self.refs)<96),'96 files/8MiB actual reads including rechecks')
  p=Path(r['path']);a=p.lstat();need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)and a.st_nlink==1 and a.st_size==r['bytes'],'ordinary exact input')
  with p.open('rb')as f:b=os.fstat(f.fileno());raw=f.read(r['bytes']+1);c=os.fstat(f.fileno())
  sig=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
  need(sig(a)==sig(b)==sig(c)==sig(p.lstat())and len(raw)==r['bytes']and hashlib.sha256(raw).hexdigest()==r['sha256'],'whole stable input pin')
  self.refs[r['path']]=r;self.raw[r['path']]=raw;self.bytes+=len(raw);return raw
 def doc(self,r):return decode(self.read(r))
 def recheck(self):
  for r in list(self.refs.values()):self.read(r,True)
