  need(type(trial)is dict and trial['criterion']=='SECTION37_FIXED_DICTIONARY'
   and trial['kernel']==plan['kernel']and trial['helpers']==plan['helpers']
   and trial['finite_misses_are_NOT_paid']is True and trial['do_not_repeat_unchanged_search']is True,
   'only exact unchanged kernel/helper trials may be skipped')
  ref=trial['Root_adoption'];need(ref in plan['selector_adoptions'],'same actually adopted trial record')
  fact=budget.doc(ref)
  need(fact['schema']=='ROOT_ACCEPTED_Q11_RANK4_SECTION_IP_OBSTRUCTIONS_V1'
   and fact['root']=='/root'and fact['adopted']is True and fact['original_job']==plan['original_job']
   and fact['independent_direct_word_power_row_minor_checks']is True
