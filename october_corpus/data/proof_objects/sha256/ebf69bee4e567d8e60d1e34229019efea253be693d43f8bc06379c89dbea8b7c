    p.add_argument('--root-review',nargs=2,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args()
    need(sys.flags.ignore_environment and sys.dont_write_bytecode and not sys.flags.optimize,'ordinary exact -E -B caller')
