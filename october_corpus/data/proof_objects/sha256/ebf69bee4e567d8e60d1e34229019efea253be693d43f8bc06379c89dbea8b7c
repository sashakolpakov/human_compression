    attempts=denial()if job['role']=='reader'else None
    own=gate['program'];need(own['path']==str(Path(__file__).resolve()),'truthful actual Root caller program');bootstrap(own,65536)
    need(gate['schema']=='ROOT_REVIEWED_F009_STANDALONE_JOB_V1'and gate['root']=='/root'
         and gate['status']=='SUPPORTED'and gate['blockers']==[]and gate['job']==jobref,
