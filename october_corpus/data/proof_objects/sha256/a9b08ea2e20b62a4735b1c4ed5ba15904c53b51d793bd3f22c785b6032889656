def pin(p,body=None):
    if body is None: body=p.read_bytes()
    return dict(path=str(p),bytes=len(body),sha256=hashlib.sha256(body).hexdigest())

def put(p,body):
    p.parent.mkdir(parents=True,exist_ok=True)
    if p.exists(): assert p.read_bytes()==body
    else:
        with p.open('xb') as f:
            assert f.write(body)==len(body);f.flush();os.fsync(f.fileno())

