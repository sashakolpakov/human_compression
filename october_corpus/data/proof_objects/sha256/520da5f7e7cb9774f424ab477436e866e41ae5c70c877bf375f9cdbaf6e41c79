def fsync_directory(path):
    fd=os.open(path,os.O_RDONLY)
    try:os.fsync(fd)
    finally:os.close(fd)

def retain(path,raw,evidence):
    path=Path(path);parent=path.parent
    ancestor=parent
    while not ancestor.exists():ancestor=ancestor.parent
    need(ancestor.resolve(strict=True)==ancestor,'canonical existing ancestry before any directory creation')
    parent.mkdir(parents=True,exist_ok=True)
    need(parent.resolve(strict=True)==parent,'canonical retained directory')
    if os.path.lexists(path):
        need(evidence.whole(reference(path,raw),True)==raw,'existing immutable copy has exact bounded bytes')
    else:
        with path.open('xb')as handle:handle.write(raw);handle.flush();os.fsync(handle.fileno())
        evidence.whole(reference(path,raw),True)
    fsync_directory(parent);fsync_directory(parent.parent)
    return reference(path,raw)

