def can(value):return(json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode()

def signature(s):return(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)

def whole(ref,destination=None):
    p=Path(ref['path']);a=p.lstat()
    need(p.is_absolute()and p.resolve(strict=True)==p and stat.S_ISREG(a.st_mode)
         and a.st_nlink==1 and a.st_size==ref['bytes']<=16*MIB,'bounded immutable ordinary artifact')
    out=None;h=hashlib.sha256();size=0
    if destination is not None:out=destination.open('xb')
    try:
        with p.open('rb')as stream:
            b=os.fstat(stream.fileno())
            for chunk in iter(lambda:stream.read(MIB),b''):
                h.update(chunk);size+=len(chunk);need(size<=ref['bytes'],'immutable whole source extent')
                if out is not None:need(out.write(chunk)==len(chunk),'whole exclusive artifact copy')
            c=os.fstat(stream.fileno())
        need(signature(a)==signature(b)==signature(c)==signature(p.lstat())
             and size==ref['bytes']and h.hexdigest()==ref['sha256'],'exact original full bytes preserved')
        if out is not None:out.flush();os.fsync(out.fileno())
    finally:
        if out is not None:out.close()
    return dict(path=str(destination or p),bytes=size,sha256=h.hexdigest())

def doc(ref):
    whole(ref);need(ref['bytes']<=2*MIB,'bounded preservation metadata')
    raw=Path(ref['path']).read_bytes()
    need(len(raw)==ref['bytes']and hashlib.sha256(raw).hexdigest()==ref['sha256'],'whole metadata before parse')
    return fmp_expand(json.loads(raw))

def fsync_dir(path):
    fd=os.open(path,os.O_RDONLY)
    try:os.fsync(fd)
    finally:os.close(fd)

