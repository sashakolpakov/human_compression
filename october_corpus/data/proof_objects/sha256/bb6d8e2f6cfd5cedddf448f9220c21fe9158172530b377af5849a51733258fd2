        and total == tag['row_count'], 'canonical field order, complete prefix use and row count')
    raw = fmp_can(logical)
    fmp_need(len(raw) <= 8*2**20 and len(raw) == tag['logical_bytes']
        and hashlib.sha256(raw).hexdigest() == tag['logical_sha256'],
        'complete canonical logical preservation identity, order and all non-row flags')
