def need(ok, why):
    if not ok:
        raise ValueError(why)


def path_value(value, roots):
    need(type(value) is str and len(value) < 4096, 'literal bounded path')
    p = Path(value)
    need(p.is_absolute() and str(p) == value and '..' not in p.parts, 'canonical absolute path')
    need(any(p != root and p.is_relative_to(root) for root in roots), 'declared local path scope')
    return p


def no_symlinks(path):
    for p in (path, *path.parents):
        if os.path.lexists(p):
            need(not p.is_symlink(), 'symlink forbidden: ' + str(p))


def pin(path):
    """Stream bytes; do not retain the input contents or a second input roster."""
    path = Path(path)
    h, size = hashlib.sha256(), 0
    with path.open('rb') as source:
        try: fcntl.fcntl(source.fileno(),48,1)
        except OSError: pass
        first = os.fstat(source.fileno())
        need(stat.S_ISREG(first.st_mode), 'regular input file')
        for chunk in iter(lambda: source.read(MIB), b''):
            h.update(chunk)
            size += len(chunk)
        last = os.fstat(source.fileno())
    now = path.stat()
    identity = lambda st: (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
    need(identity(first) == identity(last) == identity(now) and size == now.st_size, 'stable input during streaming hash')
    return dict(path=str(path), bytes=size, sha256=h.hexdigest())


def alias_identity(path):
    path = Path(path)
    need(str(path) in INHERITED_ALIASES and path.is_symlink(), 'only the two inherited read-only aliases')
    no_symlinks(path.parent)
    st = path.lstat()
    target = path.resolve(strict=True)
    need(target.is_relative_to('/opt/homebrew'), 'inherited alias stays in installed local tools')
    no_symlinks(target)
    return dict(path=str(path), link=os.readlink(path), device=st.st_dev, inode=st.st_ino,
                mode=st.st_mode, mtime_ns=st.st_mtime_ns, target=pin(target))


