_FMP_TAG = 'Root_Preservation_map_reference'
_FMP_SCHEMAS = frozenset(('F009_CONTINUATION_IMMUTABLE_PRESERVATION_PLAN_V1',
    'F009_INTERRUPTED_RETURN_IMMUTABLE_PRESERVATION_PLAN_V1',
    'ROOT_IMMUTABLE_F009_CONTINUATION_PRESERVATION_V1',
    'ROOT_IMMUTABLE_F009_COMPLETE_CASE_PRESERVATION_V1'))

def fmp_need(ok, why):
    if not ok:
        raise ValueError(why)

def fmp_can(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                       ensure_ascii=True, allow_nan=False) + '\n').encode('ascii')

def fmp_ref(value):
    fmp_need(type(value) is dict and set(value) == {'path', 'bytes', 'sha256'},
             'whole original or retained descriptor')
    path, size, sha = value['path'], value['bytes'], value['sha256']
    fmp_need(type(path) is str and 0 < len(path) <= 1024
             and type(size) is int and 0 <= size <= 2**31
             and type(sha) is str and len(sha) == 64
             and set(sha) <= set('0123456789abcdef'), 'bounded exact mapping descriptor')
    return path, size, sha

def fmp_parts(left, right):
    # The common suffix is component aligned. New artifact copies share their
    # entire original /private/tmp-relative path, including long basenames.
    aa, bb = left.split('/'), right.split('/')
    count = 0
    while count < min(len(aa), len(bb)) and aa[-count-1] == bb[-count-1]:
        count += 1
    suffix = '/'.join(aa[len(aa)-count:]) if count else ''
    return (left[:-len(suffix)] if suffix else left,
            right[:-len(suffix)] if suffix else right, suffix)

def fmp_encode(value):
    fmp_need(type(value) is dict and _FMP_TAG not in value
             and value.get('schema') in _FMP_SCHEMAS, 'explicit ordinary preservation role')
    raw = fmp_can(value)
    fmp_need(len(raw) <= 8*2**20, 'finite complete logical preservation image')
    fields, prefixes, total = [], set(), 0
    for name, kind in (('rows', 'pair'), ('reused_previous_rows', 'pair'), ('new_rows', 'relative')):
        if name not in value:
            continue
        rows = value[name]
        fmp_need(type(rows) is list, 'ordered complete mapping list')
        encoded = []
        for row in rows:
            fmp_need(type(row) is dict and set(row) ==
                     ({'original', 'retained'} if kind == 'pair' else {'original', 'relative'}),
                     'exact mapping record fields')
            left, size, sha = fmp_ref(row['original'])
            if kind == 'pair':
                right, kept_size, kept_sha = fmp_ref(row['retained'])
                fmp_need((size, sha) == (kept_size, kept_sha), 'whole retained byte and SHA identity')
            else:
                right = row['relative']
                fmp_need(type(right) is str and 0 < len(right) <= 1024,
                         'bounded complete relative destination value')
            lp, rp, suffix = fmp_parts(left, right)
            prefixes.update((lp, rp)); encoded.append([lp, rp, suffix, size, sha])
            total += 1
            fmp_need(total <= 8192, 'finite complete preservation mapping count')
        fields.append([name, kind, encoded])
    fmp_need(fields, 'at least one explicit preservation mapping field')
    table = sorted(prefixes); index = {p:i for i,p in enumerate(table)}
    for _, _, rows in fields:
        for row in rows:
            row[0], row[1] = index[row[0]], index[row[1]]
    wire = dict(value)
    for name, _, _ in fields:
        del wire[name]
    wire[_FMP_TAG] = dict(version='F009_WHOLE_PRESERVATION_PATH_PAIRS_V1',
        prefixes=table, fields=fields, row_count=total, logical_bytes=len(raw),
        logical_sha256=hashlib.sha256(raw).hexdigest())
    fmp_need(len(fmp_can(wire)) <= 2*2**20, 'unchanged physical2MiB preservation role')
    fmp_need(fmp_expand(wire) == value, 'whole exact ordered preservation inverse')
    return wire

def fmp_expand(wire):
    if type(wire) is not dict or _FMP_TAG not in wire:
        return wire
    fmp_need(wire.get('schema') in _FMP_SCHEMAS, 'explicit encoded preservation role')
    tag = wire[_FMP_TAG]
    fmp_need(type(tag) is dict and set(tag) == {'version', 'prefixes', 'fields',
        'row_count', 'logical_bytes', 'logical_sha256'}
        and tag['version'] == 'F009_WHOLE_PRESERVATION_PATH_PAIRS_V1'
        and type(tag['row_count']) is int and 0 <= tag['row_count'] <= 8192
        and type(tag['logical_bytes']) is int and 0 < tag['logical_bytes'] <= 8*2**20
        and type(tag['logical_sha256']) is str and len(tag['logical_sha256']) == 64
        and set(tag['logical_sha256']) <= set('0123456789abcdef'), 'whole preservation tag')
    prefixes, fields = tag['prefixes'], tag['fields']
    fmp_need(type(prefixes) is list and len(prefixes) <= 16384
        and all(type(p) is str and len(p) <= 1024 for p in prefixes)
        and prefixes == sorted(set(prefixes)) and type(fields) is list and 1 <= len(fields) <= 3,
        'unique canonical bounded prefix table and mapping fields')
    logical = dict(wire); del logical[_FMP_TAG]
    used, names, total, extent = set(), [], 0, 0
    order = {'rows':0, 'reused_previous_rows':1, 'new_rows':2}
    for field in fields:
        fmp_need(type(field) is list and len(field) == 3, 'whole mapping field tuple')
        name, kind, rows = field
        fmp_need(type(name) is str and name in order and name not in logical and name not in names
            and kind == ('relative' if name == 'new_rows' else 'pair') and type(rows) is list,
            'unique exact mapping field role')
        names.append(name); restored = []
        for row in rows:
            fmp_need(type(row) is list and len(row) == 5, 'complete compact mapping record')
            li, ri, suffix, size, sha = row
            fmp_need(type(li) is type(ri) is int and 0 <= li < len(prefixes)
                and 0 <= ri < len(prefixes) and type(suffix) is str and len(suffix) <= 1024,
                'typed in-range whole prefix indices and suffix')
            left, right = prefixes[li]+suffix, prefixes[ri]+suffix
            # Pre-admit expansion incrementally, including repeated paths. A
            # malicious tiny wire cannot allocate an unbounded repeated graph.
            extent += len(fmp_can([left, right])) + 192
            fmp_need(extent <= 8*2**20, 'bounded cumulative expanded mapping extent')
            original = dict(path=left, bytes=size, sha256=sha); fmp_ref(original)
            if kind == 'pair':
                retained = dict(path=right, bytes=size, sha256=sha); fmp_ref(retained)
                restored.append(dict(original=original, retained=retained))
            else:
                fmp_need(0 < len(right) <= 1024, 'whole relative path extent')
                restored.append(dict(original=original, relative=right))
            used.update((li, ri)); total += 1
            fmp_need(total <= 8192, 'complete decoded mapping count')
        logical[name] = restored
    fmp_need(names == sorted(names, key=order.__getitem__) and used == set(range(len(prefixes)))
        and total == tag['row_count'], 'canonical field order, complete prefix use and row count')
    raw = fmp_can(logical)
    fmp_need(len(raw) <= 8*2**20 and len(raw) == tag['logical_bytes']
        and hashlib.sha256(raw).hexdigest() == tag['logical_sha256'],
        'complete canonical logical preservation identity, order and all non-row flags')
    return logical


