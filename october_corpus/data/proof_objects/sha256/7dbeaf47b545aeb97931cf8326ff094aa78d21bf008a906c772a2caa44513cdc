  "whole_parent_body": "\"\"\"UNRUN original-operand SAME-END37 fixed-line certificate.\nCanonical nested-header successor by /root/journal_peer/large_end_route_audit. No project imports or old\ncontext-code loads. Root acceptance, fresh review/control/gate and whole\nfrozen Original operand/proof pins are required before case arithmetic.\n\"\"\"\nimport argparse,hashlib,json,math,os,resource,signal,stat,sys,time\nfrom pathlib import Path\nSTART=time.monotonic()\nI7=bytes(int(i==j)for i in range(7)for j in range(7))\nPRIME_THEORY_SHA='f1b6c8a69780c7b8ac88f239627a7ce6889c24203f72ddc35c86fe93e661e76b'\nEND_IP_THEORY_SHA='9f52e0d341e68ff2649b2d419635e9b6fc4d1c320a3a3469dc56af97775447bc'\nMODE='ORIGINAL_SAME_END37_UNIQUE_FIXED_LINE_ESCAPE_V1'\nGRAMMAR='SAME_END_LITERAL_012_LENGTH1_TO64_V1'\nENV4=('COVERAGE_PROCESS_START','COVERAGE_PROCESS_CONFIG','OPENSSL_CONF','OPENSSL_MODULES')\ndef need(ok,why):\n    if not ok:raise ValueError(why)\ndef canonical(value):\n    return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False,ensure_ascii=True).encode('ascii')\ndef decode(raw):\n    def pairs(items):\n        result={}\n        for key,value in items:\n            need(key not in result,'duplicate JSON key');result[key]=value\n        return result\n    def finite(text):\n        value=float(text);need(math.isfinite(value),'finite JSON number');return value\n    return json.loads(raw,object_pairs_hook=pairs,parse_float=finite,\n        parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))\ndef refcheck(ref):\n    need(type(ref)is dict and set(ref)=={'path','bytes','sha256'} and type(ref['path'])is str\n         and type(ref['bytes'])is int and 0<=ref['bytes']<=2**21\n         and type(ref['sha256'])is str and len(ref['sha256'])==64\n         and set(ref['sha256'])<=set('0123456789abcdef'),'complete bounded whole-file descriptor')\n    return ref\nclass SoftStop(Exception):pass\nclass Budget:\n    def __init__(self):\n        self.refs={};self.raw={};se