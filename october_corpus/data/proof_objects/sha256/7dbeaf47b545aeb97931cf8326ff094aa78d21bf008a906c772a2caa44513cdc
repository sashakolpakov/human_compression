bytecode and not sys.flags.optimize\n         and all(key not in os.environ for key in ENV4),'assert-enabled minimal E/S/B and ENV4')\n    signal.signal(signal.SIGALRM,lambda *_:(_ for _ in()).throw(TimeoutError('125s operand route')))\n    signal.setitimer(signal.ITIMER_REAL,max(.001,125-(time.monotonic()-START)))\n    parser=argparse.ArgumentParser(allow_abbrev=False)\n    parser.add_argument('--self-sha256',required=True);parser.add_argument('--plan',nargs=2,required=True)\n    parser.add_argument('--Root-gate',nargs=2,required=True);args=parser.parse_args();budget=Budget()\n    p=Path(__file__).resolve(strict=True);own=dict(path=str(p),bytes=p.lstat().st_size,sha256=args.self_sha256)\n    need(own['bytes']<=65536,'whole executed Source namespace<=65536');budget.read(own)\n    pref=descriptor(args.plan);need(pref['bytes']<=131072,'whole bounded plan');plan=budget.doc(pref);plan_header(plan,own,role)\n    gref=descriptor(args.Root_gate);need(gref['bytes']<=8192,'whole bounded Root gate');gate=budget.doc(gref)\n    gate_header(plan,pref,own,gate,role)\n    need(gate['Root_code_math_review']['bytes']<=32768 and gate['control_report']['bytes']<=16384,'whole review/control bounds')\n    review=budget.doc(gate['Root_code_math_review']);controls=budget.doc(gate['control_report'])\n    authority_metadata(plan,pref,own,gate,review,controls)\n    for ref in plan['inputs']:budget.read(ref)\n    # This is metadata/proof import. No original word/matrix action has run.\n    accepted=accepted_metadata(plan,budget.doc(plan['operand_acceptance']),budget.doc(plan['selector']))\n    budget.read(plan['prime_theory']);budget.read(plan['end_IP_theory'])\n    raw=budget.read(plan['operand']);parts=unpack_operand(raw)\n    expected={r['path']:r for r in plan['inputs']}\n    for ref in(own,pref,gref,gate['Root_code_math_review'],gate['control_report']):\n        need(expected.get(ref['path'],ref)==ref,'one closed whole input version');expected[ref['path']]=ref\n    need(budget.refs==expected,'exact entire actual input roster before case arithmetic');budget.expected_refs=expected\n    budget.scalar(1024)\n    return plan,pref,own,gref,accepted,parts,budget\ndef hint_header(plan):\n    return dict(schema='Q11_ORIGINAL_END37_LINE_ESCAPE_HINT_V1',proof_mode=MODE,grammar=GRAMMAR,\n        operand=plan['operand'],operand_acceptance=plan['operand_acceptance'],selector=plan['selector'],\n        original_job=[23,4],position=plan['position'],representative=plan['representative'],\n        whole_orbit_sha256=plan['whole_orbit_sha256'],mask=plan['mask'],word=plan['word'],power=plan['power'],\n        proposer_program=plan['proposer_program'])\ndef verify_hint(hint,plan,parts,budget):\n    header=hint_header(plan)\n    need(type(hint)is dict and set(hint)==set(header)|{'vector','escape_generator','minor'}\n         and canonical({key:hint[key]for key in header})==canonical(header),\n         'whole exact current Original/operand/word/mask hint header')\n    row=fixed_vector(hint['vector']);indices=end_indices(plan['mask']);label=hint['escape_generator']\n    need(type(label)is int and label in indices,'escape generator is INSIDE the SAME original end')\n    Y=word_value(parts,plan['mask'],plan['word'],plan['power'],budget)\n    need(Y!=I7 and power(Y,37,budget)==I7,'actual nonidentity exact37 same-end word')\n    need(budget.image(row,Y)==row,'all seven actual fixed-row equations')\n    escaped_minor(row,budget.image(row,parts[label]),hint['minor'],budget)\n    return dict(end_mask=plan['mask'],all_saved_fixed_equations_checked=True,same_end_escape_generator=label,\n        nonzero_minor=hint['minor'],exact37_word_checked=True,strict_RREF_or_search_calls=0)\ndef emit(plan,result,budget,hint=None):\n    need(budget.refs==budget.expected_refs,'exact whole final actual input roster');budget.recheck();result['resources']=budget.snapshot()\n    output=Path(plan['output_directory'])\n    need(output.is_absolute() and '..'not in output.parts and output.parent.resolve(strict=True)==output.parent\n         and not os.path.lexists(output),'fresh canonical output directory')\n    hraw=None if hint is None else canonical(hint)+b'\\n'\n    if hraw is not None:\n        need(len(hraw)<=16384,'whole small literal hint');result['hint']=dict(path=str(output/'hint.json'),bytes=len(hraw),sha256=hashlib.sha256(hraw).hexdigest())\n    else:result['hint']=None\n    raw=canonical(result)+b'\\n';need(len(raw)<=32768,'whole result<=32768')\n    output.mkdir()\n    for p,body in([(output/'hint.json',hraw)]if hraw is not None else[])+[(output/'result.json',raw)]:\n        with p.open('xb')as handle:need(handle.write(body)==len(body),'complete fresh output');handle.flush();os.fsync(handle.fileno())\n    print(canonical(dict(result=dict(path=str(output/'result.json'),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),status=result['status'])).decode('ascii'))\n\ndef derive_fixed_row(Y,budget):\n    # Row vY=v means transpose(Y-I)*transpose(v)=0. Seven variables only.\n    rows=[[(Y[7*i+j]-int(i==j))%11 for i in range(7)]for j in range(7)]\n    pivots=[];rank=0\n    for column in range(7):\n        budget.tick(True);pivot=next((k for k in range(rank,7)if rows[k][column]),None)\n        if pivot is None:continue\n        rows[rank],rows[pivot]=rows[pivot],rows[rank];inverse=pow(rows[rank][column],9,11)\n        budget.scalar(7,True);rows[rank]=[(x*inverse)%11 for x in rows[rank]]\n        for k in range(7):\n            if k!=rank and rows[k][column]:\n                factor=rows[k][column];budget.scalar(14,True)\n                rows[k]=[(x-factor*y)%11 for x,y in zip(rows[k],rows[rank])]\n        pivots.append(column);rank+=1\n    free=[i for i in range(7)if i not in pivots]\n    if len(free)!=1:return None\n    row=[0]*7;row[free[0]]=1\n    for k,column in enumerate(pivots):row[column]=(-rows[k][free[0]])%11\n    vector=tuple(row)\n    need(budget.image(vector,Y,True)==vector,'proposed full fixed row rechecked')\n    return vector\ndef propose_hint(plan,parts,budget):\n    Y=word_value(parts,plan['mask'],plan['word'],plan['power'],budget,True)\n    if Y==I7 or power(Y,37,budget,True)!=I7:return None,'FINITE_MISS_SUPPLIED_WORD_NOT_EXACT37'\n    row=derive_fixed_row(Y,budget)\n    if row is None:return None,'FINITE_MISS_NO_UNIQUE_FIXED_ROW_PROPOSED'\n    for label in end_indices(plan['mask']):\n        image=budget.image(row,parts[label],True)\n        for i in range(7):\n            for j in range(i+1,7):\n                budget.scalar(4,True)\n                if (row[i]*image[j]-row[j]*image[i])%11:\n                    hint=dict(hint_header(plan),vector=list(row),escape_generator=label,minor=[i,j])\n                    verify_hint(hint,plan,parts,budget)\n                    return hint,'UNTRUSTED_SAME_END37_LINE_ESCAPE_HINT'\n    return None,'FINITE_MISS_SAME_END_LINE_ESCAPE_NOT_FOUND'\ndef main():\n    plan,pref,own,gref,accepted,parts,budget=load_case('PROPOSER')\n    try:hint,status=propose_hint(plan,parts,budget)\n    except SoftStop as error:hint=None;status='UNPAID_SOFT_INTERRUPTION';stop=str(error)\n    result=dict(schema='Q11_OPERAND37_LINE_PROPOSER_RESULT_V1',status=status,program=own,plan=pref,source_gate=gref,\n        operand=plan['operand'],operand_acceptance=plan['operand_acceptance'],selector=plan['selector'],\n        original_job=[23,4],position=plan['position'],mask=plan['mask'],proof_mode=MODE,\n        prime_theory=plan['prime_theory'],end_IP_theory=plan['end_IP_theory'],independent_strict_verification_owed=True,\n        verification_authority=False,new_paid_credit=0,whole_original_credit=0,\n        qualification='Supplier hint only. No full-end/IP/NG or absence claim. Every miss/interruption remains unpaid.')\n    if status=='UNPAID_SOFT_INTERRUPTION':result['stop']=stop\n    emit(plan,result,budget,hint)\nif __name__=='__main__':main()\n"
