verdict transfers.\n\"\"\"\n\"\"\"Separate lossless preservation-map metadata edition; /root/compact_proof_author.\nOriginal mathematical callers/kernels and all parent predicates remain unchanged.\nRaw2MiB and whole original/retained byte identities are distinct from the restored logical map.\nNo previous Source verdict or actual execution is transferred.\n\"\"\"\n\"\"\"Separate complete Reader metadata transport edition; /root/prime_theory_audit.\nBorrowed parent code remains attributed below; all old editions are immutable.\nUNRUN: fresh Root review, controls and actual DATA fit are required.\n\"\"\"\n\"\"\"New lossless metadata reference edition by /root/compact_proof_author.\nRaw wire identity and full canonical logical identity are distinct.\nAll original scientific predicates/caps remain; no old verdict is transferred.\n\"\"\"\n\"\"\"New interrupted-return metadata interface, authored by /root/middle_dictionary_author.\nThe complete prior Source and attribution are preserved in source_inverse.json.\nNo represented Source, state, graph or scientific operation is activated by this edition.\n\"\"\"\n\"\"\"Bind metadata plans only after a newly closed strict Reader has really passed.\n\nThis utility reads ordinary metadata and whole immutable artifacts. It imports\nno project source, decodes no state, runs no case, and writes no live selector.\nRoot separately reviews the resulting plans, preservation and checkpoint CAS.\n\"\"\"\nimport argparse,hashlib,json,os,stat,sys\nfrom pathlib import Path\n\nMIB=2**20\n\n_F9_SOURCE_TAG = 'Root_Source_rows_reference'\n_F9_DOMAIN_TAG = 'Root_Input_rows_reference'\n_F9_CLOSURE_TAG = 'Root_Native_closure_rows_reference'\n_F9_LOGICAL_LIMIT = 8 * 2**20\n\n\ndef f9_canonical(value):\n    return (json.dumps(value, sort_keys=True, separators=(',', ':'),\n                       ensure_ascii=True, allow_nan=False) + '\\n').encode('ascii')\n\n\ndef f9_need(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\ndef f9_rows(rows, limit):\n    f9_need(type(rows) is list and len(rows) <= limit, 'bounded literal row list')\n    previous = ''; total = 0\n    for row in rows:\n        f9_need(type(row) is dict and set(row) == {'path', 'bytes', 'sha256'},\n                'exact complete row fields')\n        path, size, digest = row['path'], row['bytes'], row['sha256']\n        f9_need(type(path) is str and path.startswith('/') and path > previous\n                and '\\x00' not in path and all(x not in ('.', '..') for x in path.split('/'))\n                and type(size) is int and size >= 0 and type(digest) is str\n                and len(digest) == 64 and set(digest) <= set('0123456789abcdef'),\n                'ordered unique absolute paths and exact finite row types')\n        previous = path; total += size\n    f9_need(total <= 2**31, 'unchanged whole2GiB descriptor extent')\n    return rows\n\n\ndef f9_image(value):\n    raw = f9_canonical(value)\n    f9_need(len(raw) <= _F9_LOGICAL_LIMIT, 'existing8MiB logical metadata role')\n    return len(raw), hashlib.sha256(raw).hexdigest()\n\n\ndef f9_encode_job(job):\n    f9_need(type(job) is dict and job.get('schema') == 'ROOT_F009_STANDALONE_JOB_V1'\n            and job.get('role') in ('native', 'reader') and _F9_SOURCE_TAG not in job,\n            'one ordinary logical standalone job')\n    rows = f9_rows(job['declared_inputs'], 40000)\n    sources = f9_rows(job['source_inputs'], 1024)\n    f9_need(sum(row['bytes'] for row in sources) <= 128*2**20,\n            'unchanged128MiB functional Source extent')\n    by_path = {row['path']: i for i, row in enumerate(rows)}\n    indices = []\n    for source in sources:\n        f9_need(source['path'] in by_path and rows[by_path[source['path']]] == source,\n                'every Source role is the same exact declared row')\n        indices.append(by_path[source['path']])\n    size, digest = f9_image(job)\n    wire = dict(job); wire.pop('source_inputs')\n    wire[_F9_SOURCE_TAG] = dict(schema='F009_SOURCE_ROW_INDICES_V1', indices=indices,\n        Source_rows_sha256=hashlib.sha256(f9_canonical(sources)).hexdigest(),\n        declared_rows_sha256=hashlib.sha256(f9_canonical(rows)).hexdigest(),\n        logical_bytes=size, logical_sha256=digest)\n    f9_need(f9_expand_job(wire) == job, 'entire exact Source-reference inverse')\n    return f9_encode_declared(wire)\n\n\ndef f9_expand_job(wire):\n    wire = f9_expand_declared(wire)\n    if type(wire) is not dict or _F9_SOURCE_TAG not in wire:\n        return wire\n    f9_need(wire.get('schema') == 'ROOT_F009_STANDALONE_JOB_V1'\n            and wire.get('role') in ('native', 'reader') and 'source_inputs' not in wire,\n            'explicit Source-reference wire, never a mixed representation')\n    tag = wire[_F9_SOURCE_TAG]\n    f9_need(type(tag) is dict and set(tag) == {'schema', 'indices', 'Source_rows_sha256',\n            'declared_rows_sha256', 'logical_bytes', 'logical_sha256'}\n            and tag['schema'] == 'F009_SOURCE_ROW_INDICES_V1', 'exact reference encoding')\n    rows = f9_rows(wire['declared_inputs'], 40000); indices = tag['indices']\n    f9_need(type(indices) is list and len(indices) <= 1024,\n            'bounded Source-index list')\n    last = -1\n    for index in indices:\n        f9_need(type(index) is int and last < index < len(rows),\n                'strictly increasing nonboolean unique in-range indices')\n        last = index\n    sources = [rows[index] for index in indices]\n    f9_need(sum(row['bytes'] for row in sources) <= 128*2**20,\n            'unchanged128MiB functional Source extent')\n    f9_need(hashlib.sha256(f9_canonical(rows)).hexdigest() == tag['declared_rows_sha256']\n            and hashlib.sha256(f9_canonical(sources)).hexdigest() == tag['Source_rows_sha256'],\n            'complete exact declared and Source table identities')\n    logical = dict(wire); logical.pop(_F9_SOURCE_TAG); logical['source_inputs'] = sources\n    size, digest = f9_image(logical)\n    f9_need(type(tag['logical_bytes']) is int and tag['logical_bytes'] == size\n            and tag['logical_sha256'] == digest, 'entire canonical semantic image')\n    return logical\n\n\ndef f9_encode_table(domain, field, tag_name, version):\n    f9_need(type(domain) is dict and tag_name not in domain,\n            'ordinary complete Root domain')\n    rows = f9_rows(domain[field], 40000)\n    prefixes = sorted({row['path'][:row['path'].rfind('/')+1] for row in rows})\n    lookup = {prefix: i for i, prefix in enumerate(prefixes)}\n    packed = []\n    for row in rows:\n        cut = row['path'].rfind('/')+1; prefix = row['path'][:cut]\n        packed.append([lookup[prefix], row['path'][cut:], row['bytes'], row['sha256']])\n    size, digest = f9_image(domain)\n    wire = dict(domain); wire.pop(field)\n    wire[tag_name] = dict(schema=version,\n        prefixes=prefixes, rows=packed, logical_bytes=size, logical_sha256=digest)\n    f9_need(f9_expand_table(wire, field, tag_name, version) == domain, 'entire exact row-table inverse')\n    return wire\n\n\ndef f9_expand_table(wire, field, tag_name, version):\n    if type(wire) is not dict or tag_name not in wire:\n        return wire\n    f9_need(field not in wire, 'one explicit row-table representation')\n    tag = wire[tag_name]\n    f9_need(type(tag) is dict and set(tag) == {'schema', 'prefixes', 'rows',\n            'logical_bytes', 'logical_sha256'} and tag['schema'] == version,\n            'exact parent-path table encoding')\n    prefixes, packed = tag['prefixes'], tag['rows']\n    f9_need(type(prefixes) is list and len(prefixes) <= 40000\n            and all(type(p) is str and p.startswith('/') and p.endswith('/')\n                and '\\x00' not in p and all(x not in ('.', '..') for x in p.split('/'))\n                for p in prefixes)\n            and prefixes == sorted(set(prefixes)), 'exact unique absolute parent prefixes')\n    f9_need(type(packed) is list and len(packed) <= 40000, 'bounded complete packed 