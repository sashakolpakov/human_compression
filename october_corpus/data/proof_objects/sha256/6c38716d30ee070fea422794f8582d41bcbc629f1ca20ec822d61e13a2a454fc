f suffix else right, suffix)\n\ndef fmp_encode(value):\n    fmp_need(type(value) is dict and _FMP_TAG not in value\n             and value.get('schema') in _FMP_SCHEMAS, 'explicit ordinary preservation role')\n    raw = fmp_can(value)\n    fmp_need(len(raw) <= 8*2**20, 'finite complete logical preservation image')\n    fields, prefixes, total = [], set(), 0\n    for name, kind in (('rows', 'pair'), ('reused_previous_rows', 'pair'), ('new_rows', 'relative')):\n        if name not in value:\n            continue\n        rows = value[name]\n        fmp_need(type(rows) is list, 'ordered complete mapping list')\n        encoded = []\n        for row in rows:\n            fmp_need(type(row) is dict and set(row) ==\n                     ({'original', 'retained'} if kind == 'pair' else {'original', 'relative'}),\n                     'exact mapping record fields')\n            left, size, sha = fmp_ref(row['original'])\n            if kind == 'pair':\n                right, kept_size, kept_sha = fmp_ref(row['retained'])\n                fmp_need((size, sha) == (kept_size, kept_sha), 'whole retained byte and SHA identity')\n            else:\n                right = row['relative']\n                fmp_need(type(right) is str and 0 < len(right) <= 1024,\n                         'bounded complete relative destination value')\n            lp, rp, suffix = fmp_parts(left, right)\n            prefixes.update((lp, rp)); encoded.append([lp, rp, suffix, size, sha])\n            total += 1\n            fmp_need(total <= 8192, 'finite complete preservation mapping count')\n        fields.append([name, kind, encoded])\n    fmp_need(fields, 'at least one explicit preservation mapping field')\n    table = sorted(prefixes); index = {p:i for i,p in enumerate(table)}\n    for _, _, rows in fields:\n        for row in rows:\n            row[0], row[1] = index[row[0]], index[row[1]]\n    wire = dict(value)\n    for name, _, _ in fields:\n        del wire[name]\n    wire[_FMP_TAG] = dict(ve