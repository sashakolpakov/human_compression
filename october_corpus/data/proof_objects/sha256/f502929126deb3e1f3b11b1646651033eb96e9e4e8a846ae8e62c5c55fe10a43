"""UNRUN functional controls for a freshly owned literal-seven Source.

Root alone may execute this represented control Source. Synthetic permutation
matrices test the right-action arithmetic/predicate, not membership in G2(11).
No original case, field census, accepted model or mathematical theorem is
authenticated by these fixtures. The science caller retains all original joins.
"""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import resource
import signal
import stat
import sys
import time
import types

START = time.monotonic()
ENV4 = ('COVERAGE_PROCESS_START', 'COVERAGE_PROCESS_CONFIG', 'OPENSSL_CONF', 'OPENSSL_MODULES')


def need(ok, why):
    if not ok:
        raise ValueError(why)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('ascii')


def decode(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            need(key not in out, 'unique control JSON keys')
            out[key] = value
        return out
    def floating(text):
        value = float(text)
        need(math.isfinite(value), 'finite control float')
        return value
    return json.loads(raw, object_pairs_hook=pairs, parse_float=floating,
                      parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


def main():
    need(sys.flags.ignore_environment and sys.flags.no_site and sys.dont_write_bytecode
         and not sys.flags.optimize and all(k not in os.environ for k in ENV4),
         'fresh EBS control process and ENV4 absence')
    signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError('100s controls')))
    signal.setitimer(signal.ITIMER_REAL, max(.001, 100 - (time.monotonic() - START)))
    ap = argparse.ArgumentParser(allow_abbrev=False)
    ap.add_argument('--self-sha256', required=True)
    ap.add_argument('--target-program', nargs=2, required=True)
    ap.add_argument('--source-gate', nargs=2, required=True)
    args = ap.parse_args()
    refs = {}
    physical_read_bytes = 0

    def read(path, sha, maximum):
        nonlocal physical_read_bytes
        p = Path(path)
        a = p.lstat()
        need(p.is_absolute() and p.resolve(strict=True) == p and stat.S_ISREG(a.st_mode)
             and a.st_nlink == 1 and 0 <= a.st_size <= maximum,
             'bounded canonical single-link control input')
        with p.open('rb') as f:
            b = os.fstat(f.fileno())
            raw = f.read(maximum + 1)
            c = os.fstat(f.fileno())
        sig = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns, x.st_ctime_ns)
        need(sig(a) == sig(b) == sig(c) == sig(p.lstat()) and len(raw) == a.st_size
             and hashlib.sha256(raw).hexdigest() == sha, 'complete stable control input')
        ref = dict(path=str(p), bytes=len(raw), sha256=sha)
        need(refs.get(str(p), ref) == ref, 'one immutable control input version')
        refs[str(p)] = ref
        physical_read_bytes += len(raw)
        need(physical_read_bytes <= 8 * 2**20 and len(refs) <= 96, 'old control read/path caps')
        return ref, raw

    own, own_raw = read(str(Path(__file__).resolve()), args.self_sha256, 65536)
    target, target_raw = read(args.target_program[0], args.target_program[1], 65536)
    gate_ref, gate_raw = read(args.source_gate[0], args.source_gate[1], 8192)
    gate = decode(gate_raw)
    need(gate.get('schema') == 'ROOT_AUTHORIZED_Q11_LITERAL_MIDDLE7_FUNCTIONAL_CONTROLS_V1'
         and gate.get('root') == '/root' and gate.get('adopted') is True
         and gate.get('program') == own and gate.get('target_program') == target
         and gate.get('functional_controls_authorized') is True
         and gate.get('actual_original_case_calls_authorized') is False,
         'separate fresh Root control authority, no old PASS transfer')
    # This load/compile is an actual represented Source activation when Root runs
    # the controls. It has never been performed by the private Source author.
    subject = types.ModuleType('q11_literal7_functional_subject')
    subject.__file__ = target['path']
    exec(compile(target_raw, target['path'], 'exec'), subject.__dict__)
    need(subject.RECORD_SCHEMA['criterion'] == 'DIRECT_LITERAL_MIDDLE_EXACT_ORDER7'
         and subject.RECORD_SCHEMA['prime'] == 7 and subject.RECORD_SCHEMA['cofactor'] == 1,
         'fresh literal-seven ABI')
    checks = []

    def passed(name, condition):
        need(condition, name)
        checks.append(name)

    def refused(name, callback):
        try:
            callback()
        except (ValueError, TypeError, KeyError):
            checks.append(name)
            return
        raise ValueError('expected genuine refusal: ' + name)

    def permutation(values):
        return tuple(tuple(int(values[i] == j) for j in range(7)) for i in range(7))

    budget = subject.Budget()
    # Right row action: i -> -i -> 1+i, so B*C is the displayed seven-cycle.
    B = permutation([0, 6, 5, 4, 3, 2, 1])
    C = permutation([1, 0, 6, 5, 4, 3, 2])
    expected = permutation([1, 2, 3, 4, 5, 6, 0])
    passed('two synthetic nonidentity involutions', B != subject.I7 and C != subject.I7
           and budget.multiply(B, B) == budget.multiply(C, C) == subject.I7)
    Y = budget.multiply(B, C)
    passed('exact right-action middle product', Y == expected)
    Y7, positive = subject.literal_middle7(Y, budget)
    passed('literal-seven known positive and complete seventh power', positive is True and Y7 == subject.I7)
    inverse = subject.power(Y, 6, budget)
    inverse7, inverse_positive = subject.literal_middle7(inverse, budget)
    passed('inverse seven-cycle positive', inverse_positive is True and inverse7 == subject.I7
           and budget.multiply(Y, inverse) == budget.multiply(inverse, Y) == subject.I7)
    I7power, identity_positive = subject.literal_middle7(subject.I7, budget)
    passed('identity is a miss despite seventh power identity', identity_positive is False and I7power == subject.I7)
    T = permutation([1, 0, 2, 3, 4, 5, 6])
    T7, order2_positive = subject.literal_middle7(T, budget)
    passed('order-two negative', order2_positive is False and T7 == T and T != subject.I7)
    U = permutation([1, 2, 0, 3, 4, 5, 6])
    U7, order3_positive = subject.literal_middle7(U, budget)
    passed('order-three negative', order3_positive is False and U7 == U and U != subject.I7)
    passed('complete zero exponent identity', subject.power(Y, 0, budget) == subject.I7)
    passed('canonical full matrix roundtrip', subject.matrix([list(r) for r in Y], 7) == Y)
    refused('Boolean matrix coefficient refused', lambda: subject.matrix([[True] * 7 for _ in range(7)], 7))
    refused('truncated matrix refused', lambda: subject.matrix([[0] * 7 for _ in range(6)], 7))
    refused('duplicate JSON keys refused', lambda: subject.decode(b'{"position":1,"position":2}'))
    refused('nonfinite JSON constant refused', lambda: subject.decode(b'{"x":NaN}'))
    refused('negative exponent refused', lambda: subject.power(Y, -1, budget))
    old_products = budget.products
    budget.products = 400000
    refused('unchanged hard product cap refused', lambda: budget.multiply(subject.I7, subject.I7))
    budget.products = old_products
    # Pure carrier bound: each complete7x7 matrix uses at most162 ASCII bytes.
    # This is a structural worst-case shape, not a G2 matrix or a case fixture.
    maximum_matrix = [[10] * 7 for _ in range(7)]
    maximum_positive = [3779, 14763, True, maximum_matrix, maximum_matrix]
    passed('worst complete positive carrier fits reserved600 bytes', len(subject.can(maximum_positive)) == 343)
    passed('positive record strict JSON roundtrip', subject.decode(subject.can(maximum_positive)) == maximum_positive)
    passed('miss carrier remains typed false', subject.decode(subject.can([3779, 14763, False])) == [3779, 14763, False])
    passed('two complete matrix fields in new positive ABI', len(subject.RECORD_SCHEMA['positive']) == 5)
    # Recheck exactly the three original byte inputs. Nothing from a case plan,
    # domain, state, original frame or scientific output is loaded here.
    for ref in list(refs.values()):
        read(ref['path'], ref['sha256'], 65536 if ref != gate_ref else 8192)
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == 'darwin' else 1024)
    need(rss < 128 * 2**20 and time.monotonic() - START < 100, 'unchanged control RSS/time envelope')
    result = dict(schema='Q11_LITERAL_MIDDLE7_FUNCTIONAL_CONTROLS_RESULT_V1',
                  status='PASS_LITERAL_MIDDLE7_FUNCTIONAL_CONTROLS', program=own, target_program=target,
                  source_gate=gate_ref, checks=checks, test_count=len(checks),
                  synthetic_functional_arithmetic_only=True, natural_G2_model_membership_claimed=False,
                  actual_original_case_calls=0, new_paid_credit=0, whole_original_credit=0,
                  group_or_state_sources_loaded=False,
                  resources=dict(physical_read_bytes=physical_read_bytes, unique_files=len(refs),
                                 peak_self_rss_bytes=rss, seconds=time.monotonic() - START,
                                 functional_matrix_products=budget.products))
    raw = canonical(result) + b'\n'
    need(len(raw) <= 131072, 'bounded complete control result')
    sys.stdout.buffer.write(raw)


if __name__ == '__main__':
    main()
