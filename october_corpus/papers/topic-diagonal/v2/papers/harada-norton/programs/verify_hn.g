Read("programs/local_geometry.g");;
Read("HN_standard_1.g");;Read("HN_standard_2.g");;
Read("witnesses/HN_compact.g");;
c:=HNStandard1;;d:=HNStandard2;;
z:=c*d^3*(c*d)^4;;t0:=z^30;;
Need([Order(c),Order(d),Order(c*d),Order(z),Order(t0*d),Order(t0*d^2*(t0*d)^3)]=[2,5,42,60,22,22],"all six Atlas standard checks");;
a0:=(c*d)^-3*(c*d*c*d*c*d*c*d*d*c*d*c*d*d*c*d*d)^10*(c*d)^3;;
b0:=(c*d^2)^8*(c*d*c*d^2)^5*(c*d^2)^10;;
Need([Order(a0),Order(b0),Order(a0*b0),Order(a0*b0*a0*b0^2)]=[2,3,22,5],"inner standard adapter");;
t:=c;;a:=a0^WordValue([c,d],HNaConjugatorWord);;zs:=[];;orders:=[];;
for w in HNBraySeedWords do
 h:=WordValue([c,d],w);x:=t*t^h;k:=Order(x);
 Need(k mod 2=1,"odd Bray order");z:=h*x^((k-1)/2);
 Need(Comm(t,z)=(),"each Bray word centralizes");Add(zs,z);Add(orders,k);
od;
Need(Length(zs)=8,"eight explicit words");;
b:=Product(zs{HNbFactors})^HNbPower;;r:=[t,a,b];;
Need([Order(t*a),Order(t*b),Order(a*b)]=[12,2,5],"string product orders");;
Need(Order(WordValue(r,HNPrimeWitness11[1])^HNPrimeWitness11[2])=11,"order eleven witness");;
Need(Order(WordValue(r,HNPrimeWitness19[1])^HNPrimeWitness19[2])=19,"order nineteen witness");;
# Classification is retained; these exact rows are independently inspectable.
Need(LoadPackage("ctbllib")<>fail,"CTblLib");;
ct:=CharacterTable("HN.2");;
names:=Maxes(ct);;mos:=List(names,n->Size(CharacterTable(n)));;
Need(names=["HN","A12.2","4.HS.2","U3(8).6","2^(1+8)_+.(A5xA5).2^2","5:4xU3(5):2","5^(1+4)_+:(4Y2^(1+4)_-.5.4)","2^6.U4(2).2","(S6xS6).2^2","2^3.2^2.2^6.(S3xL3(2))","5^2.5.5^2.4S5","3^4:2(S4xS4).2","HN.2M13"],"complete retained maximal names");;
Need(mos=[273030912000000,479001600,354816000,33094656,7372800,5040000,4000000,3317760,2073600,2064384,1500000,186624,116640],"complete retained maximal orders");;
Need(Size(ct)=546061824000000 and Filtered([1..13],i->mos[i] mod 209=0)=[1],"exact maximal exclusion");;
for i in [1..13] do Print("MAXIMAL ",names[i]," ORDER ",mos[i],"\n");od;
Print("GENERATION_BY_RETAINED_MAXIMAL_CLASSIFICATION PASS\n");;
nc:=ProperIP(r);;fc:=FlagStreaming(r);;
Print("STRING proper_IP=",nc," product_tests=",fc," type=[12,2,5]\n");;
s:=[t,a,a^b];;
Need(b=(s[2]*s[3])^2*s[2],"literal halving inverse");;
Need([Order(s[1]*s[2]),Order(s[1]*s[3]),Order(s[2]*s[3])]=[12,12,5],"triangle orders");;
nc2:=ProperIP(s);;fc2:=FlagStreaming(s);;
Print("TRIANGLE proper_IP=",nc2," product_tests=",fc2," type=[12,12,5]\n");;
Print("BRAY ORDERS ",orders,"\n");;
Print("HN_COMPLETE_EXACT_WITNESS PASS 98properIP 6flag_equalities retained_named_group_and_maximal_classification\n");;
QUIT;
