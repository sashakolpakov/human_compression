import Mathlib.Algebra.Group.Subgroup.Ker
import Mathlib.GroupTheory.Perm.Basic

/-!
Two elementary steps used in the written tree and parity arguments.
The graph path identities and the equality between generated permutation groups
and the displayed constraints are written obligations, not hypotheses proved here.
The character statements use the actual subgroup generated by a set of elements.
-/
namespace HumanCompression.ParallelIntersections

variable {α G M : Type*} [Group G] [Monoid M]

def preserves (P : α → α → Prop) (σ : Equiv.Perm α) : Prop :=
  ∀ x, P (σ x) x

def pairedConstraints (P Q : α → α → Prop) (R : Set α) :
    Set (Equiv.Perm α × Equiv.Perm α) :=
  {g | preserves P g.1 ∧ preserves Q g.2 ∧ ∀ x, x ∉ R → g.1 x = g.2 x}

theorem preserves_conjunction (P P' : α → α → Prop) (σ : Equiv.Perm α) :
    preserves (fun x y => P x y ∧ P' x y) σ ↔
      preserves P σ ∧ preserves P' σ := by
  constructor
  · intro h
    exact ⟨fun x => (h x).1, fun x => (h x).2⟩
  · rintro ⟨h, h'⟩ x
    exact ⟨h x, h' x⟩

theorem paired_constraints_intersection
    (P P' Q Q' : α → α → Prop) (R R' : Set α) :
    pairedConstraints P Q R ∩ pairedConstraints P' Q' R' =
      pairedConstraints (fun x y => P x y ∧ P' x y)
        (fun x y => Q x y ∧ Q' x y) (R ∩ R') := by
  classical
  ext g
  constructor
  · rintro ⟨⟨hP, hQ, hR⟩, ⟨hP', hQ', hR'⟩⟩
    refine ⟨fun x => ⟨hP x, hP' x⟩, fun x => ⟨hQ x, hQ' x⟩, ?_⟩
    intro x hx
    by_cases h : x ∈ R
    · exact hR' x (fun h' => hx ⟨h, h'⟩)
    · exact hR x h
  · rintro ⟨hP, hQ, hR⟩
    exact ⟨⟨fun x => (hP x).1, fun x => (hQ x).1,
      fun x hx => hR x (fun h => hx h.1)⟩,
      ⟨fun x => (hP x).2, fun x => (hQ x).2,
      fun x hx => hR x (fun h => hx h.2)⟩⟩

theorem character_matches_on_generated (χ ψ : G →* M) (S : Set G)
    (hS : ∀ s ∈ S, χ s = ψ s) {g : G} (hg : g ∈ Subgroup.closure S) :
    χ g = ψ g := by
  exact MonoidHom.eqOn_closure hS hg

theorem character_separates_generated (χ ψ : G →* M) (S : Set G)
    (hS : ∀ s ∈ S, χ s = ψ s) (t : G) (ht : χ t ≠ ψ t) :
    t ∉ Subgroup.closure S := by
  intro h
  exact ht (character_matches_on_generated χ ψ S hS h)

end HumanCompression.ParallelIntersections
#print axioms HumanCompression.ParallelIntersections.preserves_conjunction
#print axioms HumanCompression.ParallelIntersections.paired_constraints_intersection
#print axioms HumanCompression.ParallelIntersections.character_matches_on_generated
#print axioms HumanCompression.ParallelIntersections.character_separates_generated
