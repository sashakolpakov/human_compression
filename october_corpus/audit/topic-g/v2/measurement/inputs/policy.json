  "units": [
    "whitespace_tokens",
    "alphanumeric_units",
    "characters_without_whitespace",
    "characters_with_collapsed_whitespace",
    "utf8_bytes_with_collapsed_whitespace"
  ],
  "unit_definitions": {
    "whitespace_tokens": "len(\" \".join(text.split()).split())",
    "alphanumeric_units": "len(re.findall(r'[^\\W_]+', text))",
    "characters_without_whitespace": "sum(not c.isspace() for c in text)",
    "characters_with_collapsed_whitespace": "len(\" \".join(text.split()))",
    "utf8_bytes_with_collapsed_whitespace": "len(\" \".join(text.split()).encode(\"utf-8\"))"
  },
  "complete_page_policy": "All physical PDF pages, including the L009 publisher identification cover, title, abstract, body, acknowledgements, references and unique first-page identification. The cover is also counted separately as a transparent sensitivity.",
  "furniture_policy": "Only exact repeated running headers and page numbers; occurrence-bound offsets and original bytes. No paragraph, display, bibliography, diagram label or unique title-page identification is furniture.",
  "calibration_policy": "Occurrence/font/encoded-glyph evidence from these exact PDFs; visible one-character aliases only, preserve actual and generated whitespace unless a particular encoded visible glyph is independently identified. No inherited font mapping assumed. Raw sensitivities retained.",
  "comparison_policy": {
    "written": "sum of both whole source PDFs / (whole U_G + whole G1 + whole G2), first comparison",
    "including_program": "sum of both whole source PDFs / (whole U_G + whole G1 + whole G2 + whole CODE), separate comparison",
