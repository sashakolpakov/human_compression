SizeScreen([1000000,1000000]);;
W:=Group(List([[1, 2, 3, 8, 16, 17, 18, 4, 9, 10, 11, 19, 20, 21, 34, 5, 6, 7, 12, 13, 14, 22, 23, 24, 25, 26, 27, 35, 36, 37, 42, 43, 44, 15, 28, 29, 30, 38, 39, 40, 45, 31, 32, 33, 41, 46, 47, 48], [1, 2, 5, 4, 3, 6, 7, 9, 8, 12, 13, 10, 11, 15, 14, 16, 22, 23, 19, 20, 28, 17, 18, 24, 25, 31, 32, 21, 29, 30, 26, 27, 33, 35, 34, 38, 39, 36, 37, 41, 40, 42, 43, 46, 45, 44, 47, 48], [1, 3, 2, 4, 6, 5, 7, 8, 10, 9, 11, 12, 14, 13, 15, 17, 16, 18, 19, 21, 20, 24, 26, 22, 27, 23, 25, 29, 28, 30, 31, 33, 32, 34, 36, 35, 37, 38, 40, 39, 41, 42, 44, 43, 45, 47, 46, 48], [2, 1, 3, 4, 5, 7, 6, 8, 9, 11, 10, 13, 12, 14, 15, 16, 18, 17, 20, 19, 21, 23, 22, 25, 24, 27, 26, 28, 30, 29, 32, 31, 33, 34, 35, 37, 36, 39, 38, 40, 41, 43, 42, 44, 45, 46, 48, 47]],PermList));;
