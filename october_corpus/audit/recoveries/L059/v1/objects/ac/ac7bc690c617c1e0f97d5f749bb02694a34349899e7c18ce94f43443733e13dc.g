G:=Graph(Group(()),[1..220],OnPoints,function(a,b) return Set([a,b]) in L059Edges; end,true);;
Need(IsConnectedGraph(G));;
F:=AutGroupGraph(G);;
arcs:=Concatenation(List(L059Edges,e->[e,Reversed(e)]));;
reps:=List(L059DescentArcs(F,arcs),Representative);;
S:=rec(label:="CAT_220_2",n_original:=220,edges_original:=L059Edges,A_subdivision:=F,witnesses:=L059SubdivisionRows(F,L059Edges,reps),search:=L059Search);;
PrintTo("nonbipartite_subdivisions/CAT_220_2.g","L059Subdivision := ",S,";\n");
Print("L059_NONBIPARTITE_COMPLETE CAT_220_2 ",Length(S.witnesses),"\n");
QUIT;
