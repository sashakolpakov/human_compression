Read("subdivision_markings.g");;
Read("maximal_descent_arcs.g");;
L059Edges:=Set([[1, 2], [1, 61], [1, 84], [2, 3], [2, 67], [3, 4], [3, 35], [4, 5], [4, 76], [5, 6], [5, 17], [6, 7], [6, 37], [7, 8], [7, 51], [8, 9], [8, 45], [9, 10], [9, 78], [10, 11], [10, 64], [11, 12], [11, 52], [12, 13], [12, 28], [13, 14], [13, 62], [14, 15], [14, 20], [15, 16], [15, 84], [16, 17], [16, 50], [17, 18], [18, 19], [18, 74], [19, 20], [19, 40], [20, 21], [21, 22], [21, 29], [22, 23], [22, 81], [23, 24], [23, 39], [24, 25], [24, 69], [25, 26], [25, 36], [26, 27], [26, 53], [27, 28], [27, 33], [28, 29], [29, 30], [30, 31], [30, 79], [31, 32], [31, 75], [32, 33], [32, 57], [33, 34], [34, 35], [34, 60], [35, 36], [36, 37], [37, 38], [38, 39], [38, 44], [39, 40], [40, 41], [41, 42], [41, 72], [42, 43], [42, 63], [43, 44], [43, 59], [44, 45], [45, 46], [46, 47], [46, 80], [47, 48], [47, 58], [48, 49], [48, 83], [49, 50], [49, 55], [50, 51], [51, 52], [52, 53], [53, 54], [54, 55], [54, 70], [55, 56], [56, 57], [56, 73], [57, 58], [58, 59], [59, 60], [60, 61], [61, 62], [62, 63], [63, 64], [64, 65], [65, 66], [65, 71], [66, 67], [66, 77], [67, 68], [68, 69], [68, 82], [69, 70], [70, 71], [71, 72], [72, 73], [73, 74], [74, 75], [75, 76], [76, 77], [77, 78], [78, 79], [79, 80], [80, 81], [81, 82], [82, 83], [83, 84]]);;
G:=Graph(Group(()),[1..84],OnPoints,function(a,b) return Set([a,b]) in L059Edges; end,true);;
Need(IsConnectedGraph(G));;
F:=AutGroupGraph(G);;
arcs:=Concatenation(List(L059Edges,e->[e,Reversed(e)]));;
reps:=List(L059DescentArcs(F,arcs),Representative);;
S:=rec(label:="CAT_84_1",n_original:=84,edges_original:=L059Edges,A_subdivision:=F,witnesses:=L059SubdivisionRows(F,L059Edges,reps),search:=L059Search);;
PrintTo("nonbipartite_subdivisions/CAT_84_1.g","L059Subdivision := ",S,";\n");
Print("L059_NONBIPARTITE_COMPLETE CAT_84_1 ",Length(S.witnesses),"\n");
QUIT;
