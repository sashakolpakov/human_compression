Read("subdivision_markings.g");;
Read("maximal_descent_arcs.g");;
L059Edges:=Set([[1, 2], [1, 47], [1, 108], [2, 3], [2, 36], [3, 4], [3, 17], [4, 5], [4, 42], [5, 6], [5, 99], [6, 7], [6, 76], [7, 8], [7, 93], [8, 9], [8, 46], [9, 10], [9, 31], [10, 11], [10, 80], [11, 12], [11, 73], [12, 13], [12, 86], [13, 14], [13, 59], [14, 15], [14, 48], [15, 16], [15, 29], [16, 17], [16, 54], [17, 18], [18, 19], [18, 88], [19, 20], [19, 105], [20, 21], [20, 58], [21, 22], [21, 43], [22, 23], [22, 92], [23, 24], [23, 85], [24, 25], [24, 98], [25, 26], [25, 71], [26, 27], [26, 60], [27, 28], [27, 41], [28, 29], [28, 66], [29, 30], [30, 31], [30, 100], [31, 32], [32, 33], [32, 70], [33, 34], [33, 55], [34, 35], [34, 104], [35, 36], [35, 97], [36, 37], [37, 38], [37, 83], [38, 39], [38, 72], [39, 40], [39, 53], [40, 41], [40, 78], [41, 42], [42, 43], [43, 44], [44, 45], [44, 82], [45, 46], [45, 67], [46, 47], [47, 48], [48, 49], [49, 50], [49, 95], [50, 51], [50, 84], [51, 52], [51, 65], [52, 53], [52, 90], [53, 54], [54, 55], [55, 56], [56, 57], [56, 94], [57, 58], [57, 79], [58, 59], [59, 60], [60, 61], [61, 62], [61, 107], [62, 63], [62, 96], [63, 64], [63, 77], [64, 65], [64, 102], [65, 66], [66, 67], [67, 68], [68, 69], [68, 106], [69, 70], [69, 91], [70, 71], [71, 72], [72, 73], [73, 74], [74, 75], [74, 108], [75, 76], [75, 89], [76, 77], [77, 78], [78, 79], [79, 80], [80, 81], [81, 82], [81, 103], [82, 83], [83, 84], [84, 85], [85, 86], [86, 87], [87, 88], [87, 101], [88, 89], [89, 90], [90, 91], [91, 92], [92, 93], [93, 94], [94, 95], [95, 96], [96, 97], [97, 98], [98, 99], [99, 100], [100, 101], [101, 102], [102, 103], [103, 104], [104, 105], [105, 106], [106, 107], [107, 108]]);;
G:=Graph(Group(()),[1..108],OnPoints,function(a,b) return Set([a,b]) in L059Edges; end,true);;
Need(IsConnectedGraph(G));;
F:=AutGroupGraph(G);;
arcs:=Concatenation(List(L059Edges,e->[e,Reversed(e)]));;
reps:=List(L059DescentArcs(F,arcs),Representative);;
S:=rec(label:="CAT_108_1",n_original:=108,edges_original:=L059Edges,A_subdivision:=F,witnesses:=L059SubdivisionRows(F,L059Edges,reps),search:=L059Search);;
PrintTo("nonbipartite_subdivisions/CAT_108_1.g","L059Subdivision := ",S,";\n");
Print("L059_NONBIPARTITE_COMPLETE CAT_108_1 ",Length(S.witnesses),"\n");
QUIT;
