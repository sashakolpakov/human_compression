r:=FullMarks.T1_12;;b:=[r[3],r[2]^r[1],r[2],r[4]];;K:=Group(b);;iso:=GroupHomomorphismByImages(Groups.T2_11,K,FullMarks.T2_11,b);;Need(iso<>fail and IsBijective(iso),"full halving");;Need(Index(Groups.T1_12,K)=2 and not r[1] in K and Order(r[1])=2,"split doubling");;Print("SPLIT_FULL_HALVING T1_12 T2_11 ",Size(K)," COMPLEMENT ",r[1],"\n");;
G:=Groups.T2_6;;N:=Last(DerivedSeriesOfGroup(G));;Need(Size(N)=336,"perfect normal order");;iso:=IsomorphismGroups(N,SL(2,7));;Need(iso<>fail and IsBijective(iso),"normal SL2");;
P2:=SylowSubgroup(G,2);;Vs:=Filtered(List(ConjugacyClassesSubgroups(P2),Representative),V->Size(V)=4 and IsElementaryAbelian(V) and Size(Intersection(V,N))=1);;
C:=fail;;for V in Vs do
 NN:=Normalizer(G,V);;els:=Filtered(Elements(NN),g->Order(g)=3 and not g in N);;
 for c in els do CC:=Group(Concatenation(GeneratorsOfGroup(V),[c]));;if Size(CC)=12 and Size(Intersection(CC,N))=1 then C:=CC;break;fi;od;
 if C<>fail then break;fi;
od;
Need(C<>fail and Size(ClosureGroup(N,C))=Size(G),"A4 complement");;iso:=IsomorphismGroups(C,AlternatingGroup(4));;Need(iso<>fail and IsBijective(iso),"complement A4");;
Print("SL2_7_SPLIT_A4 ",GeneratorsOfGroup(N)," COMPLEMENT ",GeneratorsOfGroup(C),"\n");;
# Independent named CHEVIE G29 root model, all arithmetic in Q(i).
ii:=E(4);;roots:=[[0,0,0,-2],[-ii,ii,1,1],[1-ii,-1+ii,0,0],[0,1-ii,-1+ii,0]]/2;;
Need(RankMat(roots)=4,"root span");;mats:=[];;
for v in roots do norm:=v*ComplexConjugate(v);;M:=IdentityMat(4);;for i in [1..4]do for j in [1..4]do M[i][j]:=M[i][j]-2*ComplexConjugate(v[i])*v[j]/norm;od;od;Add(mats,M);od;
MG:=Group(mats);;O:=Union(List(roots,v->Orbit(MG,v)));;Need(ForAll(mats,M->ForAll(O,v->v*M in O)),"root orbit closed");;
perms:=List(mats,M->PermList(List(O,v->Position(O,v*M))));;PG:=Group(perms);;Need(Size(PG)=7680,"G29 root-model size");;
iso:=IsomorphismGroups(Groups.T2_3,PG);;Need(iso<>fail and IsBijective(iso),"G29 exact isomorphism");;
Print("CHEVIE_G29 ",Length(O)," ",Size(PG)," SOURCE_IMAGES ",List(FullMarks.T2_3,g->Image(iso,g)),"\n");;
Print("PASS_RELATIONSHIPS\n");;QUIT;
