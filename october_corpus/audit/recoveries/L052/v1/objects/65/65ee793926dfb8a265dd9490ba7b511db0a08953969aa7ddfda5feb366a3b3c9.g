a:=Rotations.T1_1;;b:=[a[2]^-1*a[1]^-1,a[2]^-1*a[1],a[2]^-1*a[3]];;K:=Group(b);;P:=Group(Rotations.T2_1);;iso:=GroupHomomorphismByImages(P,K,Rotations.T2_1,b);;Need(iso<>fail and IsBijective(iso),"T1_1 marked halving");;Need(2*Size(K)=Size(Group(a)),"rotation half index");;Print("ROTATION_HALVING T1_1 T2_1 ",Size(K),"\n");;
r:=FullMarks.T1_1;;b:=[r[3],r[2]^r[1],r[2],r[4]];;K:=Group(b);;iso:=GroupHomomorphismByImages(Groups.T2_1,K,FullMarks.T2_1,b);;Need(iso<>fail and IsBijective(iso),"full halving");;Need(Index(Groups.T1_1,K)=2 and not r[1] in K and Order(r[1])=2,"split doubling");;Print("SPLIT_FULL_HALVING T1_1 T2_1 ",Size(K)," COMPLEMENT ",r[1],"\n");;
