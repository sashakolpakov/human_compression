SizeScreen([100000,100000]);;
tt:=List([[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 8, 9, 11, 10], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]],PermList);;
for rev in [false,true] do if rev then t:=Reversed(tt);else t:=tt;fi; c:=Centralizer(SymmetricGroup(11),Group(t{[2..6]})); if Size(c)<>1 then Error("nontrivial A11 tail centralizer");fi; Print("A11|0|",rev,"|",Size(c),"\n");od;
tt:=List([[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 8, 9, 11, 10], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [3, 5, 1, 4, 2, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]],PermList);;
for rev in [false,true] do if rev then t:=Reversed(tt);else t:=tt;fi; c:=Centralizer(SymmetricGroup(11),Group(t{[2..6]})); if Size(c)<>1 then Error("nontrivial A11 tail centralizer");fi; Print("A11|1|",rev,"|",Size(c),"\n");od;
tt:=List([[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10, 11], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]],PermList);;
for rev in [false,true] do if rev then t:=Reversed(tt);else t:=tt;fi; c:=Centralizer(SymmetricGroup(11),Group(t{[2..6]})); if Size(c)<>1 then Error("nontrivial A11 tail centralizer");fi; Print("A11|2|",rev,"|",Size(c),"\n");od;
tt:=List([[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10, 11], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [3, 5, 1, 4, 2, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]],PermList);;
for rev in [false,true] do if rev then t:=Reversed(tt);else t:=tt;fi; c:=Centralizer(SymmetricGroup(11),Group(t{[2..6]})); if Size(c)<>1 then Error("nontrivial A11 tail centralizer");fi; Print("A11|3|",rev,"|",Size(c),"\n");od;
t:=List([[1, 2, 3, 4, 5, 6, 8, 7], [1, 2, 3, 4, 5, 7, 6, 8], [1, 2, 3, 4, 6, 5, 7, 8], [1, 2, 3, 5, 4, 6, 7, 8], [2, 1, 4, 3, 5, 6, 7, 8], [1, 3, 2, 4, 5, 6, 7, 8]],PermList);;
for j in [1..6] do o:=Orbits(Group(t{Difference([1..6],[j])}),[1..8]); if Length(o)<2 then Error("transitive S8 omission");fi; Print("S8|0|",j-1,"|",SortedList(List(o,Length)),"\n");od;
t:=List([[1, 2, 3, 4, 5, 6, 8, 7], [1, 2, 3, 4, 7, 8, 5, 6], [1, 2, 3, 5, 4, 6, 7, 8], [1, 2, 4, 3, 5, 6, 7, 8], [1, 3, 2, 4, 5, 6, 7, 8], [2, 1, 3, 4, 5, 6, 7, 8]],PermList);;
for j in [1..6] do o:=Orbits(Group(t{Difference([1..6],[j])}),[1..8]); if Length(o)<2 then Error("transitive S8 omission");fi; Print("S8|1|",j-1,"|",SortedList(List(o,Length)),"\n");od;
t:=List([[1, 2, 3, 5, 4], [1, 2, 4, 3, 5], [1, 3, 2, 4, 5], [2, 1, 3, 4, 5]],PermList);;
if not ForAll([1..Length(t)-1],j->Order(t[j]*t[j+1])=3) then Error("not simplex");fi;
Print("SMALL|0|",List([1..Length(t)],j->SortedList(List(Orbits(Group(t{Difference([1..Length(t)],[j])}),[1..5]),Length))),"\n");
t:=List([[1, 2, 3, 4, 6, 5], [1, 2, 3, 5, 4, 6], [1, 2, 4, 3, 5, 6], [1, 3, 2, 4, 5, 6], [2, 1, 3, 4, 5, 6]],PermList);;
if not ForAll([1..Length(t)-1],j->Order(t[j]*t[j+1])=3) then Error("not simplex");fi;
Print("SMALL|1|",List([1..Length(t)],j->SortedList(List(Orbits(Group(t{Difference([1..Length(t)],[j])}),[1..6]),Length))),"\n");
t:=List([[2, 1, 4, 3, 6, 5], [3, 5, 1, 6, 2, 4], [2, 1, 6, 5, 4, 3], [3, 4, 1, 2, 6, 5], [2, 1, 5, 6, 3, 4]],PermList);;
if not ForAll([1..Length(t)-1],j->Order(t[j]*t[j+1])=3) then Error("not simplex");fi;
Print("SMALL|2|",List([1..Length(t)],j->SortedList(List(Orbits(Group(t{Difference([1..Length(t)],[j])}),[1..6]),Length))),"\n");
Print("PASS_INITIAL_FRACTURE_BOUNDARIES\n");QUIT;
