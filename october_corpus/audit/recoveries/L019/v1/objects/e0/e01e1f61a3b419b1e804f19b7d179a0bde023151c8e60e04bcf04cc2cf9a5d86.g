SizeScreen([100000,100000]);;
t:=List([[5, 6, 7, 8, 1, 2, 3, 4], [1, 2, 3, 4, 6, 5, 8, 7], [1, 3, 2, 4, 5, 7, 6, 8], [1, 2, 4, 3, 5, 6, 8, 7]],PermList);; a:=1;;n:=8;;
G:=Group(t);; P:=Group([],());; anchorOrbit:=[a];; failures:=[];;
for j in [1..Length(t)] do Q:=Group(t{[1..j]});;K:=Intersection(Q,SymmetricGroup(anchorOrbit));;M:=Intersection(K,P);;if not IsSubgroup(P,K) then Add(failures,[j,Size(K),Size(M),anchorOrbit]);fi;P:=Q;;anchorOrbit:=Orbit(P,a);;od;
omits:=List([1..Length(t)],j->SortedList(List(Orbits(Group(t{Difference([1..Length(t)],[j])}),[1..n]),Length)));;
Print("CANDIDATE|0|",Size(G),"|",failures,"|",omits,"\n");
