@MathCompression.AffinePeriodIntersections.quotient_inf_of_smaller_period : ∀ {G : Type u_1} [inst : Group G]
  (A B L M N : Subgroup G) [inst_1 : M.Normal] [inst_2 : N.Normal],
  M ≤ N →
    N ≤ L →
      L ⊓ A = ⊥ →
        L ⊓ B = ⊥ →
          Subgroup.map (QuotientGroup.mk' N) A ⊓ Subgroup.map (QuotientGroup.mk' N) B =
              Subgroup.map (QuotientGroup.mk' N) (A ⊓ B) →
            Subgroup.map (QuotientGroup.mk' M) A ⊓ Subgroup.map (QuotientGroup.mk' M) B =
              Subgroup.map (QuotientGroup.mk' M) (A ⊓ B)
@MathCompression.AffinePeriodIntersections.quotient_family_of_one_period : ∀ {G : Type u_1} [inst : Group G]
  {I : Type u_2} (A B L N : Subgroup G) [inst_1 : N.Normal] (M : I → Subgroup G) [inst_2 : ∀ (i : I), (M i).Normal],
  (∀ (i : I), M i ≤ N) →
    N ≤ L →
      L ⊓ A = ⊥ →
        L ⊓ B = ⊥ →
          Subgroup.map (QuotientGroup.mk' N) A ⊓ Subgroup.map (QuotientGroup.mk' N) B =
              Subgroup.map (QuotientGroup.mk' N) (A ⊓ B) →
            ∀ (i : I),
              Subgroup.map (QuotientGroup.mk' (M i)) A ⊓ Subgroup.map (QuotientGroup.mk' (M i)) B =
                Subgroup.map (QuotientGroup.mk' (M i)) (A ⊓ B)
@HumanCompression.PeriodSignObstruction.literal_word_conjugacy : ∀ {G : Type u_1} [inst : Group G] (a b c : G),
  a * a = 1 →
    b * b = 1 →
      c * c = 1 →
        a⁻¹ * HumanCompression.PeriodSignObstruction.firstWord a b c * a =
          (HumanCompression.PeriodSignObstruction.secondWord a b c)⁻¹
@HumanCompression.PeriodSignObstruction.equal_period_signs_collapse : ∀ {G : Type u_1} [inst : Group G] (a u v x : G)
  (k : ℕ),
  a⁻¹ * u * a = v⁻¹ → Commute a (x ^ 4) → u ^ (2 * k) = x ^ (4 * k) → v ^ (2 * k) = x ^ (4 * k) → x ^ (8 * k) = 1
@HumanCompression.PeriodSignObstruction.source_period_sign_obstruction : ∀ {G : Type u_1} [inst : Group G] (a b c : G)
  (k : ℕ),
  a * a = 1 →
    b * b = 1 →
      c * c = 1 →
        Commute a ((b * c) ^ 4) →
          ((b * ((b * a)⁻¹ * c * (b * a))) ^ 2) ^ (2 * k) = (b * c) ^ (4 * k) →
            ((b⁻¹ * c * b * (a⁻¹ * b * a)) ^ 2) ^ (2 * k) = (b * c) ^ (4 * k) → (b * c) ^ (8 * k) = 1
@MathCompression.QuotientIntersectionCriterion.image_inf_iff_kernel_product : ∀ {H : Type u_1} {G : Type u_2}
  [inst : Group H] [inst_1 : Group G] (f : H →* G) (A B : Subgroup H),
  Subgroup.map f A ⊓ Subgroup.map f B = Subgroup.map f (A ⊓ B) ↔ ↑f.ker ∩ (↑A * ↑B) = ↑(f.ker ⊓ A) * ↑(f.ker ⊓ B)
@MathCompression.QuotientIntersectionCriterion.quotient_inf_iff_kernel_product : ∀ {H : Type u_1} [inst : Group H]
  (A B M : Subgroup H) [inst_1 : M.Normal],
  Subgroup.map (QuotientGroup.mk' M) A ⊓ Subgroup.map (QuotientGroup.mk' M) B =
      Subgroup.map (QuotientGroup.mk' M) (A ⊓ B) ↔
    ↑M ∩ (↑A * ↑B) = ↑(M ⊓ A) * ↑(M ⊓ B)
@MathCompression.QuotientIntersectionCriterion.image_inf_iff_trivial_defect : ∀ {H : Type u_1} {G : Type u_2}
  [inst : Group H] [inst_1 : Group G] (f : H →* G) (A B L : Subgroup H),
  f.ker ≤ L →
    L ⊓ A = ⊥ →
      L ⊓ B = ⊥ → (Subgroup.map f A ⊓ Subgroup.map f B = Subgroup.map f (A ⊓ B) ↔ ↑f.ker ∩ (↑L ∩ (↑A * ↑B)) = {1})
@MathCompression.QuotientIntersectionCriterion.quotient_inf_iff_trivial_defect : ∀ {H : Type u_1} [inst : Group H]
  (A B L M : Subgroup H) [inst_1 : M.Normal],
  M ≤ L →
    L ⊓ A = ⊥ →
      L ⊓ B = ⊥ →
        (Subgroup.map (QuotientGroup.mk' M) A ⊓ Subgroup.map (QuotientGroup.mk' M) B =
            Subgroup.map (QuotientGroup.mk' M) (A ⊓ B) ↔
          ↑M ∩ (↑L ∩ (↑A * ↑B)) = {1})
