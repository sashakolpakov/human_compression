a:=(1,2)(5,6)(7,8)(11,12)(13,14)(17,18);;
b:=(2,3)(4,5)(7,9)(10,11)(14,15)(16,17);;
c:=(3,4)(5,7)(6,8)(9,10)(11,13)(12,14)(15,16);;
t:=(1,18);;q:=t*b;;
Check:=function(v,m) if not v then Error(m);fi;end;;
old:=[a,q,c];;new:=[t,a,b,c];;
Check(Size(Group(old))=Factorial(18),"literal original does not generate S18");;
Check(Size(Group(new))=Factorial(18),"literal output not S18");;
Check(ForAll(old,x->Order(x)=2) and Length(Set(old))=3,"old involutions");;
Check(ForAll(new,x->Order(x)=2) and Length(Set(new))=4,"new involutions");;
Check(Order(a*q)=6 and Order(q*c)=90,"original type");;
Check(Order(t*a)=4 and Order(a*b)=3 and Order(b*c)=90,"new adjacent orders");;
Subs:=function(xs) return List(Combinations([1..Length(xs)]),I->rec(indices:=I,group:=Group(Concatenation([()],xs{I}))));end;;
ends:=Subs(old);;pairs:=0;;
for x in ends do for y in ends do
 Check(Intersection(x.group,y.group)=Group(Concatenation([()],old{Intersection(x.indices,y.indices)})),"old full IP");pairs:=pairs+1;
od;od;
Check(pairs=64,"all old pairs");;
Check(Order(a*c)=2 and Order(t*b)=2 and Order(t*c)=2,"commuting nonadjacent marks");;
Check(SortedList(Orbits(Group(a,b),[1..18]))=List([0..5],i->[3*i+1..3*i+3]),"middle orbits");;
Check(SortedList(List(Orbits(Group(t,a,b),[1..18]),Length))=[3,3,3,3,6],"six orbit hypothesis");;
Check(1^c=1 and 18^c=18 and t*b=q and Order(b)=2,"literal permitted split");;
Check(Length(Cycles(q,[1..18]))=11 and NrMovedPoints(q)=14,"seven split cycles");;
seed:=(a*q*c*q)^45;;Check(seed=(4,9),"spanning tree seed");;
words:=[[],[q],[c],[q,a],[c,q],[c,q,a],[c,q,c],[c,q,a,q],[c,q,a,c],[c,q,c,q],[c,q,a,q,a],[c,q,a,c,q],[c,q,c,q,a],[c,q,c,q,c],[c,q,a,q,a,q],[c,q,c,q,c,q],[c,q,c,q,c,q,a]];;
edges:=[(4,9),(5,7),(3,10),(6,8),(2,11),(1,12),(2,13),(12,18),(1,14),(3,13),(11,17),(15,18),(3,14),(4,11),(10,16),(5,10),(6,10)];;
Check(ForAll([1..17],i->seed^Product(Concatenation([()],words[i]))=edges[i]),"all seventeen literal conjugates");;
Check(IsTransitive(Group(edges),[1..18]),"connected tree");;
r:=a*q;;
Check(Filtered([0..5],i->Set([1,18],j->j^(r^i))=[1,18])=[0,3],"left rotations preserving pair");;
Check(2^(r^3)=17 and not 17 in Orbit(Group(q,c),2),"nontrivial rotation excluded");;
w:=a*(b*c)^2*b*a*(c*b)^8*a;;
Check(6^w=1 and 8^w=18 and ((b*c)^45)^w=t,"explicit disjoint-index witness");;
H:=Group(t,a,b);;B:=Group(a,b);;K:=Group(a,b,c);;
Check(Size(K)=Factorial(18) and t in K and not t in B and Intersection(H,K)=H,"actual end-intersection failure");;
Check(Size(H)=48 and Size(B)=6,"actual index eight defect");;
Print("PASS_L020_DISTINCT_GAP:degree=18;old-order=",Size(Group(old)),";old-IP=",pairs,";tree-edges=17;H=",Size(H),";B=",Size(B),";intersection=",Size(Intersection(H,K)),";old-type=[6,90];new-type=[4,3,90]\n");
QUIT;
