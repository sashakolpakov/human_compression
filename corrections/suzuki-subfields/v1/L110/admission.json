      {
        "label": "Theorem 5 and literal Construction 11",
        "printed_pages": [
          17,
          18
        ],
        "failed_conclusion": "The proposed exhaustive construction list excludes an actual rank-four RWPRI pregeometry."
      }
    ],
    "hypotheses": [
      "The source definition is the weak subgroup-intersection RWPRI condition; flag transitivity, residual connectedness and even the full geometry axiom are not hypotheses of this target.",
      "All parabolic groups are standard simple subfield Suzuki groups."
    ],
    "witness": {
      "field_degree": 3465,
      "degree_factorization": "3^2 * 5 * 7 * 11",
      "rank": 4,
      "parabolic_degrees": [
        1155,
        693,
        495,
        315
      ],
      "intersection_groups": 16,
      "maximal_inclusions": 32,
      "smallest_field_degree": 3
    },
    "contradiction": "The source uses four distinct prime divisors and permits pure-subfield Construction 11 only through rank three. The actual rank-four pregeometry has all sixteen distinct intersections and all thirty-two required prime-degree maximal inclusions. Constructions 1\u201310 each require a soluble maximal parabolic, so they do not cover it.",
    "qualifications": [
      "This is the literal endpoint omission; adding appropriate truncations or changing a rank range might repair it, but no complete repair is claimed.",
      "No geometry or flag-transitivity claim about this rank-four example is used.",
      "The standard-subfield intersection lemma is acquired by L114; the two source dispositions remain distinct."
    ],
    "common_qualifications": [
      "Each disposition refutes the literal fixed published assertion, rather than recovering every true result in that paper.",
      "Classical Suzuki matrix, Bruhat, order, subfield-maximality and stated torus or automorphism facts remain explicitly attributed inputs; no new classification of Suzuki groups is claimed.",
      "The older phase6/phase8 witness and proof history is preserved without a new-discovery or priority claim.",
      "No claim about later editions, absence of errata, named open questions, new Lean declarations or compression measurements is made.",
      "No replacement complete classification or complete corrected global count is asserted."
    ],
