      },
      {
        "source": "Theorem 11.1",
        "published_authorship": "Connor\u2013Leemans, ClassificationTheorem1.1",
        "exact_scope": "The complete arbitrary-C-group Suzuki classification, including nonstring existence, remains a borrowed published theorem. It is not inferred just from the acquired string case.",
