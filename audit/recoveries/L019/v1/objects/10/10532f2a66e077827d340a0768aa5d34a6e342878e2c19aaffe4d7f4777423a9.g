tuples:=[[[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [1, 2, 3, 4, 6, 5, 7, 8, 10, 9], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [1, 2, 3, 4, 6, 5, 8, 7, 9, 10], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10], [3, 5, 1, 4, 2, 6, 7, 8, 9, 10], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [1, 2, 4, 3, 6, 5, 10, 9, 8, 7], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [1, 2, 4, 3, 6, 5, 10, 9, 8, 7], [3, 5, 1, 4, 2, 6, 7, 8, 9, 10], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [2, 1, 4, 3, 6, 5, 7, 8, 10, 9], [1, 5, 4, 3, 2, 6, 7, 8, 9, 10], [3, 4, 1, 2, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10], [2, 1, 4, 3, 6, 5, 8, 7, 9, 10], [1, 5, 4, 3, 2, 6, 7, 8, 9, 10], [3, 4, 1, 2, 5, 6, 7, 8, 9, 10]], [[1, 2, 3, 4, 5, 6, 8, 7, 10, 9], [1, 2, 3, 4, 7, 9, 5, 8, 6, 10], [1, 2, 5, 6, 3, 4, 7, 8, 9, 10], [3, 4, 1, 2, 5, 6, 7, 8, 9, 10], [1, 2, 4, 3, 6, 5, 9, 10, 7, 8]], [[1, 2, 4, 3, 6, 5, 8, 7, 10, 9], [3, 4, 1, 2, 5, 6, 7, 8, 9, 10], [1, 2, 5, 6, 3, 4, 7, 8, 9, 10], [1, 2, 3, 4, 7, 8, 5, 6, 9, 10], [1, 2, 3, 4, 5, 6, 9, 10, 7, 8]]];;
expected:=[[2,0,10,5040,5040,360,60],[3,1,1,5040,5040,360,60],[5,1,1,40320,10080,720,120],[8,0,10,40320,10080,720,120]];;
t:=[];;answers:=[];;
for idx in [1..Length(tuples)] do for rev in [0,1] do
 t:=List(tuples[idx],PermList);if rev=1 then t:=Reversed(t);fi;
 if Size(Group(t))<>Concatenation(List([1..8],x->1814400),[1920,1920])[idx] then Error("wrong acquired group order");fi;
 for a in Filtered([1..10],a->a^t[1]<>a and ForAll(t{[2..5]},h->a^h=a)) do
  if not IsTransitive(Group(t{[2..5]}),Difference([1..10],[a])) then continue;fi;
  u:=(a,11);U:=Group(t{[1..4]});V:=Group(Concatenation([u],t{[1..3]}));M:=Group(t{[1..3]});I:=Intersection(U,V);
  Add(answers,[idx,rev,a,Size(U),Size(V),Size(I),Size(M)]);
 od;
od;od;
if answers<>expected then Error("exact filter disagreement");fi;
Print("PASS_A10_GAP ",answers,"\n");QUIT;
