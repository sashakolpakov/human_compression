small:= [[[2, 1, 4, 3, 6, 5], [4, 5, 6, 1, 2, 3], [2, 1, 6, 5, 4, 3], [4, 3, 2, 1, 6, 5]], [[1, 3, 2, 4, 6, 5], [2, 1, 3, 5, 4, 6], [1, 5, 6, 4, 2, 3], [4, 5, 6, 1, 2, 3]], [[1, 3, 2, 4, 6, 5], [2, 1, 3, 5, 4, 6], [1, 6, 5, 4, 3, 2], [4, 5, 6, 1, 2, 3]], [[1, 5, 6, 4, 2, 3], [2, 1, 3, 5, 4, 6], [1, 3, 2, 4, 6, 5], [4, 5, 6, 1, 2, 3]], [[1, 5, 6, 4, 2, 3], [2, 1, 6, 5, 4, 3], [4, 3, 2, 1, 6, 5], [4, 5, 6, 1, 2, 3]], [[2, 1, 6, 5, 4, 3], [3, 5, 1, 6, 2, 4], [4, 5, 3, 1, 2, 6], [4, 5, 6, 1, 2, 3]], [[2, 1, 6, 5, 4, 3], [3, 5, 1, 6, 2, 4], [5, 4, 6, 2, 1, 3], [4, 5, 6, 1, 2, 3]], [[4, 5, 6, 1, 2, 3], [1, 3, 2, 4, 6, 5], [2, 1, 3, 5, 4, 6], [1, 5, 6, 4, 2, 3]], [[4, 5, 6, 1, 2, 3], [1, 3, 2, 4, 6, 5], [2, 1, 3, 5, 4, 6], [1, 6, 5, 4, 3, 2]], [[4, 5, 6, 1, 2, 3], [1, 5, 6, 4, 2, 3], [2, 1, 3, 5, 4, 6], [1, 3, 2, 4, 6, 5]], [[4, 5, 6, 1, 2, 3], [1, 5, 6, 4, 2, 3], [2, 1, 6, 5, 4, 3], [4, 3, 2, 1, 6, 5]], [[4, 5, 6, 1, 2, 3], [2, 1, 6, 5, 4, 3], [3, 5, 1, 6, 2, 4], [4, 5, 3, 1, 2, 6]], [[4, 5, 6, 1, 2, 3], [2, 1, 6, 5, 4, 3], [3, 5, 1, 6, 2, 4], [5, 4, 6, 2, 1, 3]], [[4, 5, 6, 1, 2, 3, 8, 7], [4, 6, 7, 1, 8, 2, 3, 5], [2, 1, 8, 5, 4, 7, 6, 3], [4, 6, 5, 1, 3, 2, 8, 7], [4, 5, 7, 1, 2, 8, 3, 6]], [[2, 1, 4, 3, 6, 5], [3, 5, 1, 6, 2, 4], [2, 1, 6, 5, 4, 3], [6, 5, 4, 3, 2, 1]]];;
large:= [[[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 8, 9, 11, 10], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]], [[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 8, 9, 11, 10], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [3, 5, 1, 4, 2, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]], [[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10, 11], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [1, 3, 2, 5, 4, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]], [[1, 2, 3, 4, 5, 6, 7, 9, 8, 11, 10], [1, 2, 3, 4, 5, 6, 8, 7, 10, 9, 11], [1, 2, 3, 4, 5, 7, 6, 9, 8, 10, 11], [1, 2, 4, 3, 6, 5, 7, 8, 9, 10, 11], [3, 5, 1, 4, 2, 6, 7, 8, 9, 10, 11], [2, 1, 4, 3, 5, 6, 7, 8, 9, 10, 11]]];;

RunWingReplay:=function()
local row,marks,orientation,a,points,c,s,u,v,inter,middle,count;
for row in small do
 marks:=List(row,PermList);
 for orientation in [0,1] do
  if orientation=1 then marks:=Reversed(marks);fi;
  points:=Filtered([1..Length(row[1])],a->a^marks[1]<>a and ForAll(marks{[2..Length(marks)]},x->a^x=a));
  if Length(points)<>0 then Error("small exception has anchor");fi;
 od;
od;
count:=0;
for row in large do
 marks:=List(row,PermList);
 if Group(marks)<>AlternatingGroup(11) then Error("wrong large group");fi;
 for orientation in [0,1] do
  if orientation=1 then marks:=Reversed(marks);fi;
  points:=Filtered([1..11],a->a^marks[1]<>a and ForAll(marks{[2..6]},x->a^x=a));
  for a in points do
   count:=count+1;
   c:=Stabilizer(Centralizer(SymmetricGroup(11),Group(marks{[2..6]})),a);
   if Size(c)<>1 then Error("nontrivial centralizer");fi;
   s:=Concatenation([(a,12)],marks);
   u:=Group(s{[2..5]});v:=Group(s{[1..4]});inter:=Intersection(u,v);middle:=Group(s{[2..4]});
   if [Size(u),Size(v),Size(inter),Size(middle)]<>[5040,5040,360,60] then Error("wrong obstruction");fi;
  od;
 od;
od;
if count<>4 then Error("wrong anchor count");fi;
Print("PASS_WINGS_SMALL15_LARGE4_ANCHORS4\n");
end;
RunWingReplay();QUIT_GAP(0);
