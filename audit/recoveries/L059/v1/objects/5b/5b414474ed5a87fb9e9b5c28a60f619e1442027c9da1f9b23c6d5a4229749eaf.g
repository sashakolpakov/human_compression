Read("subdivision_markings.g");;
Read("maximal_descent_arcs.g");;
L059Edges:=Set([[1, 2], [1, 16], [1, 102], [2, 3], [2, 10], [3, 4], [3, 80], [4, 5], [4, 89], [5, 6], [5, 61], [6, 7], [6, 84], [7, 8], [7, 36], [8, 9], [8, 19], [9, 10], [9, 98], [10, 11], [11, 12], [11, 39], [12, 13], [12, 94], [13, 14], [13, 21], [14, 15], [14, 27], [15, 16], [15, 77], [16, 17], [17, 18], [17, 60], [18, 19], [18, 51], [19, 20], [20, 21], [20, 56], [21, 22], [22, 23], [22, 74], [23, 24], [23, 37], [24, 25], [24, 86], [25, 26], [25, 67], [26, 27], [26, 41], [27, 28], [28, 29], [28, 58], [29, 30], [29, 64], [30, 31], [30, 95], [31, 32], [31, 46], [32, 33], [32, 40], [33, 34], [33, 99], [34, 35], [34, 66], [35, 36], [35, 49], [36, 37], [37, 38], [38, 39], [38, 90], [39, 40], [40, 41], [41, 42], [42, 43], [42, 102], [43, 44], [43, 88], [44, 45], [44, 59], [45, 46], [45, 53], [46, 47], [47, 48], [47, 91], [48, 49], [48, 62], [49, 50], [50, 51], [50, 75], [51, 52], [52, 53], [52, 100], [53, 54], [54, 55], [54, 72], [55, 56], [55, 96], [56, 57], [57, 58], [57, 85], [58, 59], [59, 60], [60, 61], [61, 62], [62, 63], [63, 64], [63, 78], [64, 65], [65, 66], [65, 83], [66, 67], [67, 68], [68, 69], [68, 76], [69, 70], [69, 101], [70, 71], [70, 81], [71, 72], [71, 87], [72, 73], [73, 74], [73, 92], [74, 75], [75, 76], [76, 77], [77, 78], [78, 79], [79, 80], [79, 93], [80, 81], [81, 82], [82, 83], [82, 97], [83, 84], [84, 85], [85, 86], [86, 87], [87, 88], [88, 89], [89, 90], [90, 91], [91, 92], [92, 93], [93, 94], [94, 95], [95, 96], [96, 97], [97, 98], [98, 99], [99, 100], [100, 101], [101, 102]]);;
G:=Graph(Group(()),[1..102],OnPoints,function(a,b) return Set([a,b]) in L059Edges; end,true);;
Need(IsConnectedGraph(G));;
F:=AutGroupGraph(G);;
arcs:=Concatenation(List(L059Edges,e->[e,Reversed(e)]));;
reps:=List(L059DescentArcs(F,arcs),Representative);;
S:=rec(label:="CAT_102_1",n_original:=102,edges_original:=L059Edges,A_subdivision:=F,witnesses:=L059SubdivisionRows(F,L059Edges,reps),search:=L059Search);;
PrintTo("nonbipartite_subdivisions/CAT_102_1.g","L059Subdivision := ",S,";\n");
Print("L059_NONBIPARTITE_COMPLETE CAT_102_1 ",Length(S.witnesses),"\n");
QUIT;
