L059Subdivision := rec(
  A_subdivision := SymmetricGroup( [ 1 .. 4 ] ),
  edges_original := [ [ 1, 2 ], [ 1, 3 ], [ 1, 4 ], [ 2, 3 ], [ 2, 4 ], 
      [ 3, 4 ] ],
  label := "CAT_4_1",
  n_original := 4,
  search := rec(
      method := "maximal_subgroup_descent_on_arcs",
      nodes := [ rec(
              H := SymmetricGroup( [ 1 .. 4 ] ),
              children := [ rec(
                      K := AlternatingGroup( [ 1 .. 4 ] ),
                      reason := "retained_class",
                      target := 2 ), rec(
                      K := Group( [ (3,4), (1,3)(2,4) ] ),
                      reason := "order" ), rec(
                      K := Group( [ (3,4), (2,4,3) ] ),
                      reason := "order" ) ] ), rec(
              H := AlternatingGroup( [ 1 .. 4 ] ),
              children := [ rec(
                      K := Group( [ (1,3)(2,4), (1,4)(2,3) ] ),
                      reason := "order" ), rec(
                      K := Group( [ (2,4,3) ] ),
                      reason := "order" ) ] ) ] ),
  witnesses := [ rec(
          B := Group( [ (3,4) ] ),
          H := SymmetricGroup( [ 1 .. 4 ] ),
          H0 := Group( [ (3,4), (2,3) ] ),
          H1 := Group( [ (3,4), (1,2) ] ),
          dualorder := 0,
          group_order := 24,
          maxcode := [ "2T", "2T", "2T", "X" ],
          maxorder := 4,
          normcode := [ true, false, false, false ],
          subgroup_orders := [ 6, 4, 2 ] ), rec(
          B := Group( () ),
          H := AlternatingGroup( [ 1 .. 4 ] ),
          H0 := Group( [ (2,4,3) ] ),
          H1 := Group( [ (1,2)(3,4) ] ),
          dualorder := 0,
          group_order := 12,
          maxcode := [ "M", "2T", "2T", "X" ],
          maxorder := 3,
          normcode := [ true, false, false, true ],
          subgroup_orders := [ 3, 2, 1 ] ) ] );
