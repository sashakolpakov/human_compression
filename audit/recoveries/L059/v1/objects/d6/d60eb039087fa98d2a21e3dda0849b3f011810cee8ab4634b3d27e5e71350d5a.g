G:=Graph(Group(()),[1..234],OnPoints,function(a,b) return Set([a,b]) in L059Edges; end,true);;
Need(IsConnectedGraph(G));;
F:=AutGroupGraph(G);;
arcs:=Concatenation(List(L059Edges,e->[e,Reversed(e)]));;
reps:=List(L059DescentArcs(F,arcs),Representative);;
S:=rec(label:="CAT_234_2",n_original:=234,edges_original:=L059Edges,A_subdivision:=F,witnesses:=L059SubdivisionRows(F,L059Edges,reps),search:=L059Search);;
