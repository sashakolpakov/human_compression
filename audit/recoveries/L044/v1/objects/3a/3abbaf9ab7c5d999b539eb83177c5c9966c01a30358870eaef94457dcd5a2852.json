  "uses": {
    "odd_tail": "Exact critical source-head/natural alternating tail reduction with its whole standing hypotheses and smaller-degree alternating induction.",
    "internal_pair": "Normalize each colour pair within an actual orbit to a bad orbit; disjoint complete assignment gives exact deficit sum.",
    "equivariant": "Every exchanged pair of nontrivial odd orbits gives total deficit at most -3.",
    "strict_and_localized": "Every odd internal nontrivial orbit excluded, including empty pair and final first-assigned anchor; extra fixed singleton exchange treated separately.",
    "interval": "Full actual orbit count bounds f+c<=2k, retaining all fixed vertices."
  },
  "new_mathematics": "Explicit exhaustion of all sign contributions under a per-colour ambient pair in a single actual orbit, and precise contrapositive residual interface.",
  "all_predecessor_proofs_and_required_inputs_remain_paid": true,
  "new_computation_or_formal_premise": false
}
