  "uses": {
    "ambient_and_selected_cuts": "Whole normal-form, cycle localisation, partition and ordinary/global-middle arguments, with exact prior authorship and distinct review retained.",
    "localized_internal": "Confinement of every eligible edge, not an initial choice, and actual fixed-singleton accounting.",
    "critical_and_strict_head": "Actual natural alternating tail and full-IP pure head proof giving x=b^sigma nontrivial, tau-fixed, K-fixed.",
    "paired_head": "Complete bounded per-orbit-pair conclusion for the source head, used for c=1 and most c=2/3 cases.",
    "Whiston_and_odd_path": "Exact equality for an independent involutory string of length m-1 on odd m: full S_m ordinary marked path. m=3 elementary; complete L047 theorem includes degree five. The existing fixed-label proof displays the identical quotient-independent interface."
  },
  "new_mathematics": [
    "Selected-colour confinement over actual larger-interval orbits.",
    "Actual selected-subgroup orbit bound when the selected colour set has no one-colour hole.",
    "Full c=1/2/3 exceptional-head global-pair exhaustion, with disjoint colour assignment and the actual supported subgroup in the exchanged-row equality case."
  ],
