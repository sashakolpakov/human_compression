  "exact_interfaces": {
    "transitive_tail": "Full proof of Theorem3: the small A5 tail has rank3, while both possible initial A5 exits force h=2 (i=0 or1). Full reversal maps these alternatives to g=3 or r-3. All critical small-tail and complete attachment arguments retained.",
    "maximal_crossing": "Full theorem proof, orientation and support budgets, nested/purity/touching steps, actual orbit-incidence inequality. Its three uses of excluding either A5 end are replaced explicitly; no other premise changed.",
    "early_exceptional_cuts": "Both complete lemmas: G4 has at least3 orbits and exact early unique/shared labels. No B-transitivity assumption.",
    "opposite_exceptional_ends": "Proposition1 complete later-unshared classification: singleton or D10 creating last actual A5. All directly bound small-attachment, natural-prefix and pure-head obstructions retained.",
    "large_pure_prefix_v2": "Clarified direct complete attachment route, root-accepted successor; no use of unqualified raw-table sentence.",
    "odd_tail_reduction": "Whole critical-head reduction and its induction/classical/finite inputs remain paid."
  },
  "new_argument": "Track the exact indices of exceptional exits; h>=3 and g>h exclude the already present first head, replacing those former exclusions in maximal-crossing routing.",
  "new_computation_or_formal_premise": false
}
