  "interfaces": {
    "standing": "All actual odd-degree head, natural alternating tail, ambient IP and global two-edge hypotheses are stated explicitly in the author proof.",
    "transport": "Only the first whole-orbit transport lemma from internal_pair_cuts is used. Since j>=6, the transporting element lies in G_j and centralizes rho_j, so the edge remains ambient eligible. It transports the complete marked K-action into a K-intransitive H-orbit.",
    "active_interval": "The complete local_pairs active-component and first-active-label arguments apply to actual H-witness orbits. The new proof separately establishes the K-interval and its first label 6.",
    "anchor": "Only the degree-independent actual anchor argument from odd_degree_nine_fixed is used. No nine-fixed-point exclusion or assignment hypothesis is silently borrowed.",
    "pure_core": "Only the actual natural alternating overlap argument of Lemma 4 in strict_internal is used. Its proof puts the pure alternating group on D union {beta,z0} in G_{<=4}, so its pure core three-cycle lies in the actual natural tail and full IP puts it in <tau,sigma>. No n=2r budget theorem is used.",
    "terminal_rows": "The acquired odd-degree row mechanism is replayed with the present actual hypotheses. rho_5 may act on O and V; only their status as actual H-orbits is needed for invariance.",
    "exterior_pair": "The literal transposition branch invokes the accepted near-critical exterior-pair theorem under the explicit actual head and globally paired tail hypotheses.",
    "no_quotient_ip": "The degree bound uses actual omission orbits and a spanning-tree cut argument. No restricted intersection property, independent generating set or classification of a projected marking is assumed."
  },
  "new_statements": [
    "The K-transitive witness and its transported K-orbit have active labels 6 through x; every omission except possibly the last is intransitive, and their common degree is at least x-4.",
    "The last active label is nonterminal and at least 2x+1 points are fixed by G_{>x}."
  ],
  "new_rank_induction_or_computation": false,
  "pending_packets_used_as_premises": false
}
