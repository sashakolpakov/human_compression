  "interfaces": {
    "actual_witnesses": "Two actual distinct K-intransitive witnesses for the strong simultaneous crossing colour are assumed; both have first active label 5, full local uniqueness and pointwise delta-fixation.",
    "local_prefix_count": "The strict proper-prefix lemma is applied in reverse left order. The surviving left anchor orbits, joined by the crossing, lie in a single first-omission orbit. No explicit exhausted-path classification is needed.",
    "anchor_extension": "The minimum-left-union fixed-anchor statement writes the complete extension of the earlier one-step argument to all y>j, rather than invoking its former y>=j+2 statement with a changed hypothesis.",
    "extra_point": "The possible single extra fixed-set point is shown delta-fixed, and H-fixed whenever K-fixed. It is adjoined to an invariant union only with those facts paid.",
    "exterior_pair": "The shift j+1 is proved nonterminal because a terminal shift confines the odd delta to at most three points, hence to a literal transposition, excluded by the acquired exact pair obstruction.",
    "scope": "The second witness is never transported and declared distinct without proof. The j=5 exception uses an actual distinct K-orbit image under rho4, identified by the extra point."
  },
  "new_statements": [
    "The minimum left endpoint union cannot meet a nontrivial first-omission orbit on which the full right factor is trivial.",
    "A fixed first-omission anchor in a minimum or one-larger left endpoint union controls every nontrivial first-omission orbit and its right-factor action.",
    "At minimum degree, a shorter witness ending at the crossing has one first-omission singleton and a transitive complement.",
    "When the shorter of two K-intransitive witnesses ends at j, a strict nonterminal separator exists at j+1 for j>=6; for j=5 it is at 6 or at the longer endpoint y."
  ],
  "new_rank_induction_or_computation": false,
  "pending_packets_used_as_premises": false
}
