Read("programs/local_geometry.g");;
Read("F24d2G1-p306936B0.g1");;Read("F24d2G1-p306936B0.g2");;
Read("witnesses/F24_compact.g");;
c:=b11;;d:=b21;;z:=c*d*c*d^6;;
Need([Order(c),Order(d),Order(c*d),Order(z),Order(c*z^27),Order(c*d^2)]=[2,8,29,54,3,20],"all six Atlas full-extension standard checks");;
Need(Length(F24aWord) mod 2=0,"inner a-word parity");;
a:=WordValue([c,d],F24aWord)^F24aPower;;zs:=[];;orders:=[];;
for w in F24BraySeeds do
 Need(Length(w) mod 2=0,"inner seed-word parity");
 h:=WordValue([c,d],w);x:=c*c^h;k:=Order(x);
 Need(k mod 2=1,"odd Bray order");z:=h*x^((k-1)/2);
 Need(Comm(c,z)=(),"each Bray word centralizes");Add(zs,z);Add(orders,k);
od;
Need(Length(zs)=8,"eight explicit centralizer words");;
Need(ForAll(F24bFactors,i->i in [1..8]),"b factor indices");;
b:=Product(zs{F24bFactors})^F24bPower;;r:=[c,a,b];;
Need([Order(c*a),Order(c*b),Order(a*b)]=[6,2,35],"string product orders");;
Need(F24Type=[6,35],"declared type");;
Need(Order(WordValue(r,F24Prime23[1])^F24Prime23[2])=23,"exact order23 witness");;
Need(Order(WordValue(r,F24Prime29[1])^F24Prime29[2])=29,"exact order29 witness");;
# Named group, outer class, and completeness of this list remain retained inputs.
Need(LoadPackage("ctbllib")<>fail,"CTblLib");;
ct:=CharacterTable("F3+.2");;names:=Maxes(ct);;mos:=List(names,n->Size(CharacterTable(n)));;
Need(names=["F3+","2xFi23","2^2.Fi22.2","S3xO8+(3):S3","O10-(2).2","3^7.O7(3):2","3^(1+10):(2xU5(2):2)","2^12.M24","2^2.U6(2):S3x2","2^(1+12)_+.3_1.U4(3).2^2_{122}","3^3.[3^10].(L3(3)x2^2)","3^2.3^4.3^8.(S5x2S4)","S4xO8+(2):S3","2^(3+12).(L3(2)xS6)","2^(7+8).(S3xA8)","(S3xS3xG2(3)):2","S5xS9","S6xL2(8):3","7:6xS7","7^(1+2)_+:(6xS3).2","frob"],"complete retained maximal names");;
Need(mos=[1255205709190661721292800,8178940946586009600,516494013235200,178278473318400,50030759116800,20056328248320,9697565306880,1002795171840,441447874560,321052999680,35814871872,27549901440,25082265600,3963617280,3963617280,305690112,43545600,1088640,211680,24696,812],"complete retained maximal orders");;
Need(Size(ct)=2510411418381323442585600 and Filtered([1..21],i->mos[i] mod (23*29)=0)=[1],"maximal exclusion");;
for i in [1..21] do Print("MAXIMAL ",names[i]," ORDER ",mos[i],"\n");od;
Print("GENERATION_BY_RETAINED_MAXIMAL_CLASSIFICATION PASS\n");;
nc:=ProperIP(r);;fc:=FlagStreaming(r);;
Need(nc=49 and fc=1168,"complete string local counts");;
Print("STRING proper_IP=",nc," product_tests=",fc," type=[6,2,35]\n");;
s:=[c,a,a^b];;
Need(b=(s[2]*s[3])^17*s[2],"literal halving inverse");;
Need([Order(s[1]*s[2]),Order(s[1]*s[3]),Order(s[2]*s[3])]=[6,6,35],"triangle orders");;
nc2:=ProperIP(s);;fc2:=FlagStreaming(s);;
Need(nc2=49 and fc2=1824,"complete triangle local counts");;
Print("TRIANGLE proper_IP=",nc2," product_tests=",fc2," type=[6,6,35]\n");;
Print("BRAY ORDERS ",orders,"\n");;
Print("F24_COMPLETE_EXACT_WITNESS PASS 98properIP 6flag_equalities retained_named_group_and_maximal_classification\n");;
QUIT;
