LoadPackage("primgrp");;LoadPackage("ctbllib");;
Read("programs/local_geometry.g");;Read("witnesses/Fi22.g");;
G:=PrimitiveGroup(3510,2);;r:=Fi22r;;P:=Group(r);;
Need(ForAll(r,x->x in G),"all saved permutations lie in named group");;
Need(Size(P)=129123503308800 and P=G,"independent exact generated group equality");;
H:=DerivedSubgroup(P);;
Need(Size(H)=64561751654400 and IsSimpleGroup(H),"simple derived socle order");;
Need(not r[1] in H and r[2] in H and r[3] in H,"outer/inner marking");;
Need(Size(Centralizer(P,H))=1,"faithful action on simple socle");;
Need([Order(r[1]*r[2]),Order(r[1]*r[3]),Order(r[2]*r[3])]=[6,2,13],"string orders");;
Need(Order(WordValue(r,Fi22Prime11[1])^Fi22Prime11[2])=11,"actual order11 word");;
Need(Order(WordValue(r,Fi22Prime13[1])^Fi22Prime13[2])=13,"actual order13 word");;
ct:=CharacterTable("Fi22.2");;ns:=Maxes(ct);;ms:=List(ns,n->Size(CharacterTable(n)));;
Need(ms=[64561751654400,36787322880,2090188800,908328960,185794560,106168320,78382080,35942400,35389440,25194240,10077696,8491392,190080],"retained maximal orders");;
Need(Filtered([1..13],i->ms[i] mod 143=0)=[1],"independent generation shortcut");;
for i in [1..13] do Print("MAXIMAL ",ns[i]," ",ms[i],"\n");od;
ip1:=ProperIP(r);;fc1:=FlagStreaming(r);;
s:=[r[1],r[2],r[2]^r[3]];;
Need(r[3]=(s[2]*s[3])^6*s[2],"exact odd-label halving inverse");;
Need([Order(s[1]*s[2]),Order(s[1]*s[3]),Order(s[2]*s[3])]=[6,6,13],"triangle orders");;
Need(Group(s)=P,"direct halved generation equality");;
ip2:=ProperIP(s);;fc2:=FlagStreaming(s);;
Print("EXACT_FI22_PERMUTATION_CERTIFICATE PASS order129123503308800 socle64561751654400 properIP=",[ip1,ip2]," flags=",[fc1,fc2],"\n");;
QUIT;
